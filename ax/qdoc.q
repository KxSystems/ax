system "d .z.m";

system "d .z.m.qch";
.z.m.qch.p.associative:{[f;x;y;z]
    
    f[f[x;y];z] ~ f[x;f[y;z]]
    
    }

.z.m.qch.p.commutative:{[f;x;y]
    f[x;y] ~ f[y;x]
    }

.z.m.qch.p.group:{[f;g;e;x;y;z]
    
    p.closure[f;x;y] and p.associative[f;x;y;z] and p.identity[f;e;x] and p.inverseEl[f;g;e;x]
    
    }

.z.m.qch.p.idempotent:{[f;x]
    f[x] ~ f f x
    }

.z.m.qch.p.identity:{[f;e;x]
    : p.leftIdentity[f;e;x] and p.rightIdentity[f;e;x]
    }

.z.m.qch.p.inverseEl:{[f;g;e;x]
    
    // g finds the inverse element
    (f[x; g x] ~ e) and f[g x; x] ~ e
    
    }

.z.m.qch.p.involutary:{[f;x]
    x ~ f f x
    }

.z.m.qch.p.leftIdentity:{[f;e;x]
    x ~ f[e;x]
    }

.z.m.qch.p.monoid:{[f;e;x;y]
    p.identity[f;e;x] and p.associative[f;e;x;y]
    }

.z.m.qch.p.rightIdentity:{[f;e;x]
    x ~ f[x;e]
    }

system "d .z.m";

system "d .z.m.qch";
// @fileOverview
// Check a property holds
.z.m.qch.check:{[prop]
    : i.run prop;
    }

// @fileOverview
// Create a new property of a single argument.
// 
// Note - There are 7 versions of this function. Each
// version expects a different number of spec
// definitions. This was done so that the spec
// definitions are separated in the api, and 
// not forced into an unintuitive list.
.z.m.qch.forall:{[spec; property]
    : i.foralln [enlist spec; property];
    }

// @fileOverview
// Create a new property of a single argument.
.z.m.qch.forall1:{[spec; property]
    : forall [spec; property];
    }

// @fileOverview
// Create a new property of two arguments.
.z.m.qch.forall2:{[spec1; spec2; property]
    : i.foralln [(spec1; spec2); property];
    }

// @fileOverview
// Create a new property of three arguments.
.z.m.qch.forall3:{[spec1; spec2; spec3; property]
    : i.foralln [(spec1; spec2; spec3); property];
    }

// @fileOverview
// Create a new property of four arguments.
.z.m.qch.forall4:{[spec1; spec2; spec3; spec4; property]
    : i.foralln [(spec1; spec2; spec3; spec4); property];
    }

// @fileOverview
// Create a new property of five arguments.
.z.m.qch.forall5:{[spec1; spec2; spec3; spec4; spec5; property]
    : i.foralln [(spec1; spec2; spec3; spec4; spec5); property];
    }

// @fileOverview
// Create a new property of six arguments.
.z.m.qch.forall6:{[spec1; spec2; spec3; spec4; spec5; spec6; property]
    : i.foralln [(spec1; spec2; spec3; spec4; spec5; spec6); property];
    }

// @fileOverview
// Create a new property of seven arguments.
.z.m.qch.forall7:{[spec1; spec2; spec3; spec4; spec5; spec6; spec7; property]
    : i.foralln [(spec1; spec2; spec3; spec4; spec5; spec6; spec7); property];
    }

// list(resultS) -> Table(class:String, percent:Float)
.z.m.qch.i.classDistribution:{[resultTable]
    
    classes : select c:count i by class from resultTable where not class ~\: "";
    total   : sum exec c from classes;
    classes : select class,percent from 0!update percent : 100 * c % total from classes;
    
    : classes  
    
    }

// @fileOverview Delete a file from disk
// @TODO - should be sync'd with .axfb.del or an .z.m.ax.os lib
.z.m.qch.i.fdel:{[x]
    $[-1 < type c:key x: hsym .z.m.axq.asSymbol x; [.z.s each ` sv'x,'c; hdel x]; hdel x]; 
    }
// list(genS), fn -> propS
.z.m.qch.i.foralln:{[specs; property]
    : propS.new (count specs; specs; property; (::); i.times; 1b)
    }

// @fileOverview Return the current directory
.z.m.qch.i.pwd:{[]: system "cd" }


// propS, list(list(any)) -> finalS
.z.m.qch.i.run:{[prop] 

    // An initial passing result to kick things off
    results : (); 
    Last    : resultS.new (prop; 1b; ::; ::; ::; 0D00:00:00.000);    
    ii : discarded : 0;
    
    // Loop until we find a failing result
    while [ (resultS.success Last) and ii < propS.times prop; 
        Last : i.runSingle [prop; g.reify each propS.spec prop];
        
        // Process the result
        $["discarded_test" ~ resultS.error Last; 
            [   discarded +: 1; 
                if [discarded > propS.times prop;    
                    // If we've hit the discard limit, break
                    Last : resultS.new (prop; 0b; "max_discarded"; ::; (); 0D00:00:00.000); 
                    results ,: enlist Last]];
          // Else log the test and continue
            [   results ,: enlist Last;
                ii +: 1]]];
    
    // Whether there was a failing test
    passed          : all resultS.success each results;    
    maxDiscarded    : "max_discarded" ~ resultS.error last results; 
    propertyError   : not[maxDiscarded] and not .z.m.axq.isNull resultS.error last results;    
    getFailedResult : {[x;y] first select from x where not success } results;
    time: (!) . flip (
        (`avg; `timespan$avg resultS.duration each results);
        (`max; `timespan$max resultS.duration each results);
        (`min; `timespan$min resultS.duration each results);
        (`dev; `timespan$dev resultS.duration each results);
        (`var; `timespan$var resultS.duration each results));
    
    // Return a good run, or a shrunk failed run
    : $[propertyError;
            finalS.new (prop; 0b; resultS.error last results; count results; ::; resultS.failed getFailedResult[]; ::; time);
        passed or maxDiscarded;
        [   
            classifications : i.classDistribution results;
            error : $[maxDiscarded; "max_discarded"; (::)]; 
            finalS.new (prop; 1b; error; count results; classifications; ::; ::; time)];
        // Else
        [
            // If there was, process that failing test
            failedResult : getFailedResult[]; 
            shrunk: shrink.multi failedResult;
            finalS.new (prop; 0b; ::; count results; ::; resultS.failed failedResult; shrunk; time)]];
     
    }

// propS, any -> resultS
.z.m.qch.i.runSingle:{[prop; arbs]
    
    start: .z.P;
    // Return val of the property applied to the arb args
    returnval : .[propS.prop prop; arbs; {x}]; 
    duration: .z.P - start;
    
    // The test was flagged to be discarded
    if [returnval ~ discard;
        : resultS.new (prop; 1b; "discarded_test"; ""; (); duration)]; /dnl
    
    // Non-boolean properties are invalid
    if [not -1h ~ type returnval;
        : resultS.new (prop; 0b; .z.m.axq.asString returnval; ""; arbs; duration)];

    // Classify the arbs
    classifier : propS.classifier prop;
    class : $[not null classifier; .[classifier; arbs; {"classifier_error"}]; ""]; /dnl
    
    : resultS.new (prop; returnval; ::; class; $[returnval;();arbs]; duration);
    
    }

// @fileOverview
// Create and run a property of a single argument. An
// error is thrown if the property failed. Otherwise, 
// return true. This is used to interface with qCumber.
//
// Note - There are 7 versions of this function. Each
// version expects a different number of spec
// definitions. This was done so that the spec
// definitions are separated in the api, and 
// not forced into an unintuitive list.
//
// These functions are deprecated. Please use `property`
// blocks if testing within *qcumber* test files.
// @deprecated
.z.m.qch.quick:{[spec; prop]
    : successErr check forall [spec] prop;
    }
// @fileOverview
// Create and run a property of one argument.
// @param spec {dict}
// @param prop {fn}
// @returns {boolean}
// @see qch.quick
// @deprecated
.z.m.qch.quick1:{[spec; prop] 
    // @qlintsuppress DEPRECATED_FUNCTION(1)
    quick[spec; prop]
    }
// @fileOverview
// Create and run a property of two arguments.
// @see qch.quick
// @deprecated
.z.m.qch.quick2:{[spec1; spec2; prop] 
    successErr  check forall2 [spec1; spec2] prop 
    }
// @fileOverview
// Create and run a property of three arguments.
// @see qch.quick
// @deprecated
.z.m.qch.quick3:{[spec1; spec2; spec3; prop] 
    successErr  check forall3 [spec1; spec2; spec3] prop 
    }
// @fileOverview
// Create and run a property of four arguments.
// @see qch.quick
// @deprecated
.z.m.qch.quick4:{[spec1; spec2; spec3; spec4; prop] 
    successErr  check forall4 [spec1; spec2; spec3; spec4] prop 
    }
// @fileOverview
// Create and run a property of five arguments.
// @see qch.quick
// @deprecated
.z.m.qch.quick5:{[spec1; spec2; spec3; spec4; spec5; prop] 
    successErr  check forall5 [spec1; spec2; spec3; spec4; spec5] prop 
    }
// @fileOverview
// Create and run a property of six arguments.
// @see qch.quick
// @deprecated
.z.m.qch.quick6:{[spec1; spec2; spec3; spec4; spec5; spec6; prop] 
    successErr  check forall6 [spec1; spec2; spec3; spec4; spec5; spec6] prop 
    }
// @fileOverview
// Create and run a property of seven arguments.
// @see qch.quick
// @deprecated
.z.m.qch.quick7:{[spec1; spec2; spec3; spec4; spec5; spec6; spec7; prop] 
    successErr  check forall7 [spec1; spec2; spec3; spec4; spec5; spec6; spec7] prop 
    }
// @private
.z.m.qch.report:{[spec; prop]
    summary check forall [spec] prop    
    }

// @private
.z.m.qch.report1:{[spec; prop]
    summary check forall1 [spec] prop    
    }
// @private
.z.m.qch.report2:{[spec1; spec2; prop] 
    summary check forall2 [spec1; spec2] prop 
    }

// @private
.z.m.qch.report3:{[spec1; spec2; spec3; prop] 
    summary check forall3 [spec1; spec2; spec3] prop 
    }
// @private
.z.m.qch.report4:{[spec1; spec2; spec3; spec4; prop] 
    summary check forall4 [spec1; spec2; spec3; spec4] prop 
    }
// @private
.z.m.qch.report5:{[spec1; spec2; spec3; spec4; spec5; prop] 
    summary check forall5 [spec1; spec2; spec3; spec4; spec5] prop 
    }
// @private
.z.m.qch.report6:{[spec1; spec2; spec3; spec4; spec5; spec6; prop] 
    summary check forall6 [spec1; spec2; spec3; spec4; spec5; spec6] prop 
    }
// @private
.z.m.qch.report7:{[spec1; spec2; spec3; spec4; spec5; spec6; spec7; prop] 
    summary check forall7 [spec1; spec2; spec3; spec4; spec5; spec6; spec7] prop 
    }
// @fileOverview
// Set the number of times to run each property globally.
//
// @example
// .z.m.qch.setTimes 10
//
// @example 
// .z.m.qch.setTimes 1000
.z.m.qch.setTimes:{[times]
    i.times : times;
    }

// @private
// long, long, propS, list(any) -> shrunkS
.z.m.qch.shrink.at:{[iter; idx; prop; failedArbs]
    
    if [iter >= i.shrinkiters;
        : shrunkS.new (failedArbs; iter) ];
    
    fn : genS.shrink (propS.spec prop) idx;    
    candidates : fn failedArbs idx;
    
    // The smallest failing arguments (minimizing the arg at index `idx`)
    smallestFailing : shrink.smallestFailingAt [idx; prop; failedArbs; candidates];
        
    // If no candidates failed, return the old
    if [not smallestFailing `found;
        : shrunkS.new (failedArbs; iter)];
    
    // If the new is not less than the old, return the old
    if [not (genS.less (propS.spec prop) idx) [smallestFailing[`arb;idx]; failedArbs idx];
        : shrunkS.new (failedArbs; iter)];
    
    // Otherwise, the candidate is smaller than the last and fails, so recurse;
    : .z.s [iter + 1; idx; prop; smallestFailing `arb];
    
    }

// @private
// resultS -> shrunkS | null
.z.m.qch.shrink.multi:{[result]
    
    prop : resultS.prop result;
    
    // If there are no shrinkers in the arg list, just return
    if [all null genS.shrink propS.spec prop;
        : (::)];
    
    // Set the initial arb list to be the failed args
    lastFailed : resultS.failed result;
    
    ii : 0;
    iters: 0;
    
    // Shrink over each shrinkable argument
    while [ii < propS.arity prop;    
        if [(propS.useshrink prop) and not null genS.shrink (propS.spec prop) ii;
            shrunk     : shrink.at [0; ii; prop; lastFailed];
            iters     +: shrunkS.iters shrunk;
            lastFailed : shrunkS.arb shrunk];
        ii +: 1];

    : shrunkS.new (lastFailed; iters);

    }

// @private
// long, propS, list(any), list(any) -> `found`arb!(bool; any)
.z.m.qch.shrink.smallestFailingAt:{[idx; prop; failedArbs; candidates]
    
    comparator       : genS.less (propS.spec prop) idx;
    sortedCandidates : shrink.sort [comparator; candidates];
            
    ii : 0; 
    found : 0b;
    
    // Loop over each candidate until a smallest failing
    // list of argument is found
    while [(not found) and ii < count sortedCandidates;
        failedArbs[idx] : sortedCandidates ii;
        result : i.runSingle [prop; failedArbs];
        $[not resultS.success result;
            found : 1b;
            ii +: 1]];
    
    : `found`arb!(found; $[found; failedArbs; ::]);    
    
    }

// @private
// fn, list(A) -> list(A)
// Quicksort for comparator `isless`
.z.m.qch.shrink.sort:{[isless; as]

    if [(count as) in 0 1;
        : as]; 
    
    larger : (isless .) each enlist[first as],/:enlist each 1 _ as;   
    
    : raze (.z.s [isless] (1_as) @ where not larger; 
            enlist first as; 
            .z.s [isless] (1_as) @ where larger
           );
    
    }

// @private
// resultS -> bool
.z.m.qch.success:{[resultS]
    resultS.success resultS
    }

// @private
// finalS -> boolean|error
.z.m.qch.successErr:{[final]
    
    $ [success final;
        : 1b;
        'final`error];
    
    }

// @private
// list(char), long, list(any) -> null
.z.m.qch.summarize.args:{[indent; arity; args]
        
    {[indent; args; i]
        -1 indent, "[",(string i),"]: ", .Q.s1 args i;
        }[indent; args] each til count args;
    
    }

// @private
.z.m.qch.summarize.i.distribution:{[indent; distribution]
    
    if [(.z.m.axq.isNull distribution) or 0 = count distribution; : (::)];
    
    -1 indent,.z.m.axlocalize.t`.qch_classifications;
    {[x;y] -1 y,y, string[x `percent],"% ", x `class}[;indent] each distribution; /dnl
    
    }

// @private
// finalS -> null
.z.m.qch.summarize.i.failed:{[final]
    
    arity : propS.arity finalS.prop final;
           
    // Otherwise a property returned false
    indent: "   ";
    runs : finalS.runs final;
    -1 .z.m.axlocalize.t(`.qch_failed1;runs);
    
    if [not .z.m.axq.isNull finalS.error final;
        -1 indent,.z.m.axlocalize.t[`.qch_error], raze .Q.s2 finalS.error final];
    
    -1 indent, .z.m.axlocalize.t`.qch_counterExample; 
    summarize.args[indent,indent; arity; finalS.failed final];

    if [not .z.m.axq.isNull finalS.shrunk final;
        -1 indent,.z.m.axlocalize.t (`.qch_shrunk;shrunkS.iters finalS.shrunk final);
        summarize.args[indent,indent; arity; shrunkS.arb finalS.shrunk final]];
    
    : final;
    }

// @private
// finalS -> null
.z.m.qch.summarize.i.passed:{[final]
    
    indent: "   ";
    
    // If the max number of discarded tests was seen before hitting an error (this could be 0 successes)
    $["max_discarded" ~ finalS.error final; /dnl
        -1 .z.m.axlocalize.t (`.qch_passed1; `ran`discarded!(string finalS.runs final;string propS.times finalS.prop final));
      // Else
        -1 .z.m.axlocalize.t (`.qch_passed2; string finalS.runs final)];
    
    summarize.i.distribution[indent; finalS.distribution final];
    : final;
    }

// @fileOverview
// Summarize a single run.
//
// @example
// .z.m.qch.summary .z.m.qch.check .z.m.qch.forall[.z.m.qch.g.int[]] {x=x}
// /=> Ok, passed 100 tests.
.z.m.qch.summary:{[result]

    : $[resultS.success result;
        summarize.i.passed result;
        summarize.i.failed result];
    
    }

// @fileOverview
// Add a classifier to a property. 
//
// @example
// intensify : { x + 2 };
// 
// // Want this to hold
// prop_intensify : { (x + 2) = intensify x };
//
// // An optional classifier to get random distribution information 
// // on the generated data
// classifier: { $[x>0; "positive"; x=0; "zero"; "negative"] };
// 
// .z.m.qch.summary .z.m.qch.check  
//     .z.m.qch.with.times[500]                    // Run 500 random tests (optional)
//     .z.m.qch.with.classifier[classifier]        // Run this classifier on each input (optional)
//     .z.m.qch.forall [.z.m.qch.g.int[]] prop_intensify;
//
// /=> "OK, passed 500 tests."
// /=> "   Classifications:"
// /=> "      53.70741% negative"
// /=> "      46.29259% positive"
.z.m.qch.with.classifier:{[classifier; prop]
    : propS.with.classifier [classifier] prop;
    }

// @private
// bool, propS -> propS
.z.m.qch.with.shrink:{[shrink; prop]
    : propS.with.useshrink[shrink] prop;
    }


// @fileOverview
// Set the number of times to run a specific property.
//
// @example
// intensify : { x + 2 };
// 
// // Want this to hold
// prop_intensify : { (x + 2) = intensify x };
// 
// .z.m.qch.summary .z.m.qch.check  
//     .z.m.qch.with.times[500]                    // Run 500 random tests (optional)
//     .z.m.qch.with.classifier[classifier]        // Run this classifier on each input (optional)
//     .z.m.qch.forall [.z.m.qch.g.int[]] prop_intensify;
//
// /=> "OK, passed 500 tests."
// /=> "   Classifications:"
// /=> "      53.70741% negative"
// /=> "      46.29259% positive"
.z.m.qch.with.times:{[times; prop]
    : propS.with.times[times] prop;
    }

// @fileOverview
// Return this value from a property to discard the test.
//
// @example
// .z.m.qch.summary .z.m.qch.check .z.m.qch.forall[.z.m.qch.g.boolean[]] {
//         if [not x; : .z.m.qch.discard];
//         : x
//     }
// /=> OK, passed 97 tests, discarded 100 tests.
.z.m.qch.discard:`.z.m.qch.discarded_test
// @qlintsuppress UNUSED_INTERNAL(1)
.z.m.qch.i.translations:.z.m.axlocalize.addTranslations (!) . flip 
    enlist
    (`en; (!) . flip (
        (`.qch_passed1; "OK, passed {ran} tests, discarded {discarded} tests.");
        (`.qch_passed2; "OK, passed {ran} tests.");
        (`.qch_shrunk; "Shrunk ({n, plural, one {1 time} other {# times}}):");
        (`.qch_counterExample; "Counter-example: ");
        (`.qch_error; "Error: ");
        (`.qch_failed1; "Failed! Falsifiable (after {n, plural, =0 {} one {1 test} other {# tests}}).");
        (`.qch_classifications;"Classifications:")
    )) 
// @private
.z.m.qch.i.times:100
// @private
.z.m.qch.i.shrinkiters:50
// @private
.z.m.qch.onLoad:{[]
    
    // @default-category .qch Testing
    // @default-subcategory .qch QuickCheck
    // @default-subcategory .z.m.qch.g QuickCheck - Generators
    // @default-subcategory .z.m.qch.g.messy QuickCheck - Messy Generators
    // @default-subcategory .z.m.qch.state QuickCheck - State
    
    // Data Type Definitions
    // =====================
    
    // Single test item
    .z.m.axdatatype.create [`.z.m.qch.propS; `arity`spec`prop`classifier`times`useshrink; `classifier`times`useshrink];
    
    // A shrunk item
    .z.m.axdatatype.create [`.z.m.qch.shrunkS; `arb`iters; ()];
    
    // The result of a test
    .z.m.axdatatype.create [`.z.m.qch.resultS; `prop`success`error`class`failed`duration; enlist `prop];
    
    // The result of a run of tests
    .z.m.axdatatype.create [`.z.m.qch.finalS; `prop`success`error`runs`distribution`failed`shrunk`time; `shrunk`runs`distribution];
    
    }

.z.m.qch.onLoad[];
system "d .z.m";

system "d .z.m.qu";
// @fileOverview The type definitions for qcumber
// @returns {Type}
.z.m.qu.ty.onLoad:{[]
    // @typedef userSettings {dict (
    //                                  legacy      : boolean;
    //                                  ignoreBlock : symbol[]
    //                               )}    
    }

.z.m.qu.ty.onLoad[];
system "d .z.m";

system "d .z.m.im";
// @fileOverview
// Applies a schema's attributes to a given table
//
// @param m {table<schema>} Schema with attributes
// @param t {table}         Table to apply schema to
//
// @return {table} Updated table with the attributes applied
.z.m.im.schema.apply.attribute:{[m; t]
    // Extract the attributes
    attrs: exec (name; attribute) from m where include, attribute <> `;
    
    // Apply any table attributes to the table
    : $[0 = count attrs; t;![t; (); 0b; first[attrs]!{(#;enlist x 1; x 0)} each flip attrs] ];
    }

// @fileOverview

// @return
.z.m.im.schema.apply.include:{[b; m; t]
    : $[count[m] > count c:schema.columns m; 
            .z.m.table.query[t; (); 0b] c!exec name from (b where schema.include m);
            .z.m.table.column.name[t] c
        ];
    }

// @fileOverview
// Applies a list of types to a table's columns
//
// @param types {symbols}       List of types to cast table columns to       
// @param table {table}         Table to apply schema to
//
// @return {table} Updated table with the kind applied
.z.m.im.schema.apply.kind:{[types; table]

    // @param v  {any[]}  column vector
    // @param ty {symbol} type name
    // @param m  {char}   type character
    applyType:{[v; ty; m]

        // If the column's meta data type is general or we're casting to 
        // the same type, return the original column. There is a special case 
        // for general types because schema.from treats meta types of both 
        // " " and "C" as general lists
        ctype   : .z.m.axq.typeOf v; 
        same    : ty = schema.CHARTYPES upper m;
        general : (" " = m) or (`general = ctype) and ty = `general;
        
        $[same or general;
            v;
          // Special case for chars to symbols - need to do each to 
          // avoid concatenating the entire column
          (ty like "symbol*") and `chars = ctype; 
            "S"$/:v;
          // we cannot run 'parse' on a char column as it will treat the whole column as 1 value
          m ~ "c";
            .z.m.axq.parseType[;ty] each v;
          // else
            .z.m.axq.parseType[v; ty]
            ] 
        };
    
    applyTypes: {[fn; ty; t]
        flip (cols t)!fn'[t cols t; ty; (0! meta t)`t]
        } applyType;
   
    ty: {$[y in x`name; x[`kind] x[`name]?y; `general]}[types] each cols table;
    : .Q.ft[applyTypes ty; table];
    }


// @fileOverview
// Applies a mapping function to a table to rename to match the given schema.
//
// @param m {table} Schema to map to 
// @param t {table} Table to convert
//
// @return {table} Input table mapped using the given schema
.z.m.im.schema.apply.name:{[m; t]
    : .z.m.table.column.name[t] exec name from m where include
    }
// @fileOverview
//
// @return {type}
.z.m.im.schema.apply.primary:{[m; t]
    : .z.m.table.pkey[t] schema.primary m
    }

// @fileOverview
// Checks if the input is a schema or not and
// throws an appropriate error.
//
// @param m {table<schema>} Schema to check
//
// @return {table<schema>}
//
// @throws type If the input is not a schema
.z.m.im.schema.check:{[m]
    $[not schema.is m; '"type: expected .z.m.im.schema"; m]
    }
 
// @fileOverview
// Creates a new schema column with a name and kind
//
// @param name {symbol} Name of column
// @param kind {symbol} Type of column
//
// @return {dict<schema.column>}
.z.m.im.schema.column.create:{[name; kind] 
    : schema.column.with.name[name] 
        schema.column.with.kind[kind]
        schema.column.new value schema.i.COLUMN
    }

// @fileOverview
// Fills a column with some default values
//
// @param c {dict} 
//
// @return {dict<schema.column>}
.z.m.im.schema.column.fill:{[c]
    (c .z.m.axq.asType' .z.m.axq.typeOf each schema.i.COLUMN),enlist[`kind]!enlist $["s" ~ last s:string .z.m.axq.asSymbol c`kind; "S"$-1_s; "S"$s]
    } 

// @fileOverview
// Extracts all of the names of the columns in the 
// schema and returns them as an array.
//
// @param m {table<schema>}
//
// @return {list<symbol>}
.z.m.im.schema.columns:{[m] 
    : exec name from schema.check[m] where include 
    }

// @fileOverview
// Creates a schema from an arbitrary table
// 
// @param t {table} Table to create schema for
//
// @return {table<schema>}
.z.m.im.schema.create:{[t]    
    : value[flip .z.m.table.unkey .z.m.table.take[t;0]] {[c;m]    
        isEnum: type[c] within 20 76h;
        : $[not isEnum;  m; schema.column.with.enumkey[key c] schema.column.with.enum[1b] m];
        }' schema.with.primary[.z.m.table.pkeys t] schema.from .z.m.table.schema t
    
    }

// @fileOverview
// Changes the schema to have the correct types
//
// @param s {table<schema>} The table schema to populate with default values
//
// @return {table<schema>} A schema table with the correct types
.z.m.im.schema.fill:{[m]
    : schema.column.fill each m
    }

// @fileOverview
// Filters the table to only have the desired columns in the outut
//
// @param t {table}
// @param m {table<schema>}
//
// @return {table}
.z.m.im.schema.filter:{[t; m]
    : schema.apply.include[m; m; t]
    }

// @fileOverview
// Converts a schema into a list of columns and types that can be used 
// by the table module
//
// @param m {table<schema>} Schema
//
// @return {list<list<symbol>>} Name and type pairs
.z.m.im.schema.flatten:{[m]
    : flip exec (name;kind) from m where include
    }

// @fileOverview
// Creates a schema from a meta table
//
// @param m {table<meta>} A meta table
//
// @return {table<schema>} 
.z.m.im.schema.from:{[m]
    m:0!m; 
    : ([] name: m`c; kind: schema.CHARTYPES ?["b"$m[`t]in\:" C";"*";upper m`t]; primary: 0b; foreign: m`f; attribute: m`a; include: 1b; enum: 0b; enumkey:`)
    }
// @fileOverview 
// Returns if the given data can be cast into the given type. 
// 
// @param to    {char}  The character representing the type to try
// @param data  {list}  The data to check against the given type to try and cast
//
// @returns {boolean} If this cast is possible
.z.m.im.schema.i.canCast:{[to; data]
    nw:to$"";
    if[not to in"BGXCS"; nw:(min 0#;max 0#;::)@\:nw];
    $[not any nw in to$(11&count data)#data; 
        $[11<count data; not any nw in to$data; 1b];
        0b
        ]
    }

// @qlintsuppress LINE_LENGTH UNUSED_INTERNAL
// @fileOverview 
// Given a sample table where the actual data types are unknown, try to guess the 
// correct data types for each column. The result is a meta table (The shape of the
// result from the q meta function) that contains the guessed types for each column.
//
// This is based on csvGuess by Simon Garland 
//
// @param sample    {table} The sample table where all of the data is symbols
// 
// @returns {table} The guessed meta data for the given table
.z.m.im.schema.i.guess:{[sample]
    size: count sample;
    info: meta sample;
    original: cols info;
    
    info:update t:"?", index:`s#i, ipa:0b, maxDots:0, maxWidth:0, gran:0, numDistinct:0, maybe:0b, empty:0b, j10:0b, j12:0b from info;
    info:update data: {string (distinct x) except `} peach (value flip sample) from info;
    info:update numDistinct:count each data from info;
    info:update gran:floor 0.5+100 * numDistinct%size,maxWidth:{max count each x}peach data from info where 0<numDistinct;
    
    // Determine the types
    info:update t:"*" from info where maxWidth >.z.m.im.schema.MAX_SYM_WIDTH;    // Too long
    info:update t:"C", empty:1b from info where t="?", maxWidth=0;      // Empty columns
    
    info:update distinctChars:{asc distinct raze x}peach data from info where t="?";
    info:update maxDots:{max sum each"."=x} peach data[where t="?"] from info where t="?",{"."in x} each distinctChars;
    
    info:update t:"n"            from info where t="?", {any x in"0123456789"}each distinctChars; / vaguely numeric..
    info:update t:"I", ipa:1b    from info where t="n", maxWidth within 7 15,               maxDots=3,{all x in".0123456789"}each distinctChars,.z.m.im.schema.i.canCast["I"]peach data; / ip-address
    info:update t:"F"            from info where t="n", maxWidth > 2, maxDots < 2, {all" /"in x}each distinctChars,.z.m.im.schema.i.canCast["F"]peach data; / fractions, "1 3/4" -> 1.75f
    
    if[.z.K>=3; 
        info: update t:"G" from info where t="*",maxWidth=36,maxDots=0,{all x like"*-????-????-????-*"}peach data,.z.m.im.schema.i.canCast["G"]peach data
        ]; / GUID, v3.0 or later
    
    info:update t:"J" 			    from info where t="n",maxDots=0,{all x in"+-0123456789"}each distinctChars,.z.m.im.schema.i.canCast["J"]peach data;    
    info:update t:"I" 			    from info where t="J",maxWidth<12,.z.m.im.schema.i.canCast["I"]peach data;
    info:update t:"H" 			    from info where t="I",maxWidth<7,.z.m.im.schema.i.canCast["H"]peach data;
    info:update t:"F" 			    from info where t="n",maxDots<2,maxWidth>1,.z.m.im.schema.i.canCast["F"]peach data;
    info:update t:"E", maybe:1b 	from info where t="F",maxWidth<=10;
    info:update t:"M", maybe:1b 	from info where t in"nIHEF",((maxDots>0) or "-" in/: distinctChars),maxDots<2,maxWidth within 4 7,.z.m.im.schema.i.canCast["M"] peach data; 
    info:update t:"D", maybe:1b 	from info where t in"nI",maxDots in 0 2,maxWidth within 6 11,.z.m.im.schema.i.canCast["D"]peach data; 
    info:update t:"V", maybe:1b 	from info where t="I",maxWidth in 5 6,7<count each distinctChars,{all x like"*[0-9][0-5][0-9][0-5][0-9]"}peach data,.z.m.im.schema.i.canCast["V"]peach data; / 235959 12345        
    info:update t:"U", maybe:1b 	from info where t="H",maxWidth in 3 4,7<count each distinctChars,{all x like"*[0-9][0-5][0-9]"}peach data,.z.m.im.schema.i.canCast["U"]peach data; /2359
    info:update t:"U", maybe:0b 	from info where t="n",maxWidth in 4 5,maxDots=0,{all x like"*[0-9]:[0-5][0-9]"}peach data,.z.m.im.schema.i.canCast["U"]peach data;
    info:update t:"T", maybe:0b 	from info where t="n",maxWidth within 7 12,maxDots<2,{all x like"*[0-9]:[0-5][0-9]:[0-5][0-9]*"}peach data,.z.m.im.schema.i.canCast["T"]peach data;
    info:update t:"V", maybe:0b 	from info where t="T",maxWidth in 7 8,maxDots=0,.z.m.im.schema.i.canCast["V"]peach data;
    info:update t:"T", maybe:1b 	from info where t in"EF",maxWidth within 7 10,maxDots=1,{all x like"*[0-9][0-5][0-9][0-5][0-9].*"}peach data,.z.m.im.schema.i.canCast["T"]peach data;
    info:update t:"Z", maybe:0b 	from info where t="n",maxWidth within 11 24,maxDots<4,.z.m.im.schema.i.canCast["Z"]peach data;
    info:update t:"P", maybe:1b 	from info where t="n",maxWidth within 12 29,maxDots<4,{all x like"[12]*"}peach data,.z.m.im.schema.i.canCast["P"]peach data;
    info:update t:"N", maybe:1b 	from info where t="n",maxWidth within 3 28,maxDots=1,.z.m.im.schema.i.canCast["N"]peach data;
    info:update t:"?", maybe:0b 	from info where t="n"; / reset remaining maybe numeric
    info:update t:"C", maybe:0b 	from info where t="?",maxWidth=1; / char
    info:update t:"B", maybe:1b 	from info where t in"HC",maxWidth=1,maxDots=0,{all x in"01"}each distinctChars; / boolean
    info:update t:"X", maybe:0b 	from info where t in "?H",maxWidth=2,{ all x in"0123456789abcdefABCDEF" } each distinctChars; /hex
    info:update t:"S", maybe:1b 	from info where t="?",maxWidth<.z.m.im.schema.MAX_SYM_WIDTH,maxWidth>1,gran<.z.m.im.schema.MAX_SYM_GRAN; / symbols (max width permitting)
    info:update t:"*", maybe:0b 	from info where t="?" ; / the rest as strings
    info:update j12:1b              from info where t in "S*", maxWidth<13,{all x in .Q.nA}each distinctChars;
    info:update j10:1b              from info where t in "S*", maxWidth<11,{all x in .Q.b6}each distinctChars; 
    if["?"in exec t from info;'`unknown.field]; / check all done
    : `c xkey ?[info; (); 0b; original!original];       
    }

// @fileOverview
// Extracts all of the columns not included in this table
//
// @param m {table<schema>} Schema
//
// @return {list<symbol>} Columns to drop
.z.m.im.schema.ignores:{[m]
    : exec name from schema.check[m] where not include 
    }

// @fileOverview
// Returns a boolean vector of which columns in the scheama will 
// be included in transformation operations
//
// @param m {table<schema>}
//
// @return {list<boolean>}
.z.m.im.schema.include:{[m]
    : exec include from schema.check[m]
    }

// @fileOverview
// Returns if the given input is a table schema or not
//
// @param m {table<schema>} 
// 
// @return {boolean} If the input is a schema
.z.m.im.schema.is:{[m]
    : $[98h ~ type m; cols[m] ~ cols[schema.i.SCHEMA]; 0b] 
    }
// @fileOverview
// Creates a schema object from the given data
//
// @param c {list<symbol>} Column names
// @param t {list<symbol>} Column types (ex `long`symbol etc.)
//
// @return {table<schema>}
.z.m.im.schema.new:{[c;t]
    : flip schema.i.COLUMN,`name`kind`include!(c;t;1b);
    }

// @fileOverview
// Prepends a column to the front of a schema
//
// @param col   {dict<schema.column>}   Schema column
// @param m     {table<schema>}         Schema
//
// @return {table<schema>} Updated schema
.z.m.im.schema.prepend:{[col; m]
    : (keys[schema.i.COLUMN] # col),m;
    }

// @fileOverview
// Extracts all of the names of the primary keys in a schema
//
// @param s {table<schema>} Schema
//
// @return {list<symbol>} Names of columns
.z.m.im.schema.primary:{[m]
    : exec name from schema.check[m] where primary, include
    }

// @fileOverview
// Returns a list of the column types where unincluded columns
// are empty
//
// @param m {table<schema>}
//
// @return {string}
.z.m.im.schema.types:{[m]
    : schema.i.TYPECHARS exec kind from update kind:`undefined from schema.check[m] where not include
    }

// @fileOverview
// Updates a schema to include the primary keys
//
// @param pk    {symbol | list<symbol>} Primary keys in the schema
// @param m     {table<schema>}         Schema to update
//
// @return {table<schema} Updated schema
.z.m.im.schema.with.primary:{[pk; m]
    : $[0 ~ count pk; m; update primary: 1b from m where any pk =\: name ]
    }

.z.m.im.schema.i.COLUMN:(!) . flip (
    (`name      ; `);
    (`kind      ; `);
    (`primary   ; 0b);
    (`foreign   ; `);
    (`attribute ; `);
    (`include   ; 1b);
    (`enum      ; 0b);
    (`enumkey   ; `)
    )


.z.m.im.schema.i.TYPECHARS:`general`boolean`guid`undefined`byte`short`int`long`real`float`char`symbol`timestamp`month`date`datetime`timespan`minute`second`time!"*BG XHIJEFCSPMDZNUVT"  
.z.m.im.schema.i.SCHEMA: enlist schema.i.COLUMN
.z.m.im.schema.MAX_SYM_WIDTH:32 
.z.m.im.schema.MAX_SYM_GRAN:10 
.z.m.im.schema.CHARTYPES:"*BG XHIJEFCSPMDZNUVT"!`general`boolean`guid`undefined`byte`short`int`long`real`float`char`symbol`timestamp`month`date`datetime`timespan`minute`second`time  
.z.m.im.schema.onLoad:{[]
    .z.m.axdatatype.create[`.z.m.im.schema.column; key schema.i.COLUMN; key schema.i.COLUMN]
    }

.z.m.im.schema.onLoad[];
system "d .z.m";

system "d .z.m.axpview";
// @fileOverview 
// Get the columns for each given table
//
// @param tbls {Symbol[]} List of tables
//
// @returns {Table} Table containing the table fname and it's columns
//
// @example columns
//
//      .z.m.axpview.g.columns .z.m.axpview.g.tables .z.m.axpview.g.ns `.gg
//
.z.m.axpview.g.columns:{[tbls]
    if [0 = count tbls; : ([] table: `$(); columns: `$())];
    
    tbls: raze tbls;
    
    // Tables in the root namespace need the 'get' syntax or the tests break
    t: ?[1=count each ` vs/: tbls; ` sv/: ``,/:tbls; tbls];
    c: cols each t;
    
    : ([] table: tbls; columns: c);
    }

// @fileOverview 
// Finds all the dictionaries within a given namespace.
// Note that sub-namespaces are dictionaries, and as a result will be returned as well.
//
// @param ns {symbol[]} List of namespaces to check.
//
// @returns {symbol[]} List of dictionaries
//
// @example dicts
// > Find all functions within all of `.gg
//
//      .z.m.axpview.g.dicts .z.m.axpview.g.ns `.gg
//
// > Find all functions within only .gg.scale
//
//      .z.m.axpview.g.dicts enlist `.gg.scale
//
.z.m.axpview.g.dicts:{[ns]
    // Avoid using value, as it breaks on things like the .axbct.decoder items
    : raze {[n]
        : g.i.prefix[n] g.i.dicts n;
        } each raze ns;
    }

// @fileOverview 
// Filters out namespaces from the result of .z.m.axpview.g.ns,
// as well as their subnamespaces
//
// @param ex {symbol[]} List of namespaces to exclude
// @param ns {symbol[]} List of namespaces
//
// @returns {symbol[]} List of namespaces without the namespaces or subnamespaces specified
//
// @example except
// > Find all namespaces except all of `.gg
//
//      .z.m.axpview.g.except[`.gg] .z.m.axpview.g.ns[] 
//
// > Find all namespaces except .gg.scale, .gg.cheat, .gg.i and their subnamespaces
//
//      .z.m.axpview.g.except[`.gg.scale`.gg.cheat`.gg.i] .z.m.axpview.g.ns[]
//
.z.m.axpview.g.except:{[ex; ns]
    // Find all sub-namespaces for each exception
    :raze[ns] except distinct raze .z.m.axpview.g.ns each ex;
    }

// @fileOverview
// Filters out analyst and/or platform namespaces from a given list of namespaces
//
// @param filter {symbol} The filter to apply - 
//          `none for no filtering at all, 
//          ` or `all to only filter out q internals, 
//          `platform to filter out just analyst items, 
//          `user to filter out all platform items
// @param ns {symbol[]} A list of namespaces
//
// @returns {symbol[]} Remaining namespaces with given filter applied
.z.m.axpview.g.filter:{[filter; ns]
    // q internals
    q : .z.m.axpview.g.i.Q_INTERNALS;
    
    // Analyst internal namespaces - we only need the root levels
    // TODO remove hack for projected namespaces when they no longer exist
    ax: `.odbc`.etl`.flow`.axvcs , distinct ` sv/: 2#/: ` vs/: .z.m.axenv.modules[];
    
    // Control internal namespaces
    // Check if cx exists first to support stand-alone mode
    // @qlintsuppress MISSING_DEPENDENCY(1)
    cx: $[`cx in key `; .cx.class.namespaces[]; ()];
    
    // ` and `all are so named for legacy reasons
    f: (!) . flip (
        (`none;     ());
        (`;         q);
        (`all;      q);
        (`platform; q, ax);
        (`user;     q, ax, cx)
        );
    
    : g.i.filter[ns] f filter;
    }

// @fileOverview 
// Finds all the functions within given namespaces
//
// @param ns {symbol[]} List of namespaces to check.
//
// @returns {symbol[]} List of functions
//
// @example funcs
// > Find all functions within all of `.gg
//
//      .z.m.axpview.g.funcs .z.m.axpview.g.ns `.gg
//
// > Find all functions within only .gg.scale
//
//      .z.m.axpview.g.funcs enlist `.gg.scale
//
.z.m.axpview.g.funcs:{[ns]
    : raze ns g.i.prefix' g.i.funcs each raze ns;
    }

// @fileOverview Finds all the dictionaries within a given namespace
// @param ns {Symbol} The namespace to search
// @returns {Symbol[]} A list of dictionaries
.z.m.axpview.g.i.dicts:{[ns]
    // Avoid using value, as it breaks on things like
    // .axbct.decoder items
    : vars where 99h=type each ns each vars:key ns;
    }

// @fileOverview Filters out namespaces given a series of namespace roots to exclude
// @param ns    {symbol[]} A list of namespaces
// @param roots {symbol[]} A list of root namespaces to exclude
// @returns {symbol[]} The list of namespaces with the roots filtered out
.z.m.axpview.g.i.filter:{[ns; roots]
    // Get the root of each namespace, but leave global namespaces alone
    ns where not ?[` ~/: (` vs/: ns)[;0]; ` sv/: 2#/: ` vs/: ns; ns] in roots
    }

// @fileOverview Finds all the functions within a given namespace
// @param ns {Symbol} The namespace to search
// @returns {Symbol[]} A list of functions
.z.m.axpview.g.i.funcs:{[ns]
    : system "f " , string ns;
    }

// @fileOverview 
// Append the namespace to the item name if required
//
// @param ns {Symbol} The item namespace 
// @param items {Symbol[]} A list of item names to append the namespace to
//
// @returns {Symbol[]} Item names with namespaces prefixed to them, aka the fnames
.z.m.axpview.g.i.prefix:{[ns;items]
    // Don't prefix the current ns if this is the root ns 
    : $[`. = ns;
            items;
        //else
            ` sv/: ns ,/: items];
    }

// @fileOverview Finds all the tables within a given namespace
// @param ns {Symbol} The namespace to search
// @returns {Symbol[]} A list of tables
.z.m.axpview.g.i.tables:{[ns]
    : system "a " , string ns;
    }

// @fileOverview Finds all the variables within a given namespace
// @param ns {Symbol} The namespace to search
// @returns {Symbol[]} A list of variables
.z.m.axpview.g.i.vars:{[ns]
    : system "v " , string ns;
    }

// @fileOverview 
// Given a symbol representation of an item, it will return 1b if it is a 
// namespace, and 0b otherwise. Note that things in the global context need 
// to be prefixed with "..", Ex: `..foo for variable foo in the global context
//
// @param ns {Symbol} The item to check
//
// @returns {boolean}
.z.m.axpview.g.isNS:{[ns]
    chk: {[ns]
        : $[` in key ns; 
            $[(::)~ns `; 11 = type key ns; 0b];
            0b]
        };
    
    // Check if it is a namespace
    : @[chk; ns; 0b];
    }

// @fileOverview 
// Get the keys for each given dictionary
//
// @param dics {Symbol[]} List of dictionaries
//
// @returns {Table} Table containing the dictionary fname and it's keys
//
// @example keys
//
//      .z.m.axpview.g.keys .z.m.axpview.g.dicts .z.m.axpview.g.ns `.gg
//
.z.m.axpview.g.keys:{[dics]  
    // Get the keys
    // We have to use 'get' on root context dictionaries
    // incase this function is being called from within a namespace
    k: key each {[d] $[1=count ` vs d; get ` sv ``, d; d] } each raze dics;
    : ([] dict: raze dics; dkeys: k);
    }
// @fileOverview 
// Finds all the sub-namespaces within a given namespace recursively.
// Finds all global namespaces when given `, and finds all non-global namespaces
// when given `. (root). When given nothing, assumes you want all functions.
//
// @param ns {symbol} The namespace. Ex: `.gg, `.gg.scale, `., ` , or nothing (.z.m.axpview.g.ns[])
//
// @returns {symbol[]} List containing the given namespace and all it's sub-namespaces 
//
// @example ns
// > Find all namespaces and sub-namespaces
//
//      .z.m.axpview.g.ns[]
//
// > Find all global namespaces and sub-namespaces
//
//      .z.m.axpview.g.ns `.
//
// > Find all non-global (root) namespaces and sub-namespaces
//
//      .z.m.axpview.g.ns `
//
// > Find all sub-namespaces within .gg
//
//      .z.m.axpview.g.ns `.gg
//
.z.m.axpview.g.ns:{[ns]
    ns : raze ns;
    
    // If we're given null, recursively get all sub-namespaces
    // for both the global context (`.) and the root context (`)
    if[ns ~ enlist (::); ns:`.`];
    
    : distinct except[ns; `], raze 
        {[dir]
            subdirs: g.subNS dir;
            : raze subdirs , .z.s each subdirs;
            } each ns
    }

// @fileOverview 
// Gets all immediate sub-namespaces in a given namespace.
// Does not recursively find all sub-namespaces.
//
// @param ns {symbol[]} The namespaces to check for sub-namespaces
//
// @returns {symbol[]} A list containing any sub-namespaces found
//
// @example subNS
// > Find all immediate global namespaces
//
//      .z.m.axpview.g.subNS `.
//
// > Find all immediate root namespaces
//
//      .z.m.axpview.g.subNS `
//
// > Find all immediate subnamespaces within .gg, exluding for example .gg.scale.ty
//
//      .z.m.axpview.g.subNS `.gg
//
.z.m.axpview.g.subNS:{[ns]
    ns : raze ns;
    // If we're given null, recursively get all sub-namespaces
    // for both the global context (`.) and the root context (`)
    if [ns ~ enlist (::); ns: `.`];
    

    : raze {[n]
        // Not a proper sub namespace if the keys aren't symbols
        if [not 11 = type key n; : ()];
        s: g.isNS each k: ` sv' n ,/: t: key n; 

        : $[`. ~ n; t where s; k where s];
        } each ns;
    }
// @fileOverview 
// Finds all the tables within a given namespace
//
// @param ns {symbol[]} List of namespaces to check.
//
// @returns {symbol[]} List of tables
//
// @example tables
// > Find all tables within all of `.gg
//
//      .z.m.axpview.g.tables .z.m.axpview.g.ns `.gg
//
// > Find all tables within only .gg.scale
//
//      .z.m.axpview.g.tables enlist `.gg.scale
//
.z.m.axpview.g.tables:{[ns]
    : raze ns g.i.prefix' system each "a " ,/: string each raze ns;
    }

// @fileOverview 
// Gets all variables with a given namespace. Includes sub-namespaces, dictionaries,
// tables, integers, floats, lists, etc, but not functions.
//
// @param ns {symbol[]} List of namespaces to check.
//
// @returns {symbol[]} List of variables
//
// @example vars
// > Find all variables within all of `.gg
//
//      .z.m.axpview.g.vars .z.m.axpview.g.ns `.gg
//
// > Find all variables within only .gg.scale
//
//      .z.m.axpview.g.vars enlist `.gg.scale
//
.z.m.axpview.g.vars:{[ns]
    : raze ns g.i.prefix' g.i.vars each raze ns;
    }

// @fileOverview 
// Finds all the views if given the root context
//
// @param ns {symbol[]} List of namespaces to check.
//
// @returns {symbol[]} List of views
//
// @example views
// > Find all views
//
//      .z.m.axpview.g.views enlist `.
//
.z.m.axpview.g.views:{[ns]
    // Views only exist in the root context
    : $[`. in raze ns;
            system "b .";
        //else
            `$()];
    }

// @fileOverview
// A list of q internal namespaces
// @returns {symbol[]}
.z.m.axpview.g.i.Q_INTERNALS:`.q`.Q`.h`.z`.o`.j
system "d .z.m";

system "d .z.m.im";
// @fileOverview
// Executes a saved configuration artifact
//
// @param artifact {dict} Saved artifact
//
// @example Running a Saved Artifact
// // Assume we have created a saved artifact from the importer called
// // myImport which points to a CSV file and will import to a table named
// // myTable. To execute this saved configuration, simply pass the configuration
// // to .z.m.im.execute
// .z.m.im.execute myImport
//
// @return {table | symbol} Name of the saved table
.z.m.im.execute:{[artifact]
    cfg: $[.z.m.axq.isFunction artifact; 
            value[artifact][1]; 
        io.is artifact; 
            ``state!(::;artifact); 
        // else
        artifact
        ];
   
    append : .z.m.axq.asBoolean cfg`append;
    data   : .z.m.im.readall .z.m.im.io.decode cfg`state;
    
    : $[.z.m.axq.isNull .z.m.axq.asSymbol cfg`name; 
        data; 
        .z.m.axq.asSymbol[cfg`name] set $[append & .z.m.axq.isTable t:@[get; .z.m.axq.asSymbol cfg`name; ::]; t,data; data]
        ];
    }

// @fileOverview
// Determines if an output exists at the desired location
//
// @param output {#io any} Input configuration to check
// @return {boolean} If the data exists
//
// @example Non-existent CSV File
// .z.m.im.exists .z.m.im.io.with.target[`:abc.csv] .z.m.im.io.create `csv
// /=> 0b
//
// @example Existing table
// t: ([] a: til 10; b: 10?10);
// .z.m.im.exists .z.m.im.io.with.target[`t] .z.m.im.io.create `kdb
// /=> 1b
.z.m.im.exists:{[output]
    : i.dispatch[output; `exists] output
    }
// @fileOverview
// Given an IO return a human readable version of its format
//
// @param input {#io any} Input configuration
// @return {symbol} Format of the configuration
//
// @example JSON Format Symbol
// .z.m.im.format .z.m.im.io.create `json
// /=> `JSON
.z.m.im.format:{[input]
    p: plugin.fetch io.format input;
    
    // If there is a specific implementation of the format
    // searcher then return it. Otherwise, just return the
    // plugin format 
    : $[not 0b ~ fmt:plugin.dispatch[`format] p;
        fmt input;
        upper io.format input
        ];
    
    }

// @private 
// @fileOverview
// Dispatch a behaviour to a function API for the format
// of the given input configuration
//
// @param input  {#io any}   Data source dictionary
// @param method {symbol[]}  The function name
//
// @returns {fn} If the route exists
.z.m.im.i.dispatch:{[input; method]
    lambda : plugin.dispatch[method] plugin.fetch input;

    // Search for the appropriate function for this input
    if[0b ~ lambda;    
        'i.err.nyiapi," ", string[io.format input], ": " string method];
        
    : lambda;
    }

// @private
// @fileOverview
// Executes read over a data source using a dynamic method selection
//
// @param method {symbol}  Reading method
// @param x      {any}     Input to reading algorithm
// @param input  {#io any} Input configuration to read
//
// @return {#io any} Read configuration 
.z.m.im.i.read:{[method; x; input]
    : i.dispatch[input; method] [x; input]
    }

// @fileOverview
// Reads a table by partitioned
// 
// @param p     {any}     Partitions to read
// @param input {#io any} Input configuration to read
//
// @return {#io any} Read configuration
//
// @example Reading a Partition
// t: ([] date: .z.d + til 3; price: 3?3f; volume: 3?3f); 
// /=> date       price     volume   
// /=> ------------------------------
// /=> 2018.09.11 0.3789103 0.5531411
// /=> 2018.09.12 1.204756  1.160074 
// /=> 2018.09.13 0.3366977 1.743826 
//
// .z.m.table.write[`:db`t`date] t;
// .z.m.im.pread[2018.09.11] .z.m.im.io.with.target[`:db`t] .z.m.im.io.create `kdb
// /=> date       price     volume   
// /=> ------------------------------
// /=> 2018.09.11 0.3789103 0.5531411
.z.m.im.pread:{[p; input]
    : io.target i.read[`pread; p; input] io.update.schema input
    }

// @fileOverview
// Reads a preview of a data source
//
// @param n     {long}    Number of records to read
// @param input {#io any} Input configuration
// 
// @return {string[]} Preview of content
//
// @example Previewing a File
// `:x.csv 0: csv 0: ([] a: til 10; b: 10?10; c:10?.Q.a);
// .z.m.im.preview[3] .z.m.im.io.with.target[`:x.csv] .z.m.im.io.create `csv
// /=> "a,b,c"
// /=> "0,3,x"
// /=> "1,5,e"
.z.m.im.preview:{[n; input]
    : i.dispatch[input; `preview] [n; input]
    }

// @private 
// @fileOverview
// Runs an import using a generic reader function
// @param reader {function}   Generic read function
// @param x      {long | any} Parameter to read function
// @param im     {#import <#io any> <#io any>} Import configuration
// @return {#import <#io any> <#io any>} 
.z.m.im.r.i.run:{[reader; x; im]
    : import.update.output[im] write[import.output im]
        transform[import.transform im] io.target import.input
        import.with.input[reader[x] import.input im] im
    } 
// @private
// @fileOverview
// Runs an import using a reader based on index values
// @param im {#import <#io any> <#io any>} Import configuration
// @return {#import <#io any> <#io any>} Executed import 
.z.m.im.r.indexed:{[im]
    opts  : import.options[im];
    start : io.offset[import.input im] | opts`start;
    end   : opts`end;
    
    : r.i.run[i.read[`read]; "j"$(end - start)] 
        import.with.input[io.with.offset[start] import.input im] im;
    } 

// @private
// @fileOverview
// Runs an import using a reader based on a partition value
// @param im {#import <#io any> <#io any>} Import configuration
// @return {#import <#io any> <#io any>} Executed import 
.z.m.im.r.partitioned:{[im]
    : r.i.run[i.read[`pread]; import.options[im]`partitions] im;
    }

// @fileOverview
// Reads a data source and returns the table found matching the 
// source's schema
//
// @param n     {long}      Number of records to read
// @param input {#io any}   Input source to read
//
// @return {table} The data that was read from the source
//
// @example Reading the Head of a Table
// t: ([] a:til 100; b:100?100; c:100?.Q.a);
// .z.m.im.read[10] .z.m.im.io.with.target[`t] .z.m.im.io.create `kdb
// /=> a b  c
// /=> ------
// /=> 0 89 t
// /=> 1 30 m
// /=> 2 57 g
// /=> 3 94 w
// /=> ..
.z.m.im.read:{[n; input] 
    : io.target i.read[`read; n] io.update.schema input
    }

// @fileOverview
// Reads an entire data source
//
// @param input {any} The input source to read
//
// @return {table} The data that was read from the source
.z.m.im.readall:{[input]    
    reader : plugin.dispatch[`readall] plugin.fetch io.format input;
    : $[0b ~ reader; read[-1; input]; io.target reader io.update.schema input]
    }
// @fileOverview
// Determines the number of records in the source table specified.
// Note: This can be an expensive operation and is not supported for
// all plugin types.
//
// @param input {#io any} Source table to read
// @return {long} Number of records in the source
//
// @example Records of a Memory Table
// t: ([] a: til 10);
// .z.m.im.records .z.m.im.io.with.target[`t] .z.m.im.io.create `kdb
// /=> 10
.z.m.im.records:{[input]
    : i.dispatch[input; `records] input
    }

// @fileOverview
// Deletes the specified output location if it exists.
// WARNING: This operation is not reversible
//
// @param output {#io any} An IO location to delete
//
// @return {boolean} If it was deleted
.z.m.im.remove:{[output]
    : $[exists output; i.dispatch[output; `remove] output; 0b]    
    }

// @fileOverview
// Returns a string representation of the given IO
//
// @param input {#io any} 
//
// @return {string}
.z.m.im.repr:{[input]
    : $[not 0b ~ p:plugin.lookup[`repr] plugin.fetch io.format input;
            p input;
            .z.m.axq.asString io.target input
        ];    
    }

// @fileOverview
// Executes an import by reading in data, transforming it
// and exporting it to a new location 
//
// @param im {#import <#io any> <#io any>} The import to execute
//
// @return {#import <#io any> <#io any>} Result of import
.z.m.im.run:{[im]
    // `m` is here so the debugger can step into this statement
    : (m:r[import.method im]) import.with.input[io.update.schema import.input im] im // @qlintsuppress UNUSED_VAR(1)
    }

// @fileOverview
// Runs an entire transformation one step at a time
//
//          Read --> Transform --> Write
//
//
// @param im {#import <#io any> <#io any>} Import configuration to run
//
// @return {#import <#io any> <#io any>} Result of import
.z.m.im.runall:{[im] 
    : r.i.run[read; -1] im
    }
// @private
// @fileOverview
// Reads the schema of a data source and updates
// the IO with the new schema
//
// @param input {#io any} Input source to read the schema of
//
// @return {#io any} Updated IO
.z.m.im.schema.read:{[input]
    : io.set.schema[;input] i.dispatch[input;`schema] input;
    }

// @fileOverview
// Transforms a table given a transformation function. The given transformation
// is ` then the input is just returned
//
// @param trans {fn (table) -> table} A transformation function. This function should
// take a table by value and return a table.
//
// @param t {table} The table to transform
//
// @return {table} The updated table
.z.m.im.transform:{[trans; t]
    : $[.z.m.axq.isNull trans; t; 10h ~ type output:trans t; 'output; output]
    }

// @fileOverview
// Writes a table to the desired location
//
// @param output    {#io any}   Output location of the table
// @param data      {table}     Table to write
// 
// @return {#io any} The new table output
.z.m.im.write:{[output; data]    
    : i.dispatch[output;`write] [output; data];
    }

// @qlintsuppress UNUSED_INTERNAL MISSING_OVERVIEW
.z.m.im.i.err:(!) . flip (
    (`format;       "type: format must be symbol");
    (`nyiformat;    "nyi: format requested has not been registered");
    (`nyiapi;       "nyi: unsupported operation for format")
    )
// @qlintsuppress MISSING_OVERVIEW
// @private
.z.m.im.MAX_PREVIEW_BYTES:200000 // 200kb 
// @qlintsuppress MISSING_OVERVIEW MISSING_RETURNS
.z.m.im.onLoad:{[]    
    
    // @default-category .im Importer
    // @default-subcategory .z.m.im.import Import Config
    // @default-subcategory .z.m.im.io Source Config
    
    // @typedef schema {table (name: symbol; kind: symbol; primary: boolean; foreign: symbol; attribute: symbol; include: boolean; enum: boolean) }
    // @typedef io target {dict (format: symbol; target: #target; offset: long; schema: table; baseschema: table) }
    // @typedef import in out {dict (input: #in; output: #out; transform: fn (table) -> table; records: long; batching: boolean; batchsize: long) }
    }

.z.m.im.onLoad[];
system "d .z.m";

system "d .z.m.axedi";
// @fileOverview
//
// All we're doing is moving around in the inspector, so just change the start and end
// locations and pass the cached values back to the inspector for it to do its magic.
// @param dict {dict}
// @returns {dict}

.z.m.axedi.cachedValue:{[dict]
    id : dict`cacheID;
    if [`start in key dict;                         // no `start implies we're looking at the history
        cachei.modify [id; `start; dict`start];    // to allow for history, just re-use existing
        cachei.modify [id; `end; dict `end];      // start/end stored in cache
    ];
        
    : .z.m.axedi.inspector[cachei.exprValue id; cachei.retrieve id];
    }
// @fileOverview 
// Add an item to the cache
// @param id {guid} cache id 
// @param item {any} 
// @returns {null} 
.z.m.axedi.cachei.add:{[id; item]    
    .z.m.axedi.cache[id]: item;    
    }

// @fileOverview
// given an id, find the parent inspector
// and add this id to the list of open inspectors
// note windows are kept with the expression value in the
// negative value of the cacheID!!!
.z.m.axedi.cachei.addInspectWindow:{[id]
    
    if [.z.m.axedi.cache [id] ~ (::);
        : ()]; // shouldn't happen
    
    parentInspector: cachei.findFirst .z.m.axedi.cache id;
    .z.m.axedi.cache [ .z.m.axedi.cache[parentInspector]`parent; `windows],:: id;
    };

// @fileOverview 
// Get the expression value associated with a cache id
// @param id {guid} cache id 
// @returns {any} q value associated with the cache id
.z.m.axedi.cachei.exprValue:{[id]    
    if [not id in key .z.m.axedi.cache;
        '`EDI.missingCacheID];
    
    : @[;`exprValue] .z.m.axedi.cache (.z.m.axedi.cache cachei.findFirst .z.m.axedi.cache id)`parent;    
    }

// @fileOverview Find the id for the parent inspect for the provided cache
.z.m.axedi.cachei.findFirst:{[cache]
    : $[not `history in key cache;
        cache `cacheID;
        cachei.findFirst cache `history]; 
    };

// @fileOverview
// Flush the specified caches.
// If a single cacheID is provided we enlist it so that we eliminate the specified
// cacheID(s) as opposed to eliminating cacheID elements from the cache dictionary.
// Note that negative cacheIDs are used to determine vertical vs. horizontal display
// characteristics and are also flushed.
//
//		When an inspector window is closed it is expected that the IDE inspector will call flushCache
//		which will free up the memory associated with any open inspector windows.
//
// IDs are effectively timestamps + a random value
// we remove IDs LIFO so that the parent inspect window is the last
// to go if the UI sends us a long list of inspect windows to close

// @param dict {dict (cacheID: long|long[])}
// @returns {null}
.z.m.axedi.cachei.flushCache:{[dict]
    toFlush: $[.z.m.axq.isList dict`cacheID; dict`cacheID; enlist dict`cacheID];
    cachei.removeInspectWindow each reverse toFlush;           // reverse the order so the newest one is removed first
    };
// @fileOverview 
// Determine whether the cache has the given key
// @param id {GUID} 
// @returns {Boolean} 
.z.m.axedi.cachei.has:{[id]
    : id in key .z.m.axedi.cache;
    }

// @fileOverview 
// Replace a key on an existing cache entry with a new item
// @param id {guid} 
// @param item {symbol} 
// @param val {any} 
// @returns {null} 
.z.m.axedi.cachei.modify:{[id; item; val]
    
    if [not id in key .z.m.axedi.cache;
        '`EDI.missingCacheID];
    
    .z.m.axedi.cache[id;item] : val;
    
    }

// @fileOverview Create a new cache id
// @returns {guid} 
.z.m.axedi.cachei.newCacheID:{[]
    // Need a fixed seed as multiple cache entries may be 
    // made in quick succession
    // @qlintsuppress FIXED_SEED(1)
    first 1?0Ng 
    }

// @fileOverview Remove the provided id and its associated data, clean up if it's the parent id
.z.m.axedi.cachei.removeInspectWindow:{[id]
    // The ID that the drilldown started from
    parentInspector : cachei.findFirst .z.m.axedi.cache id;
    parentID : .z.m.axedi.cache[parentInspector]`parent;
    
    // Remove the ID from the parent's list of children
    // The intersection with cache keys is to make sure that if a child has been removed, and the parent wasn't updated
    // it will be removed at this point, to prevent the parent seeming non-empty even though all its children are closed (CAREP-5209)
    .z.m.axedi.cache[parentID; `windows]: (.z.m.axedi.cache [parentID; `windows] except id) inter key .z.m.axedi.cache;
        
    // Determine if this is the last cached window, if so remove everything freeing memory
    toRemove : $[.z.m.axq.isEmpty .z.m.axedi.cache [parentID; `windows]; (id; parentID); enlist id];
        
    // Remove the cache entry
    .z.m.axedi.cache: toRemove _ .z.m.axedi.cache;
    
    // Returns 1b if a function has no children, 0b otherwise
    hasNoChildren : {[cacheRecord]
        : $[not `dictionary ~ .z.m.axq.typeOf cacheRecord;
                0b;
            not `windows in key cacheRecord;
                0b;
            // Else
                0 = count cacheRecord`windows];
        };
    
    // Find all parents with no windows
    noRefs: key[.z.m.axedi.cache] where hasNoChildren each value .z.m.axedi.cache;
    
    // Remove all parents with no children
    .z.m.axedi.cache: noRefs _ .z.m.axedi.cache;
    };

// #resetCache
// @fileOverview Set up the cache dictionary. Called once at startup.
.z.m.axedi.cachei.reset:{
    .z.m.axedi.cache: (enlist cachei.newCacheID[])!enlist (::);
    };
// @fileOverview 
// Retrieve an item from the cache
// @param id {guid} 
// @returns {any} 
.z.m.axedi.cachei.retrieve:{[id]
    .z.m.axedi.cache id
    }

// @fileOverview Create the i.ERRORS dictionary.
// This can't be in a data initialization because it needs to run after .z.m.axedi.translations
.z.m.axedi.createERRORS:{[]
    .z.m.axedi.i.ERRORS : (!) . flip (
        (`EDI:typeNotSortable; .z.m.axlocalize.t `.axedi_typeNotSortable);
        (`EDI.noSplayPart; .z.m.axlocalize.t `.axedi_noSplayPart);
        (`EDI.invalidColNames; .z.m.axlocalize.t `.axedi_invalidColNames);
        (`EDI.cacheIDExists; .z.m.axlocalize.t `.axedi_cacheIDExists);
        (`EDI.endAfterStart; .z.m.axlocalize.t `.axedi_endAfterStart);
        (`EDI.startPastEnd; .z.m.axlocalize.t `.axedi_startPastEnd);
        (`EDI.cannotInspectGenericNull; .z.m.axlocalize.t `.axedi_cannotInspectGenericNull);
        (`EDI.cannotDrilldownOnNonExistentCacheID; .z.m.axlocalize.t `.axedi_cannotDrilldownOnNonExistentCacheID)
        );
    }

// @fileOverview Create the .z.m.axedi.errorDescriptions dictionary.
// This can't be in a data initialization because it needs to run after .z.m.axedi.translations
.z.m.axedi.createErrorDescriptions:{[]
    // To avoid the limit on the number of literals, this dictionary needs to be created in two functions
    .z.m.axedi.errorDescriptions: {(!) . flip (
        ("[IJS].."; .z.m.axlocalize.t `.axedi_errorIJS); /dnl
        ("adict"; .z.m.axlocalize.t `.axedi_errorAdict); /dnl
        ("access"; .z.m.axlocalize.t `.axedi_errorAccess); /dnl
        ("accp"; .z.m.axlocalize.t `.axedi_errorAccp); /dnl
        ("arch"; .z.m.axlocalize.t `.axedi_errorArch); /dnl
        ("assign"; .z.m.axlocalize.t `.axedi_errorAssign); /dnl
        ("badtail"; .z.m.axlocalize.t `.axedi_errorBadtail); /dnl
        ("cast"; .z.m.axlocalize.t `.axedi_errorCast); /dnl
        ("con"; .z.m.axlocalize.t `.axedi_errorCon); /dnl
        ("cond"; .z.m.axlocalize.t `.axedi_errorCond); /dnl
        ("conn"; .z.m.axlocalize.t `.axedi_errorConn); /dnl
        ("d8"; .z.m.axlocalize.t `.axedi_errorD8); /dnl
        ("domain"; .z.m.axlocalize.t `.axedi_errorDomain); /dnl
        ("elim"; .z.m.axlocalize.t `.axedi_errorElim); /dnl
        ("fail"; .z.m.axlocalize.t `.axedi_errorFail); /dnl
        ("from"; .z.m.axlocalize.t `.axedi_errorFrom); /dnl
        ("glim"; .z.m.axlocalize.t `.axedi_errorLimit); /dnl
        ("hwr"; .z.m.axlocalize.t `.axedi_errorHwr); /dnl
        ("insert"; .z.m.axlocalize.t `.axedi_errorInsert); /dnl
        ("length"; .z.m.axlocalize.t `.axedi_errorLength); /dnl
        ("limit"; /dnl
            $[  .z.K < 3.6;
                .z.m.axlocalize.t `.axedi_errorLimitPre3.6;
                .z.m.axlocalize.t `.axedi_errorLimit]);
        ("loop"; .z.m.axlocalize.t `.axedi_errorLoop); /dnl
        ("mismatch"; .z.m.axlocalize.t `.axedi_errorMismatch); /dnl
        ("mlim"; .z.m.axlocalize.t `.axedi_errorMlim); /dnl
        ("Mlim"; .z.m.axlocalize.t `.axedi_errorNyi); /dnl
        ("nyi"; .z.m.axlocalize.t `.axedi_errorNyi); /dnl
        ("os"; .z.m.axlocalize.t `.axedi_errorOs); /dnl
        ("par"; .z.m.axlocalize.t `.axedi_errorPar); /dnl
        ("pl"; .z.m.axlocalize.t `.axedi_errorPl); /dnl
        ("Q7"; .z.m.axlocalize.t `.axedi_errorQ7); /dnl
        ("rank"; .z.m.axlocalize.t `.axedi_errorRank); /dnl
        ("rb"; .z.m.axlocalize.t `.axedi_errorRb); /dnl
        ("restricted"; .z.m.axlocalize.t `.axedi_errorRestricted) /dnl
        )}[] , { (!) . flip (
            ("s-fail"; .z.m.axlocalize.t `.axedi_errorSFail); /dnl
            ("splay"; .z.m.axlocalize.t `.axedi_errorSplay); /dnl
            ("stack"; .z.m.axlocalize.t `.axedi_errorStack); /dnl
            ("step"; .z.m.axlocalize.t `.axedi_errorStep); /dnl
            ("stop"; .z.m.axlocalize.t `.axedi_errorStop); /dnl
            ("stype"; .z.m.axlocalize.t `.axedi_errorStype); /dnl
            ("sys"; .z.m.axlocalize.t `.axedi_errorSys); /dnl
            ("trunc"; .z.m.axlocalize.t `.axedi_errorTrunc); /dnl
            ("type"; .z.m.axlocalize.t `.axedi_errorType); /dnl
            ("u-fail"; .z.m.axlocalize.t `.axedi_errorUFail); /dnl
            ("value"; .z.m.axlocalize.t `.axedi_errorValue); /dnl
            ("vd1"; .z.m.axlocalize.t `.axedi_errorVd1); /dnl
            ("view"; .z.m.axlocalize.t `.axedi_errorView); /dnl
            ("wsfull"; .z.m.axlocalize.t `.axedi_errorWsfull); /dnl
            ("("; .z.m.axlocalize.t `.axedi_errorOpenParen); /dnl
            (")"; .z.m.axlocalize.t `.axedi_errorCloseParen); /dnl
            ("["; .z.m.axlocalize.t `.axedi_errorOpenBracket); /dnl
            ("]"; .z.m.axlocalize.t `.axedi_errorCloseBracket); /dnl
            ("{"; .z.m.axlocalize.t `.axedi_errorOpenBrace); /dnl
            ("}"; .z.m.axlocalize.t `.axedi_errorCloseBrace); /dnl
            ("\""; .z.m.axlocalize.t `.axedi_errorUnmatchedQuote); /dnl
            ("branch"; /dnl
                $[  .z.K < 3.6;
                    .z.m.axlocalize.t `.axedi_errorBranchPre3.6;
                    .z.m.axlocalize.t `.axedi_errorBranch]);
            ("char"; .z.m.axlocalize.t `.axedi_errorChar); /dnl
            ("constants"; .z.m.axlocalize.t `.axedi_errorConstants); 
            ("globals"; /dnl
                $[  .z.K < 3.6;
                    .z.m.axlocalize.t `.axedi_errorGlobalsPre3.6;
                    .z.m.axlocalize.t `.axedi_errorGlobals]);
            ("locals"; /dnl
                $[  .z.K < 3.6;
                    .z.m.axlocalize.t `.axedi_errorLocalsPre3.6;
                    .z.m.axlocalize.t `.axedi_errorLocals]);
            ("params"; .z.m.axlocalize.t `.axedi_errorParams); /dnl
            ("syntax"; .z.m.axlocalize.t `.axedi_errorSyntax) /dnl
            )
            }[];
    }
// Evaluate the expression in the context passed in, and return the result as a string
.z.m.axedi.display:{[dict]
    : .z.m.axedi.toString .z.m.axedi.evaluate . dict `expression`ctx;
    }

// @fileOverview Evaluate the expression in the context passed in, and return the result as a string
//
// @param dict {dict (expression: string; ctx:string)}
// @returns {dict} The textual and grid representation of the expression
.z.m.axedi.displayAndGrid:{[dict]
    val: value[i.grid][i.gridConfig[];0;i.PAGE_END;::;1b;.z.m.axedi.evaluate[;dict`ctx];dict`expression];
    // Drop records since they're unused by the client
    : `expr`text`grid`storeDetails!(i.truncateText dict`expression; val`text; val`grid; `records _ val`raw);
    }

// @fileOverview Take a cacheID and an x, y coordinate and return that value back to the IDE
// 
//	If a user opts to drill down into a given data structure, drilldown is called. It leverages
//	the cached values and returns tabular informationt to be displayed in a fresh inspector. 
// drilldown calls inspect
//
// drill down now ensures the new drilldown window is added to the cache so it can be tracked
//
// @param dict {dict}
// 		cacheID		is as above, the unique ID that's associated with the inspector window
//		newCacheID	is the ID for the inspector window to be created by drilling down.
//		start, end	range to fetch records from the provided cacheID
//		x, y 		the tabular coordinates of where the user is clicking. 
//					Thus, if you have a 4x4 table and the user clicks on the first entry, 
//					that'd be 0,0. the bottom right element would be 3,3, etc. 
.z.m.axedi.drilldown:{[dict]
        
    newID: cachei.newCacheID[]; 
    id   : .z.m.axq.asGUID dict`cacheID;
    
    // Set up the new cache value for the drill down
    
    if [not cachei.has id;
        '`EDI.cannotDrilldownOnNonExistentCacheID];   
    
    item : `sort`sortBy _ cachei.retrieve[id] , (`visType`start`end`x`y#dict) , `cacheID`history`path!(newID;cachei.retrieve id;`drilldown);
    
    result : .z.m.axedi.inspector[cachei.exprValue id; item];    
    
    // Add the cache entries
    cachei.add[newID; item];
    cachei.addInspectWindow newID;  
    
    result[`id]: newID;     
    result[`parent]: id;
    : result;
    };
// @fileOverview
// Gets the parent table of an exsiting table
//
// @param dict {dict}   a dictionary holding the cacheID of the table being drilled up from
//
// @returns {dict} all the cached data of the parent table
.z.m.axedi.drillup:{[dict]
    id: .z.m.axq.asGUID dict `cacheID;
    
    if[not cachei.has id;
        '"cacheID does not exist"];
    
    item: cachei.retrieve id;
    
    if[not `history in key item;
        '"cacheID does not have a parent"];
    
    parentItem: item `history;
    parentID: parentItem `cacheID;
    
    result : .z.m.axedi.inspector[cachei.exprValue parentID; parentItem];
    
    result[`id]: parentID;    
    if[`history in key parentItem; result[`parent]: parentItem[`history] `cacheID];
    
    : result
    }
// @fileOverview Validate, then evaluate an expression in a context
// @param expr {String} An expression to evaluate
// @param ctx {String} The context to evaluate it in
// @returns {Any} The result of the expression
.z.m.axedi.evaluate:{[expr; ctx]
    
    if [-10h = type expr;
        expr: enlist expr];
    
    if [(ctx ~ "") or ctx ~ (::);
        ctx: "."];
    
    expr: plugin.preprocess each i.normalizeExpn[expr; ctx];
    
    : .z.m.axpnull.handleGenericNull .[value i.evalInContext;
        (i.evaluator[]; ctx; expr);
        {' .z.m.axedi.i.errorReport x}];
    }
// @fileOverview Validate, then evaluate an expression in a context. The code is written to a file such that it doesn't get locked.
// @param expr {String} A lambda expression to evaluate.
//  Note: Unlike .z.m.axedi.evaluate, this doesn't accept arbitrary code
// @param ctx {String} The context to evaluate it in
// @param fileName {String} Original file name
// @param line {long} Line number in original file
// @param funcName {symbol} Name to give to the function. The name won't be valid but will be the name of the function when value'd.
//                          Must be in the form `.xxx.yyy.zzz`, where `yyy` will be delete from `xxx` as part of cleanup.
// @returns {Any} The result of the expression
.z.m.axedi.evaluateViaFile:{[expr; ctx; fileName; line; funcName]

    // This must line up with isPm in i.evaluator.
    // .axedi won't load when this is pulled out into its own function
    isPm:0b;
    
    // If this is a permissioned process or reval is required,
    // use the secure "evaluate" instead of \l
    if [isPm or USE_REVAL;
        : evaluate[expr; ctx]];

    if [-10h = type expr;
        expr: enlist expr];

    baseName:last["/"vs fileName],".q";
    tmpFn:$[.z.o like "l*";
            `$":",first system"mktemp /tmp/axedi.tmp.XXXXXXXX.",baseName;
        .z.o like "w*";
            `$":",getenv[`TEMP],"\\axedi.tmp.",string[.z.m.axedi.nextGUID[]],".",baseName;
        `$":/tmp/",string[.z.u],"/axedi.tmp.",string[.z.m.axedi.nextGUID[]],".",baseName
    ];
    expr: plugin.preprocess each i.normalizeExpn[expr; "."];

    if [-11h=type ctx; ctx:string ctx];
    if [(ctx ~ "") or ctx ~ (::);
        ctx: enlist"."];
    filePrefix:enlist "\\d ",ctx;

    fileContent:((line-1)#enlist""),@[expr;0;string[funcName],":",];
    tmpFn 0: fileContent;

    originalCtx: string value "\\d";
    value "\\d ",ctx;

    r: .z.m.axpnull.handleGenericNull .[{system "l ",1_string x; value y};
        (tmpFn;funcName);
        {[originalCtx; error]
            value "\\d ",originalCtx;
            ' .z.m.axedi.i.errorReport error
            } originalCtx];
    
    value "\\d ",originalCtx;
    hdel tmpFn;
    parts:"."vs string funcName;
    ![`$".",parts 1;();0b;enlist`$parts 2];
    :r;
    }
// @fileOverview
// A wrapper for evaluate that takes the expression and context as a dictionary
// @param x {dict (expression: string; ctx: string)}
// @returns {null}
.z.m.axedi.execute:{[x]
    .z.m.axedi.evaluate[x `expression; x `ctx];
    : enlist[`expr]!enlist i.truncateText x`expression
    };
// @fileOverview This rewrites some expression types, like DSLs and commands,
//  so they can be put in larger expressions
// @param args {String[]} A pair holding the context and expression
// @returns {String} The expression, which may have been rewritten
.z.m.axedi.exprType:{[args]
    
    ctx: args 0;
    expn: args 1; 

    // If expression hooks have been installed, check whether any hooks match
    if [`ExprHooks in key .z.m.axedi.i;
        hs    : value i.ExprHooks; 
        
        // Find any valid hooks for the given expression
        match : where hs[;0] .\: (ctx; expn);  
        
        // If a hook was found, call it with the context and expression
        if [count match;
            : hs[first match][1][ctx; expn]]];

    // Otherwise return the unformatted expression
    : expn;
    }; 

// ##flushCache
//
// Flush the specified caches.
// If a single cacheID is provided we enlist it so that we eliminate the specified
// cacheID(s) as opposed to eliminating cacheID elements from the cache dictionary.
// Note that negative cacheIDs are used to determine vertical vs. horizontal display
// characteristics and are also flushed.
//
//	##flushCache [dict]
//
//		cacheID		is a long or list of longs
//
//		When an inspector window is closed it is expected that the IDE inspector will call flushCache
//		which will free up the memory associated with any open inspector windows.

// IDs are effectively timestamps + a random value
// we remove IDs LIFO so that the parent inspect window is the last
// to go if the UI sends us a long list of inspect windows to close

.z.m.axedi.flushCache:{[dict] cachei.flushCache dict };
// @fileOverview Add a new hook by key
// @param k {symbol}
// @param v {function} a validation function taking context and expression
// @param f {function} a reformatting function taking context and expression
// @returns {symbol}
.z.m.axedi.hooks.add:{[k; v; f]
    if [k in key i.ExprHooks;
        '"Hook for key already exists, please remove before adding"];
    i.ExprHooks[k]: (v; f);
    k
    }

// @fileOverview Reset the hooks
// @returns {null}
.z.m.axedi.hooks.clear:{[]
    // @qlintsuppress UNUSED_PARAM(1)
    i.ExprHooks: enlist[`]!enlist ({[c;e]0b}; {});
    }

// @fileOverview Remove a hook by key. Cannot remove builtin hooks.
// @param k {symbol}
// @returns {symbol}
.z.m.axedi.hooks.remove:{[k]
    if [k in `k`system`view`dsl;
        '"Cannot remove built-in EDI hook"];
    
    i.ExprHooks: i.ExprHooks _ k;
    k
    }

.z.m.axedi.i.drill:{[item; expr]

    x : item`x;
    y : item`y;
        
    // check the type and assign appropriately. If dealing with a simple list
    // allow for more readable horizontal display initially (determined by examine
    // whether the item being inspected is a simple list and contains a history)

    : $[(y < 0) and ((type expr) in (98 99h));                          // if y's negative the user wants the row
           $[.z.m.axq.isKeyedTable expr;                 (cols expr)!((value ((key expr) x)),value (expr ((key expr) x)));
             .z.m.axq.isDict       expr;                 (enlist (key expr) x)!(enlist expr [(key expr) x]);
             .z.m.axq.isTable      expr;                 expr x; ::];
       /otherwise
           $[(.z.m.axq.typeOf expr) in i.HorizontalLists;  $[`history in key item; $[`history in key item`history; expr x; expr]; expr];
             (`enum ~ .z.m.axq.typeOf expr);             expr x;
             .z.m.axq.isList  expr;                      expr x;                 // otherwise we'll drill down on the specified element of the list
             .z.m.axq.isDict  expr;                      (value expr) [x];       // ignore y where it doens't make sense
             .z.m.axq.isTable expr;                      (value expr x)[y];
             0 > type expr;                          expr; 
             // CAREP-7906 -- drilling down onto a function should value the function
             .z.m.axq.isFunction expr;                   value expr;
             /otherwise
                                                (value expr x)[y]]];
    };
// @fileOverview Create an empty schema for a table as a fallback in case
// schema generation fails
// @param table {table}
// @returns {table} .z.m.im.io schema table of the correct size, blanked out
.z.m.axedi.i.emptySchema:{[table]
    : update name: cols table , include:1b from count[cols table]#0#.z.m.im.io.schema .z.m.im.schema.read .z.m.im.io.with.target[([]())] .z.m.im.io.create`kdb
    }

// @fileOverview Replaces terse error messages with more descriptive message
// @param qError {String} An error message
// @returns {String} A more descriptive error message
.z.m.axedi.i.errorReport:{[qError]
    
    // If the error message contains extra information, like "noamend: `. `n", just append the description,
    // but if it is constant, like "type", do a dictionary lookup to get the description
    proseError:
        $[  qError like "noupdate:*";
                qError , " " , .z.m.axlocalize.t `.axedi_errorNoupdate;
            qError like "noamend:*";
                qError , " " , .z.m.axlocalize.t `.axedi_errorNoamend;
            // Else
                .z.m.axedi.errorDescriptions qError];
    
    // If there is no description, return the original error message
    : $[proseError ~ "";
        qError;
        proseError];
    }
.z.m.axedi.i.escape:{[str]
    chars: (`char$til 255)!(string each `char$til 255);
    chars [("\\";"\"";"\t";"\n";"\r")]: ("\\\\";"\\\"";"\\t";"\\n";"\\r");
    : raze chars str; 
    }

// @fileOverview Return the code evaluator
// @returns {fn (string) -> any}
.z.m.axedi.i.evaluator:{[]
    // This must line up with isPm in evaluateViaFile.
    // .axedi won't load when this is pulled out into its own function
    isPm:0b;
    
    : $[isPm & USE_REVAL;
            { .z.m.ax.ctrl.exas[.z.m.axenv.getUser[]] (reval;(value;x)) };
        isPm;
            .z.m.ax.ctrl.exas .z.m.axenv.getUser[]; // will use value internally
        USE_REVAL; 
            {reval(value;x)}; 
        // else
            value]
    }

// @fileOverview This rewrites the value, if it is a function, to show more information
// @param expressionValue {any} The value of the expression
// @returns {any}
.z.m.axedi.i.formatFunctions:{[expressionValue]
    // If expr is a function, it isn't very useful to just show the body
    // so show the value of it
    : $[.z.m.axq.typeOf[expressionValue] ~ `lambda;
            expressionValue : value expressionValue;
        .z.m.axq.typeOf[expressionValue] ~ `projection;
            // If it is a projection, show the function and the parameters,
            // Replacing the function with the value of the function
            [   projection      : value expressionValue;
                projection[0]   : value projection 0;
                // Label the function and parameters to make it clear what is going on
                labels          : (`$.z.m.axlocalize.t `.axedi_functionLabel) ,
                                  `${.z.m.axlocalize.t (`.axedi_parameterLabel; x)} each (til -1 + count projection);
                expressionValue : labels!projection];
        // Else
            expressionValue];
    }

// @fileOverview Return a detailed schema for a table
// @param t {table} 
// @returns {table} 
.z.m.axedi.i.getSchema:{[t]
    : @[{
        .z.m.im.io.schema .z.m.im.schema.read .z.m.im.io.with.target[x] .z.m.im.io.create`kdb
        }; t; i.emptySchema t]
    }
// @fileOverview Return an *ipc-serializable* config for displayAndGrid
// *All* external dependencies should be encapsulated here.
// @returns {dict}
.z.m.axedi.i.gridConfig:{[]
    : (!) . flip (
        // to override
        (`schema;       i.getSchema);
        (`primcode;     .z.m.axq.i_PRIMCODE);
        (`nonprimcode;  .z.m.axq.i_NONPRIMCODE);
        (`maxcols;      .z.m.axedi.i.MAXCOLS);
        (`maxrows;      .z.m.axedi.i.MAXROWS);
        (`consolesize;  system"c");
        (`types;        i.TYPES);
        (`returnRaw;    0b);
        (`rawMaxRows;   1000000);
        // types to display horizontally
        (`hlist;        "h"$1+til 76)
        );
    }


.z.m.axedi.i.inspectExpr:{[expr; item]
    
    cantSort: {[x]
        if [x ~ "type";
            '`EDI:typeNotSortable];
        '`$x;
        };
           
    // If we're supposed to drill down, get the component of interest
    
    if [`x in key item;
        expr: .z.m.axedi.i.drill [item; expr];
    ];
    
    // Sort the data if need be
    
    if [`sort in key item;
        expr: .z.m.axq.catch [.z.m.axedi.i.sortInspection; (expr; item`sort; item`sortBy); cantSort];
    ];
    
    : expr;
    };

// @fileOverview Checks if a given expression is a DSL
// @param expr {String} The expression
// @returns {Boolean} If the expression is a DSL
.z.m.axedi.i.isDSL:{[expr] expr like "[a-zA-Z])*" }
// @fileOverview Perform minor rewrites on code so it can be easily processed
// @param expn {String}
// @param ctx {String}
// @returns {String[]} A list of the rewritten lines
.z.m.axedi.i.normalizeExpn:{[expn; ctx]
    : splitExpression stripTrailingSemi wrapLines[ctx] removeMultilineComments expn;
    }


.z.m.axedi.i.sortInspection:{[item; sort; sortBy]
    
    sort : .z.m.axq.asSymbol sort;
    
    // splayed and partitioned tables cannot be sorted, return an informative error 
    
    if [`boolean ~ .z.m.axq.typeOf .Q.qp item;
        //'`$"Cannot sort splayed or partitioned tables";
        '`EDI.noSplayPart;
    ];
    
    // If the sort direction is `none, just return the unmodified item
    if [sort ~ `none;
        : item];
    
    // determine if the user wants the data sorted and return the data sorted appropriately
    
    sortBy: $[ 11h = type sortBy;               sortBy;             /* list of symbols
              -11h = type sortBy;               enlist sortBy;      /* symbol
               (type sortBy) in (10 -10h);      enlist `$sortBy;    /* string or char
               each [{10h = type x}] sortBy;    enlist `$sortBy;    /* list of strings
                                                '`EDI.invalidColNames];
                                                //'`$"Invalid col names to sort."];

    sort: $[10h = type sort; `$sort; sort];
        
    : $[(.z.m.axq.isKeyedTable item) or  
        (.z.m.axq.isTable      item);       $[sort ~ `up; sortBy xasc item; sortBy xdesc item];
        .z.m.axq.isDict        item;        $[`Value in sortBy; 
                                        $[sort ~ `up; asc  item; desc item];
                                        $[sort ~ `up; kk!item kk:asc  key item;
                                                      kk!item kk:desc key item]];
       /otherwise
                                        $[sort ~ `up; asc item; desc item]];
    };
// @fileOverview
// Traverse the inspection history. Execute the commands associated with 
// a given cache entry for all except a non-historical event, since EDI will
// cover the value correctly (i.e., it was invoked from an inspect call).
//
// Note that getRecords is invoked here on the history in the cach. That way we
// effectively replay the inspections/drilldowns that got us here.
    
// traverse USED to evaluate the expression, now it just fetches it from the cache
// the value is always in the negative entry for the parent inspection window cache
.z.m.axedi.i.traverse:{[item; exprValue]
    
    if [not `history in key item;
        : .z.m.axedi.i.inspectExpr[exprValue; item]];
    
    : .z.m.axedi.i.inspectExpr[.z.m.axedi.i.traverse[item `history; exprValue]; item];
    };

// @fileOverview Truncate text larger than the console size
// @param text {string} Text to truncate
// @returns {string} Truncated text
.z.m.axedi.i.truncateText:{[text]
    columns:     system["c"]1; 
    rows:        system["c"]0;
    truncateRow: {[c;t] $[c < count t; (c sublist t),"..."; t] } columns;
    truncated:   truncateRow each "\n" vs text;
    
    if [rows < count truncated; 
        truncated: (rows sublist truncated),enlist "..."];

    : "\n" sv truncated;
    }

// @fileOverview
// On inspect we create a new cache entry. Note, that if inspect is called
// on an existing cache entry (i.e., to sort) then we simply overwrite the 
// information associated with that cache entry as sorts, etc. appear in an
// OPEN inspector window.

// inspect has the added calls to deal with us now (again)
// caching the value of the expression

.z.m.axedi.inspect:{[dict]
    
    // Use the id if given, or create a new one
    id : $[`cacheID in key dict; .z.m.axq.asGUID dict`cacheID; cachei.newCacheID[]];
    
    // deal with an existing cache ID (i.e., we're probably sorting)
    
    if [cachei.has id;
        if [not `sort in key dict;
            //'`$"Call to inspect on existing cacheID failed, no sort provided.";
            '`EDI.cacheIDExists;
        ];
        
        // inherit the history from the cache
        item : cachei.retrieve [id] ,  `start`end`sort`sortBy`path!(dict`start;dict`end;dict`sort;dict`sortBy;`inspect);
        
        // adjust the positioning for the sort (cache exists)        
        // .z.m.axedi.cache [id; `history]:: .z.m.axedi.cache [id];      // do we need to remember the history if we're just sorting??? 
        result : .z.m.axedi.inspector[cachei.exprValue id; item];        
        cachei.add[id; item];        
        : result;
    ];
    
    // otherwise, we have a new inspect request so create the cache value

    // set the expression's value as the negative of the original inspection cache ID
    // we'll also have to retain which inspection/drill down windows remain so we can
    // free up the ID thereby freeing up any memory associated with maintaining the 
    // expression's value   
    expressionValue : .z.m.axedi.evaluate[ dict`expression; dict`ctx ];    // retain the value of the expression
    
    if [i.isProjectionNull expressionValue;
        '"EDI.cannotInspectProjectionNull"];
    
    // Values which are functions are modified to show more information about the function
    expressionValue : .z.m.axedi.i.formatFunctions expressionValue;
    
    result : .z.m.axedi.inspector[expressionValue; dict];  
    
    parent : cachei.newCacheID[];    
    // Add the parent main window
    cachei.add[parent;  (`start`end _ dict) , `windows`exprValue!( (); expressionValue )];                  
    // Add the edi cache window
    cachei.add[id;       dict , `cacheID`path`parent!(id;`inspect;parent)];
    
    // Link the cache entries
    cachei.addInspectWindow id;
    
    result[`id] : id;    
    : result;
    };

// #.i.inspector
//
// The inspector accepts inbound calls from: inspect, drilldown, and cachedValue.
// The inspector examines the dictionary passed in order to determine what should
// be done.
//
// Note, the cache for each inspection contains the entire history of what's been
// inspected. The inspector is structured this way so as to ensure that we don't
// use up a large amount of memory, which could occur if we kept the value of a given
// expression. This logic remains even for subcomponents of an expression (i.e.,
// sublists) thereby ensuring data stays reasonbly sized.
//
// The inspector is passed an initial value (the first inspect of the value), and
// a dictionary reflecting the changes made to the value (drilldown/sort,etc). The
// dictionary can have the following keys:
//
//      expression  - a string representing the expression to be inspected
//      start       - where the inspection begins
//      end         - where the inspection ends
//      sort        - `up or `down, the direction to sory
//      sortBy      - what to sort (i.e., key, column, etc.)
//      x           - the x position the user double clicked in an OPEN inspector
//      y           - the y position the user double clicked in an OPEN inspector (-1 for the row)
//      history     - a list of how we got here (list of dicts of the same form)

.z.m.axedi.inspector:{[val;item]           // internal (private) function
    // NOTE: - here we need to actually call through the history; we simply recurse
    //         on the history until we get to the bottom, evaluate that and
    //         then pop back up until we return the value desired.
    //       - .cws.i.traverse calls getRecords to fetch records according to the
    //         historical inspections
    //       - if no history exists, we use the start/end values provided by the VI
    //         otherwise we know we've traversed down to the correct element and let
    //         getRecords fetch everything and return it.

    expr    : .z.m.axedi.i.traverse [item; val];

    if [i.isProjectionNull[expr];
        '`EDI.cannotInspectProjectionNull];

    start : item`start;
    end   : item`end;

    // if this isn't the same list flipping vertical, then we need to
    // ensure we reset the start/end to reflect the true drill down event

    if [item[`start] > count expr;
        start : 0;
        end   : item[`end] - item`start];

    : value[i.grid][
        update 
            hlist: 1#10h
            // default config used for display
            from i.gridConfig[];
        start;
        end;
        item;
        0b;
        ::;
        expr]`grid; 
    };


// @fileOverview GUIDs are generated based on the system clock,
// so generating two back-to-back can generate the same number,
// especially on Windows with a less precise system clock.
// To avoid this, a pool of GUIDs can be generated as a single operation.
// @returns {GUID}
.z.m.axedi.nextGUID:{
    if [0 = count .z.m.axedi.GUIDs;
        .z.m.axedi.GUIDs: -1000?0ng];
    nextGUID: first .z.m.axedi.GUIDs;
    .z.m.axedi.GUIDs: 1 _ .z.m.axedi.GUIDs;
    nextGUID
    }

// @fileOverview Endpoint for allowing arbitrary preprocessing of expressions.
// Added for plugin overwriting.
// @param x {string} - expression
// @returns {string} Processed expression
.z.m.axedi.plugin.preprocess:{[x] x }

// @fileOverview This removes multiline comments, as value errors on strings containing them
// @param text {String} 
// @returns {String} q code with no multiline comments
.z.m.axedi.removeMultilineComments:{[text]
    
    // Multiline comment delimiters have precedence over strings,
    // so there is no need to tokenize the input as a multiline delimiter can't be in a string.
    // Add a temporary newline so text starting with "/\n" doesn't need a separate rule
    text: "\n" , text;
    lines: (where text = "\n") cut text;
    
    // starting tokens are "\n/[\t ]*"
    potentialStart: where lines like "\n/*";
    start: potentialStart where all each (2_/:lines potentialStart) in "\t ";
    
    potentialEnd: where lines like "\n\\*";
    end: 1 + potentialEnd where all each (2_/:lines potentialEnd) in "\t ";
    
    // Remove the temporary newline
    lines[0]: 1 _ lines[0];
    
    // Make an ordered list of boundaries
    boundaries: (`start,' start), (`end,' end);
    boundaries: boundaries iasc boundaries[;1];
    
    // The opening delimiters inside multiline comments must be removed
    // along with unmatched closing delimiters
    // An unmatched opening delimiter should be left, as it comments out the rest of the file
    filteredList: ();
    lastBoundary: `end;
    index: 0;
    do [count boundaries;
        if [lastBoundary <> first boundaries index;
            lastBoundary: first boundaries index;
            filteredList,: enlist boundaries index];
        index+: 1];
    
    // Remove multiline comments
    result: raze first each 2 cut raze each (0, filteredList[;1]) cut lines;
    
    : $[result ~ ();
        "";
        result];
    }

// @fileOverview Retrieve the table based on cacheID
// @param cacheID {string} the id to retrieve the data
// @returns {table} the data
.z.m.axedi.retrieveData:{[cacheID]

    id : .z.m.axq.asGUID cacheID;
    
    if [not .z.m.axedi.cachei.has id;
        '"Cache has been cleared. Unable to export data."];

    : .z.m.axedi.cachei.exprValue id
    }

// @fileOverview Split a single string into a list of multiple
// expression strings. Each expression starts in column 0, as
// the q interpreter does.
// @param e {string} a string of input
// @returns {string[]} list of expressions
.z.m.axedi.splitExpression:{[e]
    // tokenize to avoid splitting multiline strings
    t: -4!e;
    : "c"$raze each 
        // split newlines that don't start with whitespace
        (0,1+p where not 
        // ensure it's not whitespace
        {x in 1#'" \t\n"} 
        // get the character right after each newline
        t 1+p:where (1#"\n")~/:t) _ t
    }

// @fileOverview Removes any trailing semicolons and whitespace 
// from the end of the input
// @param str {String}
// @returns {String}
.z.m.axedi.stripTrailingSemi:{[str]
    trimTermWS: {[str]
        r: reverse str;
        while [(0 < count r) and (r [0] in "\r\n; \t");
        r: 1 _ r];
        : reverse r;
        };
    
    if [-10h ~ type str;
        str: string str];
    
    if [not 10h ~ type str;
        : `InvalidInput];

    str: .z.m.axutl.tokenize str;
    if [("" ~ str) or (() ~ str);
        : ""];
    
    : trimTermWS trim raze str;
    }
// @param data {Any}
// @returns {String}
// @fileOverview Similar an objects toString method in Java,
//  this takes any data, and turns it into a string representation that can be displayed to the user.
.z.m.axedi.toString:{[data]
    // First, try .Q.s
    text : .Q.s data;
    
    // .Q.s displays dictionaries, tables and lists across multiple lines making them easier to read
    // but just shows whitespace for (), (();()), enlist (), ()!(), etc.,
    // So if .Q.s just gave a string made of whitespace, try .Q.s1
    : $[all text in " \r\n";
        .Q.s1[data] , "\n"; // The newline is for consistency, as .Q.s adds this, but .Q.s1 doesn't
        text];
    }

// @fileOverview Some lines, like those starting with k) or \,
// must be rewritten before they can be joined into larger expressions.
// They must split on tokens when possible, instead of naïvely on \n,
// so as to not split up multiline strings

// @param ctx {String} A context
// @param expn {String} An expression
// @returns {String}
.z.m.axedi.wrapLines:{[ctx; expn]
    
    // Split the expression on newlines, and for versions > 3.4, remove trailing comments with -4!
    tokenizeAndSplit: {[expn]
        
        : $[.z.K <= 3.4;
            
            // In kdb+ ≤3.4, -4! will remove the comment looking part from commands like \cd /myDir,
            // just do the simpler splitting on new lines
            "\n" vs expn;
            
            [   // This needs to have a newline prefixed, as this gets split on newlines,
                // and the first token from each list gets removed
                tokens: -4!"\n" , expn;
                "" sv/: 1_/:(where tokens ~\: enlist "\n") cut tokens]];
        };
    
    // The tokenizing will fail if passed a DSL line, as it can't tokenize the unmatched bracket,
    // so these need to be caught, and handled just by splitting on "\n"
    lines: @[tokenizeAndSplit;
        expn;
        // @qlintsuppress UNUSED_PARAM(1)
        {[expn; e] "\n" vs expn}[expn]];
    
    // Accumulate DSL lines together so that they're executed properly
    lines:{[acc;line]
        $[0=count acc;
            acc,:enlist line;
        // Comments are allowed in the first column of a DSL expression,
        // and blank lines also won't interrupt a DSL expression.
        (.z.m.axedi.i.isDSL last acc) and line[0] in " \t/";
            [
            acc[count[acc] - 1]: last[acc],"\n",line;
            acc
            ];
        //else
            acc,:enlist line]
                }/[();] lines;

    // Rewrite each line, if necessary, based on its expression type
    : "\n" sv .z.m.axedi.exprType each (ctx;) each lines;
    }
.z.m.axedi.translations:.z.m.axlocalize.addTranslations (!) . flip enlist (
    (`en;
        (!) . flip (
            (`.axedi_functionLabel; "Function");
            (`.axedi_parameterLabel; "Parameter {index}");
            (`.axedi_typeNotSortable; "The type is not sortable");
            (`.axedi_noSplayPart; "Cannot sort splayed or partitioned tables");
            (`.axedi_invalidColNames; "Invalid column names to sort");
            (`.axedi_cacheIDExists; "Attempted inspect on existing cacheID failed, no sort provided");
            (`.axedi_endAfterStart; "getRecords: end must be after start");
            (`.axedi_startPastEnd; "getRecords: start must be less than size of item to inspect");
            (`.axedi_cannotInspectGenericNull; "Inspect: Cannot inspect generic null");
            (`.axedi_cannotDrilldownOnNonExistentCacheID; "Inspect: Cannot drill down on non-existent cacheID");
            (`.axedi_errorAdict; "adict: Blocked assignment");
            (`.axedi_errorAccess; "access: Attempt to read files above directory, run system commands or failed usr/pwd");
            (`.axedi_errorAccp; "accp: Tried to accept an incoming tcp/ip connection but failed to do so");
            (`.axedi_errorArch; "arch: Attempt to load file of wrong endian format");
            (`.axedi_errorAssign; "assign: Attempt to assign to a reserved word or non-variable");
            (`.axedi_errorBadtail; "badtail: Incomplete transaction at end of logfile, get good (count;length) with -11!(-2;`:file)");
            (`.axedi_errorCast; "cast: Attempt to enumerate invalid value");
            (`.axedi_errorCon; "con: 	qcon client is not supported when kdb+ is in multithreaded input mode");
            (`.axedi_errorCond; "cond: Even number of arguments to $");
            (`.axedi_errorConn; "conn: Too many incoming connections, 1022 max");
            (`.axedi_errorD8; "d8: The log had a partial transaction at the and the file couldn''t be truncated");
            (`.axedi_errorDomain; "domain: Argument to function out of function''s domain");
            (`.axedi_errorElim; "elim: More than 57 distinct enumerations");
            (`.axedi_errorFail; "fail: Invalid attribute setting");
            (`.axedi_errorFrom; "from: Badly formed select statement");
            (`.axedi_errorGlim; "glim: Group (`g#) limit, 99 max");
            (`.axedi_errorHwr; "hwr: Handle write error, can''t write inside a peach");
            (`.axedi_errorIJS; "[IJS]..: Key type is not I, J, or S");
            (`.axedi_errorInsert; "insert: Attempt to insert a record with a key that already exists");
            (`.axedi_errorLength; "length: Incompatible list lengths");
            (`.axedi_errorLimitPre3.6; "limit: List longer than allowable maximum, 2B elements");
            (`.axedi_errorLimit; "limit: Too many constants, 239 max, with locals + globals + constants < 240, or else a list with over 2^40 elements");
            (`.axedi_errorLoop; "loop: Circular reference loop");
            (`.axedi_errorMismatch; "mismatch: Columns cannot be aligned for operation");
            (`.axedi_errorMlim; "mlim: More than 999 nested columns in splayed table");
            (`.axedi_errorNyi; "nyi: Not yet implemented");
            (`.axedi_errorNoamend; "Can''t change global state inside an amend");
            (`.axedi_errorNoupdate; "Update not allowed when using -b cmd line arg, reval, negative port numbers, or updating global vars with peach");
            (`.axedi_errorOs; "os: User requested OS call failed");
            (`.axedi_errorPar; "par: Unsupported operation on a partitioned table or component thereof");
            (`.axedi_errorPl; "pl: peach cannot handle parallel lambdas");
            (`.axedi_errorQ7; "Q7: Unimplemented operation on file nested array");
            (`.axedi_errorRank; "rank: Invalid rank or valence (parameter count)");
            (`.axedi_errorRb; "rb: Encountered problem while doing a blocking read");
            (`.axedi_errorRestricted; "restricted: Blocked operation in a kdb+ process started with -b cmd line flag, or using username:password authentication file");
            (`.axedi_errorSFail; "s-fail: Cannot apply `s# to data (not ascending values)");
            (`.axedi_errorSplay; "splay: Unimplemented operation on splayed table");
            (`.axedi_errorStack; "stack: Stack space exhausted");
            (`.axedi_errorStep; "step: Attempt to upsert a step dictionary in place");
            (`.axedi_errorStop; "stop: User interrupted execution or time limit exceeded");
            (`.axedi_errorStype; "stype: Invalid type used in signal");
            (`.axedi_errorSys; "sys: Using system call from thread other than main thread");
            (`.axedi_errorTrunc; "trunc: The log had a partial transaction at the end, cannot truncate file");
            (`.axedi_errorType; "type: Mismatched types");
            (`.axedi_errorUFail; "u-fail: Cannot apply `u# to data (not unique values)");
            (`.axedi_errorValue; "value: Missing value");
            (`.axedi_errorVd1; "vd1: Attempted multithread update");
            (`.axedi_errorView; "view: Trying to re-assign a view to something else");
            (`.axedi_errorWsfull; "wsfull: Out of swap space or workspace limit exceeded");
            (`.axedi_errorOpenParen;"(: Unmatched parenthesis");
            (`.axedi_errorCloseParen; "): Unmatched parenthesis");
            (`.axedi_errorOpenBracket; "[: Unmatched square bracket");
            (`.axedi_errorCloseBracket; "]: Unmatched square bracket");
            (`.axedi_errorOpenBrace; "'{: Unmatched brace");
            (`.axedi_errorCloseBrace; "}: Unmatched brace");
            (`.axedi_errorUnmatchedQuote; "\": No closing quote on string");
            (`.axedi_errorBranchPre3.6; "branch: Too many items in if/do/while/$[..], 255 byte code max");
            (`.axedi_errorBranch; "branch: Too many items in if/do/while/$[..], 65025 byte code max");
            (`.axedi_errorChar; "char: Invalid character");
            (`.axedi_errorConstants; "constants: Too many constants, 96 max");
            (`.axedi_errorGlobalsPre3.6; "globals: Too many global variables, 31 max");
            (`.axedi_errorGlobals; "Too many global variables, 110 max, with locals + globals + constants < 240");
            (`.axedi_errorLocalsPre3.6; "locals: Too many local variables, 24 max");
            (`.axedi_errorLocals; "Too many local variables, 110 max, with locals + globals + constants < 240");
            (`.axedi_errorParams; "params: Too many parameters in function definition, 8 max");
            (`.axedi_errorSyntax; "syntax: syntax error")
            )
        ));

// @fileOverview 
// Given any value, determine whether that value is projection null.
// 
// Projection null is a special null that signals that an argument is
// still free in a projected function.
//
// For example, looking for free arguments at the end of a projection
// returns *generic* null: 
// (::) ~ (value ({x+y}[5]))[2]
// 1b
// But checking projected arguments returns a special null that projects
// whatever it is applied to:
// (::) ~ (value ({x+y}[;5]))[1]
// ~[::;]
//
// Since it projects whatever it is applied to, we can see if the result of it
// matched against itself (which should be a boolean) is a projection instead
//
// @param x {any} 
// @returns {boolean} whether the argument is generic null
.z.m.axedi.i.isProjectionNull:`projection ~ .z.m.axq.typeOf {1b}@
/{[x] `projection ~ typeSymbol first (~) ./: flip (enlist x; enlist x)};
// This is a string so that it won't get locked, as locked functions can't be run in remote processes.
// Even if this evaluates to a function, rather than being a function literal, it will still be locked during the build
.z.m.axedi.i.grid:"{[conf; start; end; item; truncate; preprocess; expr]
    
    expr:    preprocess expr;

    totext:  {[x] $[all (text:.Q.s x) in \" \r\n\"; .Q.s1[x] , \"\n\"; text] };
    typeof:  {[pc;npc;x]$[0>type x; pc neg type x; npc type x]}[conf`primcode; conf`nonprimcode];
    iskeyed: { $[99h ~ type x; all 98h = type each (key x;value x); 0b] };
    totable: {[hlist; iskeyed; typeof; vertical; expr; records]
        s: typeof expr;
        t: type expr;
        : $[(t in hlist) and not vertical;   s xcol ([] lst: enlist records);
               t within 1 19;                   s xcol ([] lst: records);
               t within -1 -19;                 s xcol ([] atom: enlist records);
               t within 20 76;                  ([] enum: raze records);
               t within 0 97;                   s xcol ([] lst: records);
               (t ~ 98h) | iskeyed expr;        records;
               t ~ 99h;                         ([] Key: key records; Value: value records);
               t in 100 101 102h;               ([] function: enlist records);
                                                s xcol ([] Content: enlist records)];
        }[conf`hlist;iskeyed;typeof];
    
    getRecords: {[iskeyed; item; start; end]
        if [end < 0; end: count item];

        if [1 = size: count item;
            if [.Q.qp item; item: .Q.ind[item; `long$enlist 0]];
            : `size`start`end`count`records!(size;0;1;1;item)];

        if [end < start;  '`EDI.endAfterStart];
        if [start > size; '`EDI.startPastEnd];

        end:   end&size;
        range: start + til (count[item] - start) & end - start;
        retValue: $[.Q.qp item;      .Q.ind[item; range];
                    iskeyed item;    neg[end-start]#end#item;
                    99h ~ type item; $[0<=type value item; (key[item]range)!value[item]range; item];
                                     item range];
        : `size`start`end`count`records!(size; start; end; count range; retValue);
        }[iskeyed];
    
    truncateGrid: {[maxcols; consolesize; data]
        charsToKeep: last consolesize;
        charCounts:  sums each count each/: data;
        colsToKeep:  til count[first data]^1+0^min min each where each charsToKeep < charCounts;
        charCounts:  charCounts@\\:colsToKeep;
        truncated:   where each not charCounts=charsToKeep&charCounts;
        data:        -1_'(0,'charsToKeep&charCounts) _' raze each data;
        data:        {$[0=count y;x;.[x;y;,;\"...\"]]}'[data;truncated];
        if [maxcols < count first data; data: maxcols sublist/: data];
        : data;
        }[conf`maxcols; conf`consolesize];

    item      : $[99 <> type item; (0#`)!(); item];
    vertical  : (`history in key item) or not type[expr] in conf`hlist;
    exprTable : totable[vertical; expr; expr];
    tableType : ((0b; 1b; 0)!`splay`partition`other) [.Q.qp expr];
    data      : getRecords[expr; start; end];
    records   : totable[vertical; expr; data`records];
    schema    : conf[`schema] exprTable;

    // try to get more precise types (long[] instead of general)
    schema: .[{[types; expr; schema]
        // occasionally `meta` can fail against some table types, so wrap with the 
        // default schema just in case
        exprTypes: types first each string value[meta expr]`t;
        @[schema;`kind;:;exprTypes]
        }; (conf`types; exprTable; schema); schema];
    
    // Update the types of enums with the more specific information
    displayData : flip {$[y`enum;.Q.s2 each x;.Q.s1 each x]}'[value flip 0!records; schema];
    
    if [truncate & not 0 = count displayData;
        displayData: truncateGrid displayData;
        
        // truncate the schema header
        if [count[schema] > count first displayData;
            displayData:   displayData ,\\: enlist \"...\";
            columnsToKeep: -1+count first displayData;
            schema : (columnsToKeep#schema) uj enlist cols[schema]!(`...;`general;0b;`;`;1b;0b;`)];
        
        // truncate rows
        maxRows: conf[`maxrows]&first conf`consolesize;
        if [maxRows < count displayData;
            displayData: (maxRows#displayData) , enlist count[first displayData]#enlist \"...\"]];
    
    schemaTypes : @[schema`kind; where schema`enum; :; `enum];
    
    : (!) . flip (
        (`text; totext expr);
        (`raw;  $[conf`returnRaw; getRecords[expr; 0; conf`rawMaxRows]; ()!()]);
        (`grid; (!) . flip (
            (`trueType;    type expr);
            (`colSymTypes; schemaTypes);
            (`tableType;   tableType);
            (`columns;     string cols records);
            (`start;       data`start);
            (`end;         data`end);
            (`size;        data`size);
            (`imschema;    schema);
            (`imdata;      displayData))));
    }"
// @fileOverview Runs an expression in a context
// @param evalFn {Function} The function that evaluates the expressions
// @param ctx {String} The context
// @param expr {String[]} An expression broken up into lines
// @returns {Any} The result of the expression

// This is a string so that it won't get locked, as locked functions can't be run in remote processes
// Even if this evaluates to a function, rather than being a function literal, it will still be locked during the build
.z.m.axedi.i.evalInContext:"{[evalFn; ctx; expr]
    
    // It isn't enough just to have a line like \"system \\\"d .z.m.myContext\\\"\" at the start of the expression,
    // as the context of any functions get bound before that line runs
    cachedCtx: string system \"d\";
    system \"d \", ctx;
    
    // Run each expression
    result: last {[evalFn; cachedCtx; expr; ii]
        e: expr ii;
        
        if [\"\\n\" ~ last e;
            e: -1_e];
        
        // Attributes are only maintained if put in the ;[::;e] structure with a terminating semicolon
        // so add back a semi-colon on every line except for the last (to continue to return the result)
        if [(not ii ~ -1 + count expr) & not \";\" ~ last e;
            e ,: \";\"];
        
        // This wrapping forces the string to be part of an expression. This implicity forces assignments
        // to return their value. An assignment in q that is not part of a larger expression (starting in column 0)
        // returns generic null rather than it's value
        e: \";[::;\" , e , \"]\";
        
        : @[evalFn;
            e;
            {[cachedCtx; err]
                system \"d \", cachedCtx;
  
                $[  err ~ enlist \" \";
                    ' \"syntax error\";
                    ' err]
                } cachedCtx];
        }[evalFn; cachedCtx; expr] each til count expr;

    system \"d \", cachedCtx;
    : result;
    }"
// and add in an [] as the nested format for each uppercase type (J:long[])
.z.m.axedi.i.TYPES:{ x , upper[k]!`$ {x,\:"[]"} string x k:k where k~'lower each k:key[x] except " " } 
    // start the with basic types (j:long)
    " bgxhijefcCspmdznuvt"!`general`boolean`guid`byte`short`int`long`real`float`char`compoundChar`symbol`timestamp`month`date`datetime`timespan`minute`second`time /dnl
.z.m.axedi.i.PAGE_END:500
.z.m.axedi.i.MAXROWS:200
.z.m.axedi.i.MAXCOLS:100
// @qlintsuppress UNUSED_INTERNAL(1)
.z.m.axedi.i.INITCACHE:.z.m.axedi.cachei.reset [];         // ensure the inspector's cache is initialized

// If a vector is in this list, it will display horizontally rather
// than vertically initially. See CAREP-6793 for a discussion.
.z.m.axedi.i.HorizontalLists:enlist `chars
// @fileOverview A dictionary of functions, taking an expression and context,
// that find expressions matching a rule, then rewrite them
// @qlintsuppress UNUSED_PARAM(1)
.z.m.axedi.i.ExprHooks:enlist[`]!enlist ({[e;c]0b}; {})  
.z.m.axedi.USE_REVAL:$[`USE_REVAL in key `.axedi; 
    // if the value has already been set (i.e., avoid resetting on reload
        USE_REVAL;  
    // otherwise, check to see if an environment variable is set
    not "" ~ env:getenv`AX_USE_REVAL; 
        "yes" ~ lower env; 
    // else, default to off (use value rather than reval)
        0b] 
.z.m.axedi.GUIDs:`guid$()
.z.m.axedi.onLoad:{[]
    .z.m.axedi.isView: {s:rtrim first l:(0,x ss "::")_x; (1<count l) & (all s in .Q.an) and 0 < count s};

    // Create dictionaries of translations
    .z.m.axedi.createErrorDescriptions[];
    .z.m.axedi.createERRORS[];

    // @qlintsuppress UNUSED_PARAM(2)    
    // This is the similar to the DSL hook, but stripTrailingSemi
    // is used to display the result of expressions ending in semicolons,
    // whereas arbitrary DSL expressions should be left unchanged.
    if [not `k in key i.ExprHooks;
        hooks.add[`k;       {[c;e] e like "[kq])*" };
                            {[c;e] "value \"",(2#e), i.escape [.z.m.axedi.stripTrailingSemi 2_e], "\";" }]];

    if [not `system in key i.ExprHooks;
        // @qlintsuppress UNUSED_PARAM(2)
        hooks.add[`system;  {[c;e] e like "\\*" };
                            {[c;e] "system \"", i.escape [trim 1_e], "\";" }]];

    if [not `view in key i.ExprHooks;
        // @qlintsuppress UNUSED_PARAM(2)
        hooks.add[`view;    {[c;e] $[`isView in key .axedi; isView e; 0b] };
                            {[c;e] "value \"", i.escape [trim e], "\";" }]];

    if [not `dsl in key i.ExprHooks;
        // @qlintsuppress UNUSED_PARAM(2)
        hooks.add[`dsl;     {[c;e] .z.m.axedi.i.isDSL e };
                            {[c;e] "value \"",(2#e), i.escape [2_e], "\";" }]];

    }


.z.m.axedi.onLoad[];
system "d .z.m";

system "d .z.m.qu";
// @fileOverview Retrieves the text split by line with all tokens identified
// @param text {string} the text of the quke file
// @param possibleTokens {symbol} tokens that may be parsed
// @param multiWords {dict (key : symbol; value :symbol[])} multi-word tokens
// @returns {table}
.z.m.qu.quke.allTokens:{[text;possibleTokens;multiWords]
    parsedTable: quke.z.m.table.splitByToken[text;possibleTokens];
    
    //Remove the beginning of the data strings when the token is found in token list
    qminTokens: exec token from parsedTable where token in possibleTokens;

    //Add block positions
    parsedTable: update positionsInFile: (-1_0,sums 1+count each data) from parsedTable;
    
    parsedTable: update data: .z.m.axstr.trimWhitespace (count each string qminTokens)_' .z.m.axstr.trimWhitespace each data 
                 from parsedTable 
                 where token in possibleTokens;

    //Some blocks only apply if two words are included in the line pattern
    parsedTable : quke.z.m.table.addMultiWords[parsedTable; multiWords];

    //Locate the before each and after each statements and update the tokens appropriately
    parsedTable: update token:({(`$(string x)," each")} each token), data: 4_/:data
                 from parsedTable 
                                                                                            // accept all chars removed by .z.m.axstr.trimWhitespace
                 where token in `before`after, ((lower data) like "each") or (lower data) like "each[ \t\013\014]*";

    :parsedTable
    }

// @fileOverview called in over statemtens by error checking functions to 
// assemble data error messages. 
// NOTE: every error message must end in [line #LINENUMBER]
// @param listOfErrors {string} the list of errors which has previously 
//              been built by checkTableDataErrors
// @param parsedTable {table (line: long;token: symbol; data: string)} 
//                      is a single row from table that contains an error
// @param errorMessageText {string} different types of errors pass in a 
//              different string so that the error message makes sense
// @private
// @returns {string} returns a list of all error messages
.z.m.qu.quke.check.addErrorMessage:{[listOfErrors;parsedTable;errorMessageText]
    :listOfErrors,enlist (errorMessageText, string parsedTable `token;parsedTable `line)
    }

// @fileOverview called in over statemtens by error checking functions to 
// assemble data error messages relating to improper bench blocks
// NOTE: every error message must end in [line #LINENUMBER]
// @param listOfErrors {string} the list of errors which has previously 
//              been built by checkTableTokenErrors
// @param lines {long[]} list of line numbers for a given bench block
// @param parsedTable {table (line: long;token: symbol; data: string)} 
//                      is a single row from table that contains an error
// @private
// @returns {string} returns a list of all error messages
.z.m.qu.quke.check.benchContentsHelper:{[listOfErrors;lines;parsedTable]
    parsedTokens: exec token from parsedTable where line in lines;
    numBaseline : count where parsedTokens in `baseline;
    numBehaviour : count where parsedTokens in `behaviour;
    numTolerance : count where parsedTokens in `tolerance;
    numTimelimit : count where parsedTokens in `timelimit;
    numReplicate : count where parsedTokens in `replicate;
    
    :listOfErrors,
          $[(numBaseline = 0) and numTolerance = 1;
               enlist ("bench block cannot have tolerance block without baseline block";first lines);
               ()],
          $[not numBehaviour = 1;
               enlist ("improper number of behaviour blocks in bench block";first lines);
               ()],
          $[not numBaseline <= 1;
               enlist ("improper number of baseline blocks in bench block";first lines);
               ()],
          $[not numTolerance <= 1;
               enlist ("improper number of tolerance blocks in bench block";first lines);
               ()],
          $[not numReplicate <= 1;
               enlist ("improper number of replicate blocks in bench block";first lines);
               ()],
          $[not numTimelimit <= 1;
               enlist ("improper number of timelimit blocks in bench block";first lines);
               ()]
    }

// @fileOverview called in over statements by error checking functions to 
// assemble data error messages if there are tokens in the wrong block
// NOTE: every error message must end in [line #LINENUMBER]
// @param listOfErrors {string} the list of errors which has previously 
//              been built by checkTableTokenErrors
// @param lines {long[]} list of line numbers for a given block
// @param parsedTable {table (line: long;token: symbol; data: string)} 
//                      is a single row from table that contains an error
// @private
// @returns {string} returns a list of all error messages
.z.m.qu.quke.check.blockContentsHelper:{[listOfErrors;lines;parsedTable]
    parsedTable: select from parsedTable where line in lines;
    missplacedTokenTable: parsedTable where not parsedTable[`token] in quke.TOKENBLOCKSPECIFICATIONS first parsedTable `token;

    :$[count missplacedTokenTable;
      {[listOfErrors;tableEntry;block]
                      listOfErrors, enlist ((string tableEntry `token)," statement in ", (string block) ," block is in improper location";tableEntry `line)
                      }[;;first parsedTable `token] over enlist[listOfErrors], missplacedTokenTable;
      listOfErrors];
    }
// @fileOverview executed by checkTableTokenErrors to determine if only the allowed tokens follow a given token
// this function is used as part of an over statement to build a list of errors for each token type
// NOTE: every error message must end in [line #LINENUMBER]
// @param listOfErrors {string} the list of errors which is being built in the over statement 
// @param specKey {symbol} the token that is being analyzed at a given time; used to index into TOKENSPECIFICATIONS, 
//                          a dictionary of the tokens that are allowed to follow a given token
// @param parsedTable {table (line: long;token: symbol; data: string)} is the table that is being checked for errors
// @private
// @returns {string} Returns a string containing any error message for a given block
.z.m.qu.quke.check.blockPositionsHelper:{[listOfErrors;specKey;parsedTable]
    :$[count errorLines:exec line from parsedTable where (not (next token) in .z.m.qu.quke.TOKENSPECIFICATIONS[specKey]), (token = specKey);
            {[listOfErrors;line;specKey]     
                listOfErrors, enlist ("incorrect token in ", (string specKey), " block";line)
                }[;;specKey] over enlist[listOfErrors], errorLines;
            //else
            listOfErrors]
    }
// @fileOverview called in over statemtens by error checking functions to 
// assemble data error messages relating to improper bench blocks
// NOTE: every error message must end in [line #LINENUMBER]
// @param listOfErrors {string} the list of errors which has previously 
//              been built by checkTableTokenErrors
// @param lines {long[]} list of line numbers for a given bench block
// @param parsedTable {table (line: long;token: symbol; data: string)} 
//                      is a single row from table that contains an error
// @private
// @returns {string} returns a list of all error messages
.z.m.qu.quke.check.expectContentsHelper:{[listOfErrors;lines;parsedTable]
    parsedTokens: exec token from parsedTable where line in lines;
    numToMatch : count where parsedTokens in `$"to match";
    
    :listOfErrors,
            $[numToMatch > 1;
                 enlist ("expect block permits at most a single to match block";first lines);
                 ()]
    }
// @fileOverview called by parseText to determine if the content in the data column 
// is the appropriate data for each token type
// NOTE: every error message must end in [line #LINENUMBER]
// @private
// @param parsedTable {table (line: long;token: symbol; data: string)} is the table that is being checked for errors
// @returns {string} returns a list of all error messages
.z.m.qu.quke.check.tableDataErrors:{[parsedTable]
    
    listOfErrors: ();
 
    //Check that any lines above the first feature are empty
    listOfErrors,: $[(`function in first parsedTable `token) and 0 <> count first parsedTable `data;
                        $[`feature in parsedTable `token;
                            enlist ("content prior to first feature";1);
                            enlist ("content outside of feature";1)
                            ];
                        ()];

    //check that before, after, setup,tolerance,timelimit,and teardown statements have no text 
    //(this will also catch improper before each and after each since those are not converted 
    //to before each or after each if there is any other text on the line)
    listOfErrors: quke.check.addErrorMessage[;;"text adjacent to "] over enlist[listOfErrors], 
                        select from parsedTable 
                               where (0 <> count each data), 
                                     token in (`before`after`setup`tolerance`timelimit`teardown,(`$"before each";`$"after each"));

     //The following tests are easier to perform if the data is shifted to the preceding token
    shiftedParsedTable : select line, token, data: next data from parsedTable;
    
    //Check that all functions directly beneath feature,should, and bench statements are empty
    listOfErrors: quke.check.addErrorMessage[;;"unrecognized content following "] over enlist[listOfErrors], 
                        select from shiftedParsedTable
                               where (`function = next token), 
                                     (token in `feature`should`bench),  
                                     (0 <> count each data);

    //Check that content in tolerance blocks consists of either one or two numbers
    listOfErrors: quke.check.addErrorMessage[;;"only 1 or 2 numbers allowed in "] over enlist[listOfErrors],
                        select from shiftedParsedTable 
                               where (token in `tolerance), 
                                     {cutSpaces: " " vs x;
                                      nonSpaces: .z.m.axq.parseFloat cutSpaces where not (count each cutSpaces) = 0;
                                      (not (count nonSpaces) in (1;2)) or 
                                      (0n in nonSpaces)} each data;  

    //Check that content in timelimit blocks consists of a single number
    listOfErrors: quke.check.addErrorMessage[;;"only single number allowed in "] over enlist[listOfErrors],
                        select from shiftedParsedTable
                               where (token in `timelimit), 
                                     {.z.m.axq.isNull .z.m.axq.parseLong .z.m.axstr.trimWhitespace x}  each data;  
    
    //Check that content in replicate blocks consists of a single number
    listOfErrors: quke.check.addErrorMessage[;;"only single positive number allowed in "] over enlist[listOfErrors],
                        select from shiftedParsedTable
                               where (token in `replicate), 
                                     {(.z.m.axq.isNull .z.m.axq.parseLong .z.m.axstr.trimWhitespace x) or 
                                      0 >= .z.m.axq.parseLong .z.m.axstr.trimWhitespace x} each data;    
    
    :listOfErrors

    }
// @fileOverview called by parseText, used to determine if all of the tokens are organised 
// in the correct positions in the table
// NOTE: every error message must end in [line #LINENUMBER]
// @param listOfErrors {string} the list of errors which has previously been built by checkTableDataErrors
// @param parsedTable {table (line: long;token: symbol; data: string)} is the table that is being checked for errors
// @private
// @returns {string} returns a list of all error messages
.z.m.qu.quke.check.tableTokenErrors:{[listOfErrors;parsedTable]

    //Check that all content is within a feature block
    listOfErrors,: $[(0 < count parsedTable) and not `feature in first parsedTable `token; 
                        enlist ("content must be wrapped in a feature block";1);
                        ()];
    
    topLevelGroups: (where parsedTable[`token] in key quke.TOKENBLOCKSPECIFICATIONS) _ parsedTable `line;
    
    //Check that all tokens are situated in the appropriate blocks
    listOfErrors: quke.check.blockContentsHelper[;;parsedTable] over enlist[listOfErrors], topLevelGroups;

    //Check that the correct number of each type of token are in bench blocks
    listOfErrors: quke.check.benchContentsHelper[;;parsedTable] over enlist[listOfErrors], 
                                topLevelGroups where `bench = parsedTable[`token] parsedTable[`line]?topLevelGroups[;0];

    shoulds : topLevelGroups where `should = parsedTable[`token] parsedTable[`line]?topLevelGroups[;0];
    expectTable : select from parsedTable where line in raze shoulds, token <> `should;
    
    listOfErrors: quke.check.expectContentsHelper[;;parsedTable] over enlist[listOfErrors], 
                                (where expectTable[`token] in `expect) _ expectTable `line;  
    
    //Each token to see if it has the allowed tokens following it (the list of allowed tokens 
    //for a given token is in TOKENSPECIFICATIONS)
    listOfErrors : quke.check.blockPositionsHelper[;;parsedTable] over enlist[listOfErrors], 
                                key quke.TOKENSPECIFICATIONS;
    
    :listOfErrors
    
    }
// @fileOverview Rewrite a function such that any return other than 1b will throw an error
// @param functionStr {string} The text of a function
// @returns {string}
.z.m.qu.quke.i.addErrorOnFail:{[functionStr]
    
    tree: .z.m.axqc.q functionStr;
    lastLineReturn: .z.m.axqc.findLastLineReturn tree;
    
    // Rewrite explicit returns
    explicitReturns: quke.i.findExplicitReturns tree;
    toReplace: (0 1 +/: explicitReturns[; 0 0]) ,\: enlist ":{$[x~1b;x;'\"Test failed\"]}(::)[";
    toReplace,: (1 + explicitReturns[; 1 1]) ,\: enlist "]";
    
    // Rewrite implicit returns
    // This would be (();()) when the function is empty
    if [not (lastLineReturn[0] ~ ()) or lastLineReturn[0] ~ (();());
        toReplace,: enlist (1 + lastLineReturn[0; 0 0]) , enlist "{$[x~1b;x;'\"Test failed\"]}(::)[";
        toReplace,: enlist (1 + lastLineReturn[0; 1 1]) , enlist enlist "]"];
    
    body: tree[0;0;1;1];
    
    // Rewrite empty functions
    if [body ~ ();
        // Since the parser doens't actually return where the parameter's square braces close,
        // this goes off the function's closing brace
        toReplace,: enlist (2#.z.m.axqc.treeMax tree[0;0]), enlist "{$[x~1b;x;'\"Test failed\"]}[::]"];
    
    // Rewrite functions without a return, as they implicitly return ::
    // This can happen if an expect block ends in ";;"
    if [(not lastLineReturn 1) and `empty ~ first last body;
        toReplace,: enlist (1 + 2#.z.m.axqc.treeMin last body) , enlist "{$[x~1b;x;'\"Test failed\"]}[::]"];
    
    : .z.m.axstr.multireplace[functionStr; toReplace];
    }

// @fileOverview Find the positions of any explicit returns
// @param tree {any} The parse tree of a function
// @returns {Long[][]} A list of pairs of the start and end positions
.z.m.qu.quke.i.findExplicitReturns:{[tree]
    
    .z.m.qu.quke.returnList: ();
    
    {[tree]
        $[  // Don't recurse into leaves
            .z.m.axq.isSymbol first tree;     ();

            // If it is a function definition, don't go into it as it's a different scope
            `FUNCTION ~ first first tree; ();

            // If it is a return, record it and recurse
            `RETURN ~ first first tree;
                [   .z.m.qu.quke.returnList,: enlist tree[0;1 2];
                    .z.s each tree];

            // Else, recurse on each child
                .z.s each tree];
        } tree[0;0;1];
    
    : .z.m.qu.quke.returnList;
    }
// @fileOverview Fills in blocks to skip based on their token
// @param parsedTable {table (line: long;token: symbol; data: string; skip: boolean)} the table
// @private
// @returns {table (line: long;token: symbol; data: string; skip: boolean)} the table with entire blocks skipped 
.z.m.qu.quke.i.findSkipBlocks:{[parsedTable]
    blockPriority:(`feature`before`after`should`bench`property`expect,(`$"before each"), `$"after each")!3 2 2 2 2 2 1 2 2;

    skipGrps: {[priority; x;y] 
                :$[x[1] and priority[x 0] > priority y 0;x;y]
                }[blockPriority]\[(`;0b);flip parsedTable `token`skip];

    parsedTable: @[parsedTable;`skip;:;skipGrps[;1]];

    // Propagate skipping upwards - if a feature or should only contains skipped blocks, it should itself be skipped
    parsedTable:update shouldLine:fills?[token=`feature;0;?[token=`should;line;0N]] from parsedTable;
    skipShould:exec shouldLine from (select all skip by shouldLine from parsedTable where 0<shouldLine, token<>`should) where skip;
    parsedTable:delete shouldLine from update skip:1b from parsedTable where line in skipShould;

    parsedTable:update featureLine:fills?[token=`feature;line;0N] from parsedTable;
    skipFeature:exec featureLine from (select all skip by featureLine from parsedTable where 0<featureLine, token<>`feature) where skip;
    parsedTable:delete featureLine from update skip:1b from parsedTable where line in skipFeature;

    :parsedTable;
    }
// @fileOverview A q parser for quke files.
// @param text {string} the text of the quke file
// @param asBlocks {boolean} should the functions be reported with their quke block names
// @private
// @returns {()} the list of q tokens 
.z.m.qu.quke.parseQukeFile:{[text; asBlocks]

    //Ensure it works on both strings and text that has been loaded from a file
    text : $[.z.m.axq.isString text;"\n" vs text;text];

    txtLen: count "\n" sv text;

    //Find lines with quke tokens. These will be ignored when running the q parse on the file
    parsedTable : quke.allTokens[text;quke.TOKENLIST, key quke.SKIPTOKENS;.z.m.qu.quke.MULTIWORDS];

    // quke.allTokens modifies the text of each block to allow remove the tokens
    // We restore the original text here so that .z.m.axqc.parseQFile can work out line numbers
    // if an error is thrown
    parsedTable[`data] : text;
    
    //Group each of the function blocks
    parsedTable: quke.z.m.table.function.groupBlocks parsedTable;

    // Replace skipped blocks with the unskipped token 
    parsedTable : update token : .z.m.qu.quke.SKIPTOKENS token from parsedTable where token in key .z.m.qu.quke.SKIPTOKENS;

    //Must handle inline comments on the same lines as quke tokens
    parsedTable: update data: {[text]
                    position: first ss[text;" /"];
                    :$[not position ~ 0N;
                        (position#" "),(position) _ text;
                        count[text]#" "
                        ]} each data  from parsedTable where token <> `function;

    // We do not remove square brackets or trailing semi-colons
    // This is for a few reasons:
    //  1. .z.m.axutl.tokenize removes comments. So calling .z.m.qu.quke.z.m.table.function.format would remove comments
    //      that could potentially be important for linting the file.
    //  2. We could use -4! to tokenize the function while maintaining comments, but doing so would show
    //      inconsistent behaviour for kdb 3.4 (where -4! does remove comments).
    //  3. With square brackets present, the file parses fine (there is only some extra parsed tokens in the result).
    //      So it is not a significant issue if we leave brackets in (it will likely not affect linting).
    //  4. I have created functions to detect comment locations without using -4!.
    //      This would have allowed us to remove the square brackets without removing comments.
    //      However, I deemed the risk of an error in the comment locator too great for too small a benefit.
    // This has the effect of potentially including the `empty token at the end. This is considered an acceptable tradeoff
    //      as it will likely not affect linting.

    parsedTable: select text:data, positionsInFile, token from parsedTable;

    parsedTable: update prs:.z.m.axqc.parseGroups parsedTable from parsedTable;

    //Semi colons at the end of each line must be removed to simulate actual parsed functions
    parsedTable[`prs]: .[;(::;::;0)] parsedTable`prs;

    tokenList: $[asBlocks;
                    exec token from parsedTable where `function = next token, token in .z.m.qu.quke.FUNCTIONBLOCKS;
                    `FUNCTION];

    parsedTable: update start:positionsInFile,  
                        // subtract 1 for block start
                        end : txtLen^-1+next positionsInFile
                 from parsedTable;

    parsedTable: select start, end, prs
                 from parsedTable where prev[token] in .z.m.qu.quke.FUNCTIONBLOCKS, token = `function;

    fns: enlist each tokenList,'parsedTable[`start],'parsedTable[`end];
    prms:enlist each enlist each enlist[`empty;""],/:parsedTable[`start],'parsedTable[`start];

    :(enlist each fns ,' enlist each prms,'enlist each parsedTable`prs),\:`noSemi

    }
// @fileOverview called by i.runFiles, used to build the tree 
// for testing by .z.m.qu.contextRunner
// @param context {symbol} the context that the functions must be compiled in
// @param text {string} the text of a given quke test file
// @param sts {#ty.userSettings} the settings for running qcumber
// @private
// @returns {#block.dagTree[]} returns the parsed tree or {string} a string 
//                  of parsing error messages
.z.m.qu.quke.parser:{[context; text; sts]

    //Parse the textFile or string into a table
    //An error is thrown if there was a parsing error
    parsedText: quke.z.m.table.text[text; sts];

    //There was a parse error
    if[not .z.m.axq.isTable parsedText; :parsedText];
    
    //Create a new empty tree to pass to the translateTable function
    spec: .z.m.axds.tree.new[];

    //build a tree of dag nodes from the entire files table
    //catch compiler errors
    :quke.translate.file[context;parsedText;spec]
    }

// @fileOverview Any quke tokens that are represented by several works (such as `to match`) 
//                  are identified and handled here.
// @param parsedTable {table (line: long;token: symbol; data: string)} the table whose functions are being condensed
// @param multiWords {dict (key : symbol; value : symbol[])} the quke block with the multiword, and the words that make up that block name.
//                      This dictionary makes it easy to add new multi word-blocks in the future.
// @returns {table (line: long; token: symbol; data:string)} The table with functions merged together
.z.m.qu.quke.z.m.table.addMultiWords:{[parsedTable;multiWords]

    // This should probably eventually be generalized to any number of tokens
    // For now, I figured it was simplest to get it working for just the two that are necessary
    // for any quke tokens in the forseable future
    // It could potentially been done easier by just splitting on whitespace characters,
    // but I decided to use quke.z.m.table.findTokenEnd because that is the function we have 
    // been using for years to parse quke tokens, so it seemed safer.
    c1 : quke.z.m.table.findTokenEnd each ldata: .z.m.axstr.trimWhitespace each lower parsedTable`data;
    w1 : `$c1#'ldata;
    c2 : quke.z.m.table.findTokenEnd each ldata : .z.m.axstr.trimWhitespace c1 _'ldata;
    w2 : `$c2#'ldata;
    
    matches : multiWords ? w1,'w2;
    
    canReplace : where (`function = parsedTable`token) and matches <> `;
    
    parsedTable[canReplace;`token] : matches canReplace;
    
    parsedTable : update lastWord : (string last each multiWords token) from parsedTable where token in key multiWords;
    parsedTable : update data: (1+count'[lastWord]+first each lower[data] ss' lastWord)_'data from parsedTable where token in key multiWords;
    
    : delete lastWord from parsedTable
    }
// @fileOverview Find the index of the first non-token character in the string
// @param txt {string}
// @returns {long}
.z.m.qu.quke.z.m.table.findTokenEnd:{[txt]
    :0^first where not (txt," ") in .Q.a,.Q.n,"_"
    }
// @fileOverview called from table.function.format.proxy, used on each function in the 
// table to reformat the function
// @param function {string} the string contained in the data column of 
//                      the table with `function as the token
// @private
// @returns {string} the reformated function
.z.m.qu.quke.z.m.table.function.format:{[function]

    function: quke.z.m.table.removeSquareBrackets function;

    toks: @[.z.m.axutl.tokenize;function;{`error}];
    if[toks ~ `error;:function];

    spaceLoc : 0 = count each .z.m.axstr.trimWhitespace each toks;
    // Locate the final non-space or comment token
    notSpace : last where not spaceLoc;

    if[(1#";") ~ toks notSpace;
        toks[notSpace] : 1#" "];

    :"", raze toks
    }
// @fileOverview Group all function blocks
// @param parsedTable {table (line: long; token: symbol; data:string)}
// @private
// @returns {table (line: long; token: symbol; data:string)} The table with functions merged together
.z.m.qu.quke.z.m.table.function.groupBlocks:{[parsedTable]
    
    //Group all groups of functions in the same block together
    //First, find the line numbers for the groups of functions
    startFunctions: exec line 
                    from parsedTable 
                    where (prev token) <> `function, token = `function;
    endFunctions:   exec line  
                    from parsedTable 
                    where (next token) <> `function, token = `function;
    functionGroups: {(x[0]-1)_1+til x 1} each startFunctions,' endFunctions;
    //Update the first line of each function block with the data from all the other function lines in a block, 
    //then remove the excess function lines
    parsedTable: update data: .z.m.qu.quke.z.m.table.function.merge[parsedTable;] each functionGroups 
                 from parsedTable
                 where (prev token) <> `function, token = `function;
    parsedTable: delete from parsedTable where (prev token) = `function, token = `function;
    
    :parsedTable
    
    }

// @fileOverview called by parser, used in an each statement to combine each 
// set of lines that make up a given function into a single function
// @param parsedTable {table (line: long;token: symbol; data: string)} the table whose functions are being condensed
// @param lineNumbers {long[]} the lines that correspond to each 
//                      row in parsedTable that forms a given function 
// @private
// @returns {string} Returns a string of the function lines joined together
.z.m.qu.quke.z.m.table.function.merge:{[parsedTable;lineNumbers] 
    :"\n" sv exec data from parsedTable where line in lineNumbers
    }
// @fileOverview Parse the quke file and find any formatting errors
// @param text {string | string[]} the file to parse
// @param sts {#ty.userSettings} the settings for running qcumber
// @private
// @returns {dict (parsedTable: table (line: long;token: symbol; data: string); listOfErrors: (string; long))} 
.z.m.qu.quke.z.m.table.parse:{[text;sts]

    // Split the textfile into separate strings along newlines if this has not allready occurred
    text : $[.z.m.axq.isString text;"\n" vs text;text];

    possibleTokens: (quke.TOKENLIST, key quke.SKIPTOKENS) except sts`ignoreBlocks;

    parsedTable : quke.allTokens[text;possibleTokens;sts[`ignoreBlocks]_ .z.m.qu.quke.MULTIWORDS];
    // We don't require the positions in the file
    parsedTable : delete positionsInFile from parsedTable;
    // Group each of the function blocks
    parsedTable : quke.z.m.table.function.groupBlocks parsedTable;

    // reformat each function so it can be run with qcumber
    parsedTable: update data: .z.m.qu.quke.z.m.table.function.format each data 
                 from parsedTable 
                 where token = `function;
    // We remove whitespace in each function block
    // to allow for identifying invalid content in function blocks after shoulds, features, etc
    parsedTable: update data: .z.m.axstr.trimWhitespace each data from parsedTable where token = `function;

    //Find tokens to skip
    parsedTable : update token : .z.m.qu.quke.SKIPTOKENS token, skip: 1b from parsedTable where token in key .z.m.qu.quke.SKIPTOKENS;

    // Add empty functions after any expect, property, behaviour, or baseline blocks that lack function blocks.
    // This will essentially change the location where errors (for the expect and property blocks) will be caught (i.e. they will
    // be caught at runtime instead of being reported as malformed files
    missingFunctionLines: 0,1+exec i from parsedTable where `function <> next token, token in (.z.m.qu.quke.FUNCTIONBLOCKS);
    parsedTable: {[table;newLines]
                        :table,(`line`token`data`skip!(last table `line; `function;"";0b)),newLines
                        }/[first missingFunctionLines _  parsedTable;1_missingFunctionLines _  parsedTable];

    parsedTable : quke.i.findSkipBlocks parsedTable;

    // Error Handling Function to determine if the content in the data field is appropriate for each token/
    listOfErrors: quke.check.tableDataErrors select from parsedTable where not skip;

    // Remove empty function lines after feature, or should. The recursive "translateTable" function only looks
    // at the first line in each parsedTable it is passed.
    parsedTable: delete from parsedTable 
                 where (prev token) in `feature`should`bench, token = `function;

    // Delete the first row from the parsedTable if it is a function (indicating that there was blank space above the first feature),
    // for the reasons mentioned above.
    parsedTable:delete from parsedTable 
                where line = 1, token = `function;

    // Error Handling Function to determine if each token is positioned where in the appropriate locations /
    listOfErrors: quke.check.tableTokenErrors[listOfErrors;select from parsedTable where not skip];

    // Sort the errors by line numbers
    listOfErrors @: iasc listOfErrors[;1];

    :`parsedTable`listOfErrors!(parsedTable;listOfErrors)
    }
// @fileOverview called by formatFunction, used to remove sets of square brackets
// that surrounded multiline functions to ensure compatability with old message formats
// @param function {string} function, the function whose enclosing square brackets are being 
//                  removed (if appropriate)
// @private
// @returns {string} returns the function with enclosing square brackets removed
.z.m.qu.quke.z.m.table.removeSquareBrackets:{[function]

    // At this point, comments should always have already been removed,
    // but we still use .z.m.axutl.tokenize for testing purposes
    tokenizedfunction: @[.z.m.axutl.tokenize;function;{`error}];
    //If there are unmatched brackets, return the original function
    if[tokenizedfunction ~ `error;
        :function];

    openBracket: first where tokenizedfunction ~\: enlist "[";
    closeBracket: last where tokenizedfunction ~\: enlist "]";

    //If no square brackets are present, return
    if[0N in openBracket, closeBracket; :function];

    spaceLoc : 0 = count each .z.m.axstr.trimWhitespace each tokenizedfunction;
    outerRegions: (openBracket#spaceLoc), (closeBracket+1) _ spaceLoc;

    :$[all outerRegions;
        [tokenizedfunction[openBracket]:enlist " ";
         tokenizedfunction[closeBracket]:enlist " ";
         raze tokenizedfunction]; 
        function]
    }
// @fileOverview Find all the tokens in the file
// @param text {string[]} the text of the file, split upon newlines
// @param possibleTokens {symbol[]} a list of available tokens to parse
// @private
// @returns {table (line: long; token: symbol; data: string)} a input file parsed by token
.z.m.qu.quke.z.m.table.splitByToken:{[text;possibleTokens]

    //Finds the tokens for each line by choosing the text positioned before the first non letter and non numerical character;
    tokens: {x:.z.m.axstr.trimWhitespace x; `$quke.z.m.table.findTokenEnd[x]#x} each lower text;

    /Convert behavior to behaviour to accommodate international spelling/
    tokens[where tokens = `behavior] : `behaviour;
    
    tokens[where not tokens in possibleTokens] : `function;
    
    //Create the table 
    :([] line:1 + til count text; token:tokens; data:text; skip:0b)
    }

// @fileOverview called by .z.m.qu.quke.parser, takes in a quke message and parses 
// it to a table which can be converted to a tree
// @param text {string | string[]}, a quke message for a given test, 
//                  either in the form of a datafile or string
// @param sts {#ty.userSettings} the settings for running qcumber
// @returns {table (line: long;token: symbol; data: string)} returns a parsedTable from the quke message
// @private
// @throws 'errorlist - throws a list of parse errors if parse errors are detected
.z.m.qu.quke.z.m.table.text:{[text; sts]
    
    parseResults: quke.z.m.table.parse[text; sts];
    
    //If there are parsing error messages, throw the first error in the list instead of the parsed table
    // This is thrown as an error instead of returned to facilitate subsequent error handling
    // The Error: and [line #] string are pre and post pended to allow distinguishing quke errors from parse errors
    if[not 0 = count parseResults`listOfErrors;:(`error;parseResults`listOfErrors)];
    //Return the parsed table
    :parseResults`parsedTable
    }



// @fileOverview Handles the content of a bench block
// @param context {symbol} the context in the form of a symbol, that each 
//                      function must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} 
//                      the portion of the quke message table 
//                      representing a single should block
// @param spec {#block.dagTree} an empty tree node, used as a placeholder to 
//                      ensure that a tree is always found at the edges of 
//                      the complete tree
// @private
// @returns {#block.dagTree} returns a .z.m.qu.describe node
.z.m.qu.quke.translate.bench:{[context;qukeTable;spec]
    :.z.m.qu.block.metadata.modify[`line;qukeTable[`line] 0] 
        .z.m.qu.block.bench[qukeTable[`data] 0]
            raze quke.translate.blockContents[context;qukeTable;;spec] each quke.translate.parseRows[qukeTable;`bench];
    }

// @fileOverview called by translateTable to build before, after, before each, 
// or after each nodes
// @param context {symbol} the context in the form of a symbol, that each 
//                  function must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} 
//                  the portion of the quke message table representing 
//                  a single before, after, before each, or after each block
// @param spec {#block.dagTree} an empty tree node, used as a placeholder to ensure 
//                  that a tree is always found at the edges of the complete tree
// @private
// @returns {#block.dagTree[]} returns a dag node
.z.m.qu.quke.translate.benchContents:{[context;qukeTable;spec]
    firstToken : first qukeTable `token;
    firstLine : qukeTable[`line] 0;
    firstData : qukeTable[`data] 0;
    func: quke.translate.function.compile[0b; context; qukeTable[`data] 1];
    defaultFunc: quke.translate.function.compile[0b; context; "1b"];
    :$[ `setup  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.metadata.modify[`setup;enlist (func;firstLine)] .z.m.qu.block.setup func;
        `teardown  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.metadata.modify[`teardown; enlist (func;firstLine)] .z.m.qu.block.teardown func;
        //DEPRECATED FEATURE, MAY ADD TO NEW BLOCK IN LATER RELEASES
        //This code used to allow the setup and teardown functions to run on each iteration of a behaviour and baseline iteration
        //`setup  = firstToken; 
        //    .z.m.qu.metadata.modify[`line;firstLine] .z.m.qu.metadata.modify[`setup;enlist (func;firstLine)] .z.m.qu.setup[defaultFunc];
        //`teardown  = firstToken; 
        //    .z.m.qu.metadata.modify[`line;firstLine] .z.m.qu.metadata.modify[`teardown; enlist (func;firstLine)] .z.m.qu.teardown[defaultFunc];
        `tolerance  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine]
                .z.m.qu.block.metadata.modify[`tolerance; qukeTable[`data] 1]
                    .z.m.qu.block.tolerance defaultFunc;
        `timelimit  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine]
                .z.m.qu.block.metadata.modify[`timelimit; qukeTable[`data] 1]
                    .z.m.qu.block.timelimit defaultFunc;
        `replicate  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine]
                .z.m.qu.block.metadata.modify[`replicate; qukeTable[`data] 1]
                    .z.m.qu.block.replicate defaultFunc;
        `baseline  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.baseline[firstData;func];
        `behaviour  = firstToken;
                    .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.behaviour[firstData;func];
        
        //else
            spec
     ]
    }

// @fileOverview Takes individual blocks (in the form of tables) and builds the
// appropriate dag node. Line numbers in the "lines" list are used to determine
// which lines in the table form a given block.
// @param context {symbol} the context in the form of a symbol, that each 
//              function must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} the portion of a
//              quke message table corresponding to a single feature
// @param lines {long[]} a set of lines numbers corresponding to a single 
//              should, before, after, before each, after each
// @param spec {#block.dagTree} an empty tree node, used as a placeholder to ensure that 
//              a tree is always found at the edges of the complete tree
// @private
// @returns {#block.dagTree[]} returns a node
.z.m.qu.quke.translate.blockContents:{[context;qukeTable;lines;spec]
    parsedTable: select from qukeTable where line in lines;
    :quke.translate.table[context; parsedTable;spec]
    }


// @fileOverview called by translateTable to build expect nodes
// @param context {symbol} the context in the form of a symbol, that 
//                  each function must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} 
//                  the portion of the quke message table 
//                  representing a single should block
// @private
// @returns {#block.dagTree[]} returns a .z.m.qu.when node
.z.m.qu.quke.translate.expect:{[context;qukeTable]

    exptBlck: quke.translate.function.compile[1b; context; qukeTable[`data] 1];

    usesToMatch : (`$"to match") in qukeTable`token;

    // If a match block is present, use it for the comparison
    mtchBlck: $[not usesToMatch;
                  {1b};
                  quke.translate.function.compile[0b; context; qukeTable[`data] 3]
                  ];

    // If usesToMatch is false, then it is not possible for mtchBlck to be a symbol
    matcher: $[.z.m.axq.isSymbol mtchBlck;
                    mtchBlck;
                    {[mtchBlck;usesToMatch;expectResult]
                        // To Address KXAX-17121, it was desired to be able to format the 
                        // result from an expect in such a way that you could run the test
                        // in the editor and return true if passing but still
                        // be able to report expected and actual results in the quke output.
                        // It is not possible to directly execute a test with a to match
                        // in the editor because the expect and to match blocks must be executed
                        // separately.
                        // The solution is to use the .z.m.qu.compare function.
                        // That function returns a boolean value if the two arguments match,
                        // but return a dictionary of two keys (expect and toMatch) if 
                        // they do not match. 
                        // We check if the result from the expect is this dictionary, and 
                        // use it as the result of this lambda to insert the behaviour 
                        // cleanly into the rest of qcumber.
                        // If the result is not a dictionary with the expected keys
                        // then we run the mtchBlck function.
                        // If there is an explicit to match block then that overrides
                        // this behaviour.
                        if[not[usesToMatch] and .z.m.axq.isDict expectResult;
                            if[`expect`toMatch ~ key expectResult;
                                :expectResult
                                ];
                            ];
                        :`expect`toMatch!(expectResult;mtchBlck[])
                        }[mtchBlck;usesToMatch]
                    ];

    :.z.m.qu.block.metadata.modify[`line;qukeTable[`line] 0]
        .z.m.qu.block.when[qukeTable[`data] 0;
            exptBlck;
            enlist .z.m.qu.block.toMatch["";matcher]]
    }
// @fileOverview Takes individual feature blocks (in the form of tables) and builds the
// appropriate dag node. Line numbers in the "lines" list are used to determine
// which lines in the table form a given block.
// @param context {symbol} the context in the form of a symbol, that each function 
//              must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} the quke message table
// @param spec {#block.dagTree} an empty tree node, used as a placeholder to ensure that a tree 
//              is always found at the edges of the complete tree
// @private
// @returns {#block.dagTree[]} returns a .z.m.qu.feature node
.z.m.qu.quke.translate.feature:{[context;qukeTable;spec]
    :.z.m.qu.block.metadata.modify[`line;qukeTable[`line] 0] 
        .z.m.qu.block.feature[first qukeTable `data; 
            raze quke.translate.blockContents[context;qukeTable;;spec] each 
            quke.translate.parseRows[qukeTable;`featureContents]]
    }


// @fileOverview called by translateTable to build before, after, 
// before each, or after each nodes
// @param context {symbol} the context in the form of a symbol, that
//                  each function must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} 
//                  the portion of the quke message table 
//                  representing a single before, after, before each, 
//                  or after each block
// @param spec {#block.dagTree} an empty tree node, used as a placeholder to 
//                  ensure that a tree is always found at the edges of 
//                  the complete tree
// @private
// @returns {#block.dagTree} returns a dag node
.z.m.qu.quke.translate.featureWrappers:{[context;qukeTable;spec]
    func: quke.translate.function.compile[0b; context; qukeTable[`data] 1];
    firstToken : first qukeTable `token;
    firstLine : qukeTable[`line] 0;
    :$[ `before  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.before func;
        `after  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.after func;
        (`$"skip if")  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.skipIf func;
        (`$"before each")  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.beforeEach func;
        (`$"after each")  = firstToken;
            .z.m.qu.block.metadata.modify[`line;firstLine] .z.m.qu.block.afterEach func;
        //else
            spec
     ]
    }

// @fileOverview translates the table t into a qmin tree, called either by parse 
// or recursively by handleBlockContents or handleShould
// @param context {symbol} the context in the form of a symbol, that each function must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} the quke messaged parsed into a table
// @param spec {#block.dagTree[]} an empty tree node, used as a placeholder to ensure that a tree is 
//             always found at the edges of the complete tree
// @private
// @returns {#block.dagTree[]} returns a list of .z.m.qu.feature nodes
.z.m.qu.quke.translate.file:{[context;qukeTable;spec]   
    tbls: {[qukeTable;lns] select from qukeTable where line in lns}[qukeTable] each quke.translate.parseRows[qukeTable;`feature]; 
    quke.translate.table[context;;spec] each tbls    
    }
// @fileOverview Checks for newlines in a q function block to identify
//               blocks that will fail with compile errors due to no 
//               leading whitespace
// @param function {string}
// @returns {boolean}
.z.m.qu.quke.translate.function.checkNewlines:{[function]
    // Add an string with a space in case this is a single character
    // We have to add a space so that the first line (which previously
    // would have had leading whitespace removed) works
    function : " ",function;

    // Find newlines that are not followed by whitspace
    :not all (first each "\n" vs function) in " \t"
    }
// @fileOverview called by handleExpect or handleBeforeAfterEach, takes the function 
// string of a given q function block converts it to a function using ".z.m.axedi.evaluate"
// @param isExpect {boolean} 1b if the function is an expect block
// @param testContext {symbol} the context for compiling the function
// @param functionStr {string} the function to be compiled
// @private
// @returns {function} the compiled function
.z.m.qu.quke.translate.function.compile:{[isExpect; testContext; functionStr]
    
    if [quke.translate.function.checkNewlines functionStr;
        :`$quke.WHITESPACEMSG];

    functionStr: "{[] ", functionStr, "\n }";
    
    if [isExpect and block.breakOnFail;
        functionStr: quke.i.addErrorOnFail functionStr];
    
    : .[.z.m.axedi.evaluate;
        (functionStr; string testContext);
        {.z.m.axq.asSymbol x}];
    }

// @fileOverview called from translateTable, used to find the line numbers  
// that make up each of the appropriate blocks, as determined 
// by the firstToken using the TABLEPARSINGSPECIFICATIONS dictionary
// @param qukeTable {table (line: long;token: symbol; data: string)} the quke message table that must be parsed for translating
// @param firstToken {symbol} the token corresponding to the first token in the table, 
//                      this is used by the TABLEPARSINGSPECIFICATIONS dictionary to 
//                      determine which sets of tokens to group the entries in the table by
// @private
// @returns {long[][]} returns groupings line numbers that correspond 
//                      to each of the appropriate blocks (list of list of longs)
.z.m.qu.quke.translate.parseRows:{[qukeTable;firstToken]
    :(where qukeTable[`token] in quke.TABLEPARSINGSPECIFICATIONS firstToken) _ qukeTable `line
    }


// @fileOverview Passes the contents of the should block to translate table so that 
// each do and expect block can be translated
// @param context {symbol} the context in the form of a symbol, that each 
//              function must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} the portion of the quke message table representing 
//              a single should block
// @param spec {#block.dagTree} an empty tree node, used as a placeholder to ensure that 
//              a tree is always found at the edges of the complete tree
// @private
// @returns {#block.dagTree[]} returns a .z.m.qu.describe node
.z.m.qu.quke.translate.should:{[context;qukeTable;spec]
    :.z.m.qu.block.metadata.modify[`line;qukeTable[`line] 0] 
        .z.m.qu.block.describe[first qukeTable `data] 
            quke.translate.table[context;;spec] each
                {[qukeTable;lns] select from qukeTable where line in lns}[1_qukeTable] 
                    each quke.translate.parseRows[1_qukeTable;`expect];
    }
// @fileOverview translates the table t into a qmin tree, called either by parse 
// or recursively by handleBlockContents or handleShould
// @param context {symbol} the context in the form of a symbol, that each function must be compiled in 
// @param qukeTable {table (line: long;token: symbol; data: string)} the quke messaged parsed into a table
// @param spec {#block.dagTree[]} an empty tree node, used as a placeholder to ensure that a tree is 
//             always found at the edges of the complete tree
// @private
// @returns {#block.dagTree[]} returns a list of .z.m.qu.feature nodes
.z.m.qu.quke.translate.table:{[context;qukeTable;spec]

    //Looks at the first token in the table to determine how to handle the table
    //In each iteration, a table is taken as input, the table is parsed by 
    //determining which line numbers form a given block
    //and passing those line numbers to handle functions along with the input table 
    //to allow the handle function to 
    //parse the table.
    //Each portion of the parsed table is then passed from the handle function 
    //recursively to this function (translateTable) to build the tree
    firstToken : first qukeTable `token;
    toSkip     : first qukeTable `skip;
    
    blckGrp:$[`feature = firstToken ;
                quke.translate.feature[context;qukeTable;spec];
            `should  = firstToken ;
                enlist quke.translate.should[context;qukeTable;spec];
            `property  = firstToken;
                enlist .z.m.qu.block.metadata.modify[`line;qukeTable[`line] 0]
                    .z.m.qu.block.property[qukeTable[`data] 0;
                        quke.translate.function.compile[0b; context; qukeTable[`data] 1];
                        enlist .z.m.qu.block.check {~[1b] .z.m.qch.success x}];
            `bench = firstToken;
                enlist quke.translate.bench[context;qukeTable;spec];
            `expect  = firstToken;
                quke.translate.expect[context;qukeTable];
            firstToken in `before`after,(`$"skip if"),(`$"before each"), `$"after each";
                enlist quke.translate.featureWrappers[context;qukeTable;spec];
            firstToken in `setup`tolerance`timelimit`replicate`baseline`behaviour`teardown;
                enlist quke.translate.benchContents[context;qukeTable;spec];
            // else
            spec
          ];
    :$[not toSkip;
         blckGrp;
       .z.m.axq.isTable blckGrp;
         .[blckGrp;(::;`item;`skipped);:;1b];
         .[blckGrp;(::;::;`item;`skipped);:;1b]]
    }
// @fileOverview functions blocks that are not expected to return data
.z.m.qu.quke.lint.PREP:`after`before,(.z.m.axq.asSymbol "after each"),(.z.m.axq.asSymbol "before each"),(`$"skip if"),`setup`teardown`behaviour`baseline
// @fileOverview functions blocks that are used for executing tests (used as a linter hint)
// these blocks expect to return a result
.z.m.qu.quke.lint.EXEC:`expect`property, `$"to match"
// @fileOverview An error message to warn of missing whitespace at the start of a q code blocks
.z.m.qu.quke.WHITESPACEMSG:"All lines in q code blocks must have leading whitespace"
// @fileOverview dictionary of what tokens can follow other tokens
.z.m.qu.quke.TOKENSPECIFICATIONS:(!) . flip
   ((`feature    ; `should`before`after`property`bench,(`$"skip if"),(`$"after each"), `$"before each");
    (`should     ; `expect);
    (`bench      ; `timelimit`tolerance`replicate`setup`baseline`behaviour`teardown);
    (`property   ; `function);
    (`expect     ; `function);
    (`$"to match"; `function);
    (`setup      ; `function);
    (`tolerance  ; `function);
    (`timelimit  ; `function);
    (`replicate  ; `function);
    (`baseline   ; `function);
    (`behaviour  ; `function);
    (`teardown   ; `function);
    (`before     ; `function);
    (`after      ; `function);
    (`$"skip if" ; `function);
    (`$"after each" ; `function);
    (`$"before each"; `function))
// @fileOverview the list of qCumber tokens
.z.m.qu.quke.TOKENLIST:`feature`should`expect,(`$"to match"),`property`bench`baseline`behaviour`setup`teardown`timelimit`tolerance`replicate`after`before,(`$"skip if"),(`$"after each"), `$"before each"
// @fileOverview the blocks that may be contained within each qCumber blocks
.z.m.qu.quke.TOKENBLOCKSPECIFICATIONS:(!) . flip
   ((`feature     ; `feature);
    (`should      ; `should`expect,(`$"to match"),`function);
    (`after       ; `after`function);
    (`before      ; `before`function);
    (`$"skip if"  ; (`$"skip if";`function));
    (`bench       ; `bench`setup`tolerance`timelimit`replicate`baseline`behaviour`teardown`function);
    (`property    ; `property`function);
    (`$"before each" ; (`$"before each";`function));
    (`$"after each"  ; (`$"after each";`function)))
// @fileOverview identifies block contents with their levels of nesting within the quke file
.z.m.qu.quke.TABLEPARSINGSPECIFICATIONS:(!) . flip (
    (`feature;          `feature);
    (`featureContents;  `should`property`bench`after`before,(`$"skip if"),(`$"after each"), `$"before each");
    (`expect;           `expect);
    (`bench;            `setup`tolerance`timelimit`replicate`baseline`behaviour`teardown))
    
    
   
// @fileOverview dictionary of tokens that can be skipped, and the real tokens they map to
.z.m.qu.quke.SKIPTOKENS:`xfeature`xshould`xexpect`xproperty`xbench!`feature`should`expect`property`bench
// @fileOverview a dictionary of quke tokens that contain internal whitespace
.z.m.qu.quke.MULTIWORDS:(!) . flip (
    (`$"to match";`to`match);
    (`$"skip if";`skip`if)
    )
// @fileOverview the blocks that may be followed by a function
.z.m.qu.quke.FUNCTIONBLOCKS:`expect,(`$"to match"),`property`behaviour`baseline`after`before,(`$"skip if"),(.z.m.axq.asSymbol "after each"),(.z.m.axq.asSymbol "before each"),`setup`teardown
// @fileOverview the blocks that form the content of the main quke blocks
.z.m.qu.quke.BLOCKCONTENTS:(!). flip
     ((`feature ;`function`should`expect,(`$"to match"),`property`bench`baseline`behaviour`setup`teardown`timelimit`tolerance`replicate`after`before,(`$"skip if"),(`$"after each"), `$"before each");
      (`should  ; `function`expect, `$"to match");
      (`expect  ; `function);
      (`bench   ; `function`baseline`behaviour`setup`teardown`timelimit`tolerance`replicate);
      (`property; `function))
// @fileOverview description of module datatypes
// @private
// @returns {null} 
.z.m.qu.quke.onLoad:{[]

// @typedef specs {table( 
//                       context    : string; 
//                       namespace  : string;
//                       fname      : string;
//                       testID     : guid;
//                       content    : string[] | string)}
//
    
    }

.z.m.qu.quke.onLoad[];
system "d .z.m";

system "d .z.m.qu";
// @fileOverview Runs a set of tests in the appropriate context
// @param testContext {int} the context to run the runners inside
// @param inputRunner {function} the runner that must be run inside of a specific context
// @param spec {#block.dagTree[]} the tree for the tests
// 
// @returns {#runner.matchedBlocks} the results from all tests in a given tree
.z.m.qu.runner.contextual:{[testContext;inputRunner;spec]
    
    currentContext: system "d ";
    
    system "d ", string testContext;
    
    testResults: runner.i.default[inputRunner;spec];

    system "d ", string currentContext;
    
    :testResults

    }
// @fileOverview a default runner. Every runner runs the default runner with a runner 
//                  as input. If the runner is null run .z.m.qu.run, otherwise run the runner
// @param inputRunner {function} the runner that must be run inside of a sandbox
// @param spec {#block.dagTree} a list of trees for a given test
// 
// @returns {#runner.matchedBlocks} the results from all tests in a given tree
.z.m.qu.runner.i.default:{[inputRunner;spec]
    :$[null inputRunner;
        .z.m.qu.block.run[spec] lj `id xkey select id, parents, children from $[0 < count spec; raze spec;.z.m.axds.tree.new[]];
        inputRunner spec]
    }

// @fileOverview Extract the context from the namespace
// @param namespace {symbol} A module name, context, or filepath
// @returns {symbol}
.z.m.qu.runner.i.namespaceToContext:{[namespace]
    
    // The context is taken from the last part of the name that starts with "." 
    parts: reverse "/" vs string namespace;
    : .z.m.axutl.getNS `$parts (parts like ".*")?1b;
    }

// @fileOverview Runs a set of tests inside of the appropriate runners
// @param qualifiedName {string} the full path name of the tests to run, 
//  including the module or folder name to get the context from
// @param spec {#block.dagTree[]} a list of trees for a given test
// @returns {#runner.matchedBlocks} the results from all tests in a given tree
.z.m.qu.runner.main:{[qualifiedName; spec]
    : runner.contextual[runner.i.namespaceToContext `$qualifiedName; ::; spec];
    }


// @fileOverview description of data structures used by the module
// @returns {null} 
.z.m.qu.runner.onLoad:{[]

// @typedef dagTree {table(id: GUID;
//                         parents: GUID[];
//                         children: GUID[];
//                         item: #blocks )}
//
// @typedef dagTreeArray arg {#arg[]}
//    
// @typedef matchedBlocks {table(
//                               null : null;
//                               i_.type: symbol;
//                               i_.extenstions : symbol[];
//                               id: GUID;
//                               name  : symbol;
//                               label: string;
//                               target     :function;
//                               contextual    :boolean;
//                               start      :timestamp;
//                               time     :timespan;
//                               result     :any;
//                               success     :boolean;
//                               error       : any;
//                               aborted     :bool;
//                               events     :dict (error: any; success: any);
//                               metadata   :dict ();
//                               parents : GUID[];
//                               children: GUID[])}
//
// @typedef browserTestResults {table(
//                             fileName  : symbol;
//                             namespace : symbol;
//                             feature: symbol;
//                             block : symbol;
//                             description: string;
//                             expectations: string;
//                             line: long;
//                             success: boolean;
//                             result: any;                  
//                             error: string;
//                             failed: any;
//                             aborted: boolean;
//                             start : timestamp;
//                             time :  timespan;
//                             featureID: GUID;
//                             parameterID: GUID)}
    }
.z.m.qu.runner.onLoad[];
system "d .z.m";

system "d .z.m.qu";
// @fileOverview called by createResultsTableEntry, used to update the results 
// table with the file path
// @param nms {dict (namespace: symbol; fileName: symbol)} the namespace and filename
// @param testResults {#formatter.matchedBlocks} table containing results for a given file
// @private
// @returns {#formatter.updatedBlocks} the results updated with module and file names
.z.m.qu.formatter.filepath:{[nms;testResults]
    
    //Updates the result table with the namespace and fileName
    : update namespace : nms`namespace,
             fileName  : nms`fileName
      from testResults
    }

// @fileOverview used to convert the aborted raw results into a format 
// that can easily be analyzed based on feature
// and used to extract the aborted tests
// @param rtbl {#formatter.updatedBlocks} a table all of the raw data from the quke tests
// @private
// @returns {#formatter.abortTestResults} a table of all the aborted tests
.z.m.qu.formatter.filter.aborted:{[rtbl]

    abrt : select from rtbl where aborted;
    
    abrt: update // Want to ensure line is always long type even if empty
                 line: `long$metadata[;`line],success: 0b, feature: label,
                 parseError: 0b
          from abrt;

    abrt: update featureID: id, parameterID: id from abrt;
    
    abrt: delete i_.type, i_.extensions, id, contextual, events, 
                         parents, children, label, name, target, parents
                  from abrt;
    
    abrt: update feature: .z.m.axq.asSymbol feature, 
                         block:`Aborted, 
                         description:enlist "abort",
                         expectations: enlist "NA" 
                  from abrt;
    
    :abrt
    }
// @fileOverview called by i.runFiles, used to convert the raw results into a format 
// that can easily be analyzed based on feature
// and used to extract the failed after blocks
// @param rtbl {#formatter.updatedBlocks} a table all of the raw data from the quke tests
// @private
// @returns {#formatter.abortTestResults} a table of all the after blocks that failed
.z.m.qu.formatter.filter.after:{[rtbl]

    //Log any errors in after blocks, which will not affect the test results, but indicate an error in the test
    afterErrors: select from rtbl where name = `after, .z.m.axq.isString each error;
    
    afterErrors: update parents: raze parents,
                        // Want to ensure line is always long type even if empty
                        line: `long$metadata[;`line],
                        parseError: 0b
                 from afterErrors;
    
    //Format the error message for the after blocks that threw errors
    errorMessages: {"abort in after block due to error of type \"",(.z.m.axq.asString x 0),"\""} each .z.m.axq.asSymbol[afterErrors `error],'afterErrors `line;
 
    afterErrors: update error: errorMessages
                 from afterErrors;
    
    featureResults: select feature:label, parents:id
                    from rtbl 
                    where name = `feature; 
    
    afterErrors: afterErrors lj `parents xkey featureResults; 
    
    afterErrors: update featureID: parents, parameterID: id,
                        feature: .z.m.axq.asSymbol feature, expectations: enlist"NA", 
                        date:{.z.d} each afterErrors,
                        error, block:`After, description:enlist "after", 
                        success: 0b from afterErrors;
    
    :afterErrors

    }

// @fileOverview used to convert the bench raw results into a format that can easily be 
// analyzed based on feature and used to extract the failed bench tests
// @param rtbl {#formatter.updatedBlocks} a table all of the raw data 
//                  from the quke tests
// @private
// @returns {#formatter.benchTestResults} a table of all the bench tests
.z.m.qu.formatter.filter.bench:{[rtbl]

    //create individual tables containing the bench, behaviour, baseline, and feature columns 
    //  and the IDs necessary for joining them
    benchList: select testID, id,bench:label,parents: raze parents,namespace,fileName,
                      // Want to ensure line is always long type even if empty
                      line: `long$metadata[;`line],
                      aborted, skipped, metadata, parseError: 0b
               from rtbl 
               where name = `bench;
    baselineList:  select baseline:label, baselineError:{raze string x} each error,id:raze parents,
                          startBaseline: start, timeBaseline:.z.m.axq.asTimespan metadata[;`avgTime], resultBaseline: result
                   from rtbl 
                   where name = `baseline;
    behaviourList: select behaviour:label, behaviourError:{raze string x} each error,id:raze parents,success,metadata ,
                          startBehaviour: start, timeBehaviour:.z.m.axq.asTimespan metadata[;`avgTime], resultBehaviour: result
                   from rtbl 
                   where name = `behaviour;
    timelimitList: select id:raze parents, metadata from rtbl where name = `timelimit;
    timelimitList: select id, timelimit: .z.m.axq.parseLong (timelimitList)[`metadata][;`timelimit] from timelimitList;
    
    featureList: select feature:label, parents:id 
                 from rtbl 
                 where name = `feature;
    
    //join the baseline, behaviour, and feature tables to the bench table
    benchList: benchList lj `id xkey baselineList;
    benchList: benchList lj `id xkey behaviourList;
    benchList: benchList lj `id xkey timelimitList;
    benchList: benchList lj `parents xkey featureList;
    
    //update the table with the results for each bench test held in the metadata

    benchList : update passedBaseline: (benchList)[`metadata][;`passedBaseline], 
                       passedTimeLimit: (benchList)[`metadata][;`passedTimeLimit], 
                       passedLowerTolerance: (benchList)[`metadata][;`passedLowerTolerance], 
                       passedUpperTolerance: (benchList)[`metadata][;`passedUpperTolerance]
                from benchList;
   
    benchList: update featureID: parents, parameterID: id from benchList;
    
    benchList : delete id, parents from benchList;

    //Update the baseline error for situations where there was no baseline block
    benchList: update baselineError: ("",/:baselineError) from benchList;
    // Update the baseline description for situations where there was not baseline block
    benchList: update baseline:("",/:baseline) from benchList;
    
    benchList: update block:`Bench, feature: .z.m.axq.asSymbol feature, description:bench, 
                      start:startBehaviour, time:timeBehaviour, 
                      result:([] baseline;behaviour;baselineError;behaviourError;passedBaseline;passedTimeLimit;passedLowerTolerance;
                                 passedUpperTolerance;%[;1000000] .z.m.axq.asLong timeBehaviour; %[;1000000] .z.m.axq.asLong timeBaseline;timelimit), 
                      error: (trim') (raze') (baselineError,'" ",'behaviourError), //note this error message format is somewhat diffucult to parse (since it doesn't explicitely say
                                                                        //which is the baseline and/or behaviour error. To find the actual errors from the table check the result column
                                                                        //This could be easily changed if desired, but I wasn't sure if the extra storage space was worth it
                      expectations: enlist"NA"
               from   benchList;
    
    :benchList
    
    }

// @fileOverview used to convert the expect raw results into a format 
// that can easily be analyzed based on feature
// and used to extract the failed expect tests
// @param rtbl {#formatter.updatedBlocks} a table all of the raw data from the quke tests
// @private
// @returns {#formatter.expectTestResults} a table of all the expect tests
.z.m.qu.formatter.filter.expect:{[rtbl]

    //find all feature, describe, when, and expect blocks 
    shouldResults: select should:label, parents:id, shouldParents: raze parents
                   from rtbl 
       where name = `describe; 
    featureResults: select feature:label, shouldParents:id
                    from rtbl 
                    where name = `feature; 

    fmTbl: select testID, expectations:label, id, start, 
                  time, aborted, skipped, parseError: 0b, 
                  parents: raze parents, children, expResult:result,
                  // Want to ensure line is always long type even if empty
                  line: `long$metadata[;`line], namespace, fileName, error
           from rtbl 
           where name = `when; 
    expectResults: select success, children:enlist each id
                   from rtbl 
                   where name = `expect;

    toMatchResults: select id, toMatchError: error, toMatchResult:result, children from rtbl where name = `toMatch;
    toMatchResults : update children: enlist each id from toMatchResults lj `children xkey expectResults;

    //join the when blocks to the describe, expect, and feature blocks using their id's 
    fmTbl: fmTbl lj `parents xkey shouldResults; 
    fmTbl: fmTbl lj `children xkey toMatchResults;
    fmTbl: fmTbl lj `shouldParents xkey featureResults;

    fmTbl: update featureID: shouldParents, parameterID: parents from fmTbl;

    fmTbl: delete id, parents, children, shouldParents from fmTbl;

    fmTbl: update feature: .z.m.axq.asSymbol feature, block:`Should, description:should from fmTbl;

    // If there was an error in the toMatch block then retrieve construct the result dictionary
    fmTbl: update result: `expect`toMatch!/: flip (expResult;toMatchResult) from fmTbl where skipped or not toMatchError ~\: `;
    // Otherwise the toMatch result is the correct result dictionary
    fmTbl: update result: toMatchResult from fmTbl where not skipped, toMatchError ~\: `;

    // Errors can happen in two locations, either in the expect block or the toMatch block
    // If errors happen in both, or an error occurs in one and the other returns null, 
    // then the final test will return true because nulls will toMatch
    // As such, this test verifies that no errors occurred
    fmTbl: update success : 0b from fmTbl where not (` ~/: error) and ` ~/: toMatchError;
    fmTbl[`error`toMatchError] : .z.m.axq.asString each fmTbl `error`toMatchError;

    // Add errors to the result so that they may be distinguished
    // These flips are used to ensure it works even when there is no data
    fmTbl[`result] : flip flip[fmTbl `result],`expectError`toMatchError!fmTbl`error`toMatchError;
    fmTbl : delete toMatchError from update error: (trim') (error,'" ",'toMatchError) from fmTbl;

    // If the test was successful, we replace the result for both expect and toMatch with (::)
    // That way we reduce the amount of unnecessary data being stored
    successLoc : where fmTbl`success;
    fmTbl : delete expectResult, toMatchResult from .[fmTbl;(successLoc;`result;`expect`toMatch);:;(::)];

    :fmTbl
    }
// @fileOverview used to convert the property raw results into a format 
// that can easily be analyzed based on feature
// and used to extract the failed property tests
// @param rtbl {#formatter.updatedBlocks} a table all of the raw data from the quke tests
// @private
// @returns {#formatter.propertyTestResults} a table of all the property tests
.z.m.qu.formatter.filter.property:{[rtbl]

    // There are helps three error cases that could cause the property block to fail:
    //  1. The property block q function executed correctly, but it was not a valid .qch function
    //      and returned an invalid .qch dict (or did not return a dictionary). In this case
    //      we report a "QuickCheck format error".
    //  2. The property block q function threw an error outside of a .qch function call.
    //      In that case we report the actual error.
    //  3. The property block had a valid qch function and executed correctly, but an error was
    //      thrown in the .qch function that was caught by .z.m.qch. This is reported in the error
    //      key of the .qch dict and the specific error is reported by qcumber.
    // he hadError column indicates that an error was encountered while executing the 
    // property q function block and helps differentiate the above three cases.
    rtbl : update hadError: not ` ~/: error from rtbl;

    //create individual tables containing the bench, behaviour, baseline, and feature columns 
    //and the IDs necessary for joining them
    propertyList: select testID, id,property:label,parents: raze parents,result, error: {raze string x} each error, hadError,
                         // Want to ensure line is always long type even if empty
                         namespace,fileName,line: `long$metadata[;`line],start,time, aborted, skipped, metadata, parseError: 0b
                  from rtbl 
                  where name = `property;
    checkResults: select success, id:raze parents
                   from rtbl where name in `check;
    featureResults: select feature:label, parents:id 
                    from rtbl where name = `feature;

    //join the property, check and feature blocks
    propertyList: propertyList lj `id xkey checkResults;
    propertyList: propertyList lj `parents xkey featureResults;

    //Differentiate between runtime errors and errors in QuickCheck formatting
    propertyList[`metadata] : {x[`metadata], enlist[`formatError]!(,)0b} each propertyList;
    
    propertyList: update result: {`output`formatError`failed!(x;0b;())} each result from propertyList;
    
    //If the return type is a dictionary, then it may not be a proper .z.m.qch.check return dictionary. To attempt to determine if it is, the columns of the 
    //dictionary are compared to a proper .z.m.qch.check result dictionary (created below). Obviously, it is possible to trick this rule if the correct
    //dictionary were created
    //change the runtimes of QuickCheck to prevent accidentally taking a long time to run
    quickCheckColumns: cols .z.m.qch.check .z.m.qch.with.times[1] .z.m.qch.forall [.z.m.qch.g.int[]]{x=x};
    
    //There are two situations where the QuickCheck statement might not be formatted correctly: either the resutlt is not a dictionary (.z.m.qch.check returns a dictionary)
    // or it is the wrong type of dictionary. Below the table is updated to reflect situations where the return value is not a dictionary
    fErrs: not {[r;c] $[99h ~ type r;c ~ key r;0b]}[;quickCheckColumns] each propertyList[`result][;`output];
    
    // If the returned structure does not have the correct format as a quick-cheq evaluation, then we mark a format error as having occurred
    // (even if the cause was a q error)
    // This makes the console output clearer by allowing differentiation of errors occuring in quick-cheq blocks (which are associated with a counter-example)
    //  with those that are not associated.
    propertyList: update result: .[;(::;`formatError);:;1b] result from propertyList where fErrs, not skipped;
    // We only update the error message to explicitely indicate an error if there is no pre-existing error message
    propertyList: update error:{"QuickCheck format error"} each line from propertyList where fErrs, not skipped, not hadError;
    
    hasShrunk: {$[not 99h ~ type x; 0b; not `shrunk in key x;0b;not .z.m.axq.isDict x `shrunk; 0b; `arb in key x`shrunk]} each propertyList[`result][;`output];
    
    propertyList : update result: .[result;(::;`failed);:;.[result;(::;`output;`shrunk;`arb)]] from propertyList where hasShrunk, not result[;`formatError], not skipped;
    
    propertyList : update result: .[result;(::;`failed);:;.[result;(::;`output;`failed)]] from propertyList where not hasShrunk, not result[;`formatError], not skipped;

    propertyList: update featureID: parents, parameterID: id from propertyList;
    propertyList: delete id, parents from propertyList;

    //Add QuickCheck errors to the table
    propertyList: update error: {.z.m.axq.asString x`error} each result[;`output] from propertyList where
                        not hadError,
                        not skipped,
                        not result[;`formatError],
                        {`error in key x} each result[;`output], 
                        not (::) ~/: result[;`output;`error];

    propertyList: update feature: .z.m.axq.asSymbol feature, block:`Property, 
                       description:property,expectations: enlist "NA" from propertyList;

    :delete hadError from propertyList
    }
// @fileOverview used to convert the raw results into a format that can easily be analyzed 
// based on feature and used to extract the failed expect tests; used to combine
// for all types of blocks (expect, bench, property) as well as aborted tests               
// @param rtbl {#formatter.updatedBlocks} a table all of the raw data from the quke tests
// @private
// @returns {#formatter.testResults} a table of all the tests
.z.m.qu.formatter.generic:{[rtbl]

    //The list of columns
    resultColumnList: cols formatter.genericSchema;
    
    //Select all of the columns
    groupedResults: raze ?[;();0b;resultColumnList!resultColumnList] each 
        formatter.filter[`bench`expect`property`aborted`after] @\: rtbl;
    
    :`namespace`fileName`testID`line xasc groupedResults
    }

// @fileOverview the generic quke schema

.z.m.qu.formatter.genericSchema:flip (!) . flip (
    (`namespace;enlist`);
    (`fileName;enlist`);
    (`feature;enlist`);
    (`block;enlist`);
    (`description; enlist "");
    (`expectations;enlist "");
    (`line;enlist 0Nj);
    (`success;enlist 0b);
    (`result;enlist (::));
    (`error;enlist "");
    (`aborted;enlist 0b);
    (`skipped;enlist 0b);
    (`parseError;enlist 0b);
    (`start;enlist 0Np);
    (`time;enlist 0Nn);
    (`testID;enlist 0ng);
    (`featureID;enlist 0ng);
    (`parameterID;enlist 0ng)
    )
// @fileOverview the schema for the build

// c          | t f a
// -----------| -----
// date       | d    
// moduleName | s    
// fileName   | s    
// feature    | s    
// block      | s    
// description| C    
// line       | j    
// success    | b    
// result     | X    
// error      | s    
// aborted    | b    
// start      | p    
// time       | n 

.z.m.qu.formatter.buildSchema:flip (!) . flip (
    (`date; enlist 0Nd);
    (`moduleName;asc enlist`);
    (`fileName;enlist`);
    (`feature;enlist`);
    (`block;enlist`);
    (`description; enlist "");
    (`line;enlist 0Nj);
    (`success;enlist 0b);
    (`result;enlist `byte$());
    (`error;enlist `);
    (`aborted;enlist 0b);
    (`skipped;enlist 0b);
    (`start;enlist 0Np);
    (`time;enlist 0Nn);
    (`version;enlist `)
    )
// @fileOverview description of data structures used by the module
// @private
// @returns {null} 
.z.m.qu.formatter.onLoad:{[]

// @typedef testResults {table(
//                             namespace       : symbol;
//                             fileName        : symbol;
//                             feature         : symbol;
//                             block           : symbol;
//                             description     : string;
//                             expectations    : string;
//                             line            : long;
//                             success         : boolean;
//                             result          : any;                 
//                             error           : string;
//                             aborted         : boolean;
//                             skipped         : boolean;
//                             parseError      : boolean;
//                             start           : timestamp;
//                             time            : timespan;
//                             testID          : GUID;
//                             featureID       : GUID;
//                             parameterID     : GUID)}
//
// @typedef expectTestResults {table(
//                                 feature: string;
//                                 should : string;
//                                 expectations: string;
//                                 whenTarget  : function;
//                                 expectTarget: function;
//                                 start : timestamp;
//                                 time :  timespan;
//                                 result: boolean;
//                                 success: boolean;
//                                 error: string;
//                                 aborted: boolean;
//                                 fileName: symbol;
//                                 namespace: symbol;
//                                 line: long;
//                                 testID: GUID;
//                                 featureID: GUID;
//                                 parameterID: GUID)}
//
// @typedef abortTestResults {table(
//                               feature: symbol;
//                               start : timestamp;
//                               time :  timespan;
//                               result: null;
//                               success: boolean;
//                               error: string;
//                               aborted: boolean;
//                               fileName: symbol;
//                               namespace: symbol;
//                               line: long;
//                               testID: GUID;
//                               featureID: GUID;
//                               parameterID: GUID)}
//
// @typedef benchTestResults {table(
//                              feature: string;
//                              namespace : symbol;
//                              fileName: symbol;
//                              bench  : string;
//                              line: long;
//                              aborted: bool;
//                              success: bool;
//                              baseline     :string;
//                              behaviour    :string;
//                              baselineError      :string;
//                              behaviourError     :string;
//                              passedBaseline     :bool;
//                              passedTimeLimit     :bool;
//                              passedLowerTolerance     :bool;
//                              passedUpperTolerance     :bool;
//                              startBaseline: timestamp;
//                              timeBaseline: timespan;
//                              startBehaviour: timestamp;
//                              timeBehaviour: timespan;
//                              resultBaseline: #any;
//                              resultBehaviour: #any;
//                              testID: GUID;
//                              featureID: GUID;
//                              parameterID: GUID)}
//
// @typedef propertyTestResults {table(
//                                  fileName: symbol;
//                                  namespace: symbol;
//                                  feature: symbol;
//                                  property : string;
//                                  line: long;
//                                  success: boolean;
//                                  result: #any;                 
//                                  error: string;
//                                  checkError: string;
//                                  aborted: boolean;
//                                  start : timestamp;
//                                  time :  timespan;
//                                  testID: GUID;
//                                  featureID: GUID;
//                                  parameterID: GUID)}
//
// @typedef matchedBlocks    {table( 
//                               null : null;
//                               i_.type: symbol;
//                               i_.extenstions : symbol[];
//                               id: GUID;
//                               name  : symbol;
//                               label: string;
//                               target     :function;
//                               contextual    :boolean;
//                               start      :timestamp;
//                               time     :timespan;
//                               result     : #any;
//                               success     :bool;
//                               error       : #any;
//                               aborted     :bool;
//                               events     :dict (error: #any; success: #any);
//                               metadata   :dict ();
//                               parents : GUID[];
//                               children: GUID[])}
//
// @typedef updatedBlocks    {table(
//                               null : null;
//                               i_.type: symbol;
//                               i_.extentions : symbol[];
//                               id: GUID;
//                               name  : symbol;
//                               label: string;
//                               target     :function;
//                               contextual    :boolean;
//                               start      :timestamp;
//                               time     :timespan;
//                               result     :#any;
//                               success     :bool;
//                               error       : string | symbol;
//                               aborted     :bool;
//                               events     :dict (error: #any; success: #any);
//                               metadata   :dict ();
//                               parents : GUID[];
//                               children: GUID[];
//                               namespace: symbol;
//                               fileName: symbol)}

    }

.z.m.qu.formatter.onLoad[];
system "d .z.m";

system "d .z.m.qu";
// @fileOverview Create a more verbose string for failed bench tests
// @param indent {String} A whitespace prefix
// @param result {dict} The failing test result
// @returns {string} More verbose string
.z.m.qu.stdout.bench:{[indent; result]
    indent: "\n", indent;
    s: "";
    
    if[not result`passedTimeLimit;
        s,: indent, "time limit was ", string[result`timelimit], " ms"];
    
    if[not result`passedBaseline;
        s,: indent, "baseline time was ", string[result`timeBaseline], " ms"];
    
    if[not result`passedLowerTolerance;
        s,: indent, "failed lower tolerance"];
    
    if[not result`passedUpperTolerance;
        s,: indent, "failed upper tolerance"];
    
    : s;
    }

// @fileOverview Colour an output string
// @param colour {symbol} The colour to make the string - see .z.m.axstr.i.COLOURS
// @param str    {string} The string to colourize
// @returns {string} The string with colourizing characters
.z.m.qu.stdout.colour:{[colour; str]
    : $[.z.m.qu.i.COLOURIZE;
        .z.m.axstr.colour[colour] str;
        str];
    }
// @fileOverview Create a more verbose string for failed property tests
// @param indent {String} A whitespace prefix
// @param result {dict} The failing test result
// @returns {string} More verbose string
.z.m.qu.stdout.property:{[indent; result]
    final : result`output;
    
    // Print the number of runs
    s : indent, .z.m.axlocalize.t(`.qch_failed1;final`runs);
    
    // Print the error if present
    if [not .z.m.axq.isNull final`error;
        s,: "\n",indent,.z.m.axlocalize.t[`.qch_error], raze .Q.s2 final`error];
    
    // Defined the function that prints args
    f: {[indent; args; index]
        m: "\n",indent, "[",(string index),"]: ", .Q.s1 args index;
        // Truncate very long messages
        : $[100 < count m; (99#m),"..."; m];
        } indent;
    
    // Print the reduced case if available, otherwise just the items that failed
    $[not .z.m.axq.isNull shr: final`shrunk;
        [
            s,: "\n", indent, .z.m.axlocalize.t (`.qch_shrunk;shr`iters);
            s,: raze f[shr`arb] each til count shr`arb;];
        [
            s,: "\n", indent, .z.m.axlocalize.t`.qch_counterExample;
            s,: raze f[final`failed] each til count final`failed]];
    
    : s;
    }

// @fileOverview Create a formatted string for a single test result
// @param isJUnit  {boolean} 1b is this is being called by the JUnit writer
// @param result   {dict}    The test result 
// @returns {string} Formatted string
.z.m.qu.stdout.test:{[isJUnit; result]
    
    depth:  $[isJUnit; 0; 12];
    indent1: depth#" ";
    indent2: (depth + 4)#" ";
    
    stringify: {[x]
        original: system "c";
        system "c 20 100";
        output: .z.m.axedi.toString x;
        system "c ", " " sv string original;
        output
        };
    
    // When errorsAsFailures is set, the error column is called "failure"
    errorKey: $[`error in cols result; `error; `failure];

    // print success or fail
    prefix: $[isJUnit; (); enlist "- " , $[result`skipped; "skip"; result`success; stdout.colour[`green] "pass"; stdout.colour[`red] "fail"]];
    s: indent1 , " | " sv prefix , {$[10h ~ type x; enlist x; x]}
        $[  `Should~result`block;
                "(expect) ", result[`expectations],
                    // Omit the Expected/Actual blocks if they are 0b and 1b, as this
                    // will usually be the case for failing tests written without .z.m.qu.compare,
                    // and it would add visual noise without adding useful information.
                    $[  ((result . `result`expect) ~ (result . `result`toMatch)) or
                        (not result[errorKey] ~ "") or
                        (0b ~ result . `result`expect) and 1b ~ result . `result`toMatch;
                        "";
                        "\n" , "\n" sv indent2 ,/: "\n" vs
                            ("Actual Result:\n" , stringify result . `result`expect) ,
                            ("\nExpected Result:\n" , stringify result . `result`toMatch)];
            `Property~result`block;
                $[result[`result; `formatError]; (); string[result[`result;`output;`runs]], " runs"];
            `Bench~result`block;
                string[result[`result;`timeBehaviour]], " ms";
            // else
                ()];
    
    // If the block errored, print the error and line number
    s,: raze {[isJUnit;indent2;result;k]
        s: "";
        if [(k in key result) & not "" ~ result k;
            s,: "\n" , $[isJUnit; ""; indent2,"error: "],result k;
            if [not null result`line; s ,: " (line ",string[result`line],")"]];
        : s;
        }[isJUnit;indent2;result] each `error`failure;
    
    // be a bit more verbose for property and bench tests that fail
    if[(`Property~result`block) and not result`success;
        if[not result[`result;`formatError];
            s,:"\n", stdout.property[$[isJUnit; ""; indent2]; result`result]]];
    
    if[(`Bench~result`block) and not result`success;
        s,: stdout.bench[$[isJUnit; ""; indent2]; result`result];
        ];
    
    // Trim a possible leading newline
    : {$[x like "\n*"; 1 _ x; x]} s
    }
system "d .z.m";

system "d .z.m.qu";
// @fileOverview Report all `error` events as `failure` events in the generated XML
// @param results {table | dict} qcumber results
// @returns {table} updated qcumber results to pass to `toJunit`
.z.m.qu.junit.errorsAsFailures:{[results]
    if [99h~type results;
        results: results`allTestResults];
    : enlist[`error] _ update failure:error from results
    }

// @fileOverview generates a class name for the fileName - feature pair
// @param x {dict}
// @returns {string}
.z.m.qu.junit.i.classname:{[x]
    // "" is dropped to avoid the awkward looking "filename." classname if there's an error
    // loading the source files, and x`feature is empty.
    ssr[;" ";"_"] "." sv (string distinct (` sv -1_` vs x`fileName) , x`feature) except enlist ""
    }

// @fileOverview Replace escape characters that act as delimiters in xml
// @param xml {string}
// @returns {string}
.z.m.qu.junit.i.escapeXML:{[xml]
    if [not 10h = type xml;
        : xml];
    
    : ssr/[xml; "&<>\"'"; "&",/:("amp";"lt";"gt";"quot";"apos"),\:";"]
    }
// @fileOverview Stringify timestamps as seconds with ms precision.
// @param timespan {timespan}
// @returns {string}
.z.m.qu.junit.i.formatTimespan:{[timespan]
    string .001 * ceiling (`float$timespan) % 1000000
    }

// @fileOverview Convert a set of qcumber results to a tree
// @param results {table}
// @returns {any[]} A tree of (tag; attribute; children) tuples
.z.m.qu.junit.i.toDict:{[results]

    // When errorsAsFailures is set, the error column is called "failure",
    // and all errors must be returned using <failure> tags
    errorKey: $[`error in cols results; `error; `failure];
    
    formatResult: {[errorKey; x]
        name: $[junit.useDeprecatedFormat or `Should <> x `block;
            x`description;
            " " sv (x`description; "| expect"; x`expectations)];

        attributes: `classname`name`time!(junit.i.classname x; name; junit.i.formatTimespan x`time);

        isError: not x[errorKey] ~ "";
        isFailure: not x[`success] or isError;
        
        // If a testcase has both a failure and an error tag, only the failure is shown in Azure DevOps,
        // so the messages are merged.
        failureMsg: $[x`success;
                "";
            isError and isFailure;
                x[errorKey] , "\n" , stdout.test[1b; x];
            // isError xor isFailure
                stdout.test[1b; x]];
            
        // Azure DevOps doesn't show newlines in the attributes,
        // so the message must also be repeated in the stack trace.
        // Note: A test can be marked as skipped and erroring if loading the source fails, so "skipped" must come last
        child: $[isError;     enlist (errorKey; `message`type!(failureMsg; "Error"); enlist failureMsg);
                 isFailure;   enlist (`failure; `message`type!(failureMsg; "Failure"); enlist failureMsg);
                 x`skipped;   enlist (`skipped; ()!(); ());
                              ()];
        
        (`testcase; attributes; child)
        } errorKey;

    // Attributes for test run
    attributes: (!) . flip (
        (`errors;    sum not results[errorKey] ~\: "");
        (`failures;  sum not results`success);
        (`hostname;  .z.h);
        (`name;      first results`namespace);
        (`tests;     count results);
        // Skipped tests are reported with the attribute "skipped" in JUnit4, and "disabled" in JUnit5
        (`skipped;   sum results `skipped);
        (`disabled;  sum results `skipped);
        (`time;      junit.i.formatTimespan sum results `time);
        (`timestamp; .h.iso8601 .z.p));
    
    (`testsuite; attributes; formatResult each results)
    }

// @fileOverview Convert a set of qcumber results to a junit XML string
// @param results {table | dict} 
// @returns {string} junit xml
//
// @example Convert qu results to junit
// "\n" vs .z.m.qu.junit.toJunit .z.m.qu.runTestFolder`.z.m.qu.block.test
//
// "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>"
// "<testsuite errors=\"0\" failures=\"0\" hostname=\"ben.firstderivatives.com\" name=\".z.m.qu.block.test\" tests=\"75\" skipped=\"0\" disabled=\"0\" time=\"0\" timestamp=\"2022-06-06T20:31:06.373682000\">"
// "<testcase classname=\"after\" name=\"return an after block | expect a tree\" time=\"0.001\"/>"
// "<testcase classname=\"after\" name=\"return an after block | expect the correct block type\" time=\"0.001\"/>"
// "<testcase classname=\"after\" name=\"return an after block | expect the correct target\" time=\"0.005\"/>"
// "<testcase classname=\"afterEach\" name=\"return an afterEach block | expect a tree\" time=\"0.001\"/>"
// ... 
.z.m.qu.junit.toJunit:{[results]
    if [99h~type results;
        results: results`allTestResults];
    
    toXML: {[element]
        if [10 = type element;
            : junit.i.escapeXML element];
        
        tag: string element 0;
        attributes: element 1;
        children: element 2;

        // write out junit xml
        props:  " "sv"=" sv' flip (::;{"\"",junit.i.escapeXML[x],"\""}')@'(raze string@)@''(key;value)@\:attributes;
        head:   "<",tag," ",props,$[count children; ">\n"; "/>"];
        inner:  "" sv .z.s each children;
        end:    $[count children; "</",tag,">"; ""];
        : head,inner,end,"\n"
        };
    
    : "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n" , toXML junit.i.toDict results;
    }
// @fileOverview Original qcumber junit format, where testcase name="should", 
// instead of name="should | expect"
.z.m.qu.junit.useDeprecatedFormat:0b
system "d .z.m";

system "d .z.m.qu";
// @fileOverview Compares two values such that the actual vs. expected values can be included in qcumber results
// @param actual {any} The output being tested
// @param expected {any} The reference value
// @returns {boolean | dict (expect : any; toMatch : any)} 1b if the inputs match,
//      or a dictionary of the actual and expected results if they differ
.z.m.qu.compare:{[actual;expected]
    :$[actual ~ expected;
        1b;
        `expect`toMatch!(actual;expected)
        ]
    }
// @fileOverview Returns a filepath without the filename, to use as a "namespace" in the output.
// @param filepath {string} A qualified file path
// @returns {symbol}
.z.m.qu.getNamespace:{[filepath]
    `$"/" sv -1 _ "/" vs filepath
    }

// @fileOverview find the test file content from its name
// @param name {string} the name of the file
// @returns {table ( filename: symbol; namespace: symbol; content: string[])}
// @private
.z.m.qu.getSpecFromFileName:{[name]
    ([]
        fileName  : enlist `$last "/" vs name;
        namespace : enlist getNamespace name;
        fname     : enlist `$name;
        content   : enlist read0 hsym `$name)
    }

// @fileOverview called by runQukeTest, if the input was a string, convert it to a table 
// that can be interpreted by the parser
// @param folderPaths {string[]} a list of strings representing each folder to test
// @returns {#specs} a table of the specs
// @private
.z.m.qu.getSpecsFromFolderNames:{[folderPaths]

    folderPaths : .z.m.axq.asList .z.m.axq.asSymbol folderPaths;
    fileList    : raze (string[folderPaths],\:"/"),/:' string key each hsym folderPaths;
    fileList    : fileList where fileList like "*.quke"; /dnl
    
    // Build a table from folder names that qumin (the same format used to read files using objectIDs)
    :([] fileName:(); namespace:(); fname:(); content:()),
        raze getSpecFromFileName each fileList
    }
// @fileOverview called by i.runFiles, run the tests and returns a table containing 
// all of the raw results
// @param qukeTrees {dict (key: string; value: #block.dagTree)} the key is the filename of the tree, and the 
//              value is the translated tree
// @param fnameMap {dict (key: guid; value: dict (namespace: symbol; fileName: symbol; context: symbol))} a mapping of guids to fnames
// @private
// @returns {#.z.m.qu.formatter.updatedBlocks} a table of all of the results from qumin
.z.m.qu.i.createResultsTable:{[qukeTrees;fnameMap]
    : raze i.createResultsTableEntry[;qukeTrees;fnameMap] each key qukeTrees;
    }
// @fileOverview called by createResultsTable, used to run individual tests
// @param treeKey {guid} the key of the dictionary for the current test
//                  to be run by .z.m.qu.runner.contextRunner
// @param qukeTrees {dict (key: string; value: #block.dagTree)} the key is the filename of the tree, 
//                  and the value is the translated tree
// @param fnameMap {dict (key: guid; value: dict (namespace: symbol; fileName: symbol; context: symbol))} a mapping of guids to fnames
// @private
// @returns {#.z.m.qu.formatter.updatedBlocks} a table containing results for a given file
.z.m.qu.i.createResultsTableEntry:{[treeKey;qukeTrees;fnameMap]
    
    // Show the current filename if the debugger will open on errors or failures,
    // so the user can tell which test they are in
    if [.z.m.qu.block.breakOnErrors or .z.m.qu.block.breakOnFail;
        .z.m.qu.block.print "/" sv string first each fnameMap[treeKey] `namespace`fileName];
    
    : update testID: treeKey from .z.m.qu.formatter.filepath[first each fnameMap treeKey] .z.m.qu.runner.contextual[first @[;`context] fnameMap treeKey;::] qukeTrees treeKey
    }
// @fileOverview Format the parse errors into the generic schema
// @param qkTr {dict (key: guid; value: (table | (symbol; (string;long)[])))} 
// @param fls {table} 
// @private
// @returns {table} the table of parse errors
.z.m.qu.i.parseErrors:{[qkTr;fls]

    qkErr : (where `error ~/: first each qkTr) # qkTr;
    
    // Only report the first error
    qkErr: first each last each qkErr;
    
    :1_.z.m.qu.formatter.genericSchema uj
        select fileName, namespace, testID, parseError: 1b,
               line: .[;(::;1)] qkErr testID, error: .[;(::;0)] qkErr testID,
               start: .z.p, time: .z.m.axq.asTimespan 0 from fls where testID in key qkErr
    }

// @fileOverview called by i.runFiles on each entry in the spec table to parse the 
// test into a tree
// @param tsts {#specsCtx} a row of the spec table, containing a single test
// @param sts {#ty.userSettings} the settings for running qcumber
// @private
// @returns {#block.dagTree} the quke file parsed into a tree
.z.m.qu.i.parserProxy:{[tsts;sts]
    : .z.m.qu.quke.parser[first tsts`context; tsts `content; sts]
    }
// @fileOverview Reformats results from programmatically running quke files
// @param res {table} the results table
// @private
// @returns {#results}
.z.m.qu.i.reformat:{[res]
    
    res  : delete featureID, parameterID, testID from res;
    fld  : select from res where success = 0b, not skipped, not parseError;
    skpd : select from res where skipped;
    prEr : select from res where parseError; 

    prsRs : (string[prEr`namespace],'"/",/:string[prEr`fileName],'" Error: ",/:prEr[`error],'" [line #",/:string[prEr`line],\:"]");
    
    :`allTestResults`allFailedTestResults`allSkippedTestResults`parseErrorList!(res;fld;skpd;prsRs)
    }
// @fileOverview called by runQukeTest, used to run the tests
// @param fls {#.z.m.qu.specs} a table containing namespace, 
//  fileName, and the content of the quke files to be run
// @param sts {#ty.userSettings} the settings for running qcumber
// @private
// @returns {#formatter.testResults} 
.z.m.qu.i.runFiles:{[fls; sts]
    
    sts : settings.create sts;
    
    // Initialise all of the table results to empty lists in all files are malformed    
    tstRs : .z.m.qu.formatter.genericSchema;
    
    // There must be at least one file
    if [count fls;
        fls   : update context: .z.m.qu.runner.i.namespaceToContext each namespace from fls;
        
        // create a parsed tree for each quke file        
        qukeTrees : {x,(enlist first y`testID)!enlist .z.m.qu.i.parserProxy[y;z]}[;;sts] over enlist[()], fls;
        fnameMap : select namespace, fileName, context by testID from fls;

        // Find tests with parse errors (a string is returned if a parse error is detected). 
        tstRs: tstRs, .z.m.qu.i.parseErrors[qukeTrees;fls];
        
        // remove trees with parse errors (these were strings)
        qukeTrees : (where not `error ~/: first each qukeTrees) # qukeTrees;
        
        if[count qukeTrees;
            // Create a table with all of the test results.
            rawTestResults : i.createResultsTable[qukeTrees;fnameMap];
            tstRs          : tstRs , .z.m.qu.formatter.generic rawTestResults
         ];
    ];
    // remove the empty entry that was used to help maintain type
    : 1_tstRs
    }
// @fileOverview qcumber results if the source files failed to load
// @param srcArgs  {symbol[]} The unmodified src argument paths
// @param srcPaths {string[]} The qualified file paths
// @param errors   {string[]} A list of the error messages thrown while loading the source
// @returns {table}
.z.m.qu.i.srcFailed:{[srcArgs; srcPaths; errors]
    
    : {[srcPath; srcArg; error]
        (!) . flip (
            (`namespace;    getNamespace srcPath);
            (`fileName;     last ` vs hsym `$srcPath);
            (`feature;      `);
            (`block;        `src);
            (`description;  "Error loading source");
            (`expectations; "");
            (`line;         0N);
            (`success;      0b);
            (`result;       `expect`toMatch`expectError`toMatchError!(1b;1b;"";""));
            (`error;        "Error loading source " , srcArg , ": " , error);
            (`aborted;      1b);
            (`skipped;      1b);
            (`parseError;   0b);
            (`start;        .z.p);
            (`time;         0D))
        } ./: flip[(srcPaths; srcArgs; errors)] where not errors ~\: 0b;
    }
// @fileOverview Create a formatted string of all test results for all tests in a given test block
// @param r  {table}  The test result table
// @param ns {symbol} The namespace (directory) of the test file
// @param fn {symbol} The test file name
// @param f  {symbol} The feature 
// @param b  {dict}   The block
// @returns {string}  Formatted string
.z.m.qu.i.stdout.block:{[r; ns; fn; f; b]
    : {x,"\n"} ((8#" "), "(",lower[string b `block],") " ,b`description),
         // We use ~\: instead of like in case there are pattern matching chars in the description
         "\n" , "\n" sv stdout.test[0b] each select from r where namespace = ns, fileName = fn, feature = f, block = b`block, description ~\: b`description;
    }
// @fileOverview Create a formatted string of all test results for all features in a given file
// @param r  {table}  The test result table
// @param ns {symbol} The namespace (directory) of the test file
// @param fn {symbol} The test file name
// @returns {string}  Formatted string
.z.m.qu.i.stdout.feature:{[r; ns; fn]
    f : exec distinct feature from r where fileName = fn, namespace = ns;
    : {[r; ns; fn; f]
        // Sort by line number to reflect original ordering
        b : `line xasc 0! select by block,description from r where feature = f, fileName = fn, namespace = ns;
        : {x,"\n"} ((4#" "),"feature ",string f) , "\n" , "\n" sv i.stdout.block[r;ns;fn;f] each b;
        }[r; ns; fn] each f;
    }
// @fileOverview Create a formatted string of all test results given the results table 
// @param r {table}  The test result table
// @returns {string} Formatted string of all test results
.z.m.qu.i.stdout.out:{[r]
    ns : exec distinct namespace from r;
    : {[r; ns]
        fns: exec distinct fileName from r where namespace = ns;
        : "\n" sv {[r; ns; fn]
            : "file ", string[fn], "\n", raze i.stdout.feature[r; ns] fn;
            }[r; ns] each fns;
        }[r] each ns;
    }

// @fileOverview 
// Prints test results to stdout, with a little summary at the end.
// @param results  {table}   The table of test results
// @param printAll {boolean} Whether to print passing results
// @returns {null}
.z.m.qu.i.stdout.summary:{[results; printAll]
    passed  : select from results where success;
    benches : select from results where not[success], block =  `Bench;
    failed  : select from results where not[success], block <> `Bench;
    skipped : select from results where skipped;

    -1 i.stdout.out $[printAll; results; benches,failed,skipped];

    -1 "Summary:";
    -1 stdout.colour[`green]  string[count passed],  " tests passed";
    -1 stdout.colour[`yellow] string[count benches], " benchmarks failed";
    -1 stdout.colour[`red]    string[count failed],  " tests failed";
    -1 string[count skipped], " tests skipped\n";
    }

// @fileOverview Runs a single test file with default settings
// @param path {string | symbol} The folder path
// @returns {#results} See `.qu/README.md` for more information about the 
// structure of the results table given different block types.

// @example
// .z.m.qu.runTestFile "file.quke"
.z.m.qu.runTestFile:{[path]
    :.z.m.qu.runTestFileWithSettings[path;::]
    }
// @fileOverview Runs a single test file
// @param path {string | symbol} The folder path
// @param sts {#ty.userSettings | null} The qcumber settings
// @returns {#results} See Running qcumber for more information about the structure 
// of the results table given different block types.

// @example
// .z.m.qu.runTestFile "file.quke"
.z.m.qu.runTestFileWithSettings:{[path;sts]

    if[.z.m.axq.isSymbol path; path: 1_string hsym path];

    path: ssr[;"\\";"/"] path;

    if[not path like "*.quke";'"Test file must have \".quke\" extension"];
    specs: .z.m.qu.getSpecFromFileName path;
    
    // @qlintsuppress RANDOM_GUIDS(1)
    res : .z.m.qu.i.runFiles[update testID: neg[count specs]?0Ng from specs;sts];
    
    :.z.m.qu.i.reformat res
    }
// @fileOverview Runs all tests in a folder with default settings
// @param path {string | symbol | null} The folder path. Null is replaced with "." namespace
// @returns {#results} See Running qcumber for more information about the structure 
// of the results table given different block types.

// @example
// .z.m.qu.runTestFolder "folder"
.z.m.qu.runTestFolder:{[path]
    :.z.m.qu.runTestFolderWithSettings[path;::]
    }
// @fileOverview Runs all tests in a folder
// @param path {string | symbol | null} The folder path. Null is replaced with "." namespace
// @param sts  {#ty.userSettings | null}  The qcumber settings
// @returns {#results} See Running qcumber for more information about the structure 
// of the results table given different block types.

// @example
// .z.m.qu.runTestFolder "folder"
.z.m.qu.runTestFolderWithSettings:{[path;sts]

    path : $[path ~ (::); 
                enlist ".";
             .z.m.axq.isSymbol path; 
                1_string hsym path; 
                path];

    if[not .z.m.axfs.isDir path;
        '"Path does not point to folder"
        ];
    
    path : ssr[;"\\";"/"] path;
    if["/" = last path; path : -1_path];

    findFiles: {{raze{$[11h=type c:key x;` sv/:x,/:c;c]}each x}over x};
    
    specs: ([] fileName:(); namespace:(); fname:(); content:()),
             raze .z.m.qu.getSpecFromFileName each 1_/:string fls where (fls: findFiles hsym `$path) like "*.quke";

    // @qlintsuppress RANDOM_GUIDS(1)
    res : .z.m.qu.i.runFiles[update testID: neg[count specs]?0Ng from specs;sts];

    :.z.m.qu.i.reformat res
    }
// @fileOverview Runs test on the given content of test file
// @param namespace {symbol} 
// @param content {string[]} 
// @returns {#results} See `.qu/README.md` for more information about the 
// structure of the results table given different block types.

// @doctest Expect to return the test results dictionary
// namespace: `.foo
// content: ("feature ref"; "should work"; "expect this to work"; "1 ~ 1"; "expect this to work as well"; "1 ~ 2"); 
// 99h ~ type .z.m.qu.runTestString[namespace; content]

// @private
.z.m.qu.runTestString:{[namespace; content]

    if[not all 10h = type each content;
        '"Content must be a list of strings"];
    
    specs: ([] 
        fileName  : enlist `; 
        namespace : enlist .z.m.axq.asSymbol namespace;
        fname     : enlist `;
        content   : enlist content);
    
    // @qlintsuppress RANDOM_GUIDS(1)
    res: .z.m.qu.i.runFiles[update testID: neg[count specs]?0Ng from specs;::];
    
    : .z.m.qu.i.reformat res
    }

// @fileOverview Allows errors from unit tests to propagate, facilitate debugging
// @param x {boolean} 1b to not trap errors in unit tests
// @returns {null}
.z.m.qu.setBreakOnErrors:{[x]
    // To avoid a circular dependency, this sets a variable in .z.m.qu.block,
    // as .z.m.qu.block can't reference variables in .qu
    .z.m.qu.block.breakOnErrors: x;
    }

// @fileOverview Allows fails from unit tests to propagate, facilitate debugging
// @param x {boolean} 1b to not trap fails in unit tests
// @returns {null}
.z.m.qu.setBreakOnFail:{[x]
    // To avoid a circular dependency, this sets a variable in .z.m.qu.block,
    // as .z.m.qu.block can't reference variables in .qu
    .z.m.qu.block.breakOnFail: x;
    }

// @fileOverview Creates the qu settings
// @param sts {dict | null} a dictionary of the settings to modify or generic null if the default settings are desired
//
// @private
//
// @returns {#ty.userSettings}
.z.m.qu.settings.create:{[sts]
    
    sts : $[sts ~ (::); ()!(); sts];
    
    usrs: settings.default,sts;

    tests:  (all each (all (.z.m.axq.isSymbol each)@) @/: usrs(,)`ignoreBlocks),
            .z.m.axq.isBoolean each usrs `legacy;
    
    failedMsgs: "Invalid ",/: string key `ignoreBlocks`legacy#usrs;
        
    err: "; " sv failedMsgs where not tests;

    if[usrs`legacy;
        usrs[`ignoreBlocks] ,: `$("to match"; "skip if")];
    
    :$[err ~ ""; usrs; 'err]
    }
// @fileOverview the default settings for qcumber
.z.m.qu.settings.default:(!) . flip (
    (`ignoreBlocks;`$());
    (`legacy;0b)
    )
// @fileOverview The writers for each type of file
.z.m.qu.i.writers:(!) . flip (
    (`dat;      {x upsert y});
    (`json;     {x 1: .z.m.axutl.json.stringify y});
    (`xml;      {x 1: .z.m.qu.junit.toJunit y});
    (`default;  {x 1: .z.m.qu.i.stdout.out y}));

// @fileOverview Whether to colourize output or not
.z.m.qu.i.COLOURIZE:0b
// @fileOverview type definitions
// @returns {null}
// @private
.z.m.qu.onLoad:{[]
    
    // @default-category .qu Testing
    // @default-subcategory .qu Qcumber
    
    // @typedef specsCtx {table( namespace : symbol; 
    //                       fileName   : symbol;
    //                       context    : symbol;
    //                       content    : string[] | string)}
    //
    // @typedef results {dict (
    //                      allTestResults       : table;
    //                      allFailedTestResults : table;
    //                      allSkippedTestResults: table;
    //                      parseErrorList       : string[])}
    //          
    // @typedef specs {table( namespace  : symbol; 
    //                        fileName   : symbol;
    //                        content    : string[] | string)}
    }

.z.m.qu.onLoad[];
system "d .z.m";

system "d .z.m.qd";
// @fileOverview Generate markdown for the typedefs page
// @param settings {#settings} 
// @param tdefs {#tdefs} 
// @returns {(string; table)}
.z.m.qd.md.fromTypedefs:{[settings; tdefs]
    // Sort them by category and ensure global typedefs appear first
    tdefs: `category xasc tdefs;
    tdefs: (select from tdefs where category = .z.m.qd.data.GLOBAL_CAT),
        select from tdefs where category <> .z.m.qd.data.GLOBAL_CAT;

    if[not settings`docprivate;
        tdefs: select from tdefs where not isPrivate
        ];
    
    // Resolve typedefs and generate markdown from the types
    resolved:       md.i.resolveTypedefs[settings; tdefs] each tdefs;
    resolvedIOTags: md.i.io.attrTags each resolved[`ioTag] ,' tdefs`descs;
    body:           md.i.fromTypedefs[settings]'[resolvedIOTags; tdefs];
    
    // Split content for every category so that we can prepend the category heading to it
    categories: enlist each ("## ",/: string distinct tdefs`category);
    ind:        -1_(+\) 0,value count each group tdefs`category;
    content:    "\n\n" sv md.i.TYPEDEF_INTRO, raze categories,'ind _ body;
    : (enlist content; raze resolved[;`warning])
    }

// @fileOverview This functions generates markdown given a table of function category and a table of tagBlocks.

// @param   settings    {dict (group: symbol; idstyle: symbol)}
// @param   tags        {#tags}

// @returns {string []}

.z.m.qd.md.gen:{[settings; tags]
    // Allow the user to customize the tags before markdown is generated
    tags:settings[`preMarkdownHook] tags;

    // Return empty schema if one of the arguments is empty
    if[.z.m.axq.isEmpty tags; :`md`error`doctest!(enlist ""; data.ERROR; data.DOCTEST)];
    
    // Generate the markdown for the I/O related tags. Multiline strings are joined by the seperator " "
    io: md.i.fromIO[settings] each tags`io;
    
    // Generate the markdown for the overview. Multiline strings are joined by the seperator " "
    overview: md.i.fromOverview each tags;
    // Generate the markdown for the see tags
    see: md.i.fromSee[tags;;settings] each tags;
    //Generate the markdown for the todo tag
    todo: md.i.fromTodo each tags`todo;
    // Generate the markdown for the example
    example: md.i.fromExample each tags;
    // Run doctests and generate markdown
    doctest: $[settings`doctest; md.i.doctest each tags; count[tags]#enlist(""; data.DOCTEST)];
    
    // Join each item in the grouping sections
    : `md`error`doctest!
        (overview,'io,'see,'todo,'example[;0],'doctest[;0];
        distinct raze example[;1];
        raze doctest[;1]);
    }  
    
// @fileOverview Checks for undocumented params and params not in code errors.
// Also reorders the parameters based on their order in function param list.
// @param fn {dict (ref: symbol; parameter: string[])} 
// @param ioTag {table} 
// @returns {dict}
.z.m.qd.md.i.checkParams:{[fn; ioTag]
    
    if[(not `param in ioTag`Tag) and 0 ~ count fn`parameters;
        :  enlist `ioTag`warning!(ioTag; data.ERROR)
        ];

    param: select from ioTag where Tag = `param;
    other: select from ioTag where not Tag = `param;
    warning: data.ERROR;
    
    // Add undocumented parameters
    if[any missing: not fn[`parameters] in param`Name;
        c: count m: fn[`parameters] where missing;
        warning,: ([]
            ref: c#fn`ref;
            qdType: enlist each m;
            errorType: c#`UNDOCUMENTED_PARAM;
            error: enlist each "Parameter '",/:m,\:"' is undocumented"
            );
        param,: ([] 
            Tag:c#`param; 
            Name: m; 
            Type: c#enlist ""; 
            Description: c#enlist ""; 
            Required: c#1b; 
            Default: c#enlist "")
        ];

    // Drop parameters that are not in code
    if[any notInCode: not param[`Name] in fn`parameters;
        // Do not drop documentation for implicit params
        $[(not all param[`Name] in string ``x`y`z) or 0 < count fn`parameters;
            [
                c: count m: param[`Name] where notInCode;
                param: select from param where Name in fn`parameters;
                warning,: ([]
                    ref: c#fn`ref;
                    qdType: enlist each m;
                    errorType: c#`PARAM_NOT_IN_CODE;
                    error: enlist each "Documented parameter '",/:m,\:"' is not in the function param list"
                    )
                ];
            // Update fn param list to include documentation for implicit param 
            fn[`parameters]: asc param[`Name]
            ]
        ];

    // Reorder params based on how they appear in function def
    param: param param[`Name]?fn`parameters;
    
    : enlist `ioTag`warning!(param, other; warning) 
    }

// @fileOverview Enter a description here...
// @returns {Type} Enter a return description here...
// tag: tags[0]
.z.m.qd.md.i.doctest:{[tag]

    results : data.DOCTEST;
    code    : "";
    
    if[(`$"@doctest") in tag[`example]`tagType;
        testTags: select from tag[`example] where tagType=`$"@doctest";
        tests: exec lines from testTags;
        ref: string tag`ref;
        feature: "feature ",ref;
        should: "should Doc tests should work for ",ref;
        tests[;0]: "expect ",/: trim tests[;0];
        
        results: @[;`allTestResults] .z.m.qu.runTestString[`.foo] (feature; should), raze tests;
        results: select ref: tag`ref, test: expectations, success, result, error from results;
        tag[`example]: update tagType:`$"@example" from testTags;
        code: first md.i.fromExample tag;
        ];
    : (code; results)
    }

.z.m.qd.md.i.escapeHTML:{[x]
    : $[x like "<param>*";  
            ssr[x; "<param>"; "&lt;param&gt;"];
        x like "<returns>*"; 
            ssr[x; "<returns>"; "&lt;returns&gt;"];
        x like "<return>*"; 
            ssr[x; "<return>"; "&lt;returns&gt;"];
        x like "*<*";
            ssr[; ">"; "&gt;"] ssr[x; "<"; "&lt;"];
        x];
    }
.z.m.qd.md.i.filter:{[settings; itags]
    
    // Drop all the lines after the first @end tag for readmes
    dropAfterEnd: {index: where (`$"@end") = x`tagType; $[index ~ `long$(); x; first[index]#x]};
    itags: update tagBlocks: dropAfterEnd each tagBlocks from itags where kind = `readme;
    
    // Drop artifacts with @private
    if[not settings`docprivate;
        itags: itags where not lib.isPrivate itags`tagBlocks];
    // Drop artifacts with @todo
    if[not settings`doctodo;
        itags: itags where not lib.isTodo itags`tagBlocks];
    // Drop artifacts that do not have any valid qdoc tags 
    if[not settings`docempty;
        itags: itags where not lib.isEmpty itags`tagBlocks];
    
    : itags
    }

// @fileOverview Generates Markdown for the @example tag
// @param tag {dictionary}
// @returns {(string; table)}
.z.m.qd.md.i.fromExample:{[tag]
    example : tag`example;
    etxt    : enlist "";
    code    : enlist "";

    // BENW: Reformated to work with more than one example at a time. Also made a variable
    // called code that can be re-used by i.runFormatBlocks below
    if[(`$"@example") in example[`tagType]; /dnl
        titles: (exec lines from example where tagType=`$"@example")[;0];
        headings: md.i.wrap["\n\n"] each md.i.wrap["**"; "Example:"],/: titles;
        code: 1_/: exec lines from example where tagType=`$"@example"; /dnl
        code: "\n" sv/: { $[.z.m.axq.isEmpty trim last x; -1_x; x] } each code;
        codeBlocks: "```q\n",/:code,\:"\n```";
        etxt: headings,'codeBlocks
    ];
    
    if[not (`$"@format") in example[`tagType];:("\n" sv etxt; data.ERROR)]; /dnl
    formatter: "\n" sv first exec lines from example where tagType=`$"@format"; /dnl
    // Hack, currently only support 1 format block
    ftxt: .z.m.qd.md.i.runFormatBlocks[tag`ref; formatter] each code;

    : ("\n" sv etxt,'(count[etxt]#enlist "\n\n"),'ftxt[;0]; raze ftxt[;1]);
    }
// io: tags[`io][2]; 
.z.m.qd.md.i.fromIO:{[settings; io]
    info: "";

    if[0 ~ count io; : info];

    // Escape all the scpecial chars
    io[`Type]: md.i.REG.ESCAPE_PIPE exec Type from io;
    
    if[settings`doctypedef;
        io: md.i.linkTypedefs[settings] each io
        ];
    
    if[`param in io`Tag;
        c: md.i.fromIOTable `Tag`Required`Default`Typedefs _ p:select from io where Tag = `param;
        info,: md.i.wrap["\n\n"; md.i.wrap["**"] $[1 < count p; "Parameters:"; "Parameter:"]], c
        ];
    
    if[any `returns`return`type in io`Tag;
        r: `Tag`Required`Default`Typedefs _ select from io where Tag in `return`returns`type;
        c: md.i.fromIOTable $[2 > count r; delete Name from r; r];
        info,: md.i.wrap["\n\n"; md.i.wrap["**"] $[`type ~ first io`Tag; "Data type:"; "Returns:"]], c
        ];
    
    if[`throws in io`Tag;
        c: md.i.fromIOTable `Tag`Name`Required`Default`Typedefs _ select from io where Tag = `throws;
        info,:  md.i.wrap["\n\n"; md.i.wrap["**"] "Throws:"], c
        ];
    
    : info
    }

// @fileOverview Generates Markdown for the tags in IO grouping
// @param table {table} Input table. All columns must be strings
// @returns {string} A string formatted as a Markdown table
// table: flip `Name`Type`Description!(("foor";"bar"); ("int"; "char"); ("";""))
.z.m.qd.md.i.fromIOTable:{[table]
    if[.z.m.axq.isEmpty table;: ""];
    
    if[`Name in cols table;
        table: update Name: (.z.m.qd.md.i.escapeHTML each table[`Name]) from table
        ];
    
    // Assume general columns are lists of strings. Join them by " ".
    gen: exec c from (0! meta table) where t = " ";
    table: ![table;();0b;gen! (sv/:;" "),/:gen];
    
    // Anything that is already a string must be cast to a string.
    nonstr: exec c from (0! meta table) where t <>"C";
    table: ![table;();0b;nonstr!(string),/:(nonstr)];
    
    // Join the column names, seperators, and values. (Columns seperated by "|", header seperated from payload by "---")
    // [KXAX-1799] Handle cell border for adjacent empty cells
    : md.i.wrap["|"] 
        "|\n|" sv "|" sv' (enlist string cols[table]),(enlist count[cols[table]]#enlist"---"),flip value flip table;
    }
// @fileOverview Generates Markdown for the tags in the overview grouping

// @param tag {dictionary}
// A table of tagType(tags that come under overview grouping) and lines(contents related to each tag)

// @returns {string} A string formatted as Markdown
.z.m.qd.md.i.fromOverview:{[tag]
    name: "## ", string tag`ref;
    deprecated: "";
    fileoverview: "";
    author: "";
    
    // Drop @ from the beginning of tags
    tag[`overview]: update `$1_/:string tagType from tag`overview;

    if[`private in tag[`overview]`tagType;
        name,: " ", md.i.wrap["**"] md.i.wrap["_"] "(private)"
        ];
    
    if[`deprecated in tag[`overview]`tagType;
        c: "\n" sv first exec lines from tag`overview where tagType=`deprecated;
        if[not .z.m.axq.isEmpty c; c:": ",c];
        deprecated: md.i.wrap["**"; "Deprecated"], c 
        ];
    
    if[any `fileoverview`overview in tag[`overview]`tagType;
        fileoverview: "\n" sv md.i.stripWhiteSpace first exec lines from tag`overview where tagType in `fileoverview`overview
        ];
    
    if[`author in tag[`overview]`tagType;
        c: trim "\n" sv first exec lines from tag`overview where tagType=`author;
        if[not .z.m.axq.isEmpty c; author: md.i.wrap["**"; "Author"], ": ", c]
        ];
    
    ret: (name; deprecated; fileoverview; author);
    
    : "\n\n" sv ret where not ""~/: ret
    }
// @example
// artifacts: @[;`data] .axwws.getArtifacts @[;`data] .axwws.current[];
// functions: asc select ref, name, content from artifacts where objType in `function, ref like ".z.m.qd.gen.*";
// catT: .z.m.qd.categorize[functions];
// tagBlocks: .z.m.qd.genTagBlocks[functions[`content]][0];
// filtered: md.transform[1b;] each tagBlocks;  
// see: filtered[`see][1];
// catD: catT[1];
.z.m.qd.md.i.fromSee:{[tags; tag; settings]
    
    : $[(`$"@see") in tag[`see]`tagType;
            md.i.getSeeLinks[tags; tag; settings];
            ""
            ];
    }
.z.m.qd.md.i.fromTodo:{[todo]

    txt:"";
   
    if[(`$"@todo") in todo[`tagType];
        c:trim each " " sv/: exec lines from todo where tagType=`$"@todo";
        if[not any .z.m.axq.isEmpty each c;
             txt: md.i.wrap["\n\n"; md.i.wrap["**"] "TODO:"], "\n" sv "* ",/:c[where not c like ""]
            ]
        ];
    : txt;
    }
.z.m.qd.md.i.fromTypedefs:{[settings; io; tdef]
    info: "";

    if[0 ~ count io; : info];

    // Escape all the scpecial chars
    io[`Type]: md.i.REG.ESCAPE_PIPE exec Type from io;
    
    if[settings`doctypedef;
        io: md.i.linkTypedefs[settings] each io];
    
    // typedefs is not a valid tag type.
    // It's created/used internally to build the typedefs page
    if[`typedefs in io`Tag;
        name   : "### ", first io`Name;
        params : $[0 = tdef`paramCount; "";
                   1 = tdef`paramCount; "Parameter: ", "%",first tdef`paramName;
                                        "Parameters: ", ", " sv "%",/:tdef`paramName]; 
        def    : md.i.fromIOTable `Tag`Required`Default`Typedefs _select from io where Tag = `typedefs;
        info  ,: "\n\n" sv $[params like ""; (name; def); (name; params; def)]];
    
    : info
    }

// tag: last tags
.z.m.qd.md.i.getSeeLinks:{[tags; tag; settings]
    
    refs: asc " " vs " " sv trim each first each exec lines from tag`see where tagType=`$"@see";

    // Drop @see tags with no function names
    refs: distinct `$refs where not refs like "";
    
    // Return an empty string in case the user just typed @see tag with no function name
    if[.z.m.axq.isEmpty refs; : ""]; 

    refs: ?[not .z.m.qd.lib.isFq each refs; ` sv/: tag[`module],/: refs; refs];
    
    // Ensure the functions referenced under the @see tag are also getting documented
    // Do not add broken links if the function doesn't exist
    missingFunctions: not refs in tags`ref;
    if[any missingFunctions;
        // show "Warning: '",string[tag`ref],"' unresolved @see reference(s): ", ", " sv refs where missingFunctions;
        // Return if none of the references can be resolved
        $[all missingFunctions; 
            : "";
            refs: refs where not missingFunctions
            ];
        ];
    
    ext  : $[`pandoc ~ settings`idstyle; `html; `md];
    files: lib.url.file[settings; select from tags where ref in refs; ext];
    files: $[`pandoc ~ settings`idstyle; `$.h.hu each string files; files];
    id   : .z.m.qd.autoidentifier[settings`idstyle] each refs;
    links: md.link[settings] ./: flip .z.m.axq.asString (refs; files; id);
    
    : " " sv (enlist "\n\n", md.i.wrap["**"; "See Also:"]), links; /dnl
    }

// @fileOverview This function handles tags grouped under io category.

// @param tagBlock          {table (lines:string; tagType:symbol)[]} A table of tagType (all the tags) and lines (contents related to each tag)
// @param escapeSpecialChar {boolean} Set to true if you want to escape special characters in md. Set to false for the AutoJS Doc scenario.

// @returns {table (Tag:symbol; Name:string; Type:string; Description:string)} Table containing information about the tagBlock
// tagBlock:r[`io];

.z.m.qd.md.i.handleIOTags:{[tagBlock; escapeSpecialChar]

    s: " " sv/: tagBlock`lines;
    
    // Find the left and right curly brackets in each string
    p:0,/: s ss\: "[{}]";
    
    // If {} occurs more than once in a tag then only take the first occurence.
    p[where 3 < count each p]: 3#/:p where 3 < count each p;
    
    // Include right brace from {Type}
    p[where 3 = count each p]: p[where 3 = count each p] +\: 0 0 1;
    
    // If only left or right curly brace is found, capture the single curly bracket as type
    // resulting in an empty type
    p[where 2 = count each p]: p[where 2 = count each p] ,'1+-1#/:p where 2 = count each p;
    
    // Add {} to front of strings that dont have a declared type
    s[where 1 = count each p]: "{}",/:s where 1 = count each p;
    
    // Compensate for the {} that was just added so that p is nx3 matrix
    p[where 1 = count each p]: count[where 1 = count each p]#enlist 0 0 2;
    
    // Format Name {Type} Description into:([] name:Name(s) type:Type(s) description:Description(s))
    t: flip `Name`Type`Description!flip p _' s;

    // [KXAX-1800] Delete @ from all the tagTypes in the IO table
    tagBlock: update tagType:.z.m.axq.asSymbol 1_/:string(tagType) from tagBlock;
    
    // Similarly to 'trim', this also trims tabs before or after non-whitespace text
    trim2: {x {$[any null x;0#0;x]} {x+til 1+y-x} . (min;max)@\:where not x in " \t"};

    returnTable: `Tag`Name`Type`Description`Required`Default xcols
        update trim2 each Name, -1_/:1_/: Type, trim2 each Description, Tag:tagBlock`tagType, Required:1b, Default:count[t]#(enlist "") from t;
    
    // Description holds the name and the actual value (of desc). Split on space, extract name (first item) and then
    // join the rest of the string together
    if[`desc in returnTable`Tag;
        descs: " " vs' exec Description from returnTable where Tag = `desc;
        returnTable: update Name: trim2 each descs[;0], Description: trim2 each " " sv/: 1_/:descs
            from returnTable where Tag = `desc;
        ];
    
    // Escaping special characters in markdown
    if[escapeSpecialChar; returnTable[`Type]: md.i.REG.ESCAPE_PIPE exec Type from returnTable];
    
    : returnTable
    }
.z.m.qd.md.i.io.attrTags:{[ioTags]
    
    if[.z.m.axq.isEmpty ioTags; : ioTags];
    
    : md.i.io.descriptionTag
        md.i.io.defaultTag
            md.i.io.requiredTag ioTags
    }

.z.m.qd.md.i.io.defaultTag:{[ioTags]
   
    a: select from ioTags where Tag = `default;
    
    if[.z.m.axq.isEmpty a; : ioTags];
    
    default: flip (enlist each d[;0]),' trim enlist each " " sv/: 1_/: d:" " vs' a[`Description];

    a: flip `Name`Default`Description! default,enlist a[`Description];
    a: select from a where Name in ioTags[`Name];
    
    // Drop default tags from the ioTags
    ioTags: select from ioTags where not Description in a[`Description];
    
    : ioTags lj `Name xkey select Name, Default from a
    }

.z.m.qd.md.i.io.descriptionTag:{[ioTags]
    map: select Name, Description from ioTags where Tag = `desc;
    
    if[.z.m.axq.isEmpty map; : ioTags];

    // KXAX-19388: Optional dict keys/table columns
    map: update Name: -1_/:1_/:Name, Description: ("Optional; ",/:Description) 
        from map where Name like "[[]*[]]";
    
    map: select from map where Name in ioTags`Name;

    // Drop default tags from the ioTags
    ioTags: select from ioTags where Tag <> `desc;
    
    : ioTags lj `Name xkey map
    }

.z.m.qd.md.i.io.requiredTag:{[ioTags]
    
    a: select from ioTags where Tag = `req;
    
    if[.z.m.axq.isEmpty a; : ioTags];
    
    a: flip `Name`Required`Description!(flip trim 2#/:" " vs' a[`Description]),enlist a[`Description];
    a: select from a where Name in ioTags[`Name];
    a: update Required: (.z.m.qd.lib.i.mapReq each a[`Required]) from a;
    
    // Drop req tags from the ioTags
    ioTags: select from ioTags where not Description in a[`Description];
    
    : ioTags lj `Name xkey select Name, Required from a
    }
// @fileOverview Create a link to the typedef definition for each typedef alias
// @param settings {#settings} 
// @param ioTag {#ioTag} 
// @returns {#ioTag}
.z.m.qd.md.i.linkTypedefs:{[settings; ioTag]
    if[0 ~ count ioTag`Typedefs; :ioTag];
    anchors: .z.m.qd.autoidentifier[settings`idstyle] each ioTag`Typedefs;
    links: md.link[``sanitizeURL!11b] ./: flip 
        (1_/:ioTag`Typedefs;  count[ioTag`Typedefs]#enlist data.TYPEDEFS_FILENAME ; anchors);
    ioTag[`Type]: ssr/[ioTag`Type; ioTag`Typedefs; links];
    : ioTag
    }

// catD: catT 2;
// ioTags: tags[`io] 2;
.z.m.qd.md.i.resolve.types:{[settings; tdefs; catD; ioTags]
        
    ioTags[`Typedefs]: count[ioTags]#();
    
    if[.z.m.axq.isEmpty ioTags:select from ioTags where Tag <> `desc; 
        : enlist `ioTag`warning!$[`table ~ settings`resolve;
            (0#ioTags; data.ERROR);
            (flip ioTags; data.ERROR)
            ]
        ];

    resolved: types.resolve[settings; tdefs; catD] each
        select from ioTags where Tag <> `desc;
    
    // Prepend local @descs (from funcs) to give local @desc preference 
    // over default @desc (from onLoads)
    : $[`table ~ settings`resolve;
            (enlist `ioTag`warning!(select from ioTags where Tag = `desc; data.ERROR)), resolved;
            resolved
            ]
    };

// @fileOverview Uses table type resolver to resolve typedefs
// tdef: tdefs 0
.z.m.qd.md.i.resolveTypedefs:{[settings; tdefs; tdef] 
    
    // typedefs is not a valid tag type.
    // It's created/used internally to build the typedefs page
    ioTag: select Tag: `typedefs, Name:ref, Type: qType, Description: description, 
        Required: 1b, Default: 1b, Typedefs: () from tdef;

    if[not .z.m.axq.isEmpty tdef`error;
        error: flip (cols data.ERROR)!enlist each (.z.m.axq.asSymbol tdef`ref; enlist tdef`qType; `PARSE_ERROR; enlist tdef`error);
        :`ioTag`warning!(enlist ioTag; error)
        ];
    
    tt: flip `Tag`Name`Type`Description!4#();
    resolved: .[types.out.table; 
        (settings; tdefs; tt; ioTag; tdef`parseTree); 
        {[name; Type; msg]
            : flip (cols data.ERROR)!enlist each (.z.m.axq.asSymbol name; enlist Type; `RESOLUTION_ERROR; enlist msg)
            }[tdef`onLoad; ioTag[`Type]]
        ]; 
    
    : $[(cols resolved) ~ cols data.ERROR; 
            `ioTag`warning!(enlist ioTag; resolved);
            [
                // TODO: may not need to do this anymore
                // drop the arg names from Typedefs so that they aren't considered as typedefs 
                if[0 <> count tdef`paramName;
                    resolved[`Typedefs]: {y where not y in x}["#",/:tdef`paramName] each resolved`Typedefs
                    ];
                `ioTag`warning!(distinct resolved; data.ERROR)
                ]
            ];

    };

.z.m.qd.md.i.runFormatBlocks:{[ref; formatter; example]
    errHandler: {[ref;formatter;etype;error] 
        : enlist cols[data.ERROR]!(ref;trim formatter;etype;error)}[ref; formatter];
    
    f: @[value; formatter; errHandler`EXAMPLE_FORMATTER_UNDEFINED_ERROR];
    if[98h ~ type f; :(""; f)];
        
    x: @[value; example; errHandler`EXAMPLE_FORMATTER_PARSE_ERROR];
    if[cols[x] ~ cols data.ERROR; :(""; x)];
    
    r: @[f; x; errHandler`EXAMPLE_FORMATTER_RUNTIME_ERROR];
    : $[98h ~ type r; (""; r);(r; data.ERROR)];
    }

// @fileOverview Strip single whitespace if every line starts with a with a whitespace
.z.m.qd.md.i.stripWhiteSpace:{[x] 
    : $[all () ~/: x;
            x;
        all " " = x[;0]; 
            1_/:x; 
            x]
    }

// resolveTo: pre.in.settings[input]`resolve;
// tdefs: pre.in.tdefs[input];
.z.m.qd.md.i.tags:{[settings; tdefs; itags]

    // Filters artifacts with private tag, todo tag, or no code if needed
    itags: md.i.filter[settings; itags];
    
    if[.z.m.axq.isEmpty itags; : md.i.TAGS_SCHEMA];
    
    // Update category and subcategory using the tags defined in the artifacts
    itags: md.i.updateArtifactInfo each itags;
    
    // 0b Do not escape the special characters in markdown
    tags: md.transform[0b; ] each itags`tagBlocks;
    
    // Use match to ensure it works for empty settings dict
    paramErrors: $[1b ~ settings`checkParams;
        [
            param: (select ref, parameters from itags) md.i.checkParams' tags[`io];
            tags[`io]: raze each param[;`ioTag];
            param[;`warning]
            ];
        count[tags]#()
        ];

    catT: lib.artifacts.wc itags;
    resolvedIOTags: catT md.i.resolve.types[settings; tdefs] ' tags`io;
    
    err: ([] error: resolvedIOTags[;`warning] ,' paramErrors);
    
    // Handle @desc, @req and default tags if the reolution type is table
    // For other resolution it doesn't matter because we can not display that information
    tags[`io]: $[`table ~ settings`resolve;
        { md.i.io.attrTags raze x`ioTag} each resolvedIOTags;
        @[;`ioTag] each resolvedIOTags
        ];

    : catT,'tags,'err
    }
.z.m.qd.md.i.updateArtifactInfo:{[itag]
    
    // join multiple lines 
    tagValue: {[x;y] `$first first exec lines from x where tagType =(`$"@",string y)}[itag`tagBlocks];
    
    tags: `$1_/:string itag[`tagBlocks]`tagType;

    if[`kind in tags; 
        itag[`kind]: $[(v:tagValue`kind) in data.SUPPORTED_KIND; v; itag`kind]];
    
    // Name tags corresponds to ref internally. Update ref and other fields like name, module, 
    if[`name in tags;
        // Spaces in names are not allowed. So grab the first item
        itag[`ref]: `$first " " vs string tagValue`name;
        itag,: first lib.i.calc.name lib.i.calc.module select name: ref, kind from enlist itag;
        itag,: first lib.module.toCat itag`module
        ];
    
    // Explicit category and subcategory tag overwrites changes made by the name tag
    if[`category in tags    ; itag[`category]   : tagValue`category];
    if[`subcategory in tags ; itag[`subcategory]: tagValue`subcategory];
    
    : itag
    }
// @fileoverview Wraps y in x
// @param x {string} 
// @param y {string} 
// @returns {string}
.z.m.qd.md.i.wrap:{[x; y]
    : x,y,x
    }

// @fileOverview Create a markdown link
// @param text {string} 
// @param path {string} 
// @param anchor {string} 
// @returns {string}
.z.m.qd.md.link:{[settings; text; path; anchor]
    path: $[settings`sanitizeURL; string lib.url.sanitize path; path];
    : "[ ", text, " ]", "( ",path, $[anchor ~ ""; anchor; "#", anchor], " )"   
    }
// @fileOverview Returns a table of tags given either the artifacts table or the input data structure.
// You can also include any of the flags from data.SETTINGS to fliter artifacts from artifacts table.
// @param settings {#settings} 
// @param tdefs {table} 
// @param artifacts {#artifacts} 
// @returns {#tags}
// @example Argument
// settings:data.SETTINGS;
// artifacts: lib.build.artifacts select from .axqdtools.ws.artifacts.get[] where module = `.qd;
// tdefs:.z.m.qd.typedefs.get[settings; artifacts];
.z.m.qd.md.tags:{[settings; tdefs; artifacts]
    
    if[.z.m.axq.isEmpty artifacts; 
        : md.i.TAGS_SCHEMA];
    
    if[.z.m.axq.isNull tdefs;
        tdefs: typedefs.get[settings] select from artifacts where kind = `function, name = `onLoad
        ];
    
    // For backward compatibility
    // Use match to ensure it works for empty settings dict
    if[not 1b ~ settings`checkParams;
        artifacts[`parameters]: count[artifacts]#()
        ];
    
    : md.i.tags[settings; tdefs]
        $[all cols[data.ARTIFACTS] in cols artifacts;
            (lib.artifacts.wc artifacts),' flip `tagBlocks`parameters!@[;0 2] 
                lib.genTagBlocks[settings; artifacts`content];
          all md.i.ARTIFACTS_TAGS in cols artifacts;
            artifacts;      // this is itags (used by datatype preprocessor)
            '"artifacts: invalid schema" 
            ];
    }

// @fileOverview Filter the tags into groupings. We currently have three groupings.

// @param escapeSpecialChar {boolean} Set to true if you want to escape special characters in md. Set to false for the AutoJS Doc scenario.
// @param tagBlock {table (lines:string; tagType:symbol)[]} A table of tagType (all the tags) and lines (contents related to each tag)

// @returns {dict} A dictionary with groupings as keys and tagBlock  as the value (a table)

// @example Execute function
// items:asc select ref, name, content from .z.m.qd.i.getArtifacts[] where kind=`function, ref like ".z.m.qd.doc";
// tagBlocks:.z.m.qd.genTagBlocks[items[`content]][0];
// tagBlock:tagBlocks[0];
// escapeSpecialChar: 0b;
.z.m.qd.md.transform:{[escapeSpecialChar; tagBlock]
    
    // Fix the type of argument if it is an empty general list. 
    // It will be very complex to create the empty schema of the return type. 
    // So, just modifying the argument to be an empty table with correct schema.
    if[ .z.m.axq.isEmpty tagBlock; tagBlock: ([] lines:(); tagType:())];
    
    // Split into several tables, one table containing the function description
    // Another containing param,throws,returns, etc (aka just the I/O or 'blackbox')
    r: md.i.TAGS!{?[x;enlist (in;`tagType; enlist y) ;0b;()]}[tagBlock] each data.TAGS md.i.TAGS;
   
    // Split param,throws,returns,etc into a name,type,description
    r[`io]: md.i.handleIOTags[r[`io]; escapeSpecialChar];
    
    : r;
    }

// @fileOverview Write Markdown files to disk
// @param settings      {#settings}
// @param output        {#pre.out} 
// @returns {symbol[]}  Filename of all the markdown files written to the disk
.z.m.qd.md.write:{[settings; output]
    
    if[.z.m.axq.isEmpty pre.out.md output; : enlist `];
    
    output: pre.out.with.md[; output] `file xgroup pre.out.md output;

    markdown: enlist each "\n\n" sv/: exec content from pre.out.md output;

    // Write the QDoc MD files to the disk
    : (` sv/: settings[`mdDir],/: exec file from pre.out.md output) 0:' markdown;
    }

.z.m.qd.md.i.TAGS:`overview`io`example`see`todo`control
.z.m.qd.md.i.TYPEDEF_INTRO:(
    "# Type Definitions"; 
    "";
    "This page contains defintions for various data structures/types used by the libraries documented here." 
    );
.z.m.qd.md.i.TAGS_SCHEMA:(``content _ 0#data.ARTIFACTS),' flip (md.i.TAGS, `error)!(count[md.i.TAGS] + 1)#()
// @fileOverview Escapes "|" character
.z.m.qd.md.i.REG.ESCAPE_PIPE:.z.m.pcre2.replace[.z.m.pcre2.compile["\\|"; .z.m.pcre2.use.replaceAll[]]; ; "\\|";::]
.z.m.qd.md.i.ARTIFACTS_TAGS:`tagBlocks`parameters, cols lib.artifacts.wc data.ARTIFACTS
system "d .z.m";

system "d .z.m.qd";
.z.m.qd.format.base64:{[x]
    encoding : (til 64)!.Q.b6;
    /* pad with nulls if not modulo 3
	
    pad : (0; 2; 1)[(count x) mod 3];
  
    exp1 : (65536; 256; 1); 
    bits : sum each ((each [`int$] 3 cut x,(pad#"")) *\: exp1);
    exp2 : (1; 64; 4096; 262144); // 2 xexp (0; 6; 12; 18);
    bytes: reverse (bits div/: exp2) mod 64; // {(x div y) mod 64}/: exponents;
    str  : raze flip encoding [bytes];
  
    /* pad end of coded text properly and return
	
    if [pad = 1; 
        str [(count str) - 1]: "=";
    ];
    if [pad = 2; 
        str [(count str) - (1 2)]: "=";
    ];
	
    : str;
    }

.z.m.qd.format.imageTag:{[x]
    "<img alt=\"Image\" src=\"data:image/png;base64,",x,"\"/>" /dnl
    }

system "d .z.m";

system "d .z.m.qd";
// @fileOverview 
// Removes qdoc tags until the first non qdoc line. Removes comments and leading 
// white space only if all the lines are commented oput. 
// @param content {string} 
// @returns {string}
// content: first pre.in.readmes[input]`content
.z.m.qd.pre.readme.i.cleanup:{[content]
    
    lines: "\n" vs content;
    
    // Find the first line that doesn't start with a qdoc tag and drop everything before that
    // There could be a readme with just a qdoc tag
    lines: $[0N ~ n: first where not .z.m.pcre2.test[reg.TAG; lines; ::]; : ""; n _ lines];
    
    // Drop all the lines after the first @end tag
    if[0 < count end: where not () ~/: .z.m.pcre2.imatch[reg.TAG_END; lines; ::];
        lines: first (0, first end) _ lines
        ];
    
    // If all the lines begin with a comment then drop the comment and leading space
    // If the readme was part of a q file then all lines must be commented. If it is coming 
    // from a md file then none of them should be commented
    if[all .z.m.pcre2.test[reg.COMMENT; lines; ::];
        lines: ltrim each last each .z.m.pcre2.imatch[reg.COMMENT; lines;::] _' lines
        ];
        
    : "\n" sv lines
    }

// @fileOverview Returns a table of readme content and updated category and subcategory fields
.z.m.qd.pre.readme.i.md:{[input; output]
    
    input: pre.in.with.readmes[; input]
        update category: `index from pre.in.readmes input where ref = `README;
    
    // Set docempty flag because you don't want to drop readmes just because they don't have a qdoc tag
    settings : update resolve:`table, docempty: 1b, checkParams: 0b from pre.in.settings input; 
    artifacts: pre.in.readmes input;
    artifacts: artifacts ,' flip `tagBlocks`parameters!@[;0 2] lib.genTagBlocks[settings; artifacts`content];
    
    catT: pre.readme.i.name.update
            lib.artifacts.wc 
                md.tags[settings; pre.in.tdefs input; artifacts];
    
    // KXAX-20378: length error due to private tag
    markdown: pre.readme.i.cleanup each 
        $[settings`docprivate;
            artifacts`content;
            exec content from artifacts where not .z.m.qd.lib.isPrivate artifacts`tagBlocks
            ];
            
    : pre.out.with.md[update content: markdown from catT]
        pre.out.with.err[$[0 = c:count catT; 1; c]#enlist data.ERROR] output
    }
// @fileOverview Update ref and name to README to be consistent
.z.m.qd.pre.readme.i.name.update:{[catT]
    : update ref: .z.m.qd.lib.unhsym[` sv/: (-1_/:` vs/: hsym catT`ref),\:`README], name:`README, kind: `readme from catT
    }

// @fileOverview This is a readme preprocessor for the qdoc (qd module) 

// @param input         {#pre.in}
// @param y             {*}                 Un-used parameter (can be used for projections)

// @returns {#pre.out}

// @example Arguments
// settings: data.SETTINGS;
// items: select ref, name, kind, content from .z.m.qd.web.i.artifacts.get[] where module in `.qd`.z.m.qd.md`.z.m.qd.types;
// input: lib.build.input[settings] lib.build.artifacts items;

// @qlintsuppress UNUSED_PARAM(1)
.z.m.qd.pre.readme.run:{[input; y]
    
    output: pre.out.new (data.ARTIFACTS; enlist data.ERROR; data.DOCTEST);
    
    if[.z.m.axq.isEmpty pre.in.readmes input; : output];
    
    : pre.readme.i.md[input; output]
    }
system "d .z.m";

system "d .z.m.qd";
// @fileOverview Parses a dBlock to extract the category and subcategory for each item in that block
// @param dBlock {#pre.datatype.dBlock} 
// @returns {dict (category: string; subcategory: string)}
.z.m.qd.pre.datatype.i.categorize:{[settings; dBlock]
    if[.z.m.axq.isEmpty dBlock; :  `module`category`subcategory!```]; 

    tagValue: {[x;y] `$trim first raze exec lines from x where tagType in `$y}[dBlock];
    
    if[null module: tagValue ("@datatype";"@datatype:private"); : `module`category`subcategory!```];

    c: first .z.m.qd.lib.defaults.apply[; settings`defaults]
         ([] module: enlist module),' lib.module.toCat module;
    
    if[(`$"@category") in dBlock`tagType;
        c[`category]: tagValue "@category"
        ];
    
    if[(`$"@subcategory") in dBlock`tagType;
        c[`subcategory]: tagValue "@subcategory"
        ];

    : c
    }

// @fileOverview Parses the onLoad function and returns blocks of datatypes in each onload
// @param input {#pre.in}
// @returns {#pre.datatype.dBlock []}
.z.m.qd.pre.datatype.i.dBlocks:{[input]
    settings: pre.in.settings input;
    
    // Get blocks of datatypes. Each item relates to all the datatypes contained in a onLoad
    datatypesBlocks: lib.genTagBlocks[settings; pre.in.onLoads[input]`content][1];
    
    // Break down blocks of datatypes into blocks of datatype. Each item relates to one datatype
    : raze pre.datatype.i.split each datatypesBlocks
    }

// @fileOverview 
// Build tdef description from datatype field/mutable descriptions
// @param ref {symbol} Datatype name to be prepended to the field name
// @param dBlock {table}
.z.m.qd.pre.datatype.i.desc:{[ref; dBlock]    
    ioTags: @[;`io] .z.m.qd.md.transform[0b] update tagType: `$"@param" from dBlock where tagType in `$("@field";"@mutable");
    : ([] 
        lines   : enlist each " " sv/: flip (string ` sv/: ref,/:`$ioTags`Name; ioTags`Description);
        tagType : `$"@desc")
    }

// @fileOverview Parses dBlock and builds the "Extends" heading to be added to the 
// readme for the modules that have the @extend tag 
// @param dBlock {#pre.datatype.dBlock} 
// @returns {#readmes}
// dBlock: dBlocks[1];
.z.m.qd.pre.datatype.i.extend.readme:{[settings; dBlock]
    
    // Get the category and subcategory of the datatype
    dict: pre.datatype.i.categorize[settings] dBlock; 
    
    // Build the Extends heading to be added to the readme for the modules that have the @extend tag 
    // Return empty schema otherwise
    : $[(`$"@extends") in dBlock`tagType;  /dnl
        [
            content: "### Extends : ", (trim first raze exec lines from dBlock where tagType = `$"@extends"); /dnl
            name: "README.md";
            ref: "/" sv (.z.m.axq.asString dict`module;name);
            t: flip `ref`name`module!enlist each .z.m.axq.asSymbol (ref; name; dict`module);
            t: t,'(lib.module.toCat t`module),'flip`kind`content!(`file; enlist content);
            .z.m.table.column.order[t; cols data.ARTIFACTS]
            ];
        0#data.ARTIFACTS
        ];
    }

// @fileOverview Genrate a table of function information for a function in the dataType
// @param dict      {dict (category: string; subcategory: string)} A dictionary of category and subcategory of the function
// @param tag       {dict (lines:string; tagTypes:symbol)} A dictionary of tagType and lines extracted from onLoad
// @returns {#pre.datatype.fnInfoT}
// tag : dBlock[2];
.z.m.qd.pre.datatype.i.fnInfoTable:{[dict; tag]
    
    if[not tag[`tagType] in `$("@field";"@mutable");
        : 0#pre.datatype.i.FN_INFO
        ];

    name: .z.m.axq.asSymbol first " " vs raze trim tag`lines;
    Type: trim " " sv 1_ " " vs raze trim tag`lines;
    
    // A mutable filed will have *.with.* name
    // For a given field --> Return type of @field = param type of @mutable
    : flip enlist each cols[pre.datatype.i.FN_INFO]!
        $[tag[`tagType]=`$"@field";
            [
                ref: ` sv (dict`module; name);
                (ref; name; `function; dict`module; dict`category; dict`subcategory; ""; Type; ""; tag`tagType)
                ];
            [
                name: ` sv `with,name;
                ref: ` sv (dict`module; name);
                (ref; name; `function; dict`module; dict`category; dict`subcategory; Type; ""; ""; tag`tagType)
                ]
            ];
    }
 
// @fileOverview Parses the dBlock and returns a table that contains information about 
// all the functions generated by this datatype block 
// @param dBlock {#pre.datatype.dBlock} 
// @returns {#pre.datatype.fnInfoT}
// dBlock: dBlocks[0];
// settings: pre.in.settings input;
.z.m.qd.pre.datatype.i.functions:{[settings; dBlock]
    
    // Return an empty schema if dBlock is empty
    if[ .z.m.axq.isEmpty dBlock; : 0#pre.datatype.i.FN_INFO]; 
    
    // Get the category and subcategory of the datatype
    dict: pre.datatype.i.categorize[settings] dBlock; 
    
    // Genrate a table of function information for all the functions in the dataType. 
    // Create an empty table if no fields or mutables in the datatype
    
    fns: raze pre.datatype.i.fnInfoTable[dict] each dBlock;
    
    // Handle the @mutable tags
    fns: pre.datatype.i.mutable fns;
    
    // Add "new" function for the datatype
    fns: pre.datatype.i.new[dict; dBlock; fns];
   
    : fns
    }
// @fileOverview Generate a tagBlock for a function in the datatype
// @param fnInfo {dict ()} A dictionary of fnInfo extracted by .z.m.qd.pre.datatype.i.fnInfoTable 
// @returns {table (lines:string; tagType:symbol)} A table of tagblock for the function

.z.m.qd.pre.datatype.i.genTags:{[fnInfo]
    
    : $[(`$"@field") = fnInfo`tagType; /dnl
            ([] lines:enlist each (fnInfo`pType; fnInfo`rType); tagType:(`$"@param";`$"@return")); /dnl
        (`$"@mutable") = fnInfo`tagType; /dnl
            ([] lines:enlist each (fnInfo`pType; fnInfo`rType; fnInfo`rType); tagType:(`$"@param";`$"@param";`$"@return")); /dnl
        (`$"@new") = fnInfo`tagType; /dnl
            ([] lines:enlist each (fnInfo`overview; fnInfo`pType); tagType:(`$"@fileoverview";`$"@param")); /dnl
            '"unsupported datatype tag: ", .z.m.axq.asString fnInfo`tagType
            ];
    }

// @fileOverview Returns a list of booleans indicating whether the given data type block is private or not
// @param tagBlocks {#tagBlocks} 
// @returns {boolean[]}
.z.m.qd.pre.datatype.i.isPrivate:{[tagBlocks]
    any flip (`$("@private";"@datatype:private")) in/: tagBlocks[;`tagType]
    }

// @fileOverview Updates the content with the generated markdown table and error table
// @param input             {#pre.in} 
// @param fnsInfo           {#pre.datatype.fnInfoT} 
// @param output            {} 
// @returns {Type}
.z.m.qd.pre.datatype.i.md:{[input; fnsInfo; output]
    
    // Generate tagBlocks for each function in a datatype
    fnsTagBlocks: pre.datatype.i.genTags each fnsInfo;
    
    // Get the typedef table
    tdefs: typedefs.get[pre.in.settings input] pre.in.onLoads input;
    
    catT: lib.artifacts.wc fnsInfo;
    
    // Convert functionsTagBlocks to md table
    alltags: md.tags[update resolve:`table, checkParams:0b from .z.m.qd.data.SETTINGS; tdefs] 
        catT,'([] tagBlocks: fnsTagBlocks);
    
    markdown: md.gen[pre.in.settings input; alltags];
    error   : enlist[markdown`error], raze each alltags`error;
    
    : pre.out.with.md[update content: markdown`md from catT] 
        pre.out.with.err[error] output;
    }
// @fileoverview Handles the @mutable tags. Updates type of field if the type 
// was specified with the mutable tag and adds corresponding field tag if it is missing
// @param   fns     {#pre.datatype.fnInfoT}
// @returns {#pre.datatype.fnInfoT}
.z.m.qd.pre.datatype.i.mutable:{[fns]
    
    if[not .z.m.axq.isEmpty muts: select from fns where tagType=`$"@mutable";
        
        // If param type of mutable is "" then replace it with the return type from its corresponding field
        if[not .z.m.axq.isEmpty missingParams: select from muts where pType like "";
            missingNames: ` sv/: 1_/: ` vs/: missingParams`name;
            newPTypes: first each {[fns; x] exec rType from fns where name = x}[fns;] each missingNames;
            fns: update pType:newPTypes from fns where pType like "", tagType=`$"@mutable"
            ];
        
        // Check if the datatype have a function with mutable tag but not a field tag. If so, create the same function with a field tag
        noField: (` sv/: 1_/: ` vs/: muts`name) except exec name from fns where tagType=`$"@field";
        t: select from fns where name in (` sv/: `with,/:noField);
        newName: first each 1_/:` vs/: t`name;
        newRef: ` sv/: t[`module],'newName;

        // Updated table with new functions if any
        fns: fns upsert update ref:newRef, name:newName, rType: pType, pType: enlist "", tagType:`$"@field" from t;
        ];
    
    : fns 
    }

// @fileOverview Inserts the *.new function the the fnInfotable. Also, updated the pType for 
// accessor functions (@field) and the rType of mutators (@mutable) to the dictionary datatype 
// @param dict      {dict (category: string; subcategory: string)} A dictionary of category and subcategory of the function
// @param dBlock    {#pre.datatype.dBlock} 
// @param fns       {#pre.datatype.fnInfoT} 
// @returns {#pre.datatype.fnInfoT}
.z.m.qd.pre.datatype.i.new:{[dict; dBlock; fns]
    
    // Build param type and file overview for the *.new function
    fields: select from fns where tagType=`$"@field";
    
    // rType can be missing if the user didn't define the type with @field tag
    if[any .z.m.axq.isEmpty each fields[`rType];
        : fns upsert flip cols[pre.datatype.i.FN_INFO]!enlist each 
            (` sv (dict`module;`new); `new; `function; dict`module; dict`category; dict`subcategory; ""; "" ;""; `$"@new")
        ];
    
    newParamDes: " A tuple of: <br>", "<br>" sv {types.i.indent, trim last "}" vs raze x} each fields`rType;
    newParamType: "{(", ("; " sv {1_ first "}" vs raze x} each fields`rType), ")}", newParamDes;
    newFileOverview: raze trim " " sv/: exec lines from dBlock where tagType=`$"@fileoverview"; /dnl
    
    // Build the dictionary object that reflects the datatype
    pair: (.z.m.axq.asString fields`name) {x,": ", 1_ first "}" vs raze y} 'fields`rType;
    object: "{dict (", ("; " sv pair), ")} ", newFileOverview;
   
    // Update  pType for accessor functions (@field) and the rType of mutators (@mutable) with dict object
    // This can be used for typedefs
    muts: select from fns where tagType=`$"@mutable";
    fns: update pType: (count fields)#enlist object from fns where pType like "", tagType=`$"@field";
    fns: update rType: (count muts)#enlist object from fns where rType like "", tagType=`$"@mutable";
    
    : fns upsert flip cols[pre.datatype.i.FN_INFO]!enlist each 
            (` sv (dict`module;`new); `new; `function; dict`module; dict`category; dict`subcategory; newParamType; object; newFileOverview; `$"@new");
    }
.z.m.qd.pre.datatype.i.readme:{[input; dBlocks; output]
    
    // Use the existing readmes of the base datatype if it exists
    extendReadmes: raze pre.datatype.i.extend.readme[pre.in.settings input] each dBlocks;
    readmes: lib.getReadmes pre.out.md[output];
    
    input: lib.build.input[pre.in.settings input] readmes, extendReadmes;
    
    readmeOutput: pre.readme.run[input; ""];
    
    // Update output with the output from readme preprocessor
    : pre.out.with.md[(pre.out.md readmeOutput) ,pre.out.md output] 
        pre.out.with.err[(pre.out.err readmeOutput), pre.out.err output] output
    }
// @fileOverview Split datatypes extracted from the onLoad into a group of each datatype
// @param tagBlock {table (lines:string; tagType:symbol)} A block of comments extracted from onLoad
// @returns {table (lines:string; tagType:symbol)[]} Vector of table. Each table represents a unique datatype 
// dataTypesBlock: blocksDatatypes[4]
.z.m.qd.pre.datatype.i.split:{[tagBlock] 
        
    // Filter out tags that are not related to datatype functionality
    dataTypesBlock: select from tagBlock where tagType in .z.m.qd.data.TAGS`datatype;
    
    // Return empty schema if dataTypesBlock is empty
    if[.z.m.axq.isEmpty dataTypesBlock; : enlist ([] lines:(); tagType:())];
    
    dataTypesList: where dataTypesBlock[`tagType] in `$("@datatype";"@datatype:private");  /dnl
    
    // Do nothing if there is only one datatype in the block
    if[1 = count dataTypesList; : enlist dataTypesBlock];
    
    // If more than one, then split them into different tables
    secondDataTypesList: ( 1_ dataTypesList,(count dataTypesBlock)) - 1j;

    // List of tables, each table corresponding to each @datatype tag block
    retTab: dataTypesList {[x;y;z] select from x where i>=y, i<=z}[dataTypesBlock;;]' secondDataTypesList;
    
    // Return empty schema if no tables exist in retTab
    : $[.z.m.axq.isEmpty retTab; 
        enlist ([] lines:(); tagType:()); 
        retTab];
    }

// @fileOverview This is the datatype preprocessor for qdoc

// @param input         {#pre.in}
// @param y             {*}                 Un-used parameter (can be used for projections)

// @returns {#pre.out}

// @example Arguments
// settings: data.SETTINGS;
// items: select name:ref, kind, content from .axqdtools.ws.artifacts.get[] where module in `.qd;
// input: lib.build.input[settings] lib.build.artifacts items;

// @qlintsuppress UNUSED_PARAM(1)
.z.m.qd.pre.datatype.run:{[input; y]
    
    output: pre.out.new (data.ARTIFACTS; enlist data.ERROR; data.DOCTEST);
    
    if[.z.m.axq.isEmpty pre.in.onLoads input; : output];

    // Parse the onLoad functions to extract the datatype definition block
    dBlocks: pre.datatype.i.dBlocks input;

    // Drop datatype with @private
    if[not pre.in.settings[input]`docprivate;
        dBlocks: dBlocks where not pre.datatype.i.isPrivate dBlocks];
    
    // Get all the information for the functions
    fnsInfo: raze pre.datatype.i.functions[pre.in.settings input] each dBlocks;

    // Return an empty schema if fnsInfo is empty
    if[ .z.m.axq.isEmpty fnsInfo; : output]; 

    // Generate readmes for the new functions that were generated by the datatype tag
    : pre.datatype.i.readme[input; dBlocks]
        pre.datatype.i.md[input; fnsInfo; output];
    }
// @fileOverview Given a tagBlock that contains datatype tags, this function will return 
// new typedef tagBlock that will contain a typedef tag for each datatype tag
.z.m.qd.pre.datatype.tdef:{[settings; tagBlock]
    
    dBlocks: pre.datatype.i.split tagBlock;
    fns: raze pre.datatype.i.functions[settings] each dBlocks;
    newTdefs: select from fns where tagType = `$"@new";
    // Update the ref by dropping .new
    newTdefs: update ref: ` sv/: -1_/: ` vs/: ref from newTdefs;
    newTdefs[`tag]: ?[pre.datatype.i.isPrivate dBlocks;  `$"@typedef:private"; `$"@typedef"];
    tdefs: {`lines`tagType!(enlist " " sv (.z.m.axq.asString x`ref; raze x`rType); x`tag)} each newTdefs;
    descs: raze pre.datatype.i.desc'[newTdefs`ref; dBlocks];
    : tdefs, descs
    }

.z.m.qd.pre.datatype.i.FN_INFO:(lib.artifacts.wc data.ARTIFACTS),'
    flip (!) . flip (
                    (`pType         ; enlist "");              // Param type
                    (`rType         ; enlist "");              // Return type
                    (`overview      ; enlist "");
                    (`tagType       ; `));
.z.m.qd.pre.datatype.onLoad:{[]
    
    // @typedef dBlock          {table (lines:string; tagType:symbol)}  Datatype related tags and their corresponding lines
    
    
    // @typedef fnInfoT         {table (ref:string; 
    //                                  name:string; 
    //                                  category:string; 
    //                                  subcategory:string; 
    //                                  retType: string;
    //                                  overview: string;
    //                                  fnTag: symbol)}
    //                                                                  A table containing function information
    
    }

.z.m.qd.pre.datatype.onLoad[];
system "d .z.m";

system "d .z.m.axqc";
// @fileOverview Converts the q in a .q file to the analyst artifact style
// @param filePath {Symbol} The path to a .q file
// @returns {Dictionary} The number of omitted lines and a table with the files contents
.z.m.axqc.parts.fromFile:{[filePath]
    
    // Read the file from disk
    lines : read0 filePath;
    
    : parts.i.import lines;
    }
// @fileOverview Converts the q in a .q file to the analyst artifact style
// @param text {string} The contents of a .q file
// @returns {Dictionary} The number of omitted lines and a table with the files contents
.z.m.axqc.parts.fromString:{[text]
    // Handle windows newlines
    // This should be safe even for carriage returns in strings
    // since if they are in a string the represent a newline, and not 
    // chariage returns in the string
    text : ssr[text;"\r\n";"\n"];

    lines : "\n" vs text;
    
    : parts.i.import lines;
    }
// @fileOverview Parses a string as though it were being loaded via \l to see if there are any parse errors
// @param text {String} Q code
// @returns {String} "" if there was no error, and a message if there was one
.z.m.axqc.parts.getSyntaxError:{[text]
    
    // Turn the typographical lines into logical lines
    // Since parse doesn't work on a line like parse "// comment\n\\d .",
    // this has to omit comments
    lines: .z.m.axqc.parts.i.extractCode[1b; "\n" vs text] `code;
    
    testLine: {
        // If the line is not in a DSL, try parsing it,
        // and if parsing succeeds, return a tuple indicating there was no error.
        // If parsing fails, this will throw the parse error
        if [(x like "q)*") or not x like "[a-zA-Z])*";
            parse x];
        
        : (0b; "");
        };
    
    // This returns an error tuple if there is an error
    handleError: {[errorMsg]
        // In the case of an error like parse ", 1", the error message is ," ".
        // This needs to be turned into something that will show up
        if [errorMsg ~ enlist " ";
            errorMsg : "Syntax error"];
        
        : (1b; errorMsg);
        };
    
    // Parse each line, making a list of which ones error
    parseResults: .z.m.axq.catch[testLine; ; handleError] each lines;
    
    : $[any parseResults[;0];
    
        // If any of the parses resulted in a error
        [   // Only report the first error
            index : first where parseResults[;0];
            parseResults[index; 1]];
        
        // If nothing errored, return an empty string
        ""];
    }

// @fileOverview In a .q file, lines are ignored until a line the first unindented non"/" char. This removes those ignored lines
// @param lines {String[]} A list of strings which are the lines of a .q file
// @returns {String[]} The same list, with any ignored initial lines dropped
.z.m.axqc.parts.i.countIgnoredLines:{[lines]
    
    // Find the first line that has content, and include all the comments between that and the previous non-comment thing
    trimmedLines: .z.m.axstr.ltrimWhitespace lines;
    
    // Find those lines which are blank
    isBlank : trimmedLines ~\: "";
    
    // Find those lines which are comments
    isComment: trimmedLines[;0] = "/";
    
    // Find the index first line that doesn't have whitespace
    // or the comment char as its first character.
    // This is also the number of lines which should be ignored at the start of the file
    firstLineOfCode : (count lines) ^ first where not lines[;0] in\: " \t/";
    
    : $[null firstLineOfCode;
        
        // If there is no first line of code, everything is ignored
        count lines;
        
        // "0 ^" comes into play when the firstLineOfCode is 0
        0 ^ 1 + last where 0 = firstLineOfCode # isBlank | isComment];
    }
// @fileOverview Drops a list of indices from a list
// @param list {()} Any list
// @param indices {Long[]} The indices that should be dropped
// @returns {()} The list without those indices
.z.m.axqc.parts.i.dropIndices:{[list; indices]
    
    // Create a boolean vector which will indicate which elements are dropped
    isDropped : (count list)#0b;
    
    // Set it to true at the indices passed in
    isDropped[indices] : 1b;
    
    // Filter out all dropped indices
    : list where not isDropped;
    }

// @fileOverview Extract the structured code from a list of strings
// @param omitComments {Boolean} 1b if all comments should be replaced with empty strings
// @param lines {String[]} A list of strings which are the lines of a .q file
// @returns {Table} A table with the columns name, code and codeType.
//  name {String} is the name of the variable the line is assigned to, or "" if there is no assignment, or if it is k)
//  code {String} is what the contents of the editor would be, were that logical line an artifact in IVY
//  codeType {Symbol} is `k, `command, `data or `function depending on what the line is, where function indicates a named function.
//      the `data codeType is used for unnamed functions
.z.m.axqc.parts.i.extractCode:{[omitComments; lines]
    
    // Replace multiline comments with blocks of single line comments
    lines : parts.i.rewriteMultilineComments lines;
    
    // Join and logical lines of code split across multiple lines into a single string
    lines : parts.i.joinCodeLines lines;
    
    // Indented comments are viewed as belonging to the unindented line above them
    trimmedLines :  .z.m.axstr.ltrimWhitespace each lines;
    
    // If a line is not a comment or a blank line, it is counted as code
    // This needs to use ~/: instead of = in case there are blank lines
    isLineCode : not ("/" ~/: trimmedLines[;0]) or 0 = count each trimmedLines;
    
    // Break after every line of code
    breaks: distinct 0 , -1 _ 1 + where isLineCode;
    
    // After breaking on each line of code, pull out the lines of code and join consecutive comments
    comments: "\n" sv/: lines (breaks cut til count lines) except\: where isLineCode;
    
    // If comments are to be ignored, such as to fix KXAX-2321, replace all comments with whitespace
    if [omitComments;
        comments: count[comments]#enlist ""];
    
    // Add a newline to the end of each comment, for when it is joined to the code
    // and remove any blank lines off the front
    comments : parts.i.trimCommentWhitespace each comments ,\: "\n";
    
    // Isolate the lines which are code
    code : lines where isLineCode;
    
    // i.getQExpressionInfo returns a dictionary per line
    // It needs to be joined to this empty table so the result is a table even if there are no lines of code
    // This finds the name, codeType and content of each line of code
    table : ([] name : (); code: (); codeType: `$()) , parts.i.getQExpressionInfo each code;
    
    // Add in the comments
    $[  0 = count table;
        // If there is no code, just add the comments to a new table
        table : ([] name : enlist ""; code: comments; codeType: enlist `data);
        
        // If there is code, prepend the comments to the code
        table[`code] : comments ,' table `code];
    
    : table;
    }
// @fileOverview For a given logical line, identify the type of line,
//  and separate the assignment from the rest of the line
// Anything otherwise uncategorized gets put into a data artifact
// For simplicity, this doesn't handle the form :[a; {x*x}]
// @param text {String} A q expression
// @returns {Dictionary} A dictionary with the name, if the root is an assignment, and the code sans assignment
.z.m.axqc.parts.i.getQExpressionInfo:{[text]
    
    // If it is a command (e.g. "\c 20 1000")
    if [text[0] ~ "\\";
        : `name`code`codeType!(""; text; `command)];

    // If it is a line of k code (e.g. "k) foo:{x~y}")
    if [text[0 1] ~ "k)";
        : `name`code`codeType!(""; text; `k)];
    
    // If it is q code, check if it is an expression being assigned to a variable
    // (e.g. "square: {x*x}")
    // Parse the code
    tree : .z.m.axq.catch[.z.m.axqc.q; text; {`error}];
    
    // These ifs check that it is a valid parse tree representing assignment by : or :: to a variable name
    if [not tree ~ `error;
        if [`DYADIC ~ first first tree[0;0];
            if [`name ~ first tree[0;0;1;0];
                // If the operator is : or :: and there is a second parameter, i.e. not "foo : // nothing"
                if [(tree[0;0;1;1;1] in (enlist ":"; "::")) and 3 = count tree[0;0;1];
                    // Extract the variable name
                    name : tree[0;0;1;0;1];
                    
                    // Extract the text of the expression being assigned
                    rightSubtree : tree[0;0;1;2];
                    rightClause : .z.m.axstr.substring[text; .z.m.axqc.treeMin rightSubtree; .z.m.axqc.treeMax[rightSubtree] + 1];
                    
                    // Join in any comments after the expression
                    rightClause ,: (1 + .z.m.axqc.treeMax tree[0;0]) _ text;
                    
                    // Determine if the expression on the right is a function
                    codeType : $[parts.i.isFunctionTree rightSubtree; `function; `data];
                    
                    // Use the name being assigned to as the name, and the right expression text as the contents
                    : `name`code`codeType!(name; rightClause; codeType)]]]];
    
    : `name`code`codeType!(""; text; `data);
    }

// @fileOverview Converts the q in a .q file to the analyst artifact style
// @param lines {string[]} The text of a .q file split on newlines
// @returns {Dictionary} The number of omitted lines and a table with the files contents
.z.m.axqc.parts.i.import:{[lines]
    
    // Count the number of lines which are ignored because they are before
    // the first line with a character in column 0
    ignoredLines : parts.i.countIgnoredLines lines;

    // The name, contents and codeType of each line
    contents : parts.i.extractCode[0b; ignoredLines _ lines];

    // Put names in the correct contexts
    contents : parts.i.resolveContexts contents;

    // Return these values
    : `ignoredLines`contents!(ignoredLines; contents);
    }
// @fileOverview This checks if a subtree describes a function or a projection
// @param tree {any[]} A subtree for a q expression
// @returns {Boolean} True if the input is a function, or a projection, false otherwise.
//  Although it will also return a false positive if it is a function with all the arguments applied
//  such as {x+y+z}[1;2;3]
.z.m.axqc.parts.i.isFunctionTree:{[tree]
    
    : $[(first first tree) in `PN`APPLY;
            // If the tree represents arguments being passed to something,
            // with or without square brackets,
            // recurse on the expression those arguments are passed to
            .z.s tree[1;0];
        
        (first first tree) ~ `FUNCTION;
            // If the recursion eventually reaches a function, return true
            1b;
        
        // Else
            // If the subtree is neither a function, nor a call to something, return false
            0b];
    }
// @fileOverview Joins logical lines split over different typographical lines
// @param lines {String[]} A list of strings which are the lines of a .q file
// @returns {String[]} The same list, with any run of strings representing the same logical line will merged into a single string
.z.m.axqc.parts.i.joinCodeLines:{[lines]
    trimmedLines: .z.m.axstr.ltrimWhitespace lines;
    
    // Find those lines which are blank
    isBlank : trimmedLines ~\: "";
    
    // Find those lines which are comments
    isComment: trimmedLines[;0] = "/";
    
    // Find those lines that are a continuation of the previous line, including comments
    isContinuation : isComment or lines[;0] in\: "\t ";
    
    // Break on lines that aren't continuations
    // "0 ," there is because 0 needed to get the start of the list, and distinct is there so it isn't added twice
    breaks: distinct 0 , where 0 = isContinuation;
    
    // Any trailing comments should get bumped down to the next line
    // This involves taking a vector like 0001010111b representing a function with comments in it, and after it
    // and turning it into 0000000111b, where only the trailing comments are flagged with 1b
    breaks ,: where raze reverse each (&\)each reverse each breaks cut isComment | isBlank;
    // After joining to break, it may not be sorted, and cut needs sorted arguments
    breaks : distinct asc 0 , breaks;
    
    // And join continuous lines with newlines
    : "\n" sv/: breaks cut lines;
    }

// @fileOverview This provides a clean way to build regexes that won't get freed, as it lacks a mechanism to free them
// @param pattern {string} The PCRE regex pattern
// @param ignoreCase {boolean} If this is true, the regex will be case-insensitive
// @returns {function} A function to run the regex, taking the a string and starting offset as parameters
.z.m.axqc.parts.i.regexBuilder:{[pattern; ignoreCase]
    // @qlintsuppress DEPRECATED_FUNCTION(4)
    compiled: .z.m.fpcre2.compile[pattern;`caseless`multiline`utf];
    result  : .z.m.fpcre2.match[compiled;;::];
    : result;
    }
// @fileOverview Add, to each line, the context it is executing in, then remove the context lines
//  which are made redundant by the explicit context column
// @param table {Table} The result of extracting the names and code from the file
// @returns {Table} The same table with names updated to take context switching into account
.z.m.axqc.parts.i.resolveContexts:{[table]
    // Run a regex to find the \d .myContext pattern, omitting any trailing comments
    dMatches : parts.i.runRegex[parts.i.contextSwitchRegex] each table `code;
    
    // Run a regex to find the system "d .z.m.myContext" pattern, omitting any trailing comments
    sMatches : parts.i.runRegex[parts.i.keywordContextSwitchRegex] each table `code;
    
    // Find every line starting with \d
    // A boolean vector which is true if the line is a context switch
    isDContextSwitch : not () ~/: dMatches;
    isSContextSwitch : not () ~/: sMatches;
    
    // The indicies of all the context switches
    dContextSwitches : where isDContextSwitch;
    sContextSwitches : where isSContextSwitch;
    
    // Find the name of each context by dropping the "\d " or system "d, and update the table context
    table: update context:` from table;
    table: update context:`$.z.m.axstr.ltrimWhitespace 3 _/: dMatches[dContextSwitches;0;0] from table where isDContextSwitch;
    table: update context:`$.z.m.axstr.ltrimWhitespace -1_/: 10 _/: sMatches[sContextSwitches;0;0] from table where isSContextSwitch;
    table[`context]: string fills table`context;
    
    // Add "." to any context that wasn't filled
    // Its done here because fill only works on nulls
    table: update context:count[i]# enlist enlist "." from table where 0=count each context;
    
    // Reorder the table so that context is last (so that I don't break the tests)
    table: `context xcols table;
        
    // Return the table, sans context switching lines
    : table where not max each isDContextSwitch ,' isSContextSwitch;
    }

// @fileOverview This replaces multiline comments with a block of single line comments
//  This is done both to make parsing for comments simpler in the following rewrites of this file
//  and because IVY doesn't support the multiline comment style (in terms of colorization or comment toggling)
// @param lines {String[]} A list of strings which are the lines of a .q file
// @returns {String[]} The same list with all multiline comments converted to blocks of single line comments
.z.m.axqc.parts.i.rewriteMultilineComments:{[lines]
    
    // A \ outside of a multiline comment represents an end-of-script token.
    // A / indicates the start of a multiline comment
    // A \ in a multiline comment indicates the end of that comment
    // In these cases, trailing white space does not affect how it is tokenized
    // but if there is anything else on a line, then neither indicates a multiline comment or end of script
    
    // Since whitespace to the right of a multiline token doesn't affect how it is parsed,
    // remove the whitespace on the right to make it easier to find them
    trimmedLines : .z.m.axstr.rtrimWhitespace lines;
    
    // Find where "/" or "\" appear at the start of a line, optionally followed by whitespace.
    // These are boolean vectors that record, for each line, if the line is one of the tokens
    isMultilineStart : trimmedLines~\:enlist "/";
    isMultilineEnd : trimmedLines~\:enlist "\\";
    
    // This tracks which lines are commented out.
    // A line will be commented out if it is in a multiline comment,
    // or after an end-of-script token
    isCommentedOut : count[lines]#0b;
    
    // Any of the lines containing a multiline comment character,
    // as these are removed after converting multiline comments to blocks of single line comments
    linesToRemove : ();
    
    // The nature of the multiline comment grammar is better suited to a state machine
    // than vector operations
    // This is the counter for tracking the current line when iterating through the lines
    i: 0;
    
    // This is true whenever a line is part of a multiline file
    inMultiline : 0b;
    
    // This is true after an end of script token
    inEndOfScript : 0b;
    
    // Iterate through the lines
    do [count lines;
        $[  inEndOfScript;
                // If an end of script token has been found previously,
                // everything that follows is a comment
                isCommentedOut[i] : 1b;
            
            inMultiline;
                $[  isMultilineEnd i;
                        [   inMultiline : 0b;
                            linesToRemove ,: i];
                        isCommentedOut[i] : 1b];
            // Else
                $[  isMultilineStart i;
                        [   inMultiline : 1b;
                            linesToRemove ,: i];
                    isMultilineEnd i;
                        [   inEndOfScript : 1b;
                            linesToRemove ,: i];
                    // Else
                        // If the line isn't in a multiline comment,
                        // and doesn't contain a multiline comment token,
                        // no action is required
                            ]];       
        i+:1];
    
    // Prepend the single line comment marker "// " to any lines in multiline comments
    lines[where isCommentedOut] : "// " ,/: lines where isCommentedOut;
    
    // Drop the lines containing multiline comment tokens
    lines : parts.i.dropIndices[lines; linesToRemove];
    
    // Return the rewritten lines
    : lines;
    }

// @fileOverview execute the regex
// @param regex {function}
// @param text {string}
// @returns {any[]}
.z.m.axqc.parts.i.runRegex:{[regex; text]
    // list  : ();
    // start : 0;
    // while[ 0 < first result: regex[text; start];
    //     start : `long$result[1; 0];
    //     end   : `long$result[1; 1];
    //     list ,: enlist (.z.m.axstr.substring[text; start; end]; start; end);
    //     start : end;
    //     ];
    // : list;
    (regex text)`x0
    }

// @fileOverview Strip any whitespace lines before the line containing the first comment
// @param comment {String} A string containing one or more lines of whitespace and single line comments
// @returns {String} The input with a subset of the leading whitespace removed
.z.m.axqc.parts.i.trimCommentWhitespace:{[comment]
    // Given an input, which is a mix of lines of whitespace and comments in a single string,
    // This finds the line the first comment is on, and strips everything before it.
    // It intentionally leaves any leading whitespace on the line with the first "/" to preserve formatting
    
    // Find the first slash
    firstSlash : first where comment = "/";
    
    : $[null firstSlash;
        
        // If there is no first slash, it is all whitespace, so return an empty string
        "";
    
        [   // Find the index of the newline immediately preceeding before the first slash
            startOfLine : 0 ^ 1 + last where "\n" = firstSlash # comment;
            
            // Drop that newline and everything before it
            startOfLine _ comment]];
    }

// @fileOverview Builds a regex to match lines that look like "system \"d .z.m.foo\"" while skipping the comment
// Don't look for spaces at the beginning, to avoid finding system "d"'s in functions
.z.m.axqc.parts.i.keywordContextSwitchRegex:parts.i.regexBuilder["(^|\\n)system\\s*\"d\\s+[^\"]+\""; 1b];
// @fileOverview Match lines that look like "\\d .foo" while skipping the comment
// [^ \t/] is to avoid mistaking a comment for a context, if the context is missing
.z.m.axqc.parts.i.contextSwitchRegex:parts.i.regexBuilder["^\\\\d\\s+([^ \t/][^ \t]*)"; 1b]
system "d .z.m";

system "d .z.m.qd";
// @fileOverview Updates the output with the generated markdown table and error table
// @param input         {#pre.in} 
// @param output        {#pre.out} 
// @returns {#pre.out}
.z.m.qd.pre.function.i.md:{[input; output]
    // Get tags in functions    
    alltags: md.tags[pre.in.settings input; pre.in.tdefs input; pre.in.functions input];
    
    if[.z.m.axq.isEmpty alltags; : output];

    // Convert to markdown
    functions: md.gen[pre.in.settings input; alltags];
    
    datastructures: pre.function.i.typedefs[pre.in.settings input; input];
    
    markdown: datastructures[`md], update content: functions`md from lib.artifacts.wc alltags;
    error   : enlist datastructures[`error], functions[`error], raze raze each alltags`error;

    : pre.out.with.md[markdown]
        pre.out.with.err[error]
            pre.out.with.doctest[functions`doctest] output;
    }
// @fileOverview Updates the output with the generated empty readmes for every category and sub category
// @param output {#pre.out} 
// @returns {#pre.out}
.z.m.qd.pre.function.i.readme:{[output]
    if[.z.m.axq.isEmpty lib.drop.empty.artifacts pre.out.md output; : output];

    input: lib.build.input[data.SETTINGS] lib.getReadmes pre.out.md output;
    readmeOutput: pre.readme.run[input; ""];
    
    // Update output with the output from readme preprocessor
    : pre.out.with.md[(pre.out.md readmeOutput) ,pre.out.md output] 
        pre.out.with.err[(pre.out.err readmeOutput), pre.out.err output] output    
    }

// @fileOverview Return the contents of the typedefs page if the user wants to document typedefs separately
// @param settings {#settings} 
// @param input {#pre.in} 
// @returns {dict}
.z.m.qd.pre.function.i.typedefs:{[settings; input]
    
    if[not settings`doctypedef;
        : `md`error!(0#.z.m.qd.data.ARTIFACTS; data.ERROR)
        ];
    
    resolved: md.fromTypedefs[settings; pre.in.tdefs input];

    artifact: cols[data.ARTIFACTS]!(4#`typedefs),`overview_typedefs`,resolved 0;
    
    : `md`error!(artifact;resolved 1)
    }

// @fileOverview This is the function preprocessor for qdoc

// @param input         {#pre.in}
// @param y             {*}                 Un-used parameter (can be used for projections)

// @returns {#pre.out}

// @example Arguments
// settings: sanitize.settings data.SETTINGS;
// items: select name:ref, kind, content from .axqdtools.ws.artifacts.get[] where module in `.qd;
// input: lib.build.input[settings] lib.build.artifacts items;
// @qlintsuppress UNUSED_PARAM(1)
.z.m.qd.pre.function.run:{[input; y]
    output: pre.out.new (data.ARTIFACTS; enlist data.ERROR; data.DOCTEST);
    
    if[.z.m.axq.isEmpty pre.in.functions input; : output];
    
    : pre.function.i.readme
        pre.function.i.md[input; output];
    }
system "d .z.m";

system "d .z.m.qd";
// @fileOverview Parses injectBlock to figure out the functions that need to injected
// from the old namespace to the new namespace
// @returns {dict (injectFrom:symbol; injectTo: symbol; param:string; injectData:table)}

// @example Execute function
// injectBlock: injectBlocks[0];

.z.m.qd.pre.inject.i.data:{[functions; injectBlock]
    
    // Return empty schema if one of the arguments is empty
    if[ max (.z.m.axq.isEmpty functions; .z.m.axq.isEmpty injectBlock); 
        : `injectFrom`injectTo`param`functions ! ((); (); (); ([] ref:`symbol$(); name:`symbol$(); content:()))];
    
    param: raze trim exec lines from injectBlock where tagType in `$"@param";
    (.z.M.qd.injectFrom;.z.M.qd.injectTo) set' " " vs raze raze trim exec lines from injectBlock where tagType in `$"@inject";

    // Get all the functions from the injectFrom namespace
    t: select from functions where ref like (.z.m.qd.injectFrom,"*");   // @qlintsuppress UNDECLARED_VAR(1)
    // Drop the functions selected from the subnamespaces above
    t: t where injectFrom ~/: first each (".",/: .z.m.axq.asString t[`name]) vs' .z.m.axq.asString t`ref; // @qlintsuppress UNDECLARED_VAR(1)
    : `injectFrom`injectTo`param`functions ! (.z.m.axq.asSymbol injectFrom; .z.m.axq.asSymbol injectTo; param; t); // @qlintsuppress UNDECLARED_VAR(1)
    }

// @fileOverview Filters the functions table (all functions) and only returns the functions 
// that needs to be injected into the new namepsaces.
// ref in the returned table will refer to the new namespace
// @param input         {#pre.in}
// @returns {#pre.in}
.z.m.qd.pre.inject.i.functions:{[input]
    
    // Get tagBlocks. Each item relates to all the cooments contained in an onLoad
    tagBlocks: lib.genTagBlocks[pre.in.settings input; pre.in.onLoads[input]`content][1];
    
    // Break down tagBloack into blocks of inject. Each item relates to one inject
    injectBlocks: raze pre.inject.i.split each tagBlocks;
    
    // Get inject data for each namespace (functions that needs to be injected)
    injectData: pre.inject.i.data[(pre.in.functions input), (pre.in.onLoads input)] each injectBlocks;
    injectData: injectData where not .z.m.axq.isEmpty each injectData`functions;
    
    if[.z.m.axq.isEmpty injectData; 
        : lib.build.input[pre.in.settings input] data.ARTIFACTS];
    
    // Drop the functions that don't have the projected param
    // Drop the project param from functions content
    // Update the category in the function table
    functions: raze pre.inject.i.updateContent[pre.in.settings input] each injectData;
    functions: pre.inject.i.updateCat functions;
    
    // Drop onLoad functions because we don't want functions preprocessor to document onLoads
    : pre.in.with.functions[functions]
        pre.in.with.onLoads[0#data.ARTIFACTS] input
    }

// param: data`param;
// tagBlock: first tagBlocks where paramExists;
.z.m.qd.pre.inject.i.getContent:{[param; tagBlock]
    
    // Drop param from the tagblock
    tagBlock: tagBlock where not (first each tagBlock`lines) like ("*",(first param),"*");
    
    // Convert tagBlock to content
    : raze lib.tagToContent `header`body!(tagBlock;0#tagBlock)
    }

// @fileOverview Splits injectsBlock extracted from the onLoad function into a group of each inject
// @param tagBlock {table (lines:string; tagType:symbol)} A block of comments extracted from onLoad
// @returns {table (lines:string; tagType:symbol) []} Vector of table. Each table represents a unique datatype 

// @example
// tagBlock: tagBlocks[23];

.z.m.qd.pre.inject.i.split:{[tagBlock]
    
    // Filter out tags that are not related to inject functionality
    injectsBlock: select from tagBlock where tagType in .z.m.qd.data.TAGS`inject;
    
    // Return empty schema if injectsBlock is empty
    if[.z.m.axq.isEmpty injectsBlock; : enlist ([] lines:(); tagType:())];
    
    // Do nothing if there is only one inject in the block
    if[1 = count where [(`$"@inject") = exec tagType from injectsBlock]; : enlist injectsBlock];
    
    // If more than one, then split them into different tables
    injectsList: where[ (`$"@inject") = exec tagType from injectsBlock]; 
    secondinjectsList: ( 1_ injectsList,(count injectsBlock)) - 1j;
    
    // List of tables, each table corresponding to each @inject tag block
    retTab: injectsList {[x;y;z] select from x where i>=y, i<=z}[injectsBlock;;]' secondinjectsList;
    
    // Return empty schema if no tables exist in retTab
    : $[.z.m.axq.isEmpty retTab; enlist ([] lines:(); tagType:()); retTab];
    }

.z.m.qd.pre.inject.i.updateCat:{[functions]
       
    c: lib.module.toCat functions`module;
    : update module: c`module, category:c`category, subcategory:c`subcategory from functions;
    }

// @fileOverview Parses function contents to find and drop the functions 
// that don't have a matching projected param
// @example
// data: injectData[0];
.z.m.qd.pre.inject.i.updateContent:{[settings; data]
    
    // Return empty schema if data is empty
    if[.z.m.axq.isEmpty data; : 0#data.ARTIFACTS];
    
    // Return empty schema if data`param is empty
    if[.z.m.axq.isEmpty raze data`param; : 0#data.ARTIFACTS];
    
    functions: data`functions;
    
    // Parse the header of the 'to be injected' functions
    tagBlocks: lib.genTagBlocks[settings; functions`content][0];

    // Drop the functions that don't have a matching projected param
    if[ not .z.m.axq.isEmpty tagBlocks; 
        temp: md.transform[1b; ] each tagBlocks;
        paramExists: {[param; io] : first (param) in io`Name }[data`param] each temp`io;
        functions: functions where paramExists;
        
        // Drop the projected param from tagBlocks, convert tagBlocks back to content
        // and update functions table with the new content
        contents: pre.inject.i.getContent[data`param] each tagBlocks where paramExists;
        functions: update content: contents from functions;
        ];
    
    // Update ref to the new namespace
    fn: { .z.m.axq.asSymbol ssr[.z.m.axq.asString z; .z.m.axq.asString x; .z.m.axq.asString y] };
    : update ref:(fn[data`injectFrom; data`injectTo] each ref) from functions; 
    }
// @fileOverview This is the inject preprocessor for qdoc

// @param input         {#pre.in}
// @param y             {*}                 Un-used parameter (can be used for projections)

// @returns {#pre.out}

// @example Arguments
// settings: data.SETTINGS;
// items: select ref, name, kind, content from .z.m.qd.web.i.artifacts.get[] where module in `.qd;
// input: lib.build.input[settings] lib.build.artifacts items;

// @qlintsuppress UNUSED_PARAM(1)
.z.m.qd.pre.inject.run:{[input; y]
    output: pre.out.new (data.ARTIFACTS; enlist data.ERROR; data.DOCTEST);
    
    // Return empty schema if one of the arguments is empty
    if[any .z.m.axq.isEmpty each (pre.in.onLoads input ;pre.in.functions input); : output];
    
    // Update functions table with the new functins to be injected
    // and then run the functions preprocessor
    : pre.function.run[;""]
        pre.inject.i.functions input
    }

system "d .z.m";

system "d .z.m.qd";
// @fileOverview 
// Every code block in the parsedFile table contains the code for the artifact (function or data)
// and all the comments before it. Since readmes don't have any code, readme doc blocks get embedded 
// into code blocks .z.m.axqc.parts.fromString parser
// This function extracts the embded readmes from the code blocks
// @param parsedFile {table} 
// @returns {table} Original table + readmes extract from function/data blocks
.z.m.qd.pre.file.i.extractReadmes:{[parsedFile]

    parsedFile: select from parsedFile where codeType in `function`data;
        
    // Split each code block by new line character and drop the empty ones
    code: code @' where each not "" ~/:/: code: "\n" vs/: parsedFile`code;
    
    // Split each code by // @kind readme|function|data to extract embedded readmes
    ikind: where each not () ~/:/: .z.m.pcre2.match[reg.TAG_KIND; ; ::] each code;
    if[all 0 = count each ikind; : parsedFile];
    
    // Handle the case where some artifcats in the file do not have @kind tag
    // Add one yourself based on the type of code interpretted by the q parser
    code: ?[ikind ~\: `long$(); 
        (enlist each "// @kind ",/:  string parsedFile`codeType),' code; 
        code];
    ikind: ?[ikind ~\: `long$(); 
        count[ikind]#enlist enlist 0; 
        ikind];

    blocks: ikind _' code;

    // Cleanup/break down the last item in each blocks which is supposed to be the actual artifact
    blocks: ("\n" sv/:/: -1_/: blocks),' parsedFile[`name] pre.file.i.splitBlock ' last each blocks;

    // Each item in the list of blocks is coming from embded doc except for the last item
    new: c where not "" ~/: c: raze -1 _/: blocks;
    
    // Each new item that we extracted must start with @kind, so get the right type
    // This allows us to support embedded function/data doc as well
    kind: `$last each " " vs/: first each .z.m.pcre2.match[reg.TAG_KIND; ; ::] each new;
    
    // Update the code for actual artifacts and add new readmes
    : ([] context: count[new]#enlist enlist "."; name: count[new]#enlist "README"; code: new; codeType: kind), 
        update code: last each blocks from parsedFile
    }
.z.m.qd.pre.file.i.getCat:{[functions]
    : functions,' lib.module.toCat functions`module
    }

// p: parts[144]
.z.m.qd.pre.file.i.getModule:{[filesModule; p]
    
    noContextDefined: {(enlist ".") ~ x};
    
    // Return the module as is if module is a subset of name and is not empty
    // Otherwise assume module name is before the first "."
    getModName: {[module; name] 
        : $[(not .z.m.axq.isEmpty module) and name like module,".*";
            module;
            ".", first "." vs 1_name
            ]
        };

    // Cases:
    //     context     |   name
    //     --------------------
    //     `           | .ab.test
    //     `.ab        | .ab.test
    //     `.bb        | .ab.test
    //     `           | test
    //     `.bb        | test
    
    : $[(lib.isFq p`name);
        $[noContextDefined p`context; getModName[filesModule; p`name]; getModName[p`context; p`name]];
        $[noContextDefined p`context; filesModule; p`context]
        ]
    }
// module: first modules;
.z.m.qd.pre.file.i.getName:{[module]

    parts: module`artifacts;
    if[.z.m.axq.isEmpty parts; : ([] ref: (); name: (); module: ())];

    
    moduleNames: pre.file.i.getModule [.z.m.axq.asString module`name] each parts;
    
    // Find all the artifacts in global module
    globalModules: not lib.isFq each moduleNames;
    
    // Find the places where name is not full qualified (starts with a ".")
    relName: not lib.isFq each parts`name;
    // Only join the context to the name if name is relative, context is not global and it is a function.
    ref: ?[relName and not globalModules;
                "." sv/: flip (moduleNames; parts`name);
                parts`name];

    // name = parts`name if it is a relative name, else drop the context from the name 
    name: ?[relName; parts`name; last each (moduleNames,\:".") vs' parts`name];
    
    : .z.m.axq.asSymbol ([] ref: ref; name: name; module: moduleNames);
    }

.z.m.qd.pre.file.i.getType:{[modules; functions]
        
    parts: raze modules`artifacts;
        
    : functions,' select kind: codeType, content: code from parts
    }

// @fileOverview
// Splits the function/data blocks by the `// @end` tag or the first non comment line
// Doesn't do anything if it's a readme block
// @param block {string[]} 
// @returns {string[][]}
.z.m.qd.pre.file.i.splitBlock:{[name; block]

    blockString: "\n" sv block;
    
    // For a function/data block
    // If the block doesn't have a name, it means that we are dealing with qdoc block before a q statement
    // or a qdoc function block at the end of file with no code after it 
    // Split the block at the first non comment line
    if[.z.m.pcre2.test[reg.TAG_KIND_FN_DATA; blockString; ::];
        : $["" ~ name;
            first .z.m.qd.lib.separateDocHeader blockString;
            enlist blockString]
        ];
        
    // Split by @end if it's present
    if[0 < count end: where not () ~/: .z.m.pcre2.match[reg.TAG_END; block; ::];
        : "\n" sv/: (0, 1+end) _ block];
    
    // Split at the first non comment line
    : first lib.separateDocHeader blockString
    }

.z.m.qd.pre.file.i.toFn:{[input]
    
    // Parse each q file into function/data
    artifacts: pre.file.i.extractReadmes each @[;`contents] .z.m.axqc.parts.fromString each pre.in.files[input]`content;
    
    modules: flip `name`artifacts!(pre.in.files[input]`module; artifacts);
    
    // Drop artifacts that can not be documented
    modules[`artifacts]: {select from x where not name like "", codeType in `function`data`readme} each modules[`artifacts];
    
    result:.z.m.table.column.order[; cols data.ARTIFACTS]
        pre.file.i.getCat
            pre.file.i.getType[modules]
                raze pre.file.i.getName each modules;
    :result
    }
// @fileOverview This is the file preprocessor for qdoc

// @param input         {#pre.in}
// @param y             {*}                 Un-used parameter (can be used for projections)

// @returns {#pre.out}

// @example Arguments
// settings: data.SETTINGS;
// paths: enlist `:.z.m.qd.pre.file.test/dummy.q;
// input: lib.build.input[settings] lib.build.artifacts getFiles[settings`recursive] paths;

// @qlintsuppress UNUSED_PARAM(1)
.z.m.qd.pre.file.run:{[input; y]

    output: pre.out.new (data.ARTIFACTS; enlist data.ERROR; data.DOCTEST);
    
    if[.z.m.axq.isEmpty pre.in.files input; : output];
    
    newInput: lib.build.input[pre.in.settings input]
        lib.artifacts.filter[pre.in.settings input]
            pre.file.i.toFn input;

    
    // Append the typedefs from the original input
    // This allows us to use typedefs in q file that were defined in onLoad function artifact.
    // The opposite of that is not supported
    newInput: pre.in.with.tdefs[;newInput]
        distinct pre.in.tdefs[newInput], pre.in.tdefs input;


    // Get the outputs for function and readme preprocessor
    datatypeOutput  : pre.datatype.run[newInput; ""];
    fnOutput        : pre.function.run[newInput;""];
    injectOutput    : pre.inject.run[newInput; ""];
    readmeOutput    : pre.readme.run[newInput; ""];

    // Combine the results from two outputs
    // Ensure readme output comes after because the preprocessor order matters
    result:pre.out.with.md[raze pre.out.md (datatypeOutput; fnOutput; injectOutput; readmeOutput)] 
        pre.out.with.err[raze pre.out.err (datatypeOutput; fnOutput; injectOutput; readmeOutput)] 
            output;
    :result
    }
.z.m.qd.pre.file.toArtifacts:{[artifacts]

    qfiles: select from artifacts where kind = `file, name like "*.q";
    
    if[0 = count qfiles; : artifacts];
    
    others: select from artifacts where (kind <> `file) or kind = `file, not name like "*.q";
    
    : others,
        pre.file.i.toFn
            lib.build.input[data.SETTINGS] 
                qfiles
    }

system "d .z.m";

system "d .z.m.qd";
// @fileOverview 
// Generates markdown documentation from given q files on disk or a table of items. 
// Default output location for the generated markdown files is `./out/md` directory. 

// @param settings  {#settings} Optional Argument. Pass empty dictionary to use default settings
// @param src       {#src}
// @returns output  {#output}

// @example Generate qdoc from all the files (`\*.q`, `\*.README` and `\*.README.md`) in the current directory with different settings.
// // Default settings
//      .z.m.qd.doc[::] `.
//
// // Write the generated markdown files to the specified directory
//      .z.m.qd.doc[(enlist `out)!enlist `:mydir] `.
//
// // Map user defined `description` and `arg` tags to qdoc's `fileoverview` and `param` tags respectively
//      .z.m.qd.doc[(enlist `tagmap)!enlist `description`arg!`fileoverview`param]  `.
//
// // Exclude items whose name matches the *.i.* expression
// // Option 1: By default it will use like 
//      .z.m.qd.doc[(enlist `exclude)!enlist "*.i.*"] `.
// // Option 2: Use like expression 
//      .z.m.qd.doc[(enlist `exclude)!enlist (`like;"*.i.*")] `.
// // Option 3: Use regex expression 
//      .z.m.qd.doc[(enlist `exclude)!enlist (`regex;".*\\.i\\..*")] `.
// 
// // Document items marked as private or have todo tags or have no qdoc tags
//      .z.m.qd.doc[`docprivate`doctodo`docempty!111b] `.
//
// // Do not search for files recursively
//      .z.m.qd.doc[(enlist `recursive)!enlist 0b] `.
// 
// // Do not write generated markdown files to disk
//      .z.m.qd.doc[(enlist `write)!enlist 0b] `.

// @example Generate qdoc from files (`\*.q`, `\*.README` and `\*.README.md`) on disk with default settings
// // Document all the files in the current directory
//      .z.m.qd.doc[::] `.
//
// // Document all the files from the specified directory
//      .z.m.qd.doc[::] `$"/dir/to/files"
//
// // Document only the specified files
//      .z.m.qd.doc[::] `:dir/foo.q`:foo.q`:dir/foo.README.md

// @example Generate qdoc from a table of items
// items: ([] 
//      name: `.foo.bar`.foo.baz`.foo.bat.bar`.foo.bat.BAZ,`$(".foo/README.md"; ".foo.bat/README.md");
//      kind: `function`function`function`data`file`file;
//      content: (
//          "// @fileoverview Description for .foo.bar\n// @category FOO\n// @subcategory\n// @param x {int}\n// @return {long[]}\n{[x]\n til x\n}";
//          "// @fileoverview Description for .foo.baz\n// @category FOO\n// @subcategory\n// @param x {int}\n// @return {int[]}\n{[x]\n \"i\"$til x\n}";
//          "// @fileoverview Description for .foo.bat.bar\n// @category FOO\n// @subcategory BAT\n// @param x {int}\n// @return {byte[]}\n{[x]\n \"x\"$til x\n}";
//          "// @fileoverview Description for .foo.bat.BAZ\n// @category FOO\n// @subcategory BAT\nrand 100";
//          "// @kind readme\n// @category FOO\n// @subcategory \n# Foo Module\nThis is a readme for .foo module\n ...";
//          "// @kind readme\n// @category FOO\n// @subcategory BAT\n# Foo.bat Module\nThis is a readme for .foo.bat module\n ..."
//          )
//      );
// .z.m.qd.doc[::] items

.z.m.qd.doc:{[settings; src]
    
    settings: sanitize.settings settings;
    src:      sanitize.src src;
    
    : i.doc[settings]
        .z.m.qd.pre.file.toArtifacts
            lib.build.artifacts 
                $[`items in key src;
                    src`items;
                    getFiles[settings`recursive] src`paths
                    ];
    }
// TODO: Deprecate this function in next major release after 4.3.0
// @deprecated
// @fileOverview This function has been deprecated. You can now right click a repository/module/file in the workspace to generate doc.
// You can also use `.z.m.qd.doc` to generate doc manually.

// @see qd.doc

// @param x  {#any}
// @throws "Deprecated: Use .z.m.qd.doc instead"

// @qlintsuppress UNUSED_PARAM(1)
.z.m.qd.docws:{[x]
    '"Deprecated: Use .z.m.qd.doc instead";
    }
// recursive: 1b
// paths: enlist `$":.z.m.qd.pre.file.test/dummy.q"
// @private
.z.m.qd.getFiles:{[recursive; paths]
    
    // Get paths to all the files matching the pattern
    files: i.getFile[recursive] each paths;
    
    if[.z.m.axq.isEmpty files; : 0#data.ITEMS];
   
    contents: "\n" sv/: read0 each raze files;
    t: raze paths i.parseFileRef ' files;
    
    : i.validate.items
        t,'([] kind:`file; content: contents)
    }
// @private
.z.m.qd.getTags:{[settings; src]
    
    : i.tags[ 
        sanitize.settings settings;
        sanitize.src src
        ]
    }


// @fileOverview Add a tagmap key to settings if not already present
// @param settings {dict}
// @returns {dict}
.z.m.qd.i.addTagmap:{[settings]
    newMap:    $[`tagmap in key settings; settings`tagmap; (0#`)!()];
    normalize: { lower `${$["@"~x 0;x;"@",x]} each .z.m.axq.asString each x };
    
    if[99h <> type newMap;
        '"tagmap: invalid type, expecting a dictionary"
        ];
    
    // convert new mappings to symbols and add @ if missing
    newMap: (!). normalize @'(key;value)@\:newMap;
    
    : enlist[`] _
        settings ,
        // extend the full tag map with any custom tagmap given
        (enlist[`tagmap]!enlist data.SETTINGS[`tagmap] , newMap) ,
        // extend existing settings
        // join to empty incase we're given a typed dict
        enlist[`]!enlist(::);
    }

// @private
// @TODO Hack for 4.3.0. The internal API should be updated to work with name and module column only.
.z.m.qd.i.convert:{[output]    
    : delete ref from update name: ref from output
    }

.z.m.qd.i.doc:{[settings; artifacts]

    if[.z.m.axq.isEmpty artifacts; 
        '"no items to be documented"
        ];
    
    // @qlintsuppress MISSING_DEPENDENCY(1)
    preprocessors: {.z.m.qd.pre[x;`run]} each (lower settings`preprocessors) except `file;
    
    : i.generate[settings]
        preprocessors @\:
            lib.build.input[settings]
                lib.artifacts.filter[settings] artifacts
    }
// @param settings              {#settings}     
// @param preprocessors         {fn []}     Preprocessor functions
//                                          directory to the additional scripts that needs to be included
// @returns                     {#output}

// @example Arguments
// settings: sanitize.settings data.SETTINGS;

// @private
.z.m.qd.i.generate:{[settings; preprocessors]
    
    // Execute the preprocessors and get their accumalted results
    output: i.preprocess[settings] preprocessors;
    
    if[.z.m.axq.isEmpty pre.out.md output; 
        '"no items to be documented"];

    // Reorder readmes to the top of each file and group them
    output: pre.out.with.md[;output]
        lib.group[settings]
            i.reorder pre.out.md output;
    
    // Write markdown files to disk
    if[settings`write; md.write[settings; output]];
    
    if[not null settings`errFile; settings[`errFile] set pre.out.err output];
    
    : `out`md`error`doctest!(
        lib.ps $[settings`write; settings`mdDir; ""]; 
        i.convert pre.out.md output; 
        pre.out.err output;
        pre.out.doctest output
        )
    }
// path: `:.qd;
// @private
.z.m.qd.i.getFile:{[recursive; path]
    
    // Join path to each path name
    fp: {` sv/: x,/: y};

    : $[11h ~ type key path;      // dir
            [
                paths: fp[path] key path;
                $[recursive;
                    raze .z.s[recursive;] each paths;
                    raze reg.filename_match paths
                    ]
                ];
        -11h ~ type key path;     // path
            reg.filename_match path;
            ()
            ]
    }


// @fileOverview Extracts ref from file names
// @param path {#hsym} 
// @param file {#hsym[]}
// @returns {table}
// @private
.z.m.qd.i.parseFileRef:{[path; file]
    
    // Drop path from files for directory paths
    // Don't delete anything for file paths since two extracted files could have same name
    file: lib.lPath each file;
    path: lib.lPath path;
    refs: $[11h ~ type key path;
        last each (lib.unhsym string path) vs/: lib.unhsym each string file;
        lib.unhsym each string file
        ];
        
    // Q file names doesn't matter since the category/subcategory 
    // is extracted from content in the q file
    refs[qi]: refs qi: where refs like "*.q";
    
    // Readmes don't have any code that we can use to extract category
    // So, try to extract the cat/subcat info from the parent directory name
    readmes: "/" sv/: -2#/: "/" vs/: refs ri:where not .z.m.axq.isEmpty each reg.readmeFile refs;
    refs[ri]: (first each (first each reg.readmeFile readmes) vs' readmes),\: "/README";
    
    : flip enlist[`name]!`$enlist i.rem each refs
    }
// @fileOverview Executes the preprocess and returns their accumalated results 
// @param preprocessors {fn []}
// @returns {dict}
// @private
.z.m.qd.i.preprocess:{[settings; preprocessors]
    
    // KXAX-13025 : Key the table on ref, and subcat to prevent a readme from getting overidden
    // Previously a default generated readme for a category was getting overriden by the actual readme
    // even if it didn't belong to the same category/subcategory
    output: pre.out.new (`ref`category`subcategory xkey data.ARTIFACTS; data.ERROR; data.DOCTEST);
    
    // Get the result from the preprocessors
    fn: {[settings; output; f]
            ret: f settings;
            output: pre.out.with.md[;output] (pre.out.md output) upsert pre.out.md ret;
            output: pre.out.with.err[;output] (pre.out.err output) upsert raze pre.out.err ret;
            output: pre.out.with.doctest[;output] (pre.out.doctest output) upsert pre.out.doctest ret;
            : output
            } settings; 

    output: fn over enlist[output], preprocessors;

    // Get the columns in right order so that all the empty entries can be deleted
    output: pre.out.with.md[; output]
                lib.drop.empty.md 
                    .z.m.table.column.order[;cols data.ARTIFACTS] 
                        0!`category`subcategory xasc pre.out.md output;

    // Move the artifacts with global category (`Global) to the top of the table
    globalMD: select from pre.out.md[output] where category = .z.m.qd.data.GLOBAL_CAT;
    allMD: globalMD, select from pre.out.md[output] where category <> .z.m.qd.data.GLOBAL_CAT;
    
    output: pre.out.with.md[allMD] output;
    output: pre.out.with.err[`ref xasc pre.out.err output] output;
    
    : output
    }
// Removes '/' or './' from the begining of the path
.z.m.qd.i.rem:{$[x like "./*"; 2_x; x like "/*"; 1_x; x]};

// @fileoverview Generating doc from q files and readmes results in 2 readmes. 1 from file preprocessor with
// empty content and other from readme preprocessor with right content but with whole system path in ref and module
// Join the contents of the two and keep the module and ref from the one with empty content generated by readme preprocessor
// @private
.z.m.qd.i.removeDuplicateReadme:{[t]
    t: t iasc 0 <> count each t`content;
    : cols[t] xcols 0!select first ref, first module, "" sv content by name, kind, category, subcategory from t
    }

// The hack below is to ensure that the content of README files for each cat-subcat is written at the 
// top of each file
// @private
.z.m.qd.i.reorder:{[markdown]

    t1: i.removeDuplicateReadme select from markdown where name = `README, kind in `file`readme;
    t2: select from markdown where name <> `README, not kind in `file`readme;
    t : ungroup `category`subcategory xgroup t1, t2;
    
    // An empty category will show up in the doc if all its sub items gets dropped because they are private/empty
    // So, drop categories that only have an empty readme and no sub categories or functions/data
    isEmptyCategory: {[table; cat]
        if[cat ~ `index; : 0b];
        filtered: select from table where category = cat;
        : (all `readme = filtered`kind) and all filtered[`content] like\: ""
        };
    dropCategories : c where isEmptyCategory[t] each c: exec distinct category from t;
    t: delete from t where category in dropCategories;
    
    : .z.m.table.column.order[t; cols data.ARTIFACTS]
    }
    
.z.m.qd.i.tags:{[settings; src]

    : md.tags[settings; ::]
        lib.artifacts.filter[settings]
            lib.build.artifacts 
                $[`items in key src;
                    src`items;
                    getFiles[settings`recursive] src`paths
                    ];
    }

// @fileOverview Validate artifacts
// @param items {#items} 
// @returns {#items}
.z.m.qd.i.validate.items:{[items]
    
    if[not all x:(cols data.ITEMS) in cols items;
        '"src: items missing one/more columns: ", ", " sv .z.m.axq.asString cols[data.ITEMS] where not x
        ];
    
    // Catch old column names
    if[any m:`ref`artType in cols items;
        '"src: ", (", " sv .j.j each `ref`artType where m), " column(s) not supported. Expecting: name, kind, content"  
        ];
    
    items: cols[data.ITEMS] xcols items;
    
    m1: delete a from meta cols[data.ITEMS]#items;
    m2: delete a from meta $[0 = count items; 0#data.ITEMS; data.ITEMS];
    
    if[not m1 ~ m2;
        '"src: items schema is incorrect"
        ];

    if[`qfn in items`kind;
        '"src:\"qfn\" kind not supported. It must be one of: file, function, data"
        ];
    
    : items
    }
// paths: hsym enlist `$"Test/prcl.q";
// paths: hsym `$("Test/prcl.q"; "test2.q");
// paths: hsym `$("Test/test1.q"; "test2.q");
.z.m.qd.i.validate.paths:{[paths]

    $[all missing:.z.m.axq.isEmpty each key each paths;
        '"src: none of the specified path(s) exist on disk";
      any missing;
        '"src: can not find following path(s) on disk: ", ", " sv 1_/:.z.m.axq.asString paths where missing; 
        paths
        ]  
    }

// @fileOverview Validates/ sanitizes basic settings
// @param settings {#.z.m.qd.settings} 
// @returns {#.z.m.qd.settings}
// @example 
// settings: data.SETTINGS;  
// @private
.z.m.qd.i.validate.settings:{[settings]

    i.validateType[settings; `out; `symbol`char`chars`unary];
    i.validateType[settings; `errFile; `symbol`char`chars`unary];

    i.validateType[settings; ;`boolean] each 
        `docprivate`docempty`doctodo`doctest`doctypedef`recursive`write`sanitizeURL`checkParams;

    i.validateType[settings; ;`symbol] each `group`idstyle`resolve;

    i.validateType[settings; ;`dictionary] each `tagmap`defaults;

    i.validateType[settings; `preMarkdownHook; `lambda`unary`binary`ternary`projection`composition,(`$("f'";"f/";"f\\";"f':";"f/:";"f\\:")),`dynamicload];

    if[not (type settings`exclude) in 10 0h;
        '"exclude: invalid type, expecting either a string or tuple (symbol; string)"];

    if[0h ~ type settings`exclude;
        if[not any -11 10h ~ type each settings`exclude;
            '"exclude: invalid type, expecting a tuple (symbol; string)"];

        if[not (first settings`exclude) in `regex`like;
            '"exclude: invalid option, expecting regex or like"]
        ];

    if[settings[`doctypedef] and not settings[`resolve] in `table`qd;
        '"doctypedef feature is only supported for table and qd type resolutions"
        ];

    if[any m: not value[settings`tagmap] in TAGS;
        '"tagmap: invalid qdoc tags (", (", " sv string value[settings`tagmap] where m), 
            "). See .z.m.qd.TAGS for a list of valid tags"
        ];

    if[not (meta each data.DEFAULTS) ~ meta each settings`defaults;
        '"defaults: invalid meta of tables"];

    settings[`preprocessors]: $[-11h = type settings`preprocessors;
            enlist settings`preprocessors;
        11h = type settings`preprocessors;
            settings`preprocessors;
            '"preprocessors: invalid type, expecting a symbol or a list of symbols"
        ];

    // Check for inavlid preprocessors
    if[any not m:settings[`preprocessors] in data.SETTINGS`preprocessors;
        '"invalid preprocessors: ", ", " sv .z.m.axq.asString settings[`preprocessors] where not m];

    settings[`errFile]: hsym .z.m.axq.asSymbol settings`errFile;
    
    // Add default output directory if required
    // Append the CWD if the supplied path wasn't an absolute path
    settings[`out]: lib.outdir settings`out;

    // Internal settings
    settings[`resolve]: `table;
    settings[`mdDir]: ` sv settings[`out],`md;

    : settings
    }

.z.m.qd.i.validateType:{[settings; property; expectedType]
    
    if[not .z.m.axq.typeOf[settings property] in expectedType;
        'string[property],": invalid type, expecting ", " or " sv string raze expectedType
        ];
    }

// @fileOverview Validate/ sanitize the settings dictionary 
// @param settings {#settings} 
// @returns {#settings}

// @example Arguments
// settings: data.SETTINGS;

// @private
.z.m.qd.sanitize.settings:{[settings]
    
    if[(.z.m.axq.isEmpty settings) or .z.m.axq.isNull settings; 
        settings: data.SETTINGS];
    
    if[not 99h ~ type settings;
        '"settings: invalid type, expecting a dictionary"];
    
    settings: i.addTagmap (enlist `) _ settings;
    
    // Check for invalid flags; do not complain about renderer specific flags
    // @qlintsuppress MISSING_DEPENDENCY(1)
    rendererFlags: $[`out in key .z.m.qd; key raze {.z.m.qd.out[x;`i;`SETTINGS]} each 1_key .z.m.qd.out; ()];
    if[any not m:(cols settings) in cols[data.SETTINGS], rendererFlags;
        '"settings: invalid flag(s): ", ", " sv .z.m.axq.asString (cols settings) where not m];

    // Overwrite default settings with the given settings
    settings: data.SETTINGS, settings;
    
    // Type validation
    settings: i.validate.settings settings;
    
    : settings
    }

// src: "Test"
// src: ("Test/test1.q"; "test2.q")
// src: `$"Test/test.q"
// src: `$("Test/test1.q"; "test2.q")
// src: `.qd
// src: `.qd`.z.m.qd.types
// @private
.z.m.qd.sanitize.src:{[src]
    
    : $[98h ~ type src;
            enlist[`items]!enlist i.validate.items src;
        (type[src] in 10 -11h) or all (type each src) in 10 -11h;
            enlist[`paths]!enlist i.validate.paths raze hsym .z.m.axq.asSymbol src;
            '"src: expecting a symbolic file/directory path or a table of items"
        ]
    }

// @fileOverview Returns a symbolic list of valid QDoc types.
.z.m.qd.TYPES:asc .z.m.qd.types.ALL
// @fileOverview Returns a symbolic list of valid QDoc tags.
.z.m.qd.TAGS:distinct raze value data.TAGS
// @private
.z.m.qd.LITERALS:(!) . flip ((`fileOverview  ; "// @fileOverview Enter a description here...\n");
            (`returns       ; "// @returns {Type} Enter a return description here...\n");
            (`body          ; "{[]\n    \n    }\n"));
// @private
.z.m.qd.onLoad:{[]
    
    // @default-category .qd Documentation Generator
    // @default-subcategory .z.m.qd.out.pandoc Pandoc Plugin
    // @default-subcategory .z.m.qd.out.mkdocs Mkdocs Plugin
    
    // @typedef src {(#files|#items)}
    //  Source of the data to be documented. You can document using q files on disk or a table of items
    
    // @typedef settings {dict ( 
    //  out             : symbol;
    //  errFile         : symbol;
    //  preprocessors   : symbol[];
    //  tagmap          : dict(...symbol:symbol);
    //  group           : symbol;
    //  exclude         : string| (symbol; string);
    //  docprivate      : boolean;
    //  docempty        : boolean;
    //  doctodo         : boolean;
    //  doctest         : boolean;
    //  recursive       : boolean;
    //  write           : boolean;
    //  sanitizeURL     : boolean
    // )}
    //
    // @desc settings.out           Path to store generated documentation. Default is ./out
    // @desc settings.errFile       Path to file to store the errors/warnings encountered during qdoc generation
    // @desc settings.preprocessors Specifies the preprocessors you want to run. Options are `FILE`, `FUNCTION`, `README`. Default is all.
    // @desc settings.tagmap        Use a non-default tag name, i.e. ``` `parameter`description!`param`fileoverview` ```
    // @desc settings.group         Specifies grouping in markdown files. Options are `category` and `subcategory`. Default is category.
    // @desc settings.exclude       Specifies a regex expression indicating items to exclude.
    // @desc settings.docprivate    Specifies whether to include items with an @private tag. Default is false. 
    // @desc settings.docempty      Specifies whether to include items that have no qdoc tags. Default is false. 
    // @desc settings.doctodo       Specifies whether to include items that have @todo tags. Default is false. 
    // @desc settings.doctest       Specifies whether to run and document examples with @doctest tags. Default is false. 
    // @desc settings.recursive     Specifies whether to recurse subdirectories looking for q scripts and README.md files. Default is true.
    // @desc settings.write         Specifies whether to write the generated markdown files to disk. Default is true.
    // @desc settings.sanitizeURL   Specifies whether to sanitize the file names by replacing spaces and underscores with hyphen. Default is false.
    // @desc settings.preMarkdownHook If provided, this function will be called on the representation of the documentation prior to it being converted to markdown. Default is `::`.
    
    // @typedef files {symbol|symbol[]} 
    // A symbolic path to the q file or the directory if you want to document all files in the directory 
    
    // @typedef items {table (
    //  name    : symbol;
    //  kind    : symbol;
    //  content : string
    // )}
    // An in memory table of items to be documented
    //
    // @desc items.name     Symbolic name of the items inlcuding their namespace/context. E.g.: .foo.bar
    // @desc items.kind     Symbolic type of the items. Could be one of \`function\`, \`data\`, \`file\`
    // @desc items.content  String contents of the items
    
    // @typedef output  {dict (
    //  out : hsym;
    //  md  : table (
    //      file        : symbol; 
    //      name        : symbol; 
    //      kind        : symbol; 
    //      module      : symbol; 
    //      category    : symbol; 
    //      subcategory : symbol; 
    //      content     : string);
    // error: table (
    //      ref         : symbol; 
    //      qdType      : string; 
    //      errorType   : symbol; 
    //      error       : string)
    // )}     
    // A dictionary of path to the output directory (MD files), markdown content in each file and the table of errors
    //
    // @desc output.out             The directory where the generated markdown files are written on disk
    // @desc output.md              A table of items and their generated markdown content
    // @desc output.md.file         Name of the markdown file where the item resides
    // @desc output.md.name         Name of the item
    // @desc output.md.kind         Type of the item
    // @desc output.md.module       The module the item belongs to
    // @desc output.md.category     The category the item belongs to
    // @desc output.md.subcategory  The subcategory the item belongs to
    // @desc output.md.content      Markdown content of the item
    // @desc output.error           A table of errors encountered during markdown generation
    // @desc output.error.ref       Name of the item
    // @desc output.error.qdType    The documented qdoc type
    // @desc output.error.errorType The type of error (`PARSE` or `RESOLUTION`)
    // @desc output.error.error     The error message    
        
    // @typedef:private artifacts {table (
    //  ref         : symbol;
    //  name        : symbol; 
    //  kind        : symbol;
    //  module      : symbol; 
    //  category    : symbol; 
    //  subcategory : symbol;
    //  content     : string
    //  )}
    //  A table containg information about artifacts
    
    // @typedef:private functions       {table (ref:symbol; name:symbol; contents:string)} Table of ref (fully qualified fucntion names), name (function names) and content(contents of function)
    
    // @typedef:private onLoad          {table (ref:symbol; name:symbol; contents:string)} Table of ref (fully qualified onLoad names), name (onLoad names) and content(contents of onLoad)
    
    // @typedef:private readmes         {table (ref:symbol; name:symbol; contents:string)} Table of ref (fully qualified readme names), name (readme names) and content(contents of README)
    
    // @typedef:private mdT             {table (ref:string; content:string)} Table containing artifact's MD file name and MD content
    
    // @typedef:private catT            {table (ref:string; kind:string; module:string; category:string; subcategory:string)}
    //      Table containing artifact's fully qualified name, category and subcategory
    
    // @typedef:private catD            {dict (ref:string; kind:string; module:string; category:string; subcategory:string)} 
    //      Dictionary of fully qualified name, category and subcategory of an artifact
    
    // @typedef:private ioTags          {table (Tag: symbol; Name: string; Type: string; Description: string)}  Table of IO tags (param, returns, throws) with their name type and description
    
    // @typedef:private ioTag           {dict (Tag: symbol; Name: string; Type: string; Description: string)}   Dictionary of IO tag (param, returns, throws) with their name type and description
    
    // @typedef:private errorD          {dict (ref: symbol; qdType: string; errorType: symbol; error: string)}
    //                                A dict containing information about an arror  
    
    // @typedef:private errorT          {table (ref: symbol; qdType: string; errorType: symbol; error: string)}
    //                                  A table containing information about all the errors  
    
    // @typedef:private tags            {table (ref:symbol; kind:symbol; overview:table; io:table; example:table; see:table; todo:table; error:table)}
    //                                  A table containing qdoc tags extracted from function header
    
    // @datatype .z.m.qd.pre.in
    // @private
    // @fileoverview Input datastructure for the preprocessors
    // @mutable files           {table (ref: symbol; name: symbol; kind: symbol; module: symbol; category: symbol; subcategory: symbol; content: string)}          
    //                                      Artifacts table cotaining information about files
    // @mutable functions       {table (ref: symbol; name: symbol; kind: symbol; module: symbol; category: symbol; subcategory: symbol; content: string)}          
    //                                      Artifacts table cotaining information about functions    
    // @mutable readmes         {table (ref: symbol; name: symbol; kind: symbol; module: symbol; category: symbol; subcategory: symbol; content: string)}          
    //                                      Artifacts table cotaining information about readmes    
    // @mutable onLoads         {table (ref: symbol; name: symbol; kind: symbol; module: symbol; category: symbol; subcategory: symbol; content: string)}          
    //                                      Artifacts table cotaining information about onLoads
    // @mutable tdefs           {table}
    //                                      A table of typedefs extracted from onLoad functions
    // @field   settings        {#.z.m.qd.settings}
    //                                     A dictionary containg settings for generating QDoc. <br>
    .z.m.axdatatype.create[`.z.m.qd.pre.in; `files`functions`readmes`onLoads`tdefs`settings; `files`functions`readmes`onLoads`tdefs];
    
    // @datatype:private .z.m.qd.pre.out
    // @fileoverview Output datastructure from the preprocessors
    // @mutable md              {table (ref: symbol;  name: symbol; kind: symbol; module: symbol; category: symbol; subcategory: symbol; content: string)}          
    //                                      Markdown table cotaining information about generated markdown content
    // @mutable err             {table (ref: symbol; qdType: (); errorType: symbol; error: ())}          
    //                                      Error table cotaining information about the errors encountered while running the preprocessor
    .z.m.axdatatype.create[`.z.m.qd.pre.out; `md`err`doctest; `md`err`doctest];
    
    }

.z.m.qd.onLoad[];
system "d .z.m";

system "d .z.m.qd";
// @private
// @subcategory Mkdocs Plugin
// @deprecated Will be removed in the next release
// @fileOverview Returns the version of mkdocs
// @returns {string} version number
.z.m.qd.out.mkdocs.getVersion:{[]
    last "version " vs first @[system; "mkdocs -V"; {'"mkdocs is not installed"}]
    }
// @fileOverview Builds the nav (pages) list for mkdocs configuration file. 
// Builds a flat list if the user wants items grouped by category.
// @param settings {#out.mkdocs.settings} 
// @param output {#ret}
// @returns {string[]} Return structions look like the following

// For group equals `category
// nav:
//   - Overview: index.md
//   - cat1:
//   - cat1: cat1.md
//   - cat2: cat2.md
//   - cat3: cat3.md

// For group equals `subcategory
// nav:
//   - Overview: index.md
//   - cat1:
//     - Introduction: cat1.md
//     - subcat1: cat1_subcat1.md
//     - subcat2: cat1_subcat2.md
//   - cat2.md: 
//     - Introduction: cat2.md
//     - subcat1: cat2_subcat1.md

// @private
.z.m.qd.out.mkdocs.i.getNav:{[settings; output]

    // Don't add index.md and typedefs files to the generated navtable because they are supposed 
    // to be linked to the overview
    ignore: `index.md, `$data.TYPEDEFS_FILENAME;
    links: $[
        `category ~ settings`group; 
        [
            navtable: string key select by file, category from pre.out.md output where not file in ignore;
            {"  - ", x[`category], ": ", x`file} each navtable 
            ];
        `subcategory ~ settings`group; 
        [
            navtable: `category xgroup string distinct 
                select file, category, subcategory from pre.out.md output where not file in ignore;  
            categories: "  - ",/:(exec category from navtable),\: ": ";
            subcategories: {"    - ", $["" ~ x`subcategory; "Introduction"; x`subcategory], ": ", x`file} each/: flip each navtable;
            raze (enlist each categories),'value subcategories
            ];
            '"group: unsupported group attribute ", string settings`group
        ];

    : out.mkdocs.i.NAV, $[settings`doctypedef; out.mkdocs.i.NAV_TYPEDEFS; ""], links
    }
// @fileOverview Returns the contents from a file on disk.
// @param x {stmbol|string|string[]} 
// @returns {string []}
// @private
.z.m.qd.out.mkdocs.i.getUserFileContents:{[x]
    : $[-11h ~ type x;
        $[not () ~ key hsym x;
            read0 hsym x;
            '"config: specified file doesn't exist"];
       0h ~ type x;
        $[all 10h = type each x;
            x;
            '"config: expecting a symbolic file path or string contents"];
       10h ~ type x;
            enlist x;
            '"config: expecting a symbolic file path or string contents"
        ]
    }

// @fileOverview Validate the output from markdown generation
// @param output {#ret} 
// @private
.z.m.qd.out.mkdocs.i.output.validate:{[output]
    
    if[(not `out in key output) or .z.m.axq.isEmpty[output`out] or .z.m.axq.isNull output`out;
        '"missing: path to generated markdown files on disk"];
    
    if[() ~ key hsym .z.m.axq.asSymbol output`out;
        '"no files at the specified path"];
    
    if[not `md in key output;
        '"missing: table of items and their generated markdown content"];
    
    if[.z.m.axq.isEmpty[output`md] or type[output`md] <> 98h; 
        '"no items in the markdown table"];
    }

// @fileOverview Sanitize settings dictionary
// @param settings {#out.mkdocs.settings} 
// @param output {#ret} 
// @returns {dict}
.z.m.qd.out.mkdocs.i.settings.sanitize:{[settings; output]
    
    if[(.z.m.axq.isEmpty settings) or .z.m.axq.isNull settings; 
        settings: out.mkdocs.i.SETTINGS];
    
    if[not 99h ~ type settings;
        '"settings: invalid type, expecting a dictionary"];
    
    // Overwrite default settings with the given settings and only keep the relevant settings
    // Allows user to pass same dict to the generate markdown and render it using one of the plugins
    settings: (key out.mkdocs.i.SETTINGS)#out.mkdocs.i.SETTINGS, settings;
    
    if[.z.m.axq.isNull settings`out;
        settings[`out]: ` sv -1_ ` vs lib.lPath output`out];
    
    : out.mkdocs.i.settings.validate out.mkdocs.i.SETTINGS, settings
    }

// @fileOverview Validate the items in the settings dictionary
// @param settings {#out.mkdocs.settings} 
// @returns {#mkdocs.settings}
.z.m.qd.out.mkdocs.i.settings.validate:{[settings]
    
    if[not (type settings`out) in -11 -10 10 101h;
        '"out: invalid type, expecting a symbol or hsym or string"];
    
    if[not (type settings`sitename) in -11 -10 10 101h;
        '"sitename: invalid type, expecting a symbol or string"];
    
    if[-1h <> type settings`sanitizeURL;
        '"sanitizeURL: invalid type, expecting boolean"];
    
    if[not (::) ~ settings`config;
        settings[`config]: out.mkdocs.i.getUserFileContents settings`config];
    
    if[not (::) ~ settings`index;
        settings[`index]: out.mkdocs.i.getUserFileContents settings`index];
    
    if[not .z.m.axq.isNull settings`assets;
        
        $[type[settings`assets] in -11 -10 10h;
            if[() ~ key hsym .z.m.axq.asSymbol settings`assets; 
                '"assets: specified directory doesn't exist"];     
            '"assets: expecting a symbol or hsym or string"
            ]
        ];

    settings[`out]: hsym .z.m.axq.asSymbol settings`out;
    settings[`htmlDir]: ` sv settings[`out],`doc;
    settings[`mdDir]: ` sv settings[`out],`md;
    settings[`assets]: hsym .z.m.axq.asSymbol settings[`assets];
    
    : settings
    }

// @fileOverview Builds a default config file if it isn't supplied and writes it to disk. 
// nav list is appened in both cases
// @param settings {#out.mkdocs.settings} 
// @param output {#ret} 
// @returns {symbol}
// @private
.z.m.qd.out.mkdocs.i.write.config:{[settings; output]
    
    settings[`config]: $[(::) ~ settings`config;
        out.mkdocs.i.CONFIG settings`sitename;
        settings`config
        ];
    
    : (` sv settings[`htmlDir],`mkdocs.yml) 0:
       settings[`config], out.mkdocs.i.getNav[settings; output]
    }
// @fileOverview Copies markdown files from the qdoc markdown output directory to mkdocs directory
// @param settings {#out.mkdocs.settings} 
// @returns {symbol | symbol[]}
.z.m.qd.out.mkdocs.i.write.file:{[settings]
    
    .z.m.ax.os.mkdir lib.unhsym string (dd:` sv settings[`htmlDir],`docs);
    
    files: key ` sv settings[`mdDir],`;
    src: ` sv/: settings[`mdDir],/: files;
    dst: ` sv/: dd,/:files;
    
    .z.m.ax.os.cp ./: flip lib.unhsym each string (src; dst);
    
    : dst
    }
// @fileOverview Builds a default index.md with table of contents if one isn't provided.
// Append the ToC to the index.md file if it was generated by qdoc core
// @param settings {#out.mkdocs.settings} 
// @param output {#ret} 
// @returns {symbol}
// @private
.z.m.qd.out.mkdocs.i.write.index:{[settings; output]

    index: (` sv settings[`htmlDir],`docs`index.md);
    
    if[(::) ~ settings`index;
        
        navtable: `category xgroup string distinct 
            select file, category, subcategory from pre.out.md output where not category in `index`overview_typedefs;
        
        categories: {"  - ", md.link[x; y; y, ".md"; ""]}[settings] each exec category from navtable;
        // Drop the first subcategory for each one because it's empty. Represents top level module
        subcategories:  ", " sv/: (md.link[settings;;;""] . value @) each/: 1_/:flip each select subcategory, file from navtable;
        subcategories: ?["" ~/: subcategories; subcategories; ": " ,/: subcategories];
        
        toc: out.mkdocs.i.INDEX, categories,' subcategories;

        settings[`index]: $[() ~ key index; toc;  toc,  enlist[""], read0[index] ]
        ];
    
    : index 0: settings`index
    }
// @fileOverview Writes static files to disk
// @param settings {#out.mkdocs.settings} 
// @returns {symbol[]}
// @private
.z.m.qd.out.mkdocs.i.write.static:{[settings]

    if[.z.m.axq.isNull settings`assets; : (::)];
    
    src: lib.unhsym .z.m.axq.asString ` sv settings[`assets], `.;
    dst: lib.unhsym .z.m.axq.asString ` sv settings[`htmlDir],`assets;
    .z.m.ax.os.mkdir dst;
    .z.m.ax.os.cp[src; dst];
    }
// @private
// @subcategory Mkdocs Plugin
// @deprecated Will be removed in the next release
// @fileOverview Checks whether mkdocs is installed on the server or not.
// @returns {boolean}
.z.m.qd.out.mkdocs.isInstalled:{[]
    not .z.m.axq.isEmpty @[system; "mkdocs -V"; ()]
    }

// @subcategory Mkdocs Plugin
// @fileoverview 
// Organizes Markdown files generated by the `.z.m.qd.doc` function in a directory structure 
// that can be consumed by mkdocs to build a static HTML site. 
// Copy the files output by this function to an mkdocs dev environment and execute 
// `mkdocs serve` or `mkdocs build` to build a static HTML site.
//
// Mkdocs is not required to run this function since it doesn't actually build the site.

// @param settings  {#out.mkdocs.settings} Optional. Pass generic null to use defaults
// @param output    {#output} Output from the .z.m.qd.doc function
// @returns {dict (out: symbol; md: table (file: symbol))} Filenames of all the md files written to the disk

// @desc settings.out           Path to the generated Markdown files on disk. By default it will be determined from output.out
// @desc settings.config        Path/contents of a mkdoc.yml file. A default config file will be used if nothing is specified
// @desc settings.index         Path/contents of an index file. A default index file will be used if nothing is specified
// @desc settings.assets        Path to a directory holding static assets referenced in the user specified config file
// @desc settings.sitename      Symbolic name for the site. This will be ignored if the config file is supplied by the user
// @desc settings.group         Specifies grouping in Markdown files. Options are `category` and `subcategory`. Default is category.
// @desc settings.sanitizeURL   Specifies whether to sanitize the file names (URLs) by replacing spaces and underscores with hyphen. Default is false.

// @desc output.out             The directory where the generated Markdown files are written on disk
// @desc output.md              A table of items and their generated Markdown content
// @desc output.md.file         Name of the Markdown file the item would exist in
// @desc output.md.name         Name of the item
// @desc output.md.kind         Type of the item
// @desc output.md.module       The module this item belongs to
// @desc output.md.category     The category this item belongs to
// @desc output.md.subcategory  The subcategory this item belongs to
// @desc output.md.content      Markdown content of the item
// @desc output.error           A table of errors encountered during Markdown generation
// @desc output.error.ref       Name of the item
// @desc output.error.qdType    The documented QDoc type
// @desc output.error.errorType The type of error (`PARSE` or `RESOLUTION`)
// @desc output.error.error     The error message

// @example Setup with default settings
// .z.m.qd.out.mkdocs.write[::] .z.m.qd.doc[::] `.foo.q

// @example Setup with user defined config, index and assets
// .z.m.qd.out.mkdocs.write[`config`index`assets!`:/path/to/mkdocs.yml`:/path/to/index.md`:/path/to/assets] .z.m.qd.doc[::] `.foo.q

// @example Group the items by subcategory
// .z.m.qd.out.mkdocs.write[``group!``subcategory] .z.m.qd.doc[``group!``subcategory] `.foo.q

// @see qd.doc
.z.m.qd.out.mkdocs.write:{[settings; output]

    out.mkdocs.i.output.validate output;
      
    settings: out.mkdocs.i.settings.sanitize[settings; output];
    
    out.mkdocs.i.write.static settings; 

    files: out.mkdocs.i.write.file settings;
    
    files,: out.mkdocs.i.write.index[settings; output];
    
    files,: out.mkdocs.i.write.config[settings; output];

    files: `$1_/:last each string[settings`htmlDir] vs/: string files;
    
    : `out`md!(lib.ps settings`htmlDir; ([] file: files))
    }

// @private
.z.m.qd.out.mkdocs.i.SETTINGS:(!) . flip 0N 2#(
    `out                ; ::;
    `config             ; ::;
    `index              ; ::;
    `assets             ; ::;
    `sanitizeURL        ; 0b;
    `doctypedef         ; 0b;
    `sitename           ; `Documentation;
    `group              ; `category
    );
.z.m.qd.out.mkdocs.i.NAV_TYPEDEFS:enlist "    - Type Definitions: ", data.TYPEDEFS_FILENAME
.z.m.qd.out.mkdocs.i.NAV:("nav: "; "  - Overview:"; "    - Introduction: index.md")
.z.m.qd.out.mkdocs.i.INDEX:("# Overview"; "This document contains documentation for the following APIs: "; "")
// @fileOverview Return a blank mkdocs config with the given name
// @param sitename {string}
// @returns {string[]}
.z.m.qd.out.mkdocs.i.CONFIG:{[sitename]
    ("site_name: ", .z.m.axq.asString sitename;
    "use_directory_urls: false";
    "markdown_extensions:";
    "    - toc:";
    "        permalink: true";
    "        baselevel: 1";
    "        toc_depth: 3")
    }

// @private
.z.m.qd.out.mkdocs.onLoad:{[]
    // @typedef settings {dict (
    //  out:            symbol; 
    //  config:         symbol| string| string[]; 
    //  index:          symbol| string| string[]; 
    //  assets:         symbol;
    //  sitename:       symbol;
    //  group:          symbol;
    //  sanitizeURL:    boolean)}
    }
.z.m.qd.out.mkdocs.onLoad[];
system "d .z.m";

system "d .z.m.axcmdline";
// @fileOverview Initialize args
// @param options  {dict} Command line arguments
// @param defaults {dict} Default values for each argument
// @param required {symbol[]} Required arguments
// @returns {dict}
.z.m.axcmdline.args:{[options; defaults; required]
    if [(not any null raze required) & 0 <> count required;
        if[not all required in key options;
            e:raze ("arguments are required: ";" " sv string required);
            -2 e;
            'e
            ]
        ];

    // Give boolean options 'true' if they have a different type
    bool:where -1h = type each defaults;
    present:key[options] where key[options] in bool;
    impliedTruth:present where -1h <> type each options present;
    if[0 < count impliedTruth;options[impliedTruth]: 1b];
    :defaults,options;
    }

// @fileOverview Create a cmdline hook for a public library
// @param title {string} Title of the library
// @param file {symbol} Script name (without extension) to check against
// @param required {symbol[]} List of required symbols
// @param flags {string[]} List of lines to output when -help is passed in
// @param main {fn (dict) -> any} Function to run against cmdline argument dictionary
// @returns {any} 

.z.m.axcmdline.create:{[title; file; required; flags; main]
    isMain: @[{(`axtriggerlib in key .Q.opt .z.x) or
                x ~ first ` vs `$.z.m.axfs.path.basename .z.X 1 }; file; 0b];

    if [isMain;
        // convert flags to symbol keys
        options: {$[99=type x;x;(0#`)!()]} `$first each .Q.opt .z.x;
        // trim any leading "-" from flags to support, for example, -help and --help
        options: ({`$(count where (&\)"-"=s)_s:string x} each key options)!value options;

        if [(`help in key options) | 0 = count options;
            logger.out "\n" sv  (
                    title;
                    "";
                    "Usage: q ",string[file],".q_ <flags>";
                    "";
                    "Flags:") ,
                    {$[10=type x;enlist x;x]} flags;
            logger.out "\nExiting.";
            exit 0];
        
        if [`version in key options;
            //@qlintsuppress MISSING_DEPENDENCY(1)
            logger.out "\n" sv  (title; ""; "Version: ",.z.m.axenv.displayVersion[])];

        if [not all required in key options;
        logger.err "\n" sv (
            "Missing required arguments: ", ", " sv "-",/: string required except key options;
            "Use -help for more information";
            "\nExiting.");
            exit 1];

        logger.out"Starting ",title;
        logger.out"";

        // This flag enables debugging
        $[  any `breakOnErrors`breakOnFail in key options;
            main options;
            @[main; options; {logger.err"[",x,"] failed: ",y; exit 1}[string file;]]]];
    }

// @fileOverview Execute a provided plugin and execute a plugin function
// @param name {string} name of the plugin 
// @param options {dict} cmdline args 
// @param flag {symbol} key into options defining the path to the plugin script
// @param fn {symbol} function defined in the plugin
// @param args {any[]} arguments to pass to the plugin function
// @returns {null}
.z.m.axcmdline.customFn:{[name; options; flag; fn; args]
    if [flag in key options;
        logger.out "Loading custom ",name,": ", string options flag;
        
        d: string system"d";
        system"d .z.m";
        @[system;"l ",string options`reporter;
            {[d; err]
                // Restore the context to avoid breaking unit tests
                system "d ",d;
                .z.m.axcmdline.fatal["Error loading custom reporter: "; err];
                }d];
        system"d ",d;

        if [not fn in key `.;
            fatal["Custom ",name," did not define function '",string[fn],"'";""]];

        .[get`.,fn; args;
            fatal"Custom ",name," errored with: "]];
    }

// @fileOverview Fatally error with the given message and error (exit code 1)
// @param msg {string} message prefix
// @param error {string} error
// @returns {null}
.z.m.axcmdline.fatal:{[msg;error]
    -2 msg, error; 
    exit 1
    }

// @fileOverview Write to stderr, always
// @param x {char[]}
// @returns {null}
.z.m.axcmdline.logger.err:{-2 x;}

// @fileOverview Write to stdout, unless suppressed
// @param x {char[]}
// @returns {null}
.z.m.axcmdline.logger.out:{if[not `quiet in key .Q.opt .z.x;-1 x];}

// @fileOverview Exit with status code 0
// @returns {null}
.z.m.axcmdline.success:{[]
    exit 0;
    }

system "d .z.m";

system "d .z.m.qd";
// @overview
// Initialize args
// @param options {dict} 
// @returns {dict}
.z.m.qd.cmdline.args:{[options]
    if[not all cmdline.REQUIRED in key options;
        e:raze ("columns are required: ";" " sv string cmdline.REQUIRED);
        -2 e;
        'e
        ];
    
    args: `out`idstyle`group`docprivate`docempty`doctodo`recursive!
                (hsym options`out;`mkdocs;`category;0b;0b;0b;1b);
    
    if[`errFile in key options;     args[`errFile]:     options`errFile];
    if[`docprivate in key options;  args[`docprivate]:  1b];
    if[`docempty in key options;    args[`docempty]:    1b];
    if[`doctodo in key options;     args[`doctodo]:     1b];
    if[`doctest in key options;     args[`doctest]:     1b];
    if[`doctypedef in key options;  args[`doctypedef]:  1b];
    if[`norecurse in key options;   args[`recursive]:   0b];
    if[`sanitizeURL in key options; args[`sanitizeURL]: 1b];
    if[`exclude in key options;     args[`exclude]:     (`regex; string options`exclude)];
    if[`index in key options;       args[`index]:       options`index];
    if[`group in key options;       args[`group]:       options`group]; 
    if[`config in key options;      args[`config]:      options`config];
    if[`sitename in key options;    args[`sitename]:    options`sitename];
    if[`assets in key options;      args[`assets]:      options`assets];
    // TODO: Adding this temporarily for 4.6.0. Replace this with fixParam or something in main
    if[`noCheckParams in key options; args[`checkParams]: 0b]; 
    // Add in any tagmap mappings ("-map descr:fileoverview")
    args[`tagmap]: { $[x~(); ()!(); (!) . x]} flip ":"vs' string value[options] where `map = key options;
    
    // Allow in memory table of name, content, kind
    // else allow options to have non unique keys for -src, .e.g -src A -src B
    args[`src]: $[98h = type options `src;
        options `src;
        value[options] where `src = key options
        ];
    :args;
    }

// @fileOverview Command line interface for qdoc, runs qdoc, and then exits
// @param options {dict} See cmdline.onLoad
// @returns {null} Never returns, it exits
.z.m.qd.cmdline.cli:{[options] exit @[cmdline.main;options;{ -2 x; exit 1;}] }

// @doctest should colorize the string
// "\033[32mfoo\033[0m" ~ cmdline.i.color[`green; "foo"]
.z.m.qd.cmdline.i.color:{[color; str]
    : $[cmdline.i.COLORIZE;
        cmdline.i.COLORS[color],str,cmdline.i.COLORS`clear;
        str];
    }

// @fileOverview Builds a string of doctest results
// @param r {table} 
// @returns {string}
.z.m.qd.cmdline.i.doctest.out:{[r]
    files : exec distinct ref from r;
    : "\n\n" sv {[r; file]
        : "file ", string[file], "\n", "\n" sv 
            cmdline.i.doctest.test each select from r where ref = file
        }[r] each files;
    }
// @fileOverview Prints doctest results and summary
// @param results {table} 
// @param printAll {boolean}
.z.m.qd.cmdline.i.doctest.summary:{[results; printAll]
    passed: select from results where success;
    failed: select from results where not success;
    
    if[printAll or 0 <> count failed;
        -1 "\n\nDoctest Results:";
        -1 cmdline.i.doctest.out $[printAll; results; failed]
        ];
    
    -1 "\n\nDoctest Summary:";
    -1 cmdline.i.color[`green]  string[count passed],  " tests passed";
    -1 cmdline.i.color[`red]    string[count failed],  " tests failed";
    }

.z.m.qd.cmdline.i.doctest.test:{[test]
    status: $[test`success; cmdline.i.color[`green] "pass"; cmdline.i.color[`red] "fail"];
    output: (4#" "), "- ", status, " | ", test`test;
    if[not test`success;
        output,: "\n", (8#" "),
            $["" ~ test`error;
                "expected: ", .Q.s1[test[`result]`expect], "; got: ", .Q.s1[test[`result]`toMatch];
                "error: ", test`error
                ]
        ];
    : output
    }
// @fileOverview The command line runner for qdoc
// @param options {dict} 
// @returns {long} Exit code
.z.m.qd.cmdline.main:{[options]
    args:cmdline.args options;
    src:args `src;
    args:`src _ args;
    symsrc:11h = type src;

    if[`loadGG in key options; .z.m.aximport.import`graphics];

    
    if[symsrc;
        -1 "Generating qdoc for src: " , ", " sv string src;
        ];
    markdown: @[.z.m.qd.doc args; $[symsrc; hsym each src; src];
        { 
            -2 "Error generating qdoc"; 
            'x; 
            }];

    if [`render in key options;
        -1"Rendering qdoc for format: ",string args`idstyle;
        // @qlintsuppress MISSING_DEPENDENCY(1)
        @[.z.m.qd.out[args`idstyle][`write] args; markdown; 
            {[o;x]
                -2 "Error rendering qdoc using writer ",string o`idstyle;
                'x;
                } args]];

    -1 "Documentation written to: ",string options`out;

    if [`doctest in key options;
        cmdline.i.doctest.summary[markdown`doctest; 0b]
        ];

    : 0

    }
// @fileOverview A list of colours
.z.m.qd.cmdline.i.COLORS:(!) . flip (
    (`green;  "\033[32m");
    (`red;    "\033[31m");
    (`clear;  "\033[0m")
    )
// Required options
.z.m.qd.cmdline.REQUIRED:`src`out
.z.m.qd.cmdline.i.getCOLORIZE:{.z.m.qd.cmdline.i.COLORIZE}
.z.m.qd.cmdline.i.setCOLORIZE:{.z.M.qd.cmdline.i.COLORIZE set x}
.z.m.qd.cmdline.onLoad:{[]
    
    .z.m.qd.cmdline.i.COLORIZE: 1b;
    
    // q qdoc.q_ -src ./src -out ./dist [-use {pandoc,mkdocs}]
    .z.m.axcmdline.create["qDoc: q documentation generator"; `qdoc; cmdline.REQUIRED; (
        "   -help                   - display this help";
        "   -src        <dir/file>  - path to q scripts to document (allows multiple -src flags)";
        "   -out        <dir>       - path to store generated documentation";
        "   [-errFile]  <file>      - file to store the errors/warnings encountered during qdoc generation";
        "";
        "Generator Settings (Optional): ";
        "   [-map <from>:<to>]  - use a non-default tag name, i.e., -map description:fileoverview";
        "   [-exclude] <regex>  - items with a name matching the regex will not be documented";
        "   [-group]   <option> - (default category) use this to change item groupings in markdown files";
        "                           - supported options: category, subcategory";
        "   [-docprivate]       - (default off) include items with an @private tag";
        "   [-docempty]         - (default off) include items that have no qdoc tags";
        "   [-doctodo]          - (default off) include items that have @todo tags";
        "   [-doctest]          - (default off) run and document examples with @doctest tag";
        "   [-norecurse]        - (default off) do not recurse into subdirectories looking for q scripts";
        "   [-sanitizeURL]      - (default off) sanitize the filenames (URLs)";
        /"   [-loadGG]           - (default off) load the Grammar of Graphics for embedded visualizations";
        "";
        "Renderer Settings (Optional):";
        "   [-render]           - configure markdown files to be used with mkdocs renderer";
        "   [-sitename] <name>  - main title for the project documentation";
        "   [-config]   <file>  - mkdocs configuration file. Sitename argumeent will be ignored";
        "   [-index]    <file>  - index file for the rendered markdown";
        "   [-assets]   <dir>   - path to static assets (js, img, css ...) referenced in the user defined config file";
        "";
        "   [-version]          - print the library version"
        );
        cmdline.cli];
    }

.z.m.qd.cmdline.onLoad[];
system "d .z.m";

export:([.z.m.qd])
