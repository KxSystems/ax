// .z.m.axq.asInt 12:34:56.789
// /=> 45296789i
//
// @param data {*} Any data to convert to an int data type
//
// @returns {int} Data with same shape of int type
.z.m.axq.asInt:i.cast["i"; 2 11h; $["i"]]
// @fileOverview
