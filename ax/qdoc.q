system "d .z.m";

system "d .z.m.axstr";
// @fileOverview Colour a string that will be printed to stdout
// @param c   {symbol} The colour to make the string - see i.COLOURS
// @param str {string} The string to colourize
// @returns   {string} The string with colourizing characters
.z.m.axstr.colour:{[c; str] 
    : $[not c in key i.COLOURS;
        str;
        i.COLOURS[c],str,i.COLOURS`clear];
    }
// @fileOverview
// Takes in a string and outputs a string with all the tabs replaced 
// with appropriate spacing using blanks only so as to preserve tabification
// as defined by the tab size specified
// @param str {String}
// @param tabSize {Long}
// @returns {String}
.z.m.axstr.detabify:{[str; tabSize]
    tab : "\t";
    size: count str;
    ii  : 0;
    new : "";
    lst : 0;	/* location of last non-tab
    while [ii < size;
        lst: (count new);
        $[  str[ii] = tab;
            new,: (tabSize  - (lst mod tabSize)) # " ";
            new,: str ii]; 
        ii +: 1];
    
    : new;
    }

// @fileOverview Sanitizes a user provided argument to the system command
// @param arg {string} The user input to sanitize
// @returns {string} The sanitized user input
.z.m.axstr.escape:{[arg]
    arg     : .z.m.axq.asString arg;
    quote   : $[.z.o like "w*"; "\""; "'"];
    escapes : $[.z.o like "w*"; ESCAPE_WIN; ESCAPE_NIX];
    
    arg: {[arg; e] ssr[arg; e[0]; e[1]] } over enlist[arg],escapes;
    : quote,arg,quote;
    }

// @fileOverview Takes a string and modifies it to remove any regexs that could be recognized by like or ss
// @param s {string} the original string
// @returns {string} the escaped string
.z.m.axstr.escapeRegex:{[s]
    sl : enlist each s;
    rp : where s in "[]*?";
    sl[rp] : "[",/:sl[rp],\:"]";
    : raze sl
    }

// @fileOverview 
// Sort strings, handling numbers semantically
// so values will be ordered "1", "2", "100", instead of "1", "100", "2" as in asciibetical sorting
// @param x {string[]}
// @returns {long[]} indicies of natural sort
.z.m.axstr.inatsort:{iasc {$[0=count x;"x"$x;?[null r;"x"$c;0x0 vs/:r:"J"$c:where[differ x in\:.Q.n]_x]]} each lower .z.m.axq.asString each x}

// @fileOverview
// Inserts a character or string at a given index
// 
//
// @param x {string} Base string to insert into
// @param y {string} String to insert
// @param z {long}   Index to insert at
//
// @returns {string} Updated string 
//
// @example
//
// .z.m.axstr.insertAt["all time"; " the"; 3]
// /=> "all the time"
//
.z.m.axstr.insertAt:{{y,x,z}[y] over (0, z) _ x}
// @fileOverview 
// Evaluate a string literal with one or more placeholders. The placeholders
// should be of the form {0}, {1}, ... {n}. Each placeholder will be replaced by
// the corresponding string in args.
//
// @param str {string} The string literal 
// @param args {string[]} A list of strings to inject into the placeholder
//
// @returns {string} The interpolated string
//
// @example
//      .z.m.axstr.interp["The {0} brown {1} jumped"] ("quick"; "fox");
//          => "The quick brown fox jumped"
.z.m.axstr.interp:{[str; args]
    e: (til count args),' enlist each args;
    : {[str; param]
        c: string param[0];
        v: .z.m.axq.asString param[1];
        
        if [v like "{*}"; '"Cannot interpolate string"];
        : ssr[str; "{",c,"}"; v];
        }/[str;e]
    }

// @fileOverview Return 1b if a string is valid UTF8
// @param text {String|char}
// @returns {Boolean}
.z.m.axstr.isValidUTF8:{[text]
    if [not `acceptAnything in key  .z.M.axstr.i; 
        compiled:.z.m.pcre2.compile[".?";`utf];
        i.acceptAnything:.z.m.pcre2.match[compiled;;::]];
    : (count i.acceptAnything .z.m.axq.asString text) >= 0;
    }

// @fileOverview
// Trims all types of whitespace from the front of a string. This 
// extends on the basic trimming from ltrim by trimming all characters
// in the list below
// 
// - tab
// - line feed
// - vertical tab
// - form feed
// - carriage return
// - space
//
// @param x {string} String to trim
//
// @returns {string} Trimmed string
.z.m.axstr.ltrimWhitespace:{[x]
    whitespace: `char$(9 10 11 12 13 32);				
    : $[0 = type x;   
            .z.s each x;
        .z.m.axq.isString x;  
            (sum &\[x in whitespace]) _ x;
       	// else
            $[any x~/:whitespace;""; x]
        ];
    }


// @fileOverview Makes multiple replacements in a string
// Replacements take the form of 3-tuples (start index; end index; text)
// The replacement is from the start index to the position before end index with the text given
// If the start = the end, then it is just an insertion, not a replacement
// Insertions are always done after replacements, which is necessary,
// as (5 9 "replacement) would overwrite (5 5 ": ") if it were done the other way round
// @param text {String} The text that the replacements are occuring in
// @param toReplace {()} A list of the replacements
// @returns {String} The text with the replacements done
.z.m.axstr.multireplace:{[text; toReplace]
    
    // This is a stable sort, sorting just with desc is not a stable sort w/ regards to starting index
    : {[text;toReplace]
        (toReplace[0] # text) , toReplace[2] , (toReplace[1]) _ text
        }/[text; toReplace idesc toReplace[;0 1]];
    }

// @fileOverview 
// Sort strings, handling numbers semantically
// so values will be ordered "1", "2", "100", instead of "1", "100", "2" as in asciibetical sorting
// @param x {string[]}
// @returns {string[]}
.z.m.axstr.natsort:{ x inatsort x }

// @fileOverview
// Trims all types of whitespace from the end of a string. This 
// extends on the basic trimming from rtrim by trimming all characters
// in the list below
// 
// - tab
// - line feed
// - vertical tab
// - form feed
// - carriage return
// - space
//
// @param x {string} String to trim
//
// @returns {string} Trimmed string
.z.m.axstr.rtrimWhitespace:{:$[0 = type x; reverse each ltrimWhitespace reverse each x; reverse ltrimWhitespace reverse x]};
// @fileOverview 
// Strip all \r characters to change \r\n line-endings to \n line endings
// @param str {String} A string containing either \r\n or \n newlines
// @returns {String} A string using only \r\n newlines
.z.m.axstr.stripCR:{[str]
    : str where str <> "\r";
    }

// @fileOverview
// Returns a substring of the input
// 
// @param text  {string} The text to take a substring of
// @param start {number} The index to start the substring at
// @param end   {number} The index after the last one included in the substring
//  
// @returns {string} The substring
// 
// @example
// .z.m.axq.substring["A test of substring is a test"; 2; 6];
// /=> "test"
.z.m.axstr.substring:{[text; start; end]
    : start _ end # text;
    }
// @fileOverview
// Converts string data to lowercase text
//
// @param data {*} Data to convert to lowercase
// Data can be string or symbolic. Any other types
// will be ignored
//
// @returns {*} Lowercase version of input data  
.z.m.axstr.toLower:{[data]
    ty: abs type data;
    
    : $[ty in 10 11 87 88h; 
            lower data;
        ty in 0 77h;
            .z.s each data;
        // else
            data
        ];
    }

// @fileOverview
// Converts string data to titlecase text
//
// @param data {*} Data to convert to titlecase
// Data can be string or symbolic. Any other types
// will be ignored
//
// @returns {*} Titlecase version of input data
.z.m.axstr.toTitle:{[data]
    ty: type data;
    
    : $[ty in 11 88h; 
            "S"$.z.s each string data;
        -11h ~ ty;
            "S"$.z.s string data;
        10h ~ ty;
            raze {(upper[x 0],lower 1 _ x)} each (0,1 + where " " = data) _ data;
        -10h ~ ty;
            upper data;
        ty in 0 77 87h;
            .z.s each data;
        // else
            data
            ];
    
    }

// @fileOverview
// Converts string data to uppercase text
//
// @param data {*} Data to convert to uppercase
// Data can be string or symbolic. Any other types
// will be ignored
//
// @returns {*} Uppercase version of input data
.z.m.axstr.toUpper:{[data]
    ty: abs type data;
    
    : $[ty in 10 11 87 88h; 
            upper data;
        ty in 0 77h;
            .z.s each data;
        // else
            data
        ];
    }

// @fileOverview
// Trims all types of whitespace from the start and end of a string. This 
// extends on the basic trimming from trim by trimming all characters
// in the list below
// 
// - tab
// - line feed
// - vertical tab
// - form feed
// - carriage return
// - space
//
// @param x {string} String to trim
//
// @returns {string} Trimmed string
.z.m.axstr.trimWhitespace:{ltrimWhitespace rtrimWhitespace x}
// @fileOverview
// Truncate a string to a given number of characters, rather than a given number of bytes.
// This treats strings as UTF8, and counts multi-byte characters as single chars,
// as well as counting a character and any associated combining characters as a single character
//
// @param text {string} A string, which gets treated as UTF8
// @param maxLength {long} The number of characters that won't be truncated
// @returns {string} The truncated string
.z.m.axstr.truncate:{[text; maxLength]
    
    // Short-circuit for cases where the rest of the function won't work
    if [(maxLength ~ 0) or text ~ "";
        : ""];
    
    if [not `splitUTF8 in key .z.M.axstr.i; 
        // Install global regex the first time it is needed.
        .z.M.axstr.i.splitUTF8 set {[x]
            // @qlintsuppress MISSING_DEPENDENCY(1)
            :1_/:@[;`x0].z.m.fpcre2.match["\\X"; x; ::];
            }];
    
    text: .z.m.axq.asString text;
    
    ranges: .z.m.axstr.i.splitUTF8 text;
    end: -1 + min (count ranges; maxLength);
    : ranges[end; 1]#text;
    }

// N.B. READ BEFORE MODIFYING
// This function could be sped up if it just looked at the bytes, and counted any non-continuing characters,
// which would be any bytes not in the range 128 to 191, however it needs to be able to handle combining characters,
// including multiple combining characters per glyph.
// It would need to be able to handle strings like

//"h̀̔̀è̔̀l̀̔̀l̀̔̀ò̔̀" as well as strings like (`char$0xCC88), which is the combining umlaut in a string by itself.
// The slower pcre version handles these and other unforeseen edge cases for free.
// @fileOverview A list of colours
.z.m.axstr.i.COLOURS:(!) . flip (
    (`black;  "\033[30m");
    (`red;    "\033[31m");
    (`green;  "\033[32m");
    (`yellow; "\033[33m");
    (`blue;   "\033[34m");
    (`purple; "\033[35m");
    (`cyan;   "\033[36m");
    (`white;  "\033[37m");
    (`clear;  "\033[0m")
    )


// @fileOverview Mappings of things to escape and how to escape them
.z.m.axstr.ESCAPE_WIN:(
    ("\\\""; "");   // Remove \" as it will allow the use of & and other operators after it
                    // even if we enclose the input in surrounding double quotes
    ("\""; "\"\"")  // Escape double quotes by using another one
    );
// @fileOverview Mappings of things to escape and how to escape them
.z.m.axstr.ESCAPE_NIX:enlist
    ("'"; "'\\''") // Replace instances of ' with the escaped '\''
system "d .z.m";

system "d .z.m.axqc";
// @fileOverview This returns the index of the first and last character of the range where an error occurred.
//  The start is the index of the first char in the token/subtree most recently pushed into the stack
//  The end is the index of the last char in the current token, which would be the unexpected token
//  This is called by the error handling routine.
// @param tokenPtr {long} The index of the last token in the range
// @returns {any[]} A 2-tuple holding the staring and ending positions of the range,
//  as indexes into the original text
.z.m.axqc.calcErrorPosition:{[tokenPtr]
    lastIndex :  count[.z.m.axqc.INPUT] - 1;
    
    // The lowest index in the most recent subtree pushed to the stack
    startPos: .z.m.axqc.treeMin last .z.m.axqc.stack;
    
    // The last index of the last token in the range
    // Either the index just before the start of the next token
    // or if there are no more tokens, the last index of the input
    endPos : $[ (tokenPtr + 1) < count .z.m.axqc.tokenLoc;
                (.z.m.axqc.tokenLoc tokenPtr + 1) - 1;
                lastIndex];
    
    // commandEnd tokens can run past the end of the text,
    // so this is needed to make sure ranges are always within the string
    endPos &: lastIndex;
    startPos &: endPos;
    
    : (startPos; endPos);
    }

// @fileOverview checks against a regex
// @param regex {string}
// @param start {long}
// @returns {(long;long)}
.z.m.axqc.checkAgainstRegex:{[regex; start]
    // @qlintsuppress DEPRECATED_FUNCTION(1)
    // match : .z.m.pcre.execute[regex; 0i; .z.m.axqc.local.tokLoc[start] _ .z.m.axqc.INPUT;  0; 0];
    match : .z.m.pcre2.imatch[regex;.z.m.axqc.local.tokLoc[start] _ .z.m.axqc.INPUT;::];
    if[match~();:(start;start+1)];
    :(start;start + 1 + first match)

    }
// @fileOverview Magic null is the second value in the list (value {[x;y]}[;1])
// It represents a missing parameter, so testing for it is difficult,
// as functions don't evaluate when they are passed magic null.

// Passing magic null to a non-monadic function creates a projection.
// As monadic functions can't be curried, they will accept magic null.
// Because of this, it must be passed in to this function as part of a list.

// It is only when multiple arguments are passed, and one is empty, that magic null appears.
// .z.m.axqc.countMagicNulls[value +[]] will return 0, as the empty brackets pass a generic null.
// This is demonstrated by running +[;][;][;], where the + doesn't evaluate,
// versus running +[][], which throws a type error, as it passes in two generic nulls

// @param x {any[]} A list which could contain magic nulls
// @returns {integer} The number of magic nulls in the list
.z.m.axqc.countMagicNulls:{[x]
    // Test for magic null by seeing if match doesn't evaluate when passed x.
    // If match is a projection, then x must be magic null.
    // Then count how many projections there are
    : .z.m.axpnull.countMagicNulls x;
    }
// @fileOverview Count the number of parameters for which projected values are not supplied
// @param function {function} The function whose unprojected parameters get counted
// @returns {long} The number of unprojected parameters
.z.m.axqc.countUnprojectedParams:{[function]
    // Get the function info,
    // which for a projection is a list starting with the function and followed by the values,
    // and for a lambda is a list starting with the bytecode
    functionInfo : value function;
    
    // If the function was a projection
    : $[not `bytes ~ .z.m.axq.typeOf first functionInfo;
        // subtract one from the running total for every parameter which is projected
        // excluding magic nulls from the count, as they are just placeholders
        // (the -1 is to subtract the initial list element which is the unprojected function)
        // and recurse on the unprojected function, which may still be a projection
        // if it was something like {x+y+z}[1][2]
        (neg (count[functionInfo] - countMagicNulls functionInfo) - 1)
            + .z.m.axqc.countUnprojectedParams first functionInfo;
        // If the function is a lambda, add one to the running total for every projection in the function
        count functionInfo 1];
    }
// @fileOverview token description map
// A dictionary for converting charts token names to descriptions
// @returns {null}
.z.m.axqc.createTokenDescriptionMap:{[]
    .z.m.axqc.tokenNameToDescription : (!) . flip (
        ("EOF"; .z.m.axlocalize.t `.axqc_tokenEOF);
        ("name"; .z.m.axlocalize.t `.axqc_tokenVariable);
        ("dyadicAdverb"; .z.m.axlocalize.t `.axqc_tokenDyadicAdverb);
        ("dyadic"; .z.m.axlocalize.t `.axqc_tokenDyadic);
        ("dyadicAssign"; .z.m.axlocalize.t `.axqc_tokenDyadicAssign);
        ("bslash"; "\\");
        ("lParen"; "(");
        ("rParen"; ")");
        ("lBrace"; "{");
        ("rBrace"; "}");
        ("lBracket"; "[");
        ("rBracket"; "]");
        ("colon"; ":");
        ("semi"; "; ");
        ("doubleQuote"; "\"");
        ("apostrophe"; "'");
        ("comma"; ",");
        ("dot"; ".");
        ("slash"; "/");
        ("backtick"; "`");
        ("newline"; "\\n");
        ("whitespace"; .z.m.axlocalize.t `.axqc_tokenWhitespace);
        ("number"; .z.m.axlocalize.t `.axqc_tokenNumber);
        ("underscore"; "_");
        ("multilineStart"; .z.m.axlocalize.t `.axqc_tokenMultilineStart);
        ("multilineEnd"; .z.m.axlocalize.t `.axqc_tokenMultilineEnd);
        ("comment"; .z.m.axlocalize.t `.axqc_tokenComment);
        ("unparsedCommand"; .z.m.axlocalize.t `.axqc_tokenCommand);
        ("symbol"; .z.m.axlocalize.t `.axqc_tokenSymbol);
        ("dotNumber"; .z.m.axlocalize.t `.axqc_tokenNumber);
        ("multivalent"; .z.m.axlocalize.t `.axqc_tokenFunction);
        ("monadic"; .z.m.axlocalize.t `.axqc_tokenMonadicFunction);
        ("sql"; .z.m.axlocalize.t `.axqc_tokenQSQL);
        ("where"; "where");
        ("from"; "from");
        ("by"; "by");
        ("distinct"; "distinct");
        ("qCommand"; .z.m.axlocalize.t `.axqc_tokenCommand);
        ("commandEnd"; .z.m.axlocalize.t `.axqc_tokenCommand);
        ("inlineComment"; .z.m.axlocalize.t `.axqc_tokenInlineComment);
        ("doubleColon"; "::")
        );
    }

// @fileOverview
/*
/* Symbol Table and functions (syntactic sugar)
/* A simple set of symbol table routines for a simple symbol table of unique symbols.
/* Note, if scoping is required then the symbol table and its routines need to be
/* appropriately amended.
 
/* Initialize the .z.m.axqc.symbolTable proper
/* Note that "INSERTED_NAME" is added as element 0 as we might need it for error recovery
/*
/* symbolTable is structured as follows:
/*
/*     symbolTable [`name] :: (index; type; value)
/*
/* where index, type, value, start and size are all integers.
/*
/* This should be adjusted as necessary by the programmer for their particular needs.
/*
 
/* ##defineSymbolTable
/*
/* Define the symbol table initially and populate it with its initial values
// @returns {null}
.z.m.axqc.defineSymbolTable:{
    noValue     : 0;
    initialIndex: 0;
    
    .z.m.axqc.symbolTable : ()!();               /* an empty dictionary
    .z.m.axqc.symbolTable[`$"INSERTED_NAME"]: (initialIndex; `noType; noValue); /dnl
    .z.m.axqc.stSize      : 1;
    }
// @fileOverview This function provides information on a possible implicit returns in the last line of the function.
// This function ignores returns inside expressions and returns not in the last line
// @param tree {*[]} A parse tree of a function
// @returns {*[]} A pair where the last element is a boolean value which is true if the last line returns a value
//  If the last line is an implicit return, the first element is a pair of ints expressing the range in the text of the function where this line is
// Otherwise, the first element is the empty list
.z.m.axqc.findLastLineReturn:{[tree]
    
    // Find if the last line returns
    // The parse tree of just the body of the function
    body : tree[0;0;1;1];
    
    // The indicies in the text of the function of all lines containing code
    nonempty : where not `empty ~/: body[;0];
    
    // If the last line starts with a colon
    lastLineHasColon : `RETURN ~ first first body last nonempty;
    
    // If the last line ends in a semicolon
    lastLineHasSemi : `empty ~ first last body;
    
    // Does the last line of the function return a value
    lastLineReturns : lastLineHasColon | not lastLineHasSemi;
    
    // If the last line returns implicitly, return the range so it can be counted as a return
    returns : $[not lastLineHasSemi | lastLineHasColon;
        
                (.z.m.axqc.treeMin[last body] - 1; .z.m.axqc.treeMax last body);
                ()];
    
    // Return, if there is an extra return to add, its range; and if the last line returns a value
    : (returns; lastLineReturns);
    }

// @fileOverview This will parse a string of q code, and return details if there is a parse error, and 0b otherwise
// @param input {string} The code to parse
// @returns {any[]|boolean} 0b if there is no parse error, otherwise
//  a list that looks like (((1;6);(2;1));"':' was found before expected rBracket";"y\\n:")
//  It is a 3-tuple where the first element is a pair of pairs
//  representing the line/col position of the first and last chars in the erroring range.
//  The second element is a string describing the error.
//  The third element is a string showing the substring in the code where the error is.
.z.m.axqc.getParseError:{[input]
    // Run the parser on the input
    parseResult: @[
        .z.m.axqc.runParser 0;
        input;
        {[error]
            // Only evaluate the error if it is a parse error
            : $[`chars ~ .z.m.axq.typeOf error;
                $[  error like "(`ERROR;*"; /dnl
                    value error;
                    0b];
                0b];
            }];
    
    // If it didn't return from inside the catch, then the parser didn't find a parse error
    : $[first[parseResult] ~ `ERROR;
        1 _ parseResult;
        0b];
    };
// @fileOverview halts the parser
// @param msg {string}
// @returns {any}
.z.m.axqc.halt:{[msg]
    // @qlintsuppress DEBUG_FUNCTION(2)
    show .z.m.axlocalize.t `.axqc_fatalParserError;
    show msg;
    .z.m.axqc.looping: 0b;      /* abort walker
    .z.m.axqc.halted: 1b;
    : .z.m.axqc.fatalTermination;
    }

// @fileOverview Converts an index into .z.m.axqc.INPUT into a line number, column pair
// @param index {Number} An index into .z.m.axqc.INPUT
// @param text {String} The text the index refers to
// @returns {(long;long)} A 2-tuple storing the line number and the column
.z.m.axqc.indexToLineAndColumn:{[index; text]
    // Find all the newlines before the current position
    newlines: where text[til index] = "\n";
    
    // The starting line is one more than the count of the newlines
    // As there is no newline character before the start of the first line
    line: 1 + count newlines;
    
    // The start index of the last token minus the index of the last newline before it gives the current index
    // If there are no newlines, replace the `long$() with -1 so the index will be right
    column:  index - -1 ^ last newlines;
    : (line; column);
    };
// @fileOverview
//  For user defined functions, this returns if that function is dyadic or not.
//  It doesn't work for native q functions, due to issues like "value mmu" returning 11,
//  which doesn't contain any useful information.
// @param input {function}
// @returns {boolean} 1b if the function is dyadic, 0b otherwise
.z.m.axqc.isDyadic:{[input]
    // If input is a function
    if [.z.m.axq.isFunction input;
        
        // And value doesn't return a bytecode
        if [1 < count value input;
            
            // Check if it needs 2 parameters
            if [2 ~ .z.m.axqc.countUnprojectedParams input;
                
                // It is dyadic
                : 1b]]];
    
    // It isn't dyadic
    : 0b;
    }
// @fileOverview determines if this is an expression
// @param tree {any[]}
// @returns {boolean}
.z.m.axqc.isExpression:{[tree]
    :(.z.m.axq.isSymbol first first tree) & (3~count first tree) & 2 ~ count tree;
    };

// @fileOverview Given locations, assemble names from .z.m.axqc.INPUT
// @param location {(long;long)}
// @returns {string}
.z.m.axqc.lib.assembleNames:{[location]
    : .z.m.axqc.INPUT .z.m.axqc.local.tokLoc [location 0]+ til .z.m.axqc.local.tokLoc [location 1]-.z.m.axqc.local.tokLoc location 0; /* faster by eliding
    };
// @fileOverview finds where the names are based on an algorithm for
// assembling q-specific names/namespaces
// ONLY USED FOR NAMES, COULD BE REPLACED WITH A REGEX
// @param start {long}
// @returns {(long;long)}
.z.m.axqc.lib.find:{[start]
    i: start+1;
    
    assembling: 1b;
    while [assembling;
        while [.z.m.axqc.local.types [i] in .z.m.axqc.local.validChars;
            i +: 1;
            ];
        if [.z.m.axqc.local.types [i] in .z.m.axqc.local.delims;                    /* suck up delimiters
            i +: 1; 
            ];
        assembling: .z.m.axqc.local.types [i] in .z.m.axqc.local.validChars;
        ];
    : (start; i);
    };
// @fileOverview
/* Main routine that handles names and numbers.
/* For languages other than q this needs to be adjusted as do
/* the support routines above.
// @param toks {any[]}
// @returns {any[]}
.z.m.axqc.namesAndNums:{[toks]
    unknown  : `$ .z.m.axqc.CHARTS [`SOT],"unknown"; /dnl
    allAlpha : "abcdefghijklmnopqrstuvwxyz"; /dnl
    allAlpha,: upper allAlpha;
    numerals : "0123456789";
        
    /* Get the size of each token and their locations
    
    tokens            : each [first] toks;                                                  /* just the tokens
    .z.m.axqc.local.tokSizes: 1_deltas (last each toks),count .z.m.axqc.INPUT;                          /* each token's size
    .z.m.axqc.local.tokLoc  : each [first last] toks;
    .z.m.axqc.local.tokLoc ,: count .z.m.axqc.INPUT;                                                    /* append the size of the input so tokLoc doesn't overflow
    importantChars    : .z.m.axqc.INPUT .z.m.axqc.local.tokLoc;                                       /* the first chars of each token
    
    /* Quickly determine where there might be valid numbers
    
    /* ###tokDefn
    /*
    /* Define an enumeration dictionary for numbers (this is multi-part).
    /*
    /* Each character is defined as a specific type: "A" for alphabetic, "#" for numbers, etc.
    /* Each enumeration is used to create a new string that represents the tokenized stream
    /* so we can do fast string searches via q to determine patterns for numbers, namespaces, ...
    /* This is used throughout this function and modified according to the type of token
    /* to be parsed.
    
    tokDefn: (`char$ til 256)! 256#"$";                   /* define "$" as "don't care"
    
    /* ###types
    /*
    /* Take a string and based on the token locations create simple patterns.
    /* For example, .z.m.axqc.INPUT: "name: 56+33+.some.name" woudl turn into "A$$#+#+.A.A$"
    /* This allows us to quickly create simple patterns to look for names, numbers, etc.
    /* in the input stream. This is used throughout this function in various ways.
    
    /***** the next two pieces are the slowest part
    /*****
    
    /* General number tokenizing including binary numbers, null, infinity, hex
    
    tokDefn [allAlpha]  : "A";
    tokDefn [numerals]  : "#";
    tokDefn [".-"]      : ".-";
    
    .z.m.axqc.local.types     : peach [tokDefn] importantChars;                                                                               /* Now, let's find time number definitions
    start               : raze ("$",.z.m.axqc.local.types) ss/: ("$#"; "$.#"; "$-#"; "$-.#"; "A-#"; "A-.#"; "--#"; "--.#"; ".-#"; ".-.#");    /* Start of a number
    start              ,: 1 + raze ("$",.z.m.axqc.local.types) ss/: ("#-.#"; "#-#");
    startsWithMinus     : where "-" = .z.m.axqc.INPUT .z.m.axqc.local.tokLoc start;
    cantBeNegative      : not any (.z.m.axqc.INPUT .z.m.axqc.local.tokLoc[start] - 1) in/:"([{;\n\t ~!@#$%^&*_-+=:'|\\/,.<>?";
    start[startsWithMinus inter where cantBeNegative] +: 1;
    //startsCanBeNegative : start where not cantBeNegative;
    //startsCantBeNegative: start where cantBeNegative;
    
    /* include ":" in the tokDefn as certain numbers use ":" as delimiters
    
    tokDefn [".:-"]     : ".:-";
    .z.m.axqc.local.types     : peach [tokDefn] importantChars;
    numRange            : .z.m.axqc.checkAgainstRegex[.z.m.axqc.numberRegex] peach start;
    //numRange            : .z.m.axqc.checkAgainstRegex[.z.m.axqc.numberOptNegativeRegex] peach startsCanBeNegative;
    //numRange           ,: .z.m.axqc.checkAgainstRegex[.z.m.axqc.numberNoNegativeRegex] peach startsCantBeNegative;
    nums                : peach [.z.m.axqc.lib.assembleNames] numRange;                                                   /* and now assemble those numbers and save the locations
    
    /* Define an enumeration dictionary for names and symbols.
    
    tokDefn [allAlpha]  : "A";
    tokDefn [numerals]  : "#";
    tokDefn ["."]       : ".";
    tokDefn ["_.`-/:"]  : "_.`-/:";
    
    /* Take a string and based on the token locations create simple patterns.
    /* For example, .z.m.axqc.INPUT: "name: 56+33+.some.name" woudl turn into "A$$#+#+.A.A$"
    /* This allows us to quickly create simple patterns to look for names, numbers, etc.
    /* in the input stream.
    
    .z.m.axqc.local.types     : peach [tokDefn] importantChars;                                           /* Now, let's find time number definitions
    
    /* Now that we have the types, let's do simply searches to find
    /* where names, numbers, etc. start. Quickly determine where there
    /* might be valid variable names and namespaces
    
    start               : raze .z.m.axqc.local.types ss/: (enlist "A"; ".A");                             /* Start of a name and start of a dot name.
    .z.m.axqc.local.validChars: "A#_";
    .z.m.axqc.local.delims    : enlist ".";
    nameRange           : peach [.z.m.axqc.lib.find] start;                                               /* Determine the range for each name and
    names               : peach [.z.m.axqc.lib.assembleNames] nameRange;                                  /* assemble the names we've found.
    
    /*****
    /***** slowest part above (assembleNames and find appear esp. slow)
    
    /* Find each backtick, check if it starts a symbol, then find the text for that rang
    
    start    : where .z.m.axqc.local.types = "`";
    symRange : .z.m.axqc.checkAgainstRegex[.z.m.axqc.symbolRegex] peach start;
    symbols  : peach [.z.m.axqc.lib.assembleNames] symRange;
    
    /* Do the final assembly on the names, numbers, and symbols
    /* Note: By first assigning the assembled tokens we can then overwrite
    /*       any tokens that happen to be subcomponents of a larger token
    /*       with unknown ensuring only correct tokens are generated.
    
    toAss: peach [{x[0]+ til x[1]-x 0}] numRange,nameRange,symRange;                 /* all the tokens to assemble
    tokens [first each toAss]    : each [`$] nums,names,symbols;                        /* save the compound name, number, symbol
    tokens [raze each [1_] toAss]: unknown;                                             /* and the rest to unknown
    
    /* Return the tokens list, with associated character locations for each
    
    : tokens [where not tokens = unknown] ,' .z.m.axqc.local.tokLoc where not tokens = unknown;
    };

// @fileOverview Output the error and up the error count. Abort if there are too many errors.
// @param errorMessage {string} A description of the error
// @param tokenPtr {long} The index of the token to use as the end position
// @param explicitIndex {long[]|any[]} Either longs for the index of the first and last chars in the range,
//  or () to have the function calculate this. There are times when it would be calculated incorrectly though,
//  so sometimes it must be explicitly passed in
// @throws {string} An error message that looks like "(`ERROR;((1;6);(2;1));\"':' was found before expected rBracket\";\"y\\n:\")"
//  It is a 4-tuple where the first element is always `ERROR, so these parse errors can be separated from other types of errors.
//  The second element is a pair of pairs representing the line/col position of the first and last chars in the erroring range
//  The third element is a string describing the error
//  The fourth element is a string showing the substring in the code where the error is
// @returns {null}
.z.m.axqc.noteError:{[errorMessage; tokenPtr; explicitIndex]
    if [.z.m.axqc.errorNumber > 50;
        : halt .z.m.axlocalize.t `.axqc_tooManyErrors];
    
    .z.m.axqc.errorNumber +:: 1;
    
    // Get the indexes into the original text where the erroring subtree starts and ends
    indexes: $[ explicitIndex ~ ();
                .z.m.axqc.calcErrorPosition tokenPtr;
                explicitIndex];
    
    // The range as a pair of line/column pairs for the start and end position
    // e.g. ((1;20);(3;45))
    range: {x: .z.m.axqc.indexToLineAndColumn[x; .z.m.axqc.INPUT]; "(" , (raze string x[0] , ";" , x 1) , ")"} each indexes;
    range: "(" , range[0] , ";" , range[1] , ")";
    
    // The text covered by the subtree
    text: .z.m.axqc.substring . indexes;
    
    // The error message is a string that can be passed to value to get a list.
    // It needs to be a string as lists can not directly be thrown as errors.
    // stringify turns a q string into a string that will evaluate to the original string if passed to value.
    // Newlines are escaped as they can't be thrown in errors
    asSafeString: (')[ssr[ ;"\n"; "\\n"]; .z.m.axqc.stringify];
    
    stringifiedErrorMessage : asSafeString errorMessage;
    
    message: "(`ERROR;" , range , ";" , stringifiedErrorMessage , ";" , asSafeString[text] , ")"; /dnl
    
    // q error messages will get truncated at 254 characters, so if the message is longer than this replace stringifiedText with an error message.
    // stringifiedText is not truncated, as truncating it in the middle of a unicode sequence, or after a backslash would cause errors when evaluating the message
    $[  count[message] > 254;
        ' "(`ERROR;" , range , ";" , stringifiedErrorMessage , ";" , asSafeString[.z.m.axlocalize.t `.axqc_errorTooLong] , ")"; /dnl
        ' message];
    }


// @fileOverview Parse groups of q code from a file. This is used for situations where only part of the file has q code that must be parsed
// @param textTable {table (text: string; positionsInFile: long)} a table of text along with the positions of the first character in the original file.
// The text column in the textTable must have the content unmodified from the original file (i.e. no whitespace removed) other than 
// removing the newlines at the end of each group.
// Otherwise the parser may not be able to identify correct positions or line numbers.
// @returns {()} the list of q tokens 
.z.m.axqc.parseGroups:{[textTable]

    codeToParse: textTable `text;
    positionsInFile: textTable `positionsInFile;
    
    // Every time the .z.m.axqc.runParser function is called, 
    // the comments must be stored to ensure that they can be collected at the end
    runParserStoreComments:{[text]
        parsedFile: @[.z.m.axqc.runParser 0;text;{$[x like "(`ERROR;*"; value x; 'x]}];
        : enlist[parsedFile], enlist .z.m.axqc.comments
        };
    
    treesComments: runParserStoreComments each codeToParse;

    trees: treesComments[;0];
    comments: treesComments[;1];

    // Ensure comments have proper positions
    comments: raze  comments {[comment;position]
        : $[0 <> count raze/[comment];
            [   comment @: where 0 < count each comment;
                comment[;1 2] +: position;
                comment];
            ()];
        }' positionsInFile;
    
    // Store the modified comments
    .z.m.axqc.comments:comments;
    
    // Ensure that the tree has the proper positions
    positionTree: positionsInFile,'enlist each trees;

    // If there were any parse errors, throw the first one
    if [any positionTree[;1;0] ~\: `ERROR;
        errorTree: positionTree tblPos:first where positionTree[;1;0] ~\: `ERROR;
        // Find the number of newlines prior to the given q group
        newlines : where "\n" = textTable[`positionsInFile][tblPos]# "\n" sv textTable`text;
        
        lastLine : count newlines;
        // Update the line numbers to reflect the actual position in the file
        // This is necessary because the original error message represents the 
        // position in the erroneous q block, not the entire file.
        errorTree[1;1;;0] +: lastLine;
        // Create the string for the error range
        lnFn : {"(" , (raze string x[0] , ";" , x 1) , ")"};
        range: "(" , lnFn[errorTree[1;1;0]] , ";" , lnFn[errorTree[1;1;1]] , ")";
        // Create the error string
        '"(`ERROR;" , range , ";" , .z.m.axqc.stringify[.z.m.axq.asString errorTree[1;2]] , ";" , .z.m.axqc.stringify[.z.m.axq.asString errorTree[1;3]] , ")"
        ];
    
    // Walk through the output tree and update position numbers to the correct value.
    // This is necessary because originally each block of the 
    // q file was parsed independently, so their positions would start at zero. 
    : {[lineAdd; tree]
        l:  enlist each til count tree;
        
        while[count l;
            path: first l;
            node: tree . path;

            tree: .[tree; path , enlist where -7h = type each node; +; lineAdd];

            if [-11h <> type first node; // Skip leaves
                l ,: path ,/: where 0h = type each node];
            l _: 0];
        
        : tree;
        }./: positionTree;
    
    }

// @fileOverview Parse a q file
//                  Running .z.m.axqc.q on a q file will not produce the 
//                  correct output because .z.m.axqc.q will not recognize
//                  line endings as expression deliminators.
//                  This function parses the file to handle this situation.
// @param text {string} the file
// @returns {any[]} The tree representing the parsed file
.z.m.axqc.parseQFile:{[text]

    //Ensure it works on both strings and text that has been loaded from a file
    text : $[.z.m.axq.isString text;"\n" vs text;text];
    
    ml:.z.m.axstr.rtrimWhitespace each text;

    //Find multiline comments in the file
    strML: ml ~\:/: enlist each ("/";"\\");
    mlCmts: where 0 <> deltas 0^fills @[;where strML 1;:;0] @[;where strML 0;:;1] count[ml]#0N;

    mlCmts: 2 cut where 0 <> deltas {[x;y] 
        $[  (x = 0) and y ~ enlist "\\";
                2;
            (x = 0) and y ~ enlist "/";
                1;
            (x = 1) and y ~ enlist "\\";
                0;
                x]}\[0;ml];
    
    //Handle multiline comments that reach to the end of the file
    if[1 = count last mlCmts; mlCmts[(count mlCmts)-1] : mlCmts[(count mlCmts)-1], count ml]; 
    
    //Add an extra region after the end of the file to ensure that the pattern always matches
    //even if there are no multiline comments
    mlCmts : mlCmts,enlist (count ml; 1+count ml);
    
    //Find indented locations in the file, 
    //This will ensure that the code is split into the proper blocks.
    //Conveniently enough, if a line had no code (and so appears as "" in the list of strings)
    //It will be converted to an empty space when text[;0] is run. Thus maintaining the block
    //across empty lines (similar to the behaviour of q)
    //The \ has to be handled differently to differentiate comments and system commands
    textLocations: where not (text[;0] in " /\t") or ml ~\: 1#"\\";

    //Remove starting locations within multiline comments
    textLocations: textLocations where not or/[textLocations within/: mlCmts];
    
    if[0 <> first textLocations; textLocations: 0,textLocations];
    
    codeToParse: "\n" sv/: textLocations _ text;
    positionsInFile: -1_0,sums 1+count each codeToParse;

    :raze parseGroups ([] text: codeToParse; positionsInFile: positionsInFile)
    
    }

// @fileOverview This is the way to run the parser if you want the error message formatted in a human readable way
// @param input {string} The code to parse
// @returns {any[]} The parse tree
// @throws {string} A human readable error for parse errors, and a usual error if it is an error with the parser itself
.z.m.axqc.q:{[input]
    if["\r" in input; '.z.m.axlocalize.t `.axqc_errorCarriageReturn];
    lines:"\n" vs "",input;

    // Workaround: as of 4.1 2024.09.20, .Q.ld trims trailing whitespace, ruining the offsets
    trimLengths:{0^{x[0]*first where x=-1}deltas reverse[x],0b}each lines in" \t";
    trims:neg[trimLengths]#'lines;
    linesCopy:"",/:(::)each/:lines; // bug in 4.1 2024.09.20: .Q.ld clobbers the original string with the whitespace removal, so duplicate it
    split:.Q.ld linesCopy; // only clobbers the copy, not the original
    splitLinesTrimmed:"\n"vs/:split 1;
    splitLines:"\n"sv/:splitLinesTrimmed,''(count each splitLinesTrimmed)#'(split[0]-1)cut trims;

    // This is the intended version:
    // splitLines:split 1

    // Put back the original contents of comment lines, as they are transformed by .Q.ld
    isComment:"/"=first each splitLines;
    splitLines[where isComment]:lines(split[0]-1)where isComment;
    // Merge all the consecutive comment lines into a single block
    splitLines:raze{ind:1+2*til count[x]div 2;x[ind]:enlist each"\n"sv/:x ind;x}(0,where 0<>deltas isComment,0b)cut splitLines;

    offsets:-1_0,sums 1+count each splitLines;
    lineNums:-1_0,sums 1+sum each splitLines="\n";
    treesAndComments: .[{r:.z.m.axqc.runParser[x;y];(1b;r;.z.m.axqc.comments)};;{(0b;x;.z.m.axqc.comments)}]each flip(offsets;splitLines);
    goodResults:{1_/:x where x[;0]}treesAndComments;
    .z.m.axqc.comments:raze treesAndComments[;2];
    badIndex:where not treesAndComments[;0];
    if[count badIndex;
        errorIndex:first badIndex;
        error:treesAndComments[errorIndex;1];
        $[`chars ~ .z.m.axq.typeOf error;
            // Only evaluate the error if it is a parse error
            $[  error like "(`ERROR;*"; /dnl
                // If it is a parse error, make it into a human readable error message
                [   details: value error;
                    range: details[1] +\: (lineNums errorIndex;neg offsets errorIndex);
                    rangeStr: {raze string x[0] , "." , x 1} each range;
                    msg: .z.m.axlocalize.t (`.axqc_errorInRange; `description`start`end`code!(details 2; rangeStr 0; rangeStr 1; details 3));
                    ' ssr[msg; "\n"; "\\n"]];
                ' error];
            ' error];
    ];
    : raze goodResults[;0];
    };

// @fileOverview This takes a filepath as a symbol and returns the parser tree for the file
// @param fileName {symbol}
// @returns {any[]}
.z.m.axqc.qFile:{[fileName]
    : .z.m.axqc.q "\n" sv read0 fileName;
    }
// @fileOverview This runs the parser, but if it throws a parse error, the error must be formatted by another function to be very useful
// @param offset {long} The offset at which the input appears in the overall code, added to token positions
// @param input {string} The code to parse
// @returns {any[]} The parse tree
// @throws {string|any} For parse errors, this throws a string that can be evaluated into a list detailing the error,
//  and a usual error if it is an error with the parser itself
.z.m.axqc.runParser:{[offset;input]
    
    // Since some tokens count on newlines at the start or end, and the SOF or EOF work as well,
    // this puts on new lines, so these tokens will still match
    .z.m.axqc.INPUT       : "\n", input, "\n";

    // If the stacks don't have an extra element, it is inconsistent in how it adds new elements
    // It is also useful for checking if the bottom of the stack has been reached
    .z.m.axqc.QSQLStack   : enlist (`bottomOfStack;" ";-1;-1);
    .z.m.axqc.stack       : enlist (-1;" ";0;0);
    .z.m.axqc.loopCount   : .z.m.axqc.errorNumber : .z.m.axqc.foundMatch : .z.m.axqc.inCommand : 0;

    // All OTHER values, used in the CHARTS need integer representations
    // These may not end up being used, depending on how much the tokenizer can capture
    // Imagining there is a blank before the first character simplifies parsing
    .z.m.axqc.stateDict   : `blank`Punctuation`VarNumSym! 100 101 102;
    .z.m.axqc.state       : .z.m.axqc.stateDict `blank;

    // from, by, where and ',' all behave differently inside QSQL statements.
    // .z.m.axqc.inQSQL is a flag to tell how these tokens should be parsed
    // because this doesn't apply to certain structures like lists inside a QSQL expression,
    // a stack is used to hold the flags so nesting will work
    .z.m.axqc.inQSQL      : `false;
    .z.m.axqc.inQSQLSaved : ();

    // These are where the final outputs are stored
    // .z.m.axqc.tree is the input represented as a parse tree
    // .z.m.axqc.comments is a list of all the comments which need to be stripped out
    // to simplify the parse tree
    .z.m.axqc.tree        : enlist (();());
    .z.m.axqc.comments    : enlist ();

    // Keeps track of which tokens can be used in an apply
    .z.m.axqc.markedApplies   : ();
    
    // Read in the file
    // Setup the tokenizer and all associated data structures and variables
    // Fetch the first token to prime the pump
    // This initializes the .z.m.axqc.tokenLoc and .z.m.axqc.tokenEnd vectors.
    .z.m.axqc.setupTokenizer[];
    .z.m.axqc.INPUT       : input;
    .z.m.axqc.OFFSET      : offset;

    // Apply the offset to get accurate token positions in lines other than the first.
    .z.m.axqc.tokenLoc +: offset;
    .z.m.axqc.tokenEnd +: offset;

    // This sets .z.m.axqc.currentToken and moves .z.m.axqc.tokenPtr to the first token
    .z.m.axqc.getNextToken[];

    // This starts it
    @[{.z.m.axqc.chartWalker[.z.m.axqc.chartStart 1; .z.m.axqc.chartStart; .z.m.axqc.chartCode]};
        (::);
        {[input; errorMsg]
            // Remove the leading empty list from the comments list
            .z.m.axqc.comments: 1  _ .z.m.axqc.comments;
            // Re-throw "stop" so it doesn't get flagged as a syntax error
            $[  (errorMsg like "(`ERROR;*") or errorMsg ~ "stop"; /dnl
                ' errorMsg;
                [   newlines : where "\n" = input;
                    lastLine : 1 + count newlines;
                    lastCharCol : -1 + count (0 ^ last newlines) _ input;
                    ' "(`ERROR; ((1;",string[1+.z.m.axqc.OFFSET],"); (" , string[lastLine] , ";" , string[lastCharCol+.z.m.axqc.OFFSET] , "));" /dnl
                        , " \"Invalid syntax\";" /dnl
                        , " \"\")"]]; 
            } input];
    
    // To keep comments enlisted, there is an enlisted empty list at the start, this must be removed
    .z.m.axqc.comments: 1  _ .z.m.axqc.comments;
    
    
    // The finished parse tree, .z.m.axqc.tree, is returned
    // Comments are put into .z.m.axqc.comments, but are not returned
    : .z.m.axqc.tree;
    }

// @fileOverview handles special cases
/* NOW HANDLE SPECIAL CASES: note this manipulates .z.m.axqc.tokenized, a global
/* "*:", "?:" which are not handled because q doesn't like "?" and "*" in strings
// @returns {null}
.z.m.axqc.specialCases:{
    unknown: `$ .z.m.axqc.CHARTS [`SOT],"unknown"; /dnl
    
    /* Place your special case handler code below
    
    sp1     : where ("*" =\: .z.m.axqc.INPUT);                                          /* find the "*:" tokens
    sp2     : where (":" =\: .z.m.axqc.INPUT);
    follows : (sp2-1) inter sp1;
    .z.m.axqc.tokenized [follows]  : `$"*:";
    .z.m.axqc.tokenized [follows+1]: unknown;
    
    follows : (sp2-2) inter (sp2-1) inter sp1;                                      /* find the "*::" tokens
    .z.m.axqc.tokenized [follows]  : `$"*::";
    .z.m.axqc.tokenized [follows+1]: unknown;
    .z.m.axqc.tokenized [follows+2]: unknown;
    
    sp1     : where ("?" =\: .z.m.axqc.INPUT);                                          /* find the "?:" tokens
    follows : (sp2-1) inter sp1;
    .z.m.axqc.tokenized [follows]  : `$"?:";
    .z.m.axqc.tokenized [follows+1]: unknown;
    
    follows : (sp2-2) inter (sp2-1) inter sp1;                                      /* find the "*::" tokens
    .z.m.axqc.tokenized [follows]  : `$"?::";
    .z.m.axqc.tokenized [follows+1]: unknown;
    .z.m.axqc.tokenized [follows+2]: unknown;
    };
// @param text {string} The string to stringify
// @returns {string} The stringified string

// @fileOverview This takes a string, doubly escapes any quotes or slashes in it
//  and surrounds it with quotes.
//  This is useful went you want to create a string like "value \"stringified string\""

// @example
// q) .z.m.axqc.stringify "a:\"string and \\ \""
// "\"a:\\\"string and \\\\ \\\"\""
.z.m.axqc.stringify:{[text]
    // Take a string, puts it in quotes and escape it
    :   "\"" 
        , ssr[ssr[text; "\\"; "\\\\"]; "\""; "\\\""] 
        , "\"";
    }

// @fileOverview When walking the tree, column names shouldn't get parsed as variable names
//  so when a table is encountered, each clause in the table gets passed to this function,
//  which removes column names, if the clause starts with one
// @param tree {any[]} The parse tree for a clause in a table
// @returns {any[]} The tree with the column name stripped, if there was one
.z.m.axqc.stripColName:{[tree]
    : $[`DYADIC ~ first first tree;
        $[  `colon ~ tree[1;1;0];
            tree[1;2];
            tree];
        tree];
    };
// @fileOverview You must define syntaxError to represent how errors will be handled for your Charts.
 
// #syntaxError
//
// syntaxError must be defined by the user to handle errors as they see fit. The following basic
// error recovery routine will provide basic insertion recovery. More intelligent recovery
// may be required depending on application.
 
// @param expectedToken {string}
// @returns {null}
.z.m.axqc.syntaxError:{[expectedToken]
    /* define whitespace as they have to be handled special
    whitespace: .z.m.axqc.CHARTS [`TAB] , .z.m.axqc.CHARTS `BLANK;
    
    // This decides what to show as the expected value
    // Where the first acceptable token would be okay, a description of the token is used
    // Where that wouldn't make sense, the chart name is turned into something useful
    currentChartName: .z.m.axqc.chartNames first .z.m.axqc.currChart;
    expectedToken   : .z.m.axqc.printToken expectedToken;
    tokenDescription: .z.m.axqc.tokenNameToDescription expectedToken;
    expectedValue   : $[currentChartName in ("EXPRESSION_START";"OPTIONAL_EXPRESSION_START"); /dnl
                            .z.m.axlocalize.t `.axqc_tokenExpression;
                        (currentChartName in ("EXPRESSION";"OPTIONAL_EXPRESSION";"OPTIONAL_AFTER_TERM")) and expectedToken ~ "name"; /dnl
                            .z.m.axlocalize.t `.axqc_tokenTerm;
                        tokenDescription ~ "";
                            expectedToken;
                        // Else    
                            tokenDescription];
    
    found: $[   .z.m.axqc.rawTokens[.z.m.axqc.tokenPtr] in whitespace;
                    .z.m.axlocalize.t `.axqc_tokenWhitespace;
                .z.m.axqc.rawTokens[.z.m.axqc.tokenPtr] = .z.m.axqc.CHARTS `EOF;
                    .z.m.axlocalize.t `.axqc_tokenEOF;
                // Else
                    string .z.m.axqc.rawTokens .z.m.axqc.tokenPtr];
    
    errorMsg: .z.m.axlocalize.t(`.axqc_foundBeforeExpected; (`found`expected)!(found; expectedValue));
    .z.m.axqc.noteError[errorMsg; .z.m.axqc.tokenPtr; ()];
    
    .z.m.axqc.currentToken: expectedToken;
    }

// @fileOverview
/* #Chart Walker
/*
/* Updated    May  4, 2011      Eugen Bacic     Created
/* Modified   Aug 12, 2011      Eugen Bacic     Removal of unnecessary globals
/* Modified   Aug 26, 2011              Eugen Bacic             Optimized
/*                                                                                                      - removed operand1, operand2
/*                                                                                                      - converted $[ .. ] to if [ .. ]
/*                                                                                                      - all opcode functions return ic increments
/*                                                                                                      - error checking/bounds checking removed
/* Modified   Sept 28, 2011             Eugen Bacic             Added chooseJump, an optimized choose op code
/*                                                                                                      - note, you must run the optimizer to gain the
/*                                                                                                        advantages of the new opcode
/*            Sept 29, 2011             Eugen Bacic             Minor optimizations:
/*                                                                                                      - redid chooseJump to eliminate unnecessary assigns, elides, etc.
/*                                                                                                      - changed how return works, now leverages the stack at posn 0 for halting
/*
/* DO NOT CHANGE THIS FILE!
/*
 
/*
/* DANGER:
/* THIS CHART WALKER HAS NO ERROR CHECKING FOR OUT OF BOUNDS INSTRUCTION
/* COUNTER (IC). STACKS WILL JUST BLOW UP WITH A LENGTH ERROR. IT IS TO
/* BE USED ON DEBUGGED CODE ONLY.
 
 
/* # Chart Opcodes
/*
/* Define the various walker functions individually
 
.z.m.axqc.walkerFastInit:.z.m.axqc.nop: {
    // @qlintsuppress DEBUG_FUNCTION(1)    
    show "*** Abort: This should not happen. Invalid .z.m.axqc.opcode 0 (zero)."; /dnl
    .z.m.axqc.termination : `fatal;
    : .z.m.axqc.ic : 0;  /* loop halts on ic 0
    };
 
.z.m.axqc.readOperation: {
    /* is the expected token found in operand1 equal to the current token

    if [.z.m.axqc.chartCode [.z.m.axqc.ic + 1] <> .z.m.axqc.currentToken;
            .z.m.axqc.syntaxError .z.m.axqc.chartCode .z.m.axqc.ic + 1;
            : .z.m.axqc.ic;
    ];

    /* otherwise, suck up the token and continue

    .z.m.axqc.getNextToken [];
    : .z.m.axqc.ic +: 2;
    };
 
.z.m.axqc.callOperation: {
    .z.m.axqc.stackPtr +: 1;
    .z.m.axqc.callStack [.z.m.axqc.stackPtr] : .z.m.axqc.ic+2;

    /* call the chart referenced by operand1
    .z.m.axqc.currChart: .z.m.axqc.chartCode [.z.m.axqc.ic+1],.z.m.axqc.currChart;  // remember called chart
    : .z.m.axqc.ic : .z.m.axqc.chartStart .z.m.axqc.chartCode .z.m.axqc.ic + 1;
    };

.z.m.axqc.returnOperation: {
    /* Position zero in the call stack is set to zero. This will normally terminate the walker (ic=0 terminates).
    /* Note: this is an optimization!

    .z.m.axqc.stackPtr -: 1;
    .z.m.axqc.currChart : 1 _ .z.m.axqc.currChart;
    : .z.m.axqc.ic : .z.m.axqc.callStack .z.m.axqc.stackPtr+1;
    };
 
.z.m.axqc.chooseOperation: {
    .z.m.axqc.savedIc : .z.m.axqc.ic;
    .z.m.axqc.savedIcToken : .z.m.axqc.chartCode .z.m.axqc.ic + 2;
    : .z.m.axqc.ic +: 2;
    };
 
 
.z.m.axqc.chooseJumpOperation: {
    .z.m.axqc.savedIc : .z.m.axqc.ic;
    .z.m.axqc.savedIcToken : .z.m.axqc.chartCode .z.m.axqc.ic + 3;

    /* fetch the jump table

    offset   : .z.m.axqc.chartCode .z.m.axqc.ic + 1;
    size     : .z.m.axqc.chartCode offset;
/       otherwise: .z.m.axqc.chartCode [offset + 1];
/       tokenList: .z.m.axqc.chartCode [(offset + 2)+ til size];
/       jumpTable: .z.m.axqc.chartCode [(offset + 2 + size)+ til size];

    if [0 = count locn: where .z.m.axqc.currentToken = .z.m.axqc.chartCode offset + 2 + til size;
            : .z.m.axqc.ic : .z.m.axqc.chartCode offset + 1; /* otherwise
    ];

    jump: .z.m.axqc.chartCode [(offset + 2 + size)+ til size] first locn;

    if [jump > 0;
            .z.m.axqc.getNextToken[];                                             /* case read
            : .z.m.axqc.ic : jump;
    ];

    : .z.m.axqc.ic : neg jump;                                         /* case look
    };
 
 
.z.m.axqc.actionOperation: {
    /* call the action at operand1 with actions starting at operand2

    op2: .z.m.axqc.chartCode .z.m.axqc.ic + 2;
    .z.m.axqc.actionResult : .z.m.axqc.action [.z.m.axqc.chartCode .z.m.axqc.ic + 1; .z.m.axqc.chartCode (.z.m.axqc.ic+3)+ til op2];

    : .z.m.axqc.ic +: op2 + 3;                   /* inc ic by (operand2 + 3)
    };
 
.z.m.axqc.anyOperation: {
    .z.m.axqc.getNextToken[];
    : .z.m.axqc.ic +: 1;
    };
 
.z.m.axqc.caseReadTokenOperation: {
    if [.z.m.axqc.chartCode [.z.m.axqc.ic + 1] = .z.m.axqc.currentToken;      /* is operand1 = currentToken
        .z.m.axqc.getNextToken [];
        : .z.m.axqc.ic +: 3;
     ];

    /* Otherwise, increment and move on

    : .z.m.axqc.ic +: .z.m.axqc.chartCode .z.m.axqc.ic + 2;                                                        /* inc ic by operand2
    };
                
.z.m.axqc.caseActionResultOperation: {
    if [.z.m.axqc.chartCode [.z.m.axqc.ic + 1] = .z.m.axqc.actionResult;      /* is operand1 = actionResult
        : .z.m.axqc.ic +: 3;
    ];

    : .z.m.axqc.ic +: .z.m.axqc.chartCode .z.m.axqc.ic + 2;                                                        /* inc ic by operand2
    };
 
.z.m.axqc.caseTokenLookOperation: {
    if [.z.m.axqc.chartCode [.z.m.axqc.ic + 1] = .z.m.axqc.currentToken;      /* is operand1 = currentToken?
        : .z.m.axqc.ic +: 3;         
    ];
 
    : .z.m.axqc.ic +: .z.m.axqc.chartCode .z.m.axqc.ic + 2;                                                        /* inc ic by operand2
    };
 
.z.m.axqc.forwardBranchOperation: {
    : .z.m.axqc.ic +: .z.m.axqc.chartCode .z.m.axqc.ic + 1;                                                        /* inc ic by operand1
    };
 
.z.m.axqc.backwardBranchOperation: {
    : .z.m.axqc.ic -: .z.m.axqc.chartCode .z.m.axqc.ic + 1;                                                        /* dec ic by operand1
    };
 
.z.m.axqc.errorOperation: {
    .z.m.axqc.ic : .z.m.axqc.savedIc;
    .z.m.axqc.syntaxError .z.m.axqc.savedIcToken;
    : .z.m.axqc.ic +: 0;
    };
 
.z.m.axqc.abortOperation: {
    .z.m.axqc.walkerError `actionChoiceError;
    : .z.m.axqc.ic : 0;                                                                                                          /* loop halts on ic 0
    };
 
 
/ *
/ * Now combine the various walker functions into a vector for simpler calls
/ *
 
.z.m.axqc.maxOpcode: 13;                                                              / number of .z.m.axqc.opcodes
 
/* These are the walker opcodes
/* Note that each of these defines a function (see above).
/* And, each function returns the amount to increment the ic.
/* Note that some routines (like call & return) actually set the
/* ic to where it should be, thus returning 0.
 
.z.m.axqc.walker: (
    .z.m.axqc.nop;                                                                /* opcode 0
    .z.m.axqc.readOperation;                                              /* opcode 1
    .z.m.axqc.callOperation;                                              /*      :
    .z.m.axqc.returnOperation;
    .z.m.axqc.chooseOperation;
    .z.m.axqc.actionOperation;
    .z.m.axqc.anyOperation;
    .z.m.axqc.caseReadTokenOperation;
    .z.m.axqc.caseActionResultOperation;
    .z.m.axqc.caseTokenLookOperation;
    .z.m.axqc.forwardBranchOperation;
    .z.m.axqc.backwardBranchOperation;
    .z.m.axqc.errorOperation;                                     /*      :
    .z.m.axqc.abortOperation;                                     /* opcode 13
    .z.m.axqc.chooseJumpOperation );                              /* opcode 14 (new chooseJump)
 
/ *
/ * chartWalker loops until done (i.e., .z.m.axqc.looping = 0)
/ *
 
.z.m.axqc.initWalkerVariables: {
    // an empty stack for now (note, if we try to access more than 200 elements the stack will blow
    .z.m.axqc.callStack    :  200000#0;
    
    .z.m.axqc.currChart    :  ();
    .z.m.axqc.stackPtr     :  0;
    
    // forces the walker to stop normally
    .z.m.axqc.callStack [0]:  0;
    .z.m.axqc.ic           :  0;
    .z.m.axqc.opcode       :  0;
    .z.m.axqc.operand1     :  0;
    .z.m.axqc.operand2     :  0;
    .z.m.axqc.savedIc      :  0;
    .z.m.axqc.savedIcToken :  0;
    .z.m.axqc.actionResult :  0;
    
    // flag for when walker terminates set to `fatal on error
    .z.m.axqc.termination  :  `normal;
    };
 
/* # Chart Walker
/*
/* This is the routine that walks the bytecodes. It's core is an infinite loop
/* that terminates upon an error or the first chart returning successfully.
 
.z.m.axqc.chartWalker: {[firstChart;chartStart;chartCode]
    /* set up the initial variables

    .z.m.axqc.initWalkerVariables[];              /* reset the variables in case of subsequent invocation

    .z.m.axqc.initialChart    :   firstChart;
    .z.m.axqc.chartStartLimit :  count chartStart;
    .z.m.axqc.chartCodeLimit  :   count chartCode;

    .z.m.axqc.chartCode   : chartCode;
    .z.m.axqc.chartStart  : chartStart;
    .z.m.axqc.ic          : .z.m.axqc.chartStart firstChart;

    /* Start the walker proper. It loops until the ic = 0.
    /* There is no loop body.
    while [.z.m.axqc.walker [.z.m.axqc.chartCode .z.m.axqc.ic][];
    ];
    : .z.m.axqc.termination;
    };
                
/ *
/ * walkerError
/ *     usage: .z.m.axqc.walkerError [errorNo]
/ *
/ *     spits out the error information pertaining to errorNo
/ *
 
.z.m.axqc.walkerError: {[errorNo]
    // @qlintsuppress DEBUG_FUNCTION(15)
    $[  errorNo = `startOfChartError;
            [show "*** Chart Walker Error, Start chart is ", (string .z.m.axqc.initialChart), " and there are only ", (string .z.m.axqc.chartStartLimit), " charts."]; /dnl
        errorNo = `memoryProtectError;
            [show "*** Chart Walker Error, memory protect at ", (string .z.m.axqc.ic), " with memory limits 1 - ", (string .z.m.axqc.chartCodeLimit),"."]; /dnl
        errorNo = `callStackOverflowError;
            [show "*** Chart Walker Error, chart call stack overflow at depth ", (string .z.m.axqc.stackPtr), "."]; /dnl
        errorNo = `illegalOperationError;
            [show "***** Chart Walker Error, illegal operation ", (string .z.m.axqc.opcode), " at location ", (string .z.m.axqc.ic), ". Aborting."]; /dnl
        errorNo = `chartNumberError;
            [show "*** Chart Walker Error, illegal chart number ", (string .z.m.axqc.operand1), " on call at memory location ", (string .z.m.axqc.ic), "."]; /dnl
        errorNo = `actionParameterLimitError;
            [show "*** Chart Walker Error, illegal number of action parameters (", (string .z.m.axqc.operand2), ") on action at memory location ", (string .z.m.axqc.ic), ". Must be 0 or more."]; /dnl
        errorNo = `actionChoiceError;
            [show "*** Chart Walker Error, an action choice failed at memory location ", (string .z.m.axqc.ic), "."]; /dnl
            [show "*** Chart Walker Error, unknown error: ", (string errorNo), "."] /dnl
    ];
    errorNo;
    };

// @fileOverview Localized strings for the parser
.z.m.axqc.translations:.z.m.axlocalize.addTranslations (!) . flip enlist
    (`en;
        (!) . flip (
            (`.axqc_tokenExpression; "expression");
            (`.axqc_tokenTerm; "term");
            (`.axqc_tokenVariable; "variable");
            (`.axqc_tokenDyadicAdverb; "dyadic adverb");
            (`.axqc_tokenDyadic; "dyadic operator");
            (`.axqc_tokenDyadicAssign; "amend operator");
            (`.axqc_tokenWhitespace; "whitespace");
            (`.axqc_tokenNumber; "number");
            (`.axqc_tokenMultilineStart; "multiline comment start");
            (`.axqc_tokenMultilineEnd; "multiline comment end");
            (`.axqc_tokenComment; "comment");
            (`.axqc_tokenCommand; "command");
            (`.axqc_tokenDSL; "DSL");
            (`.axqc_tokenSymbol; "symbol");
            (`.axqc_tokenNumber; "number");
            (`.axqc_tokenFunction; "function");
            (`.axqc_tokenMonadicFunction; "monadic function");
            (`.axqc_tokenQSQL; "q sql query");
            (`.axqc_tokenInlineComment; "inline comment");
            (`.axqc_tokenEOF; "end of file");
            (`.axqc_errorQSQLSyntax; "Invalid QSQL syntax, possibly an extra comma");
            (`.axqc_errorCommentAfterCommand; "Comments can not be on the same lines as commands");
            (`.axqc_errorMalformedValue; "Malformed value");
            (`.axqc_errorSignalAfterReturn; "A signal can not follow a return");
            (`.axqc_errorQSQLConsecutiveCommas; "QSQL queries can not contain consecutive commas");
            (`.axqc_errorUnmatchedQuote; "Unmatched quote");
            (`.axqc_errorInvalidColon; "Invalid colon use");
            (`.axqc_errorInvalidSyntax; "Invalid syntax");
            (`.axqc_errorInvalidList; "Invalid list");
            (`.axqc_errorPolishNotationFunction; "Invalid polish notation function");
            (`.axqc_errorIncompleteDydAdv; "Incomplete dyadic adverb expression");
            (`.axqc_errorInvalidFunction; "Invalid function");
            (`.axqc_tooManyErrors; "Too many errors. Aborting.");
            (`.axqc_errorTooLong; "Erroring expression too long to show");
            (`.axqc_fatalParserError; "Fatal parser error");
            (`.axqc_foundBeforeExpected; "{found} was found before expected {expected}");
            (`.axqc_errorInRange; "Parse Error: \"{description}\" in the range {start} to {end} in the code: {code}");
            (`.axqc_errorCarriageReturn; "Parse Error: Inputs containing carriage returns (\\r, found in windows-style line endings) are not supported")
        ))
// @fileOverview A regex to find tokens which are symbols
// @qlintsuppress DEPRECATED_FUNCTION(1)
.z.m.axqc.symbolRegex:.z.m.fpcre2.compile["`([a-zA-Z0-9.][a-zA-Z0-9._]*(:[a-zA-Z0-9._/:]*)?|:[a-zA-Z0-9._/:]*)?";::]; /dnl

// @fileOverview Regexes related to identifying number, data and time primitives
// The time regex also contains 0:, 1: and 2: to be compatible with the existing code
// This is more lenient than the colourizer regex, because it must accept all valid q code
// The colourizer will colorize confusing representations as errors
.z.m.axqc.numberRegex:{
    cantBeNegative      : "[012]:|[10]+b|0x[\\da-fA-F]*";
    nullsAndInfinities  : "0[nNwW][cdefghijmnptuvz]?";
    numeric             : "(\\d+(\\.\\d*)?|\\d*\\.\\d+)(e[+-]?\\d+)[efpnt]?|(\\d+\\.\\d*|\\d*\\.\\d+)[efpnt]?|\\d+[eihjfpnuvt]?";
    // The timespans produced by using infixes other than T and D are not meaningful, but they do parse, so they are supported
    dateAndTimes        : "\\d{4}[:.](\\d{1,2}[:.]\\d{1,2}([a-zA-Z]\\d{2}(:\\d{2}(:\\d{2}([:.]\\d*)?)?)?[zpn]?|[TDdpmnz]?)|\\d{2}m)";
    timeOnly            : "\\d{2}:\\d{2}(:\\d{2}([:.]\\d*)?)?[pnvut]?";
    DDelimitedTime      : "\\d{1,6}D(\\d{1,2}(:\\d{2}(:\\d{2}(\\.\\d*|\\.?)?)?)?)?[np]?";
    PDelimitedTime      : "\\d{1,6}P\\d{2}:\\d{2}([np]|:\\d{2}([np]|\\.[np]|\\.\\d*[np]|\\.\\d{3,}[np]?))";
    // @qlintsuppress DEPRECATED_FUNCTION(1)
    : .z.m.fpcre2.compile["^(" , cantBeNegative, "|-?(" , ("|" sv (nullsAndInfinities; dateAndTimes; timeOnly; DDelimitedTime; PDelimitedTime; numeric)) , "))";::];
    }[];
// @fileOverview This defines the charts bytecode, and allows re-generating the bytecode after changing the charts file
.z.m.axqc.initializeInit:.z.m.axqc.loadChartsF: {[fnIn;fnOut]
    // Generates the charts instructions
    @[hdel; fnOut; ::]; /dnl
    dict:: .z.m.axsc.compile[fnIn;fnOut];
    .z.m.axqc.initialChart    : dict `initialChart;
    .z.m.axqc.chartStartSize  : dict `chartStartSize;
    .z.m.axqc.chartStart      : dict `chartStart;
    .z.m.axqc.chartCode       : dict `chartCode;
    .z.m.axqc.chartNames      : dict `chartNames;
    .z.m.axqc.tokenNames      : dict `tokenNames;
    .z.m.axqc.chartCode       : .z.m.axsc.optimizer[.z.m.axqc.chartStart; .z.m.axqc.chartCode; `tail`jump];
    };

.z.m.axqc.loadCharts:{.z.m.axqc.loadChartsF[`:.axqc/q.ss;`:.axqc/qParserChartsBin.q]};

// Run this to load the charts into memory, useful for development, but doesn't persist the bytecode
// .z.m.axqc.loadCharts[];

// Use these to save the bytecodes
// consoleSize: " " sv string system "c";
// system "c 2000 2000";
.z.m.axqc.saveChartsAsQ:{[fn]
    @[hdel;fn;::];
    h:hopen fn;
    h"    .z.m.axqc.initialChart    : ",string[.z.m.axqc.initialChart],";\n";
    h"    .z.m.axqc.chartStartSize  : ",string[.z.m.axqc.chartStartSize],";\n";
    h"    .z.m.axqc.chartStart      : ",(" "sv string[.z.m.axqc.chartStart]),";\n";
    h"    // @qlintsuppress LINE_LENGTH (2)\n";
    h"    .z.m.axqc.chartCode       : ",(" "sv string[.z.m.axqc.chartCode]),";\n";
    h"    .z.m.axqc.chartNames      : (",(";"sv"\"",/:.z.m.axqc.chartNames,\:"\""),");\n";
    h"    .z.m.axqc.tokenNames      : (",(";"sv"\"",/:.z.m.axqc.tokenNames,\:"\""),");\n";
    hclose h;
    fn}

// `$enlist each 1995 cut " " sv string .z.m.axqc.chartCode;
// .z.m.axqc.chartStart
// enlist enlist `$"(\"", ("\";\"" sv .z.m.axqc.chartNames) , "\")"
// system "c ", consoleSize

//.z.m.axqc.loadChartsF[`:axqparser/kxscm/module/.axqc/file/q.ss;`]
//.z.m.axqc.saveChartsAsQ[`:charts.q]

.z.m.axqc.initChartCode:{
    // The saved charts instructions
    .z.m.axqc.initialChart    : 1;
    .z.m.axqc.chartStartSize  : 31;
    .z.m.axqc.chartStart      : 0 1 1377 41 1641 89 65 370 650 1591 1299 1487 1465 1103 1530 1726 1752 1867 1942 1824 1908 1193 1882 1321 1428 1239 1564 1267 1345 1433 1701 1925;
    // @qlintsuppress LINE_LENGTH (2)
    .z.m.axqc.chartCode       : 0 2 2 14 1960 7 13 8 5 9 0 10 27 7 38 11 5 46 0 5 9 0 10 16 7 0 10 5 10 0 10 10 10 6 2 3 10 2 11 37 3 2 2 14 1968 9 13 5 10 16 7 12 10 5 4 0 2 4 10 6 2 5 10 2 3 2 2 14 1974 9 13 5 10 16 7 12 10 5 4 0 2 4 10 6 2 7 10 2 3 2 2 14 1980 7 1 5 10 15 7 31 5 10 10 7 36 5 10 5 7 30 10 5 4 0 2 8 10 253 7 3 5 10 10 7 4 5 10 5 7 12 10 5 4 0 2 9 10 233 7 17 5 10 5 7 23 10 5 33 0 2 9 10 218 7 40 10 5 3 0 2 9 10 208 7 10 9 2 10 2 8 10 199 7 22 9 2 11 2 8 10 190 7 14 10 5 2 0 2 8 10 180 7 28 9 2 12 2 8 10 171 7 6 9 2 13 2 8 10 162 7 5 5 10 5 7 2 7 2 14 10 150 7 8 7 2 15 10 143 7 32 7 2 16 10 136 7 33 24 4 0 5 31 0 8 2 7 2 17 10 9 5 4 0 2 8 10 2 10 112 7 16 24 4 0 5 28 0 8 0 10 5 33 0 2 9 10 6 2 18 10 2 10 88 9 34 5 10 5 9 35 35 4 0 5 28 0 8 0 23 14 2036 7 34 5 10 5 7 35 10 5 29 0 2 8 10 3 12 10 4 10 2 10 48 7 15 7 2 19 10 41 7 27 11 5 4 0 5 39 0 10 30 7 41 11 5 4 0 5 51 0 10 19 7 37 16 5 4 0 5 43 0 2 20 5 42 0 10 3 12 3 2 2 14 2042 7 1 5 10 15 7 31 5 10 10 7 36 5 10 5 7 30 10 5 4 0 2 8 10 252 7 3 5 10 10 7 4 5 10 5 7 12 10 5 4 0 2 9 10 232 7 17 5 10 5 7 23 10 5 33 0 2 9 10 217 7 40 10 5 3 0 2 9 10 207 7 10 9 2 10 2 8 10 198 7 22 9 2 11 2 8 10 189 7 14 10 5 2 0 2 8 10 179 7 28 9 2 12 2 8 10 170 7 6 9 2 13 2 8 10 161 7 5 5 10 5 7 2 7 2 14 10 149 7 8 7 2 15 10 142 7 32 7 2 16 10 135 7 33 24 4 0 5 31 0 8 2 7 2 17 10 9 5 4 0 2 8 10 2 10 111 7 16 24 4 0 5 28 0 8 0 10 5 33 0 2 9 10 6 2 18 10 2 10 87 9 34 5 10 5 9 35 35 4 0 5 28 0 8 0 23 14 2098 7 34 5 10 5 7 35 10 5 29 0 2 8 10 3 12 10 4 10 2 10 47 7 15 7 2 19 10 40 7 27 11 5 4 0 5 39 0 10 29 7 41 11 5 4 0 5 51 0 10 18 7 37 16 5 4 0 5 43 0 2 20 5 42 0 10 2 3 2 2 14 2104 9 13 5 10 445 7 1 5 10 15 7 31 5 10 10 7 36 5 10 5 7 30 35 4 0 5 45 0 8 1 16 5 49 0 5 4 0 2 8 5 8 0 10 11 8 0 8 5 44 0 10 3 13 10 395 7 3 5 10 10 7 4 5 10 5 7 12 13 5 49 0 5 4 0 2 21 10 372 7 23 13 5 49 0 5 33 0 2 21 10 359 7 17 32 4 0 5 45 0 8 1 13 5 49 0 5 33 0 2 21 10 11 8 0 8 5 44 0 10 3 13 10 327 7 40 13 5 49 0 5 3 0 2 21 10 314 7 5 5 10 5 7 2 7 2 22 10 302 7 10 9 2 23 2 8 10 293 7 28 15 5 49 0 2 12 2 8 5 8 0 10 278 7 14 16 5 49 0 5 2 0 2 8 5 8 0 10 262 7 22 34 4 0 5 45 0 8 1 15 5 49 0 2 11 2 8 5 8 0 10 11 8 0 8 5 44 0 10 3 13 10 228 7 6 15 5 49 0 2 13 2 8 5 8 0 10 213 7 8 13 5 49 0 2 15 5 8 0 10 200 7 32 13 5 49 0 2 16 5 8 0 10 187 7 33 30 4 0 5 31 0 8 2 7 2 17 10 15 5 49 0 5 4 0 2 8 5 8 0 10 2 10 157 7 16 27 4 0 5 28 0 8 0 13 5 49 0 5 33 0 2 21 10 6 2 18 10 2 10 130 9 34 5 10 5 9 35 60 4 0 5 28 0 8 0 48 14 2162 7 34 5 10 5 7 35 35 4 0 5 45 0 8 1 16 5 49 0 5 29 0 2 8 5 8 0 10 11 8 0 8 5 44 0 10 3 13 10 3 12 10 4 10 2 10 65 7 15 7 2 22 10 58 7 27 17 5 49 0 5 4 0 5 39 0 5 8 0 10 41 7 41 17 5 49 0 5 4 0 5 51 0 5 8 0 10 24 7 37 22 5 49 0 5 4 0 5 43 0 2 20 5 42 0 5 8 0 10 2 3 5 4 0 5 11 0 2 2 4 0 7 10 62 5 4 0 2 2 4 0 7 11 7 2 2 10 12 2 24 2 2 1 11 2 2 10 2 5 4 0 4 0 7 7 11 5 4 0 5 50 0 10 19 5 15 0 2 24 2 2 1 7 5 4 0 5 14 0 10 2 10 16 2 25 2 2 1 7 5 4 0 5 13 0 10 2 5 12 0 3 2 2 14 2168 7 5 5 10 10 7 2 5 10 5 7 15 9 2 14 2 26 10 24 7 10 12 2 23 2 8 5 8 0 10 12 2 7 5 22 0 5 23 0 10 2 3 2 2 14 2178 7 13 8 5 4 0 10 13 7 38 11 5 46 0 5 4 0 10 2 2 6 10 3 3 2 2 14 2184 7 13 12 5 4 0 2 6 2 27 10 17 7 38 15 5 46 0 5 4 0 2 6 2 27 10 2 3 5 4 0 5 11 0 2 25 2 2 1 11 5 4 0 5 20 0 5 12 0 3 5 4 0 5 11 0 2 6 2 28 2 2 1 11 5 4 0 5 19 0 5 12 0 3 2 2 14 2190 7 13 12 5 4 0 2 6 2 28 10 17 7 38 15 5 46 0 5 4 0 2 6 2 27 10 2 3 14 2196 7 21 5 10 5 7 20 8 5 16 0 10 35 7 26 5 10 5 7 39 8 5 17 0 10 22 7 24 8 5 41 0 10 14 7 25 8 5 40 0 10 6 10 6 10 2 11 48 3 2 3 10 3 3 2 2 14 2210 7 13 12 5 4 0 2 3 2 29 10 17 7 38 15 5 46 0 5 4 0 2 3 2 29 10 2 3 5 4 0 4 0 7 28 10 2 12 5 7 0 10 6 10 6 10 2 11 16 3 5 4 0 2 2 4 0 7 22 29 4 0 5 45 0 8 1 10 2 11 5 6 0 10 11 8 0 8 5 44 0 10 3 13 10 6 10 6 10 2 11 37 3 5 21 0 2 2 14 2216 7 5 5 10 10 7 2 5 10 5 7 15 10 2 14 5 24 0 10 6 10 6 10 2 11 28 3 2 2 4 0 7 10 15 2 23 5 25 0 2 8 5 8 0 10 9 2 7 5 26 0 10 2 3 2 2 14 2224 7 5 5 10 10 7 2 5 10 5 7 15 26 2 14 4 0 7 10 12 2 23 5 25 0 2 8 10 7 5 26 0 10 2 10 11 7 10 9 2 23 2 8 10 2 3 2 2 14 2234 7 5 5 10 5 7 2 26 2 14 4 0 7 10 12 2 23 5 25 0 2 8 10 7 5 26 0 10 2 10 26 7 10 9 2 23 2 8 10 17 7 15 8 5 47 0 10 9 2 7 5 18 0 10 2 3 2 2 4 0 7 10 20 5 4 0 2 25 2 2 1 11 5 4 0 5 35 0 10 2 3 5 4 0 5 11 0 2 30 2 25 2 2 1 9 5 4 0 5 34 0 5 12 0 11 1099 3 5 4 0 5 11 0 5 30 0 2 2 4 0 7 10 9 2 10 2 2 10 2 4 0 7 36 10 5 4 0 2 2 10 2 2 7 2 2 4 0 7 35 12 5 4 0 2 7 2 2 10 2 1 34 5 12 0 5 4 0 5 36 0 2 5 5 37 0 5 38 0 3 14 2244 9 10 16 5 33 0 2 2 1 10 2 23 2 8 10 26 9 5 5 10 10 9 2 5 10 5 9 15 7 2 14 10 9 5 32 0 2 8 10 2 3 5 11 0 5 30 0 2 5 5 12 0 5 27 0 3 2 14 2 2 4 0 7 10 12 2 23 5 25 0 2 8 10 9 2 7 5 26 0 10 2 3 2 2 4 0 7 13 8 5 4 0 10 2 2 6 10 3 3 2 2 4 0 7 13 12 5 4 0 2 6 2 31 10 2 3 2 2 4 0 7 16 8 5 48 0 10 2 2 5 5 27 0 3 3 34 13 38 0 8 16 27 2 60 13 12 -48 53 2 84 13 12 -72 77 27 368 1 31 36 30 3 4 12 17 23 40 10 22 14 28 6 5 2 8 32 33 16 34 35 15 27 41 37 96 101 106 111 121 126 131 141 146 156 166 175 184 194 203 212 217 224 231 238 262 -286 -291 326 333 344 355 2 316 34 35 304 309 27 649 1 31 36 30 3 4 12 17 23 40 10 22 14 28 6 5 2 8 32 33 16 34 35 15 27 41 37 377 382 387 392 402 407 412 422 427 437 447 456 465 475 484 493 498 505 512 519 543 -567 -572 607 614 625 636 2 597 34 35 585 590 28 1102 13 1 31 36 30 3 4 12 23 17 40 5 2 10 28 14 22 6 8 32 33 16 34 35 15 27 41 37 -657 662 667 672 677 712 717 722 735 748 780 793 798 805 814 829 845 879 894 907 920 950 -977 -982 1042 1049 1066 1083 2 1032 34 35 995 1000 4 1228 5 2 15 10 1200 1205 1210 1219 2 1262 13 38 1246 1254 2 1298 13 38 1274 1286 2 1376 13 38 1352 1364 6 1421 21 20 26 39 24 25 1382 1387 1395 1400 1408 1416 2 1464 13 38 1440 1452 3 1557 5 2 15 1540 1545 1550 4 1640 5 2 15 10 1598 1603 1608 1634 4 1693 5 2 10 15 1648 1653 1679 1688 4 1859 10 5 2 15 -1829 -1845 -1850 -1855;
    .z.m.axqc.chartNames      : ("-----";"START_OF_FILE";"REMOVE_UNIMPORTANT";"EXPRESSION_START";"OPTIONAL_AFTER_COLON_INITIAL";"EXPRESSION";"OPTIONAL_EXPRESSION_START";"OPTIONAL_EXPRESSION";"OPTIONAL_AFTER_TERM";"OPTIONAL_AFTER_DYD";"SQUARE_BRACKET_END";"HANDLE_NUMBER";"SYMBOL_LIST";"PARENTHESIS_END";"OPTIONAL_ADVERB_LIST_END";"L_BRACE_END";"HANDLE_SQL";"HANDLE_ALTERNATE_WHERE";"HANDLE_COMMA_IN_QSQL";"HANDLE_APOSTROPHE";"OPTIONAL_COMMAND_EXPRESSION_LIST";"OPTIONAL_EXPRESSION_END_DYD";"ADVERB_AFTER_TERM";"POLISH_NOTATION";"FILLED_EXPRESSION_LIST";"OPTIONAL_EXPRESSION_LIST";"OPTIONAL_AFTER_ADVERB";"OPTIONAL_EXPRESSION_LIST_END";"OPTIONAL_POLISH_NOTATION_END";"FILLED_EXPRESSION_LIST_END";"OPTIONAL_INTERNAL_PARAMS";"OPTIONAL_COMMAND_EXPRESSION_LIST_END");
    .z.m.axqc.tokenNames      : ("EOF";"name";"dyadicAdverb";"dyadic";"dyadicAssign";"bslash";"lParen";"rParen";"lBrace";"rBrace";"lBracket";"rBracket";"colon";"semi";"doubleQuote";"apostrophe";"comma";"dot";"slash";"backtick";"newline";"whitespace";"number";"underscore";"multilineStart";"multilineEnd";"comment";"unparsedCommand";"symbol";"dotNumber";"multivalent";"monadic";"sql";"where";"from";"by";"distinct";"qCommand";"commandEnd";"inlineComment";"doubleColon";"dsl");
    }

// This is outside the .z.m.axqc.q function so it doesn't get reset every run
// Setting it to `true means that it will print out the names of most actions
// called from CHARTS, and in some instances, their arguments
.z.m.axqc.debug: `false;

// @fileOverview The Fast Tokenizer (includes getNextToken)
/*
/* Provided a string it quickly asserts the various punctuation marks and their location into a complimentary list of tokens.
/* Names, numbers, and strings are not handled. It is up to the tokenizer proper to determine combinations such as `$ or
/* strings such as "this is a string" and handle it all appropriately. This includes namespaces which will appear with the
/* periods in the name pretokenized as `dot.
 
 
/* # User Defined Tokenizer Setup
/*
/* The following globals must be set so that the tokenizer will properly handle the tokens
/* associated with your charts.
 
.z.m.axqc.fastTokenizerHDInit:.z.m.axqc.CHARTS: `SOT`EOF`EOL`BLANK`TAB`TOKENS`PRINT`MULTIVALENT`MONADIC`DYADIC`SQL`CHARS`CNAMES`CHARSYMS`COMPOUND`COMPNAMES!();
 
/* ## Collision proof tokens
/*
/* Allow for the creation of collision proof tokens by suffixing with an unprintable char
 
.z.m.axqc.CHARTS [`SOT]    : `char$0x02;         /* ctrl-B, start-of-text in ascii
.z.m.axqc.CHARTS [`EOF]    : `$ `char$0x04;     /* ctrl-D, unix eof
.z.m.axqc.CHARTS [`EOL]    : `$"\n";             /* ctrl-J, unix newline
.z.m.axqc.CHARTS [`BLANK]  : `$"\002ws";    /dnl /* whitespace marker
.z.m.axqc.CHARTS [`TAB]    : `$"\002tab";   /dnl /* tab marker
 
/* ## Tokens & Keywords
/*
/* These MUST align with the classifications as defined within your CHARTS program
 
.z.m.axqc.initFastTokenizerHD:{
    .z.m.axqc.CHARTS [`TOKENS]: .z.m.axqc.tokenNames;
    .z.m.axqc.CHARTS [`PRINT]:  `$.z.m.axqc.CHARTS `TOKENS;
    }

/* define any special keywords to look for, handle these special if needed (see below).
 
.z.m.axqc.CHARTS [`MULTIVALENT]: `aj`aj0`ajf`ajf0`do`ej`enlist`if`while`wj`wj1`ww;
 
.z.m.axqc.CHARTS [`MONADIC]: asc
    `abs`acos`all`any`asc`asin`atan`attr`avg`avgs`ceiling`cols`cos`count`deltas`desc`dev`differ,
    `eval`exit`exp`fills`first`fkeys`flip`floor`get`getenv`group`gtime`hclose`hcount`hdel,
    `hopen`hsym`iasc`idesc`inv`key`keys`last`load`log`lower`ltime`ltrim`max`maxs`md5`med`meta,
    `min`mins`neg`next`not`null`parse`prd`prds`prev`rand`rank`ratios`raze`read0`read1`reciprocal,
    `reval`reverse`rload`rsave`rtrim`save`sdev`show`signum`sin`sqrt`ssr`string`sum`sums`svar`system`tables,
    `tan`til`trim`type`ungroup`upper`value`var`view`views;

.z.m.axqc.CHARTS [`DYADIC]: asc
    `and`asof`bin`binr`cor`cov`cross`cut`div`dsave,
    `each`ema`except`fby`ij`ijf`in`insert`inter`like`lj`ljf`lsq`mavg`mcount,
    `mdev`mmax`mmin`mmu`mod`msum`or`over`peach`pj`prior`rotate`scan`scov,
    `set`setenv`ss`sublist`sv`uj`ujf`union`upsert,
    `vs`wavg`within`wsum`xasc`xbar`xcol`xcols`xdesc`xexp`xgroup`xkey,
    `xlog`xprev`xrank,
    // For embedPy
    `pykw;

.z.m.axqc.CHARTS [`SQL]     : `delete`exec`select`update;

/* Define the the non-alphanumeric characters that your program may recognize.
/* Typically this is NOT changed as it is standard non-alphanumeric keyboard characters.
/* CNAMES are the printable names for the CHARS.
 
.z.m.axqc.CHARTS [`CHARS]  : "\004\n \t{}()[];`'$/\\#?@+-*&|%!<>=:\"~,._^"; 
.z.m.axqc.CHARTS [`CNAMES]   : `EOF`EOL`whitespace`tab`openCurly`closeCurly`openBracket`closeBracket`openSquare`closeSquare,
    `semi`backtick`quote`dollar`slash`backslash`pound`question`at`plus`minus`star`and`bar`percent`bang`lessthan`greaterthan,
    `equal`colon`dquote`tilde`comma`dot`underscore`caret;
.z.m.axqc.CHARTS [`CHARSYMS] : each [{$[x = " "; `$"\002ws"; x = "\t"; `$"\002tab"; `$ string x]}] .z.m.axqc.CHARTS `CHARS; /dnl
 
/* If you have compound operators, define them here as a list. Sort them from longest to shortest.
 
/***************************
/* NOTE: ss does not like an asterisk so I've removed *:, *::, ?:, and ?:: for now as they interfere with ss big time!
/*     they are handled via special case code in fastTokenize function
 
.z.m.axqc.CHARTS [`COMPOUND]  :  ("\n/\n\\\n";"\n/\n";"\n\\\n";" /";"\t/"), /dnl
                             (enlist "\n\\ts "), ("\n\\",/:"abBcCdefgopPsStTuvwWxz",\:" "), /dnl
                             (enlist "\n\\ts\n"), ("\n\\",/:"abBcCdefgopPsStTuvwWxz",\:"\n"), /dnl
                             ("\n/";"\n\\";"/:";"\\:";"':";">=";"<=";"<>";"::"), /dnl
                             ("<>:";">=:";"<=:";"<>::";">=::";"<=::"), /dnl
                             ("~!@#$%^&-_+=,.|<>",\:":"), ("~!@#$%^&-_+=,.|<>",\:"::"), /dnl
                             ("\n",/:raze[.Q`A`a],\:")");
 
/* UGLY CODE:
/* q eliminates leading spaces in strings when you symbolize them,
/* so we have to manually associate what we want for " /" and "\t/"
 
.z.m.axqc.CHARTS [`COMPNAMES] :(`$("\n/\n\\\n";"\n/\n";"\n\\\n";"\002ws/";"\002tab/"), /dnl
                             (enlist "\n\\ts\002ws"), ("\n\\",/:"abBcCdefgopPsStTuvwWxz",\:"\002ws")),`$28 _ .z.m.axqc.CHARTS `COMPOUND; /dnl
 
 
/***************************************************
/* BELOW THIS POINT NO CHANGES SHOULD BE NECESSARY *
/***************************************************
 
/* #setup the Tokenizer/Lexer
/*
/* This sets up the various parsing dictionaries and parsing lists. You need to replace keywords with
/* your own keywords, tokens with your own tokens, etc. If you handle characters in a way that is unique
/* that must also be handled below so that the appropriate lexer function can be called. Note that the
/* lexer dictionaries relate a character with a function that will be called when the character is seen.
/* The function will then determine the token type.
/*
/* setupTokenizer assumes that .z.m.axqc.INPUT has been set to a valid input string.
 
.z.m.axqc.setupTokenizer: {
    /* Define the tokens that are defined in the Chart program here. Note that if a specific
    /* token represents a single character, utilize the single character in chartTokens and
    /* use a symbolic name in  printableTokens.
    
    chartTokens     : .z.m.axqc.CHARTS `TOKENS;             /* the tokens for the chart to be tokenized and
    printableTokens   : .z.m.axqc.CHARTS `PRINT;            /* printable representations, both fetched from above
    
    
    /* short names for commonly used CHARTS elements
    EOF : .z.m.axqc.CHARTS `EOF;
    
    /* This is used to enumerate the input stream properly. Note that `name is
    /* used for any variables, functions, etc. defined in the text to be parsed
    /* that isn't a defined token as defined above. Note that the token `name
    /* properly resolves even if the user defines name as a variable or function.
    /* However, caution should be taken in case this fouls up the symbol table.
 
    /* take each chartToken string and convert to a symbol and associate it with its
    /* token ID (charts) and its printable name creating a correspondence of the form:
    /* (token | id printableName)
    
    .z.m.axqc.tokens: (`$chartTokens)! til count printableTokens;
    .z.m.axqc.tokensPrnt: (til count printableTokens)!printableTokens;       /* printable dictionary for quick lookup
    .z.m.axqc.startWithNewline: .z.m.axqc.tokens `newline`multilineStart`multilineEnd`comment`unparsedCommand`qCommand`dsl;

    /* This stores token text as symbols and the corresponding CHARTS code in a dictionary
    tokenDict:    (`$("\n/\n\\\n";"\n/\n";"\n\\\n";"\002ws/";"\002tab/";"\n/";"\n\\";"/:";"\\:";"':";">=";"<=";"0:";"1:";"2:";"<>";"<>:";">=:";"<=:";"<>::";">=::";"<=::") /dnl
                    ,("~!@#$%^&*-_+=,.|?<>",'":"),("~!@#$%^&*-_+=,.|?<>",\:"::"),"~!@#$%^&*-=+|<>?\\(){}[]:;\"',./`\n_" /dnl
                    ,("\002ws";"\002tab";"\004";"\n\\ts\002ws";"\n\\ts\n") /dnl
                    ,("\n\\",/:"abBcCdefgopPsStTuvwWxz",\:"\002ws"),("\n\\",/:"abBcCdefgopPsStTuvwWxz",\:"\n"),enlist["::"]
                    ,("\n",/:raze[.Q`A`a],\:")")) /dnl
                    ! raze (2 1 2 1 1 3 6 44 16, (20#1), 46 1,count[raze .Q`A`a]){x#.z.m.axqc.tokens y}
                    ' `multilineStart`multilineEnd`inlineComment`comment`unparsedCommand`dyadicAdverb`dyadic`dyadicAssign`dyadic`bslash
                    , `lParen`rParen`lBrace`rBrace`lBracket`rBracket`colon`semi`doubleQuote`apostrophe`comma
                    , `dot`dyadicAdverb`symbol`newline`underscore`whitespace`whitespace`EOF`qCommand`doubleColon`dsl;
    enumerate: {[x;tokenDict]
        alpha  : "abcdefghijklmnopqrstuvwxyz"; /dnl
        allAlpha: alpha,upper alpha;
        
        if [0N=a:tokenDict x;                       /* if it's unknown, it must be a number or a name
            if [(f: first str: string x) in allAlpha;
                : .z.m.axqc.tokens `name;
            ];
            if [f in "0123456789";
                : .z.m.axqc.tokens `number;
            ];
            if [f in "-.";                          /* if we see a period, decide on a number or a name spaced name
                $[str [1] in "0123456789";                          : .z.m.axqc.tokens `number;
                  (str [1] = ".") and str [2] in "0123456789";    : .z.m.axqc.tokens `number;
                                                                    : .z.m.axqc.tokens `name];
            ];
            if [f = "`";
                : .z.m.axqc.tokens `symbol;
            ];
        ];
        if [x = .z.m.axqc.CHARTS `EOL;                    /* if it's EOL, we'll just handle it as whitespace
            : .z.m.axqc.tokens `newline;                  /* obviously, you could just handle EOL in the charts
        ];
        : a;                                      /* otherwise return the token ID
        }[;tokenDict];

    /* Read in the file and fast tokenize it
    /* We will mark each end of line with a unique end-of-line marker
    /* It may be necessary to define an EOL marker more unique than .z.m.axqc.EOL
    stream: .z.m.axqc.namesAndNums .z.m.axqc.fastTokenize[];              /* first, fast tokenize it into a list of lists
    stream: stream, enlist (EOF;1 + count .z.m.axqc.INPUT);            /* tack on EOF
    .z.m.axqc.rawTokens: first each stream;                            /* pull out just the tokens

    /* Create a token list where we match each of the tokens and if we find
    /* a token that doesn't match, assume it's a name and assign
    /* it appropriately. Note that enumerate is defined above and can
    /* be customized by the user.
    .z.m.axqc.tokenList : enumerate each .z.m.axqc.rawTokens;                    /* tokens as per charts
    .z.m.axqc.tokenLoc  : each [first last] stream;                        /* locations for error recovery
    .z.m.axqc.tokenEnd  : (1_stream[;1]-1),last last stream;               /* the position of the last char in each token

    /* Handle keywords
    .z.m.axqc.tokenList [where .z.m.axqc.rawTokens in .z.m.axqc.CHARTS `MULTIVALENT]  : .z.m.axqc.tokens `multivalent;
    .z.m.axqc.tokenList [where .z.m.axqc.rawTokens in .z.m.axqc.CHARTS `MONADIC]      : .z.m.axqc.tokens `monadic;
    .z.m.axqc.tokenList [where .z.m.axqc.rawTokens in .z.m.axqc.CHARTS `DYADIC]       : .z.m.axqc.tokens `dyadic;
    .z.m.axqc.tokenList [where .z.m.axqc.rawTokens in .z.m.axqc.CHARTS `SQL]          : .z.m.axqc.tokens `sql;
    .z.m.axqc.tokenList [where .z.m.axqc.rawTokens = `where]                    : .z.m.axqc.tokens `where;
    .z.m.axqc.tokenList [where .z.m.axqc.rawTokens = `from]                     : .z.m.axqc.tokens `from;
    .z.m.axqc.tokenList [where .z.m.axqc.rawTokens = `by]                       : .z.m.axqc.tokens `by;
    .z.m.axqc.tokenList [where .z.m.axqc.rawTokens = `distinct]                 : .z.m.axqc.tokens `distinct;

    /* Define misc. tokenizer variables
    
    .z.m.axqc.currentToken: .z.m.axqc.tokens EOF;
    
    .z.m.axqc.tokenPtr: -1;
    .z.m.axqc.errorNumber: 0;
    
    /* Define symbol table as an empty dictionary (not used in nvc)
    
    .z.m.axqc.defineSymbolTable[];
 
    /An imaginary newline is added to the start of the input, this adjusts the indicies to account for it   
    .z.m.axqc.tokenLoc-:1;
    .z.m.axqc.tokenEnd-:1;
 
    /If the first token captured the imaginary newline
    /This takes the imaginary newline out
    $[ .z.m.axqc.tokenList[0] ~.z.m.axqc.tokens `newline;
        [     .z.m.axqc.tokenLoc:  1_.z.m.axqc.tokenLoc;
            .z.m.axqc.tokenEnd:  1_.z.m.axqc.tokenEnd;
            .z.m.axqc.tokenList: 1_.z.m.axqc.tokenList;
            .z.m.axqc.rawTokens: 1_.z.m.axqc.rawTokens];
        [     .z.m.axqc.tokenLoc [0]: 0;
            .z.m.axqc.rawTokens[0]: `$1_string .z.m.axqc.rawTokens 0]];
    };
 
/* # Tokenize Routines
/*
/* The following are the tokenize routines. They should not need to be modified
 
/* the individual charTokens so we can quickly find the related character for a given token to recreate the input stream
/* we need to append/prepend SOTs to each so that they don't conflict with actual text/tokens in the input stream.
 
/* Create a dictionary character tokens from the various printable chars, plus end-of-line, blank and tab.
 
/* Note that \004 is ctrl-D which is end-of-file in Unix.
/* Also note that q does not store end-of-file in a read file, so when we append it to a fil
/* it is done so simply to allow us to return an end-of-file token.
 
.z.m.axqc.charTokens: .z.m.axqc.CHARTS [`CHARS]!.z.m.axqc.CHARTS `CHARSYMS;       /* a dictionary of characters and associated tokens
 
/* Create a dictionary of printable token names which can be used by a Chart to reference back into the unique token list
 
.z.m.axqc.tokenNames: (value .z.m.axqc.charTokens)!.z.m.axqc.CHARTS `CNAMES;
 
    
/* ## fastTokenize
/*
/* This takes in a string (.z.m.axqc.INPUT) and quickly tokenizes it to a list of symbols.
/* Note that the tokenized list can be reconstituted into the string if necessary.    
 
.z.m.axqc.fastTokenize: {
    /* ## tokenize
    /*
    /* take the input stream and extract alpha numerics,
    /* depending on which token type is provided
 
    tokenize: {[tok]
        x1: where .z.m.axqc.tokenized = tok;                          /* first find where the "tok"s are and then go across  ((-':)(0;1;2;3;4;5;6;7))
        
        /* handle fencepost problem where the first unknown is at index 1
        
        start: $[x1[0] = 1; x1 where (1-':x1) <> 1;          /* pairwise finding where the counts change (this is word starts)
                            x1 where ((-':)x1)<> 1];             /* if we're at anything other than index 1, we can use this case
 
 
        /* let's reverse the .z.m.axqc.tokenized list and go at it from the back!
 
        rx1: where (reverse .z.m.axqc.tokenized) = tok;                 /* first find where the tokens (digit/alpha) are
 
        /* handle the fencepost the other way
        
        rx2: $[rx1[0] = 1;  rx1 where (1-':rx1) <> 1;            /* and thus calculate the end points
                            rx1 where ((-':)rx1)<> 1];
                            
        end: reverse ((count .z.m.axqc.tokenized) - 1) - rx2;     /* (a bit more complicated than figuring out the start)
        
        /* now, pull the strings out of the input string and make them into symbols.
        
        symbols: .z.m.axqc.INPUT {`$ x y[0]+ til 1+y[1]-y 0}/:(start ,' end);
        
        /* and create indices so we can update the .z.m.axqc.tokenized list correctly (note, str[indices] will give you the strings)
        
        indices: each [{x[0]+ til 1+x[1]-x 0}] (start ,' end);
         
        /* ensure we embed the symbols throughout
 
        indices {.z.m.axqc.tokenized[first x]:y;}' symbols;
        };
 
    /* set the worst case (i.e., a line of count tokens)

    unknown: `$ .z.m.axqc.CHARTS [`SOT],"unknown"; /dnl
    digits : `$ .z.m.axqc.CHARTS [`SOT],"digit"; /dnl
    alpha  : `$ .z.m.axqc.CHARTS [`SOT],"alpha"; /dnl
    
    /* Note that .z.m.axqc.tokenized is a global since we need to modify it
    /* in a variety of spots within the tokenize routine, above and within
    /* embedded lambdas, below. Proper scoping would be handy.
 
    .z.m.axqc.tokenized: (count .z.m.axqc.INPUT)#unknown;
 
    /* Tokenize single chars and their locations. Alphanumerics are handled immediately afterwards.
    /* Note, we need to use a global to do it in one line as opposed to
    /* using a do, as below, with only locals
 
    .z.m.axqc.INPUT {.z.m.axqc.tokenized[where x in y 0]: y 1;}/:(key .z.m.axqc.charTokens),' value .z.m.axqc.charTokens;
 
    allAlpha : "abcdefghijklmnopqrstuvwxyz"; /dnl
    allAlpha,: upper allAlpha;
/     allAlpha,: "_";
/     allAlpha,: "._";
/     allAlpha,: "0123456789";
    numerics : "0123456789";
    
    alphaNumericTokens : allAlpha,' (count allAlpha)#alpha;
    alphaNumericTokens,: numerics,' (count numerics)#digits;
 
    .z.m.axqc.INPUT {.z.m.axqc.tokenized[where x in y 0]: y 1;}/: alphaNumericTokens;
    // _:, _::, .: and .:: are special cases, as they aren't compound tokens when they follow an alpha
    // as the _ or . becomes part of the variable name. As such, replace any _ or . following an alpha with an alpha
    .z.m.axqc.tokenized[where (.z.m.axqc.tokenized in `$/:"_.") & 0b,-1_.z.m.axqc.tokenized = alpha] : alpha;
    
    /* Let's examine the remaining characters which are 0..9a..zA..Z and reduce them to symbols within
    /* the .z.m.axqc.tokenized list.
    
    tokenize alpha;
    tokenize digits;
    tokenize unknown;
    
    /* HANDLE COMPOUND OPERATORS SUCH AS ++, &:, +=, etc. (depending on language)
    /*
    /* Take each defined compound token and find it within the input stream.
    /* Then take the returned list and assign the appropriate symbol.
    /* Note the special cases that follow for "*:", "*::", "?:" and "?::" due to
    /* idiosyncracies in q.
    
    compLens : group count each .z.m.axqc.CHARTS `COMPOUND;           /* group the compound tokens based on length
 
    /* First get the keys, which correspond to the compound token lengths
    
    i : asc key compLens;
    
    /* Then, for each length of compound token, iterate

    do [count compLens;
        /* take each defined compound token, starting with the shortest,
        /* and determine their locations
        
        clen: first i;
        
        compLocns: .z.m.axqc.INPUT ss/: .z.m.axqc.CHARTS [`COMPOUND] compLens clen;
        // To prevent a_:1 from being parsed as a _: 1 when it should be a_ : 1,
        // _ and . in this ambiguous situation are tokenized as alphas.
        // This line caches any alphas so that occurances of _ and . that get tokenized as
        // compound operators can be turned back to alphas
        alphas : where .z.m.axqc.tokenized = alpha;
        .z.m.axqc.tokenized [compLocns] : .z.m.axqc.CHARTS [`COMPNAMES] compLens clen;
        .z.m.axqc.tokenized [alphas] : alpha;
        
        /* assign unknown to all but the first element so we can
        /* eliminate them efficiently going forward.
        // The "except alphas" prevents the : or :: following a wrongly tokenized .:, .::, _: or _::
        // from being set to unknown when it should remain an assignment operator
        .z.m.axqc.tokenized[raze (raze[compLocns] except alphas) +/: 1 + til clen - 1] : unknown;
        
        /* get the rest of the list
        i : 1 _ i;
    ];
    
    /* Handle special cases. Not necessary for all languages,
    /* but some have exotic compound tokens so they need to
    /* be handled but without cluttering up the fast tokenizer.
    
    .z.m.axqc.specialCases [];
 
    /* Drop the `unknowns as they're in the spots where the remainder of a name is for example
    /* care would appear as
    /*   `care`alpha`alpha`alpha
    /* and create a paired list of where each token is found in the input stream
    /* Note that the line numbers are implicit based on the line of the input
    
    tokenList: .z.m.axqc.tokenized [where not .z.m.axqc.tokenized in (digits;alpha;unknown)] ,' where not .z.m.axqc.tokenized in (digits;alpha;unknown);
 
    /* And then take the token list and pull out the names, numbers and symbols
    /* as particular for the language being tokenized and ultimately parsed.
    
    : tokenList;
/     : .z.m.axqc.namesAndNums [tokenList];
    };
 
 
 
/* ## reconstitute
/*
/* Takes a list of symbols and reconstitutes it back into a string
 
.z.m.axqc.reconstitute: {[list]
    : string each list;
    };
 
 
/* ## printToken
/*
/* This returns a human readable token for the error handling routines. It may be acceptable as is.
/* Adjust the following routine to reflect your particular situation if necessary.
 
.z.m.axqc.printToken: {[token]
/     if [token in (key .z.m.axqc.tokenNames);
/         : string (.z.m.axqc.tokenNames [token]);
/     ];
/     : string token;
    : string .z.m.axqc.tokensPrnt token;
    };
 
.z.m.axqc.printCurrentToken: {
    : string .z.m.axqc.rawTokens .z.m.axqc.tokenPtr;
    };
 
/* ## getNextToken
/*
/* This is the main token routine. It's called by the Walker and (at times) by
/* action routines to fetch the next token. It is also called by syntaxError to
/* skip forward to an expected token.
 
.z.m.axqc.getNextToken: {
    /* Fetch the next token

    .z.m.axqc.tokenPtr   +: 1;
    .z.m.axqc.currentToken  : .z.m.axqc.tokenList .z.m.axqc.tokenPtr;
    : 0;
    };

/* ## jumpToToken
/*
/* Jumps to the specitied token. Used by actions to skip multiple tokens.

.z.m.axqc.jumpToToken: {[index]
    /* Fetch the next token

    .z.m.axqc.tokenPtr   : index;
    .z.m.axqc.currentToken  : .z.m.axqc.tokenList .z.m.axqc.tokenPtr;
    : 0;
    };
// @fileOverview These are the actions invoked by CHARTS

// Used when parsing double colons
.z.m.axqc.actionsInit:.z.m.axqc.lastToken   :  0;

// Used when commands are being parsed so that comments are not parsed
// Comments can't be on the same line as a command
.z.m.axqc.inCommand   :  0b;

// Used for passing the type of the previous token to CHARTS
.z.m.axqc.typeDict    :  `unparsedCommand`qCommand`colon`doubleColon`varSymNum`other;
.z.m.axqc.typeDict    !: 3 + til count .z.m.axqc.typeDict;

// Similar to sublist, but takes a start index and an end index. Gets the substring, inclusive.
// It only operates on the input to the parser
.z.m.axqc.substring   :  {[start; end]
    : (start-.z.m.axqc.OFFSET; 1 + end - start) sublist .z.m.axqc.INPUT;
    };

// Fetches consecutive tokens until they no longer are found within validTokens
.z.m.axqc.fetchWhile : {[validTokens]
    while [ .z.m.axqc.currentToken in validTokens;
        .z.m.axqc.getNextToken []
        ];
    };

// For Debugging
.z.m.axqc.display : {
    // @qlintsuppress DEBUG_FUNCTION(1)
    : show "-=-=-=-=-=-=-=-=-=-=-";
    };

// The min and max of a token or tree
.z.m.axqc.treeMin : {[tree]
    :   $ [ 4 ~ count tree;
        tree 2;
        tree [0; 1]
        ];
    };

.z.m.axqc.treeMax : {[tree]
    :   $ [ 4 ~ count tree;
        tree 3;
        tree [0; 2]
        ];
    };

// Is it a 4-tuple starting with a  symbol?
// This tells if the argument is a representation of a single token
.z.m.axqc.isValue : {[tree]
    : (-11h ~ type first tree) & 4 ~ count tree;
    };

// Is it a 3-tuple starting with a symbol?
// This tells if the argument is the description of a subtree
.z.m.axqc.isDesc : {[tree]
    : (-11h ~ type first tree) & 3 ~ count tree;
    };

// For using the stack
.z.m.axqc.push : {[tree]
    : .z.m.axqc.stack ,: enlist tree;
    };

.z.m.axqc.pop : {
    tree        : last .z.m.axqc.stack;
    .z.m.axqc.stack   : -1 _ .z.m.axqc.stack;
    : tree;
    };

.z.m.axqc.boundary: (-1; `lParen; `lBrace; `lBracket; `qCommand; `sql; `semi; `colon; `doubleColon);

// An action that stops execution. Useful for debugging
.z.m.axqc.break   : {
    ' `PAUSE;
    };

.z.m.axqc.skipWhitespace : {
    .z.m.axqc.fetchWhile .z.m.axqc.tokens `whitespace`newline;
    };

// From, By and ',' act differently in SQL statements, so these are needed to tell when
// the parser is working in an SQL statement
.z.m.axqc.QSQLStart : {
    .z.m.axqc.inQSQL: `true;
    };

.z.m.axqc.QSQLEnd : {
    .z.m.axqc.inQSQL: `false;
    };

.z.m.axqc.QSQLStateLoad : {
    .z.m.axqc.inQSQL      : last .z.m.axqc.inQSQLSaved;
    .z.m.axqc.inQSQLSaved :  -1 _ .z.m.axqc.inQSQLSaved;
    };

.z.m.axqc.QSQLStateSave : {
    .z.m.axqc.inQSQLSaved ,: .z.m.axqc.inQSQL;
    .z.m.axqc.inQSQL      : `false;
    };

// Needs to return an int, hence the conditional
.z.m.axqc.isInQSQL : {
    :   $ [ .z.m.axqc.inQSQL ~ `true;
        1;
        0
        ];
    };

.z.m.axqc.getQSQLState : {
    : ((`where`true`false) ! 2 1 0) .z.m.axqc.inQSQL;
    };

.z.m.axqc.getLastToken : {
    : .z.m.axqc.lastToken;
    };

.z.m.axqc.alternateWhereStart : {
    .z.m.axqc.inQSQL: `where;
    };

.z.m.axqc.alternateWhereEnd : {
    .z.m.axqc.inQSQL: `false;
    };

// This moves part of the stack to another stack to facilitate parsing QSQL
.z.m.axqc.moveToQSQLStack : {
    if[ not -1 ~ first last .z.m.axqc.stack;
        $[  .z.m.axqc.isValue last .z.m.axqc.stack;
            .z.m.axqc.QSQLStack ,: .z.m.axqc.pop [];
            .z.m.axqc.QSQLStack ,: enlist .z.m.axqc.pop []]];
    };

.z.m.axqc.makeString:{
    /start at the index after the quote
    i: .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr;
    
    /-1 to include the first quote
    start: i-1;
    
    /Loop through chars until the unescaped double quote or EOF
    /If an escape is found, skip the next token
    while [ (.z.m.axqc.INPUT[i] <> "\"") & i < count .z.m.axqc.INPUT;
        i+: $[.z.m.axqc.INPUT[i] = "\\"; 2;1]];
    
    /If the loop didn't find the closing quotes, throw an error
    if[ "\"" <> .z.m.axqc.INPUT i;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorUnmatchedQuote; .z.m.axqc.tokenPtr; ()]];
    
    /Find the token matching the current index and set it as the current token
    .z.m.axqc.tokenPtr: 1 + .z.m.axqc.tokenLoc?i;
    .z.m.axqc.currentToken: .z.m.axqc.tokenList .z.m.axqc.tokenPtr;
    
    .z.m.axqc.push (`string; .z.m.axqc.substring[start;i]; start; i);
    };

.z.m.axqc.makeDoubleColon:{
    /2+ colons are treated as ::
    /This breaks the usual q rule for handling multiple operators in a row
    /It is much simpler to throw an error here if something like ::: is found
    /as otherwise it would be mistaken by the parser for :: : or something similar
    if[ (.z.m.axqc.tokens ? .z.m.axqc.currentToken) in `colon`doubleColon;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorInvalidColon; .z.m.axqc.tokenPtr; ()]];
    .z.m.axqc.pushToken[];
    };

/Makes the 4-tuple for a token and pushes a token onto the stack        
.z.m.axqc.pushToken:{
    pointer: .z.m.axqc.tokenPtr-1;
    .z.m.axqc.push (.z.m.axqc.tokensPrnt .z.m.axqc.tokenList pointer;
        string .z.m.axqc.rawTokens pointer;
        .z.m.axqc.tokenLoc pointer;
        .z.m.axqc.tokenEnd pointer);
    };

.z.m.axqc.addToNumberList:{.z.m.axqc.addToX `NUMBER_LIST;};
.z.m.axqc.addToAdverbList:{.z.m.axqc.addToX `ADVERB_LIST;};
.z.m.axqc.addToSymbolList:{.z.m.axqc.addToX `SYMBOL_LIST;};

/This function either starts a list, or if the right argument is already a list, it just adds to it
/It takes a symbol as a parameter and uses it for the type of a subtree
.z.m.axqc.addToX:{[name]
    right: .z.m.axqc.pop[];
    left:  .z.m.axqc.pop[];
    
    /This checks if the right argument is a single item, or a list
    $[  .z.m.axqc.isValue right;
        
        /If it is just a single item, it creates a list
        .z.m.axqc.push ((name; .z.m.axqc.treeMin left; .z.m.axqc.treeMax right);(left;right));
        
        /If the right argument was a list, it adds the left argument to the list
        [   right[0;1]:     .z.m.axqc.treeMin left;
            right[1]:       enlist[left], right 1;
            .z.m.axqc.push right]];
    };

.z.m.axqc.newApply:{
    // Creates an Apply subtree from the first two items on the stack
    right   : .z.m.axqc.pop[];
    left    : .z.m.axqc.pop[];
    mini    : .z.m.axqc.treeMin left;
    maxi    : .z.m.axqc.treeMax right;
    
    // This gets tripped if there is an adverb that eats all the tokens that would be in the apply.
    // Since there is nothing to be applied to, both are pushed back on the stack
    $[  not .z.m.axqc.treeMin[right] in .z.m.axqc.markedApplies;
        [   .z.m.axqc.push left;
            .z.m.axqc.push right];
        .z.m.axqc.push ((`APPLY; mini; maxi);(left; right))];
    };

/This is called at the end of a line, triggered by a semi, unless that line is in a function/list/etc.
/It pops a completed line off the stack and creates a token for the semi after it
/It is adds both of these as a pair to the tree
/It is also called when the end of the file is found, incase the file didn't end in a semi
.z.m.axqc.addLine:{
    line: .z.m.axqc.pop[];
    
    /If the bottom of the stack was popped, put it back
    line:$[ line~(-1;" ";0;0);
        [.z.m.axqc.push line; ()];
        line];
    position: .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr-1;
    
    /make a semi token where applicable
    semi:$[ (`$";")~.z.m.axqc.rawTokens .z.m.axqc.tokenPtr-1;
        (`semi;enlist ";";     position; position);
        `noSemi];
    
    /If it is just a single token, give it a description
    if[ .z.m.axqc.isValue line;
        line: (`SINGLE_TOKEN, line 2 3;line)];
    
    .z.m.axqc.tree,: enlist(line;semi);
    };

/Called when the end of the file is reached
/removes a possible last line off the stack, checks for errors and writes the final output
.z.m.axqc.addEOF:{
    /There may still be one line left on the stack if the last line wasn't semi-terminated, or if there was an error
    /If there is something on the stack that comes after the end of the tree, add it to the tree.
    /If there is no tree yet, it isn't an error, so add it to the tree
    /Otherwise it is the result of invalid q and should be left so it throws an error
    if[ not enlist[(-1;" "; 0;0)]~.z.m.axqc.stack;
        $[  .z.m.axqc.tree~enlist (();());
            .z.m.axqc.addLine[];
            [   endOfCode: .z.m.axqc.treeMax $[   `semi ~ first last last .z.m.axqc.tree;
                    last last .z.m.axqc.tree;
                    first last .z.m.axqc.tree];
                if[ (.z.m.axqc.treeMin last .z.m.axqc.stack)>=endOfCode;
                    .z.m.axqc.addLine[]]]]];
    
    /If the bottom of the stack has not been reached, there is a syntax error. Throw an error message
    if[ not enlist[(-1;" "; 0;0)] ~ .z.m.axqc.stack;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorInvalidSyntax; .z.m.axqc.tokenPtr; (.z.m.axqc.treeMin last .z.m.axqc.stack; .z.m.axqc.treeMax last .z.m.axqc.stack)]];
    
    /The tree starts with a dummy value so other items are added correctly
    /remove this and edd the end of file token      
    .z.m.axqc.tree: 1_.z.m.axqc.tree;
    };

.z.m.axqc.makeList :{.z.m.axqc.makeGenericList[`lParen;`rParen;`PAREN];};

.z.m.axqc.makeSquareBrackets  :{.z.m.axqc.makeGenericList[`lBracket;`rBracket;`SQUAREBRACKETS];};

/generalized function for making lists
.z.m.axqc.makeGenericList:{[lDelimiter;rDelimiter;tag]
    terms : ();
    
    /pop everything in square brackets off the stack
    while[  (not lDelimiter ~ first last terms) & not -1 ~ first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    if[ -1 ~ first last terms;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorInvalidList; .z.m.axqc.tokenPtr; ()]];
    
    /find all the delimiters, and separate them from the expressions
    delimiters      : (first each terms[;0]) in (`commandEnd;`semi;lDelimiter;rDelimiter);
    nonDelimiters   : where not delimiters;
    delimiters      : where delimiters;
    
    /wherever two delimiters are touching, make an empty token for that spot
    delimiters : terms delimiters where 1 = deltas delimiters;
    expressions: terms[nonDelimiters] , (`empty;"") ,/: delimiters[;2 2];
    
    /combine the empty tokens and actual expressions
    expressions: expressions iasc .z.m.axqc.treeMin each expressions;
    .z.m.axqc.push ((tag;.z.m.axqc.treeMin last terms;.z.m.axqc.treeMax first terms);expressions);
    };

/Writes a list of keyed column definitions for a table
/Pops arguments off the stack until it reaches the start of the brackets
.z.m.axqc.makeKeys:{
    terms:();
    /pop everything in brackets off the stack
    while[  (not `lBracket ~ first last terms) & not -1 ~ first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    
    /if there is something other than the brackets
    /the -1_1_ removes the brackets
    if[ 2 <> count terms;
        .z.m.axqc.push ((`KEYS; .z.m.axqc.treeMin last terms; .z.m.axqc.treeMax first terms);reverse -1_1_terms where not (first each terms[;0]) in `semi`commandEnd)];
    };

.z.m.axqc.makeTable:{
    terms:();
    /pop everything in parentheses off the stack
    while[  (not `lParen ~ first last terms) & not -1 ~ first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    
    maxi: last first terms;
    mini: last last terms;
    
    /the 1-_1_ removes the brackets
    elements: reverse terms -1_1_where not ({first first x} each terms[;0]) in `KEYS`semi`commandEnd;
    keyIndex: terms count[terms]-2; /This is where the key columns are, if they exist
    
    /If there are keys, just take the expressions, otherwise, an empty list
    keyCols: $[ `KEYS ~ first first keyIndex;
                last keyIndex;
                ()];
    
    .z.m.axqc.push ((`TABLE;mini;maxi);(keyCols;elements));
    };

.z.m.axqc.makeDictionary:{
    terms:();
    /pop everything in parentheses off the stack
    while[  (not `lParen ~ first last terms) & not -1 ~ first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    
    maxi: last first terms;
    mini: last last terms;
    
    /Remove the "([" and "])"
    terms: reverse terms -2_2_where not ({first first x} each terms[;0]) in `semi`commandEnd;
    .z.m.axqc.push ((`DICTIONARY;mini;maxi); terms);
    };

.z.m.axqc.addToReturn:{
    /A return is a line in the form of :1+2, they can appear inside functions, lists, parameters, etc.
    /The colon always has to be at the start of the expression though
    right: .z.m.axqc.pop[];
    left : .z.m.axqc.pop[];
    
    /This is incase there is a return with nothing afterwards
    /It checks if the return has been put in right instead of left, meaning the expression ends after the colon
    /By seeing if it *hasn't* been put in the left. It must be in one of the two
    
    $[  not left[0]~`colon;
        [.z.m.axqc.push left; .z.m.axqc.push right];
        .z.m.axqc.push ((`RETURN;.z.m.axqc.treeMin left; .z.m.axqc.treeMax right);(left;right))];
    };

/once the brackets have been read for polish notation, call this
.z.m.axqc.finishPolishNotation:{
    terms:();
    while[  (not `lBracket ~ first last terms) & not -1 ~ first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    if[ -1 ~ first last terms;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorPolishNotationFunction; .z.m.axqc.tokenPtr; ()]];
    maxi: last first terms;
    
    /when two punctuations are touching, it means there is an empty clause
    /unless they are command end, and a closing bracket, so these are removed from empties
    isPunctuation   : ({[x] first first x} each terms) in `rBracket`lBracket`semi`commandEnd;
    notPunctuation  : not isPunctuation;
    empties                 : (`empty;""),/: terms[where 0 = deltas isPunctuation;2 2];
    values                  : empties, terms where notPunctuation;
    
    operator: .z.m.axqc.pop[];
    
    /Changes the descriptor based on the type of operator and number of arguments
    /Also checks to see if the statement is a $-if statement with an invalid number of clauses
    
    /* The following was changed from Ben's code since $[clause; expr; clause; expr] is valid q
    /* The original disallowed even numbers of clauses.
    
    // If there is more than one semi, $ is a dollar-if, otherwise $[a;b] is a cast
    name: $[(operator[1] ~ enlist "$") and (sum isPunctuation) > 3;     `DOLLAR_IF;
        operator[1] ~ "if";               `IF; /dnl
        operator[1] ~ "do";               `LOOP; /dnl /don't combine do and while via 'in', it will cause a type error
        operator[1] ~ "while";            `LOOP; /dnl
        operator[0] ~ `dyadicAssign;      `PN_DYD_ASSIGN;
        `PN];
    
    .z.m.axqc.push ((name;.z.m.axqc.treeMin operator;maxi);enlist[operator], values iasc .z.m.axqc.treeMin each values);
    };

.z.m.axqc.makePNAdverb:{
    right:  .z.m.axqc.pop[];
    left:   .z.m.axqc.pop[];
    .z.m.axqc.push ((`PN_DYDADV;.z.m.axqc.treeMin left;.z.m.axqc.treeMax right);enlist[left],right 1);
    };

.z.m.axqc.isBoundary:{[tree]
    :$[ -1 ~ first tree;
            1b;
        `symbol ~ .z.m.axq.typeOf first tree;
            any (first tree) ~/: .z.m.axqc.boundary;
        `symbol ~ .z.m.axq.typeOf first first tree;
            (first first tree) ~ `INTERNAL_PARAMS;
            0b];
    };

.z.m.axqc.addToAdverb:{
    // This makes the subtree for dyadic adverbs not in polish notation, such as 1+/:1 4 6
    right : .z.m.axqc.pop[];
    middle: .z.m.axqc.pop[];
    arg1  : ();
    arg2  : ();
    
    $[  (`dyadicAdverb~first right)|(`apostrophe~first right)| `ADVERB_LIST~first first right;
        [   left    : .z.m.axqc.pop[];
            adverb  : right;
            operator: middle;
            $[  isBoundary left;
                [   .z.m.axqc.push left;
                    mini: .z.m.axqc.treeMin middle];
                [   arg1: left;
                    mini: .z.m.axqc.treeMin left]]];
        [   operator: .z.m.axqc.pop[];
            arg1    : .z.m.axqc.pop[];
            arg2    : right;    /if there is an expression after the adverb
            adverb  : middle;
            mini    : .z.m.axqc.treeMin arg1]];
    
    maxi: .z.m.axqc.treeMax right;
    
    // If the dyadic adverb is only an operator, adverb and rigth hand side, with no left hand side, throw an error
    if[ .z.m.axqc.isBoundary arg1;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorIncompleteDydAdv; .z.m.axqc.tokenPtr; (mini; maxi)]];

    .z.m.axqc.push ((`DYADIC_ADVERB; mini; maxi); (arg1; operator; adverb; arg2));
    };

// These all are examples of expression types that can filter functions that I'm aware of
// `DICTIONARY         ([x:(:10+)]): ([x:1 2 3])
// `TABLE              ([y:(:2*)] x:(:10+)): ([y: 0 1 2] x:3 4 5)
// `DYADIC             x:(:10+): 1 2 3
// `SQUAREBRACKETS     [(:not)]: 001b
// `PAREN              (:not): 001b
// In other types of expressions, trying to use a filter function gives nyi (e.g. {($[1b;:not;:sum]): 001b}[])
// or they behave as returns {(:[x;:sum]): 001b}[]
.z.m.axqc.canContainFilterFns: `s#`DICTIONARY`DYADIC`PAREN`SQUAREBRACKETS`TABLE;

.z.m.axqc.addToDyadic:{
    right: .z.m.axqc.pop[];
    
    /This checks cases where the left value shouldn't be added to the right.
    /They put the right back and exit early
    if[ not .z.m.axqc.isValue right;
        operator: first first right 1;
        if[ 0h~ type operator;
            if[ 2~count last right;
                :.z.m.axqc.push right]]; /this happens in expresseions like 11++[12;13]+
        if[ not operator in `dyadic`apostrophe`dyadicAssign`colon`doubleColon`comma;  /if it is a dyd projection, e.g. 11 +
            if[ 2~count last right;
                :.z.m.axqc.push right]]];
    
    left: .z.m.axqc.pop[];
    
    /A return on the left hand of an assignment can be a FILTER_FN and needs to be rewritten as such.
    /There's no way to distinguish them at the time they're originally parsed.
    if [(first first last right) in `colon`doubleColon;
        if [(first first left) in canContainFilterFns;
            left: .z.m.axqc.rewriteReturn left]];
    
    /as the right is pretty close to the final expression, it is changed in place
    right[0;1]:     .z.m.axqc.treeMin left;
    .z.m.axqc.push (right 0; enlist[left],right 1);
    };

.z.m.axqc.rewriteReturn: {[tree]
    : $[.z.m.axqc.isExpression tree;
        $[  (first first tree) in canContainFilterFns;
                (first tree; .z.m.axqc.rewriteReturn last tree);
            (first first tree) ~ `RETURN;
                [   tree[0;0]: `FILTER_FN;
                    : tree];
            // Else
                tree];
        .z.m.axqc.isValue tree;
            tree;
        type[tree] = 0h;
            .z.m.axqc.rewriteReturn each tree;
        // Else
            tree]
    }
        

/takes the first two args from the stack and makes a function out of them using the type of the left token
.z.m.axqc.addArgFromStack:{
    right:  .z.m.axqc.pop[];
    left:   .z.m.axqc.pop[];
    name:   $[left[0]~`dyadicAssign; `DYD_ASSIGN; `DYADIC];
    
    /Commas don't act as dyadic operators in QSQL statements, so everything just gets pushed back
    if[ .z.m.axqc.inQSQL ~ `true;
        if[ ","~first left 1;
            .z.m.axqc.push left; :.z.m.axqc.push right]];
    
    .z.m.axqc.push ((name; .z.m.axqc.treeMin left; .z.m.axqc.treeMax right); (left; right));
    };

/These create a new values with a type other than the type given by the tokenizer
/It is used when pushing tokens which could act as multiple types of tokens
.z.m.axqc.createNewValueDyadic:               {.z.m.axqc.createNewValueX `dyadic};
.z.m.axqc.createNewValueMonadic:              {.z.m.axqc.createNewValueX `monadic};
.z.m.axqc.createNewValueDyadicAdverb: {.z.m.axqc.createNewValueX `dyadicAdverb};

/this gets called with a type which it overwrites the tokens current type with before pushing it
.z.m.axqc.createNewValueX:{[tokenType]
    pointer: .z.m.axqc.tokenPtr-1;
    .z.m.axqc.push( tokenType;
        string .z.m.axqc.rawTokens pointer;
        .z.m.axqc.tokenLoc pointer;
        .z.m.axqc.tokenEnd pointer);
    };

/By and from can be variables or keywords, so they are parsed separately
.z.m.axqc.makeByFrom:{
    pointer: .z.m.axqc.tokenPtr-1;
    /if they are part of an sql statement, the type is `from or `by instead of `name
    tokenType: $[ .z.m.axqc.inQSQL ~`true;
        .z.m.axqc.rawTokens pointer;
        `name];
    .z.m.axqc.push( tokenType;
        string .z.m.axqc.rawTokens pointer;
        .z.m.axqc.tokenLoc pointer;
        .z.m.axqc.tokenEnd pointer);
    };

/This is for making the list that starts a function
.z.m.axqc.makeInternalParams:{
    terms:();
    
    /pop everything in square brackets off the stack
    while[ not `lBracket ~ first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    
    /If there is nothing in the []s, add an empty token
    $[  2 = count terms;
        terms: enlist (`empty;""; terms[1;3]; terms[1;3]);
        terms: reverse -1_1_terms where (first each terms[;0]) <> `semi];
    
    /the first and last terms are the brackets, so they are removed along with all semis
    .z.m.axqc.push ((`INTERNAL_PARAMS; .z.m.axqc.treeMax terms; .z.m.axqc.treeMin terms); terms);
    };

/Pops arguments off the stack until it reaches the start of the function        
.z.m.axqc.makeFunction:{
    terms:();
    
    // Pop everything in braces off the stack
    while[  (not `lBrace ~ first last terms) & not -1 ~ first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    if[  -1 ~ first last terms;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorInvalidFunction; .z.m.axqc.tokenPtr; ()]];
    
    maxi: last first terms;
    mini: last last terms;
    
    
    // Find all the delimiters, and separate them from the expressions
    delimiters: 1b,((first each -1_1_terms[;0]) in `commandEnd`semi),1b;
    nonDelimiters: where not delimiters;
    delimiters: where delimiters;
    
    internalParams: terms count[terms]-2;
    internalParams: $[  `INTERNAL_PARAMS ~ first first internalParams;
                        last internalParams;
                        ()];
    
    /If there is nothing there, expressions are just an empty list
    /Otherwise, give them the actual expressions used.
    $[  delimiters ~ 0 1;
        expressions: ();
        [   // Wherever two delimiters are touching, make an empty token for that spot
            delimiters: terms delimiters where 1 = deltas delimiters;
            
            // Anywhere else except the internal parameters get made into a term
            terms: terms nonDelimiters except where ({first first x} each terms[;0]) = `INTERNAL_PARAMS;
            
            //Join the empty and non-empty terms
            expressions: terms , (`empty;"") ,/: delimiters[;2 2];
            
            // Sort all the expressions by position
            expressions: expressions iasc .z.m.axqc.treeMin each expressions]];
    
    .z.m.axqc.push ((`FUNCTION; mini; maxi); (internalParams; expressions));
    };

/Runs at the end of reading an SQL expression, it parses it all off the stack in one go
.z.m.axqc.makeSQL:{
    selectClause:byClause:whereClause:();
    /strip out all sql information from the stack
    /go backwards until you hit the start of the sql
    /the enlist () is necessary for terms to be added to the stack properly
    /the -1_ removes it once everything is added
    terms: enlist ();
    /Loop until the sql keyword is found or the bottom of the stack is popped
    while[ (not `sql ~ first last terms) & not -1 ~ first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    
    /If there is an extra comma in the first part, the bottom of the stack will be popped
    /It isn't caught by the parser because comma separated expressions are written to their own stack
    if[ -1 ~ first last terms;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorQSQLSyntax; .z.m.axqc.tokenPtr; ()]];
    
    terms: -1_reverse terms;
    names: terms[;0];
    
    // These must be present
    selectKeyword   : terms 0;
    fromIndex       : names?`from;
    // The index of the first char of the from keyword
    fromMin         : terms[fromIndex;2];
    // The table the operation is applied to
    fromClause      : terms fromIndex+1;
    
    // If optional clauses are present, find their locations
    
    // The "take" clause, eg. the [10] in select[10] from t 
    takeClause      : $[`SQUAREBRACKETS ~ first first terms 1; terms 1; ()];
    // The "distinct" clause, eg. select distinct a, b from t
    // The distinct applies to the whole result, not just column "a"
    distinctClause  : $[(names ? `distinct) < count names; terms names ? `distinct; () ];
    
    /The first finds expressions immediately following the first keyword (select, exec, delete, update)
    /The second finds expressions following 'by', if it is there
    byIndex         : names?`by;
    byMin: ();
    $[      byIndex = count names;
        [   byIndex: 0N;
            byClause:()];
        [   $[  `from ~ names byIndex + 1;
                [   byMin: terms[byIndex;3]+1;
                    byClause: enlist (`empty; ""; byMin; byMin)
                    ];
                [   byMin: terms[byIndex;2];
                    byClause: enlist terms byIndex+1
                    ]
                ]
            ]
        ];
    
    // The select clause is normally in position 1, but if there are other clauses, it gets pushed ahead
    selectClausePosition: 1 + (not takeClause ~ ()) + not distinctClause ~ ();
    
    // There is a select clause if the select clause position is not occupied by the 'by' or 'from' keywords
    selectClause: $[(not `by ~ names selectClausePosition) and fromIndex > selectClausePosition;
                    enlist terms selectClausePosition;
                    ()];
    
    /QSQL statements need the middle parsed as though it is the end if there is a comma
    /QSQLStack holds the ends that are temporarily removed
    /for nested selects, knowing the minimums and the locations of the keywords allows everything to
    /be put back into the right select statement
    minimums:       .z.m.axqc.treeMin each .z.m.axqc.QSQLStack;
    
    /these are the lists of indicies that are used, and must be removed from the stack
    i1: i2: i3: ();
    
    /When there are nested QSQL statements, or expressions within QSQL statements enclosed in some type of brackets
    /expressions get pushed onto the .z.m.axqc.QSQLStack. This at the indicies of what is on the stack to find which items are
    /relevant to the expression currently being parsed. The deepest statements are always parsed first.
    whereClause,:   .z.m.axqc.QSQLStack i1: reverse  where minimums > fromMin;
    $[      byIndex <> 0N;
        [   byClause        ,:.z.m.axqc.QSQLStack i2: reverse where (minimums < fromMin)& minimums > byMin;
            selectClause,:.z.m.axqc.QSQLStack i3: reverse where (minimums < byMin)  & minimums > selectKeyword 2];
        selectClause,:.z.m.axqc.QSQLStack i3: reverse where (minimums < fromMin)& minimums > selectKeyword 2];
    
    /Remove any subtrees used by the statement currently being parsed               
    .z.m.axqc.QSQLStack: .z.m.axqc.QSQLStack where not (til count .z.m.axqc.QSQLStack) in i1,i2,i3;
    
    /If there is a where clause, it will have a higher maximum index
    maxi: $[whereClause ~ (); .z.m.axqc.treeMax fromClause; .z.m.axqc.treeMax last whereClause];
    
    /builds and outputs the tree
    .z.m.axqc.push ((`QSQL; selectKeyword 2; maxi);
        (selectKeyword; selectClause; byClause; fromClause; whereClause; takeClause; distinctClause));
    };

.z.m.axqc.commentTilEnd:{
    /When there is a close multiline comment without an open multiline comment before it
    /The rest of the file is commented out. This skips the token pointer to the end
    /And writes a substring of the input to the comment list
    start           :  .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr-1;
    end             :  count[.z.m.axqc.INPUT]-1;
    .z.m.axqc.tokenPtr    : count[.z.m.axqc.tokenList]-1;
    .z.m.axqc.currentToken: last .z.m.axqc.tokenList;
    
    /Remove the newline at the start if it's there
    if[ "\n" ~ .z.m.axqc.INPUT start;
        start+:1];
    .z.m.axqc.comments   ,: enlist (`tilEnd; start; end; start _ .z.m.axqc.INPUT);
    };

.z.m.axqc.finishMultiline:{
    /Parses block comments writing them to the comment list. Loops until the multiline end token or the end of the file
    /Start and end are the starting and ending indicies in the input string
    /This is the first index of the token that starts the comment, i.e. `multilineStart
    start:  .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr-1;
    
    /\n/\n\\\n is a special case. It can't be detected with the \n/\n and \n\\\n tokens, as there is only one \n in the middle
    /This parses just that case
    if[ (.z.m.axqc.rawTokens .z.m.axqc.tokenPtr-1) in `$("/\n\\\n";"\n/\n\\\n");
        end: .z.m.axqc.tokenEnd .z.m.axqc.tokenPtr-1;
        /If it hits the end of file, it needs to back up two to have the right ending index
        if[ `EOF ~ .z.m.axqc.tokens? .z.m.axqc.tokenList .z.m.axqc.tokenPtr;
            end-:1];
        /If there is a newline at the start, get rid of it
        if[ "\n" ~ .z.m.axqc.INPUT start;
            start+:1];
        /The -1 gets rid of the ending newline
        :.z.m.axqc.comments,: enlist (`multiline; start; end-1; "/\n\\")];
    
    /Loop until the `multilineEnd token, or the end of the file
    /The -2 is so that the loop doesn't go past the end of the file
    while[  (`multilineEnd <> .z.m.axqc.tokens ? .z.m.axqc.currentToken) & .z.m.axqc.tokenPtr<count[.z.m.axqc.tokenList]-2;
        .z.m.axqc.getNextToken[]];
    
    /The end index of the multiline end, if it is present
    end: .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr;
    
    /If the end of file has been reached, then the end index needs to be backed up
    /If it isn't, eat the `multilineEnd token to end the comment
    $[ `EOF ~ .z.m.axqc.tokens? .z.m.axqc.currentToken;
        end-:3;
        .z.m.axqc.getNextToken[]];
    
    /If it is at the end of the file and didn't find the multilineEnd, set the token type to multilineNoEnd, otherwise `multiline
    tokenType:      $[      `multilineEnd ~ .z.m.axqc.tokens ? .z.m.axqc.tokenList .z.m.axqc.tokenPtr-1;
        `multiline;
        `multilineNoEnd];
    
    if[ `EOF ~ .z.m.axqc.tokens ? .z.m.axqc.currentToken;
        end-:1];
    
    if[ tokenType~`multiline;
        end+:2];
    
    /just a hack until I find out why this needs to be here
    if[ (tokenType ~`multilineNoEnd) & count[.z.m.axqc.INPUT]=1;
        end+:1];
    
    if[ "\n" ~ .z.m.axqc.INPUT end-.z.m.axqc.OFFSET;               end-:1];
    if[ "\n" ~ .z.m.axqc.INPUT start-.z.m.axqc.OFFSET;             start+:1];
    /This makes the output tuple for the comment and pushes it to the global list that holds all the comments       
    .z.m.axqc.comments,: enlist (tokenType; start; end; .z.m.axqc.substring[start;end]);
    };

.z.m.axqc.makeSingleLineComment: {
    /Parses the comment that comes at the end of the line
    /This block finds the start and end of the comment and moves the pointer accordingly
    /This is pointing to the token after the slash
    savedPtr: .z.m.axqc.tokenPtr;
    start:  .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr-1;
    while [ not .z.m.axqc.currentToken in .z.m.axqc.startWithNewline;
        .z.m.axqc.getNextToken[]];
    
    /The index of the newline
    end:    .z.m.axqc.tokenEnd .z.m.axqc.tokenPtr-1;
    
    /The tokenType is slash when the start of the file is a slash, so it wasn't tokeinzed with the \n/ token
    tokenType: .z.m.axqc.tokens?.z.m.axqc.tokenList savedPtr-1;
    
    /If tokenType is `comment, that is a single line comment, `inlineComment or something else
    /(which happens in the event that a semi preceedes the slash, which stops the slash from being tokenized as a comment)
    /both mean it's an inline comment
    $[      tokenType~`comment;
        tokenType:`singleLine;
        tokenType:`inline];
    
    if[     "\n" ~ .z.m.axqc.INPUT start;
        start+:1];
    
    /This writes the token type, start and end positions and text to its final location, .z.m.axqc.comments
    /Unless it is on the same line as a command
    $[  .z.m.axqc.inCommand;
        .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorCommentAfterCommand; .z.m.axqc.tokenPtr - 1; ()];
        .z.m.axqc.comments,: enlist (tokenType; start; end; .z.m.axqc.substring[start;end])];
    };

.z.m.axqc.makeUnparsedCommand:{
    /This function parses a command sent to the OS
    /This block finds the start and end of the command and moves the pointer accordingly
    start:  .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr-1;
    .z.m.axqc.jumpToToken count[.z.m.axqc.tokenList]-2; // point at the newline
    end:    .z.m.axqc.tokenEnd .z.m.axqc.tokenPtr-1;
    
    /Take the command off the stack
    command: .z.m.axqc.pop[];
    
    /Set the command token's text and end index to include everything on that line
    /then push the completed expression onto the stack      
    command[1]: .z.m.axqc.substring[start;end];
    command[3]: end;
    
    /If the command starts in a newline, remove it from the text & start index
    if[ "\n"~command[1;0];
        command[1]: 1_command 1;
        command[2]+:1];
    
    .z.m.axqc.push (`UNPARSED_COMMAND,command 2 3; command);
    
    /Put the `commandEnd token in all the streams
    .z.m.axqc.addCommandEnd[];
    };

/Pops arguments off the stack until it reaches the start of the command
/Removes anything that isn't an expression
.z.m.axqc.makeQCommand:{
    /This is the list that will hold the expression.
    /It needs to be enlist () so terms added to it will stay enlisted
    terms: enlist ();
    
    /pop everything in the command off the stack
    while[  not any `UNPARSED_COMMAND`qCommand ~\: first first last terms;
        terms,: enlist .z.m.axqc.pop[]];
    if[ `UNPARSED_COMMAND ~ first first last terms;
        : .z.m.axqc.push last terms];
    
    /this removes any punctuation, which shouldn't be in the parse tree, from the list of expressions
    /the 1_ removes the enlist (); put in at the start of 'terms'
    terms: terms 1+where not (first each 1_terms[;0]) in `semi`commandEnd;
    
    /The command either ends in a newline or a space
    /Remove this whitespace from the text
    text: (last terms) 1;                /get the text of the command
    endsWithNewline:"\n"=last text;
    text: $[ "\002ws" ~ -3#text;  /dnl   /if the text ends in a space
        -3 _ text;                       /drop the space (3 because \002ws is 3 characters)
        -1 _ text];                      /else drop the newline
    
    /The command may start with a newline which also needs to be removed
    /This removes it from the text and increases the start index to exclude it
    if[     "\n" ~ first text;
        text: 1_text;
        terms[count[terms]-1;2]+:1];
    
    /Put the modified text back in and decrease the ending index by one to account for the whitespace being removed
    terms[count[terms]-1;1]:text;
    terms[count[terms]-1;3]-:1+endsWithNewline;
    
    /the last term is the qcommand, so .z.m.axqc.treeMin isn't needed, as the position of the min value is already known
    .z.m.axqc.push (`QCOMMAND, (last terms)[2],.z.m.axqc.treeMax first terms;reverse terms);
    
    };

.z.m.axqc.addCommandEnd:{
    :(::); // since runParser is now called after splitting the input with .Q.ld, commands can't end in the middle of the input
    /This is true until commandEnd is found. It prevents comments from being written
    .z.m.axqc.inCommand: 1b;
    
    /Unless the command token ends in a newline, look for the next newline and insert a command there
    ptr: .z.m.axqc.tokenPtr;
    if[ "\n" <> last string .z.m.axqc.rawTokens .z.m.axqc.tokenPtr-1;
        while[  not .z.m.axqc.tokenList[ptr] in .z.m.axqc.startWithNewline;
            ptr+:1]];
    
    /This puts the token in the streams at the specified positions
    .z.m.axqc.insertCommandEnd ptr;
    /As the current token could have changed to `commandEnd, it must be updated
    .z.m.axqc.currentToken: .z.m.axqc.tokenList .z.m.axqc.tokenPtr;
    };

.z.m.axqc.insertCommandEnd:{[nextNewline]
    /This inserts a commandEnd token in all the streams immediately before the next newline
    insertIndex: nextNewline - count .z.m.axqc.rawTokens;
    .z.m.axqc.rawTokens: (insertIndex _ .z.m.axqc.rawTokens),`commandEnd                 , nextNewline _ .z.m.axqc.rawTokens;
    .z.m.axqc.tokenList: (insertIndex _ .z.m.axqc.tokenList),.z.m.axqc.tokens[`commandEnd]   , nextNewline _ .z.m.axqc.tokenList;
    .z.m.axqc.tokenLoc : (insertIndex _ .z.m.axqc.tokenLoc) ,.z.m.axqc.tokenLoc[nextNewline] , nextNewline _ .z.m.axqc.tokenLoc;
    .z.m.axqc.tokenEnd : (insertIndex _ .z.m.axqc.tokenEnd) ,.z.m.axqc.tokenEnd[nextNewline] , nextNewline _ .z.m.axqc.tokenEnd;
    };

/It's tricky to throw a parse error from CHARTS for this, as any of these can follow another if there is a space
/But whitespace is mostly ignored, so the error is done explicitly via an action.
/This catches things like 23453ff which gets tokenized as `23453f`f
/It outputs the text of both tokens involved in the error and the index of the first character of the first token
.z.m.axqc.varNumError:{[]
    .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorMalformedValue; .z.m.axqc.tokenPtr - 1; ()];
    };

/This is called when a variable or number is found. It looks behind that token and see what the previous one was.
/If it was a name, symbol or a number, then that indicates a malformed term
/-2 is because -1 is the one just consumed, and we want to go before that.
.z.m.axqc.isVarNumSafe:{[]
    : `int$not (.z.m.axqc.tokens? .z.m.axqc.tokenList .z.m.axqc.tokenPtr-2) in `name`symbol`number;
    };

.z.m.axqc.endInCommand:{[]
    .z.m.axqc.inCommand: 0b;
    };

.z.m.axqc.signalError:{[]
    .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorSignalAfterReturn; .z.m.axqc.tokenPtr; ()];
    };

.z.m.axqc.consecutiveCommaError:{[]
    .z.m.axqc.noteError[.z.m.axlocalize.t `.axqc_errorQSQLConsecutiveCommas; .z.m.axqc.tokenPtr; ()];
    };

// markApply needs to be used anywhere newApply will be used to mark which token the apply can affect
// this is because the charts can't capture all the grammar relating to an expression like "a b c/: d"
// It will put an apply in for a b and b c, but since b c gets eaten, there are now two newApplies queued up
// but only one actual apply to eat. The extra apply will end up somewhere strange unless markApply specifies
// which tokens newApply can eat.
.z.m.axqc.markApply:{[]
    // Since qCommand tokens at this point have a \n that is not part of the final token,
    // an extra +1 must be added to move the apply position being marked into the correct location
    .z.m.axqc.markedApplies ,:
        $[  `qCommand ~ .z.m.axqc.tokensPrnt .z.m.axqc.tokenList .z.m.axqc.tokenPtr - 1;
            1 + .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr - 1;
            .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr - 1];
    };

.z.m.axqc.makeDSL:{
    /This function parses a DSL in the form x) where x is a small or capital letter
    /This block finds the start and end of the command and moves the pointer accordingly
    start:  .z.m.axqc.tokenLoc .z.m.axqc.tokenPtr-1;
    /A newline paired with a character in the first column will immediately end a DSL expression
    endsDSL: .z.m.axqc.startWithNewline except .z.m.axqc.tokens`newline;
    
    /Otherwise, a DSL expression ends when the current token is a newline, and the next character is anything other than whitespace or a newline
    while [not (currentToken in endsDSL) or ((tokenList[tokenPtr] ~ .z.m.axqc.tokens`newline) and not tokenList[tokenPtr+1] in tokens`newline`whitespace);
        .z.m.axqc.getNextToken[]];
    end: .z.m.axqc.tokenEnd .z.m.axqc.tokenPtr-1;
    /Take the command off the stack
    command: .z.m.axqc.pop[];

    /Set the command token's text and end index to include everything on that line
    /then push the completed expression onto the stack
    command[1]: .z.m.axqc.substring[start;end];
    command[3]: end;

    /If the command starts in a newline, remove it from the text & start index
    if[ "\n"~command[1;0];
        command[1]: 1_command 1;
        command[2]+:1];

    .z.m.axqc.push (`DSL,command 2 3; command);

    /Put the `commandEnd token in all the streams
    .z.m.axqc.addCommandEnd[];
    };


/* #Action Strings
/* Note that each entry is a lambda. Also note that q tables start at index 0, therefore we MUST
/* have an action routine for action 0 or have a null action, such as the noSuch action.
/* Note, for your own charts this must be changed to reflect the actions you define
/* in your own charts. This list can also be used for tracing (see .z.m.axqc.action below)
/* You have to number your actions in your charts code and those should be
/* numerically aligned below. If there are gaps (i.e., you had no action #9) then those
/* gaps should be referenced to .z.m.axqc.noSuch.

.z.m.axqc.actionString: (
    ".z.m.axqc.getLastToken";                                     / dnl action 0
    ".z.m.axqc.display";                                          / dnl action 1
    ".z.m.axqc.makeString";                                       / dnl action 2
    ".z.m.axqc.makeDoubleColon";                                  / dnl action 3
    ".z.m.axqc.pushToken";                                        / dnl action 4
    ".z.m.axqc.break";                                            / dnl action 5
    ".z.m.axqc.addToNumberList";                                  / dnl action 6
    ".z.m.axqc.addToSymbolList";                                  / dnl action 7
    ".z.m.axqc.newApply";                                         / dnl action 8
    ".z.m.axqc.addLine";                                          / dnl action 9
    ".z.m.axqc.addEOF";                                           / dnl action 10
    ".z.m.axqc.QSQLStateSave";                                    / dnl action 11
    ".z.m.axqc.QSQLStateLoad";                                    / dnl action 12
    ".z.m.axqc.makeList";                                         / dnl action 13
    ".z.m.axqc.makeTable";                                        / dnl action 14
    ".z.m.axqc.makeKeys";                                         / dnl action 15
    ".z.m.axqc.skipWhitespace";                                   / dnl action 16
    ".z.m.axqc.makeSingleLineComment";                            / dnl action 17
    ".z.m.axqc.addToReturn";                                      / dnl action 18
    ".z.m.axqc.finishPolishNotation";                             / dnl action 19
    ".z.m.axqc.makeSquareBrackets";                               / dnl action 20
    ".z.m.axqc.createNewValueDyadicAdverb";                       / dnl action 21
    ".z.m.axqc.addArgFromStack";                                  / dnl action 22
    ".z.m.axqc.addToDyadic";                                      / dnl action 23
    ".z.m.axqc.addToAdverbList";                                  / dnl action 24
    ".z.m.axqc.makePNAdverb";                                     / dnl action 25
    ".z.m.axqc.addToAdverb";                                      / dnl action 26
    ".z.m.axqc.moveToQSQLStack";                                  / dnl action 27
    ".z.m.axqc.isInQSQL";                                         / dnl action 28
    ".z.m.axqc.makeByFrom";                                       / dnl action 29
    ".z.m.axqc.QSQLStart";                                        / dnl action 30
    ".z.m.axqc.getQSQLState";                                     / dnl action 31
    ".z.m.axqc.createNewValueMonadic";                            / dnl action 32
    ".z.m.axqc.createNewValueDyadic";                             / dnl action 33
    ".z.m.axqc.makeFunction";                                     / dnl action 34
    ".z.m.axqc.makeInternalParams";                               / dnl action 35
    ".z.m.axqc.alternateWhereStart";                              / dnl action 36
    ".z.m.axqc.alternateWhereEnd";                                / dnl action 37
    ".z.m.axqc.makeSQL";                                          / dnl action 38
    ".z.m.axqc.makeUnparsedCommand";                              / dnl action 39
    ".z.m.axqc.commentTilEnd";                                    / dnl action 40
    ".z.m.axqc.finishMultiline";                                  / dnl action 41
    ".z.m.axqc.makeQCommand";                                     / dnl action 42
    ".z.m.axqc.addCommandEnd";                                    / dnl action 43
    ".z.m.axqc.varNumError";                                      / dnl action 44
    ".z.m.axqc.isVarNumSafe";                                     / dnl action 45
    ".z.m.axqc.endInCommand";                                     / dnl action 46
    ".z.m.axqc.signalError";                                      / dnl action 47
    ".z.m.axqc.consecutiveCommaError";                            / dnl action 48
    ".z.m.axqc.markApply";                                        / dnl action 49
    ".z.m.axqc.makeDictionary";                                   / dnl action 50
    ".z.m.axqc.makeDSL"                                           / dnl action 51
    );

.z.m.axqc.actions: value each .z.m.axqc.actionString;

/* # Action routine proper
/* This calls the associated action based on the actionNo as passed by the walker.
/* Note to trace the action calls one simply needs to set .z.m.axqc.debug to `true
/* and you can see what action is being called below.
.z.m.axqc.action: {[actionNo;actionParms]
    if [.z.m.axqc.debug ~ `true;
        // @qlintsuppress DEBUG_FUNCTION(1)
        -1"[tracing actions]: ", string[actionNo]," - ",.z.m.axqc.actionString actionNo]; /dnl
    
    .z.m.axqc.actionParameter : actionParms;
    : .z.m.axqc.actions [actionNo][];
    };
// @fileOverview Loads required global state
// @returns {null}
.z.m.axqc.onLoad:{[]
    // Load the token description map after the translations have been created
    .z.m.axqc.createTokenDescriptionMap[];
    .z.m.axqc.initChartCode[];
    .z.m.axqc.initFastTokenizerHD[];
    }

.z.m.axqc.onLoad[];
system "d .z.m";

system "d .z.m.qd";
// @fileOverview Filter artifacts based on the exclude parameter in the settings dictionary. 
// can use either like expression or regex expression to exclude artifacts
// settings: data.SETTINGS;
// artifacts: i.getArtifacts[];
// settings[`exclude]: "*.i.*";
// settings[`exclude]: (`regex; ".*\\.md\\..*");
// settings[`exclude]: (`like; "*.i.*");
// @private
.z.m.qd.lib.artifacts.filter:{[settings; artifacts]
    
    // Filter out the artifacts that are not needed
    artifacts: select from artifacts where (kind in `function`data) or .z.m.qd.reg.filename_test ref;
    
    // If just x is given (not a dictionary), assume a default (like)
    : $[.z.m.axq.isEmpty settings`exclude;
            artifacts;
        10h ~ type settings`exclude;
            select from artifacts where not ref like settings`exclude;
        `like ~ first settings`exclude;
            select from artifacts where not ref like settings[`exclude][1];
        `regex ~ first settings`exclude;
            select from artifacts where not .z.m.pcre2.test[settings[`exclude][1]; ref ;::];
            '"exclude: invalid option, expecting like or regex"
        ]  
    }

// @fileOverview Returns artifacts without content
// @param artifacts {#pre_artifacts} 
// @returns {#catT}
.z.m.qd.lib.artifacts.wc:{[artifacts]
    : except[cols data.ARTIFACTS; `content] # artifacts
    }

// @fileOverview Builds artifacts (artifacts for preprocessing) schema from items
// Maps the original name column to ref
// Adds new name column that represent the relative name. Which is extracted from the
// module (if present) or the last part of ref. 
// Adds module, category, and subcategory column to the items table if they are not present
// @param items {#src} 
// @returns {#artifacts}
// Example: Arguments
// items: select name:ref, kind, content from .axqdtools.lib.artifacts.get[] where module = `.qd;
// items: ([] name: `.z.m.qd.q`foo.q; kind: `file`file; content: 2#enlist "")
.z.m.qd.lib.build.artifacts:{[items]
    
    
    if[(.z.m.axq.isEmpty items) or .z.m.axq.isNull items; : `ref xasc 0#data.ARTIFACTS];
    
    if[items ~ data.ITEMS; : `ref xasc data.ARTIFACTS];
    
    if[all cols[data.ARTIFACTS] in cols items;
        items: cols[data.ARTIFACTS]#items;
        
        if[meta[items] ~ meta data.ARTIFACTS; 
            : `ref xasc items]
        ];
    
    // TODO: Only doing this for 4.3.0 since all the internal API expects a ref column
    // Update the internal API to work with name and module column only
    // Map name to ref that refers to fully qualified name
    // Convert to linux style file names since the internal API expects that
    items: update name: .z.m.qd.lib.unhsym .z.m.qd.lib.lPath each name from items;
    
    // Get module and relative names if they doesn't exist
    items: lib.i.calc.name lib.i.calc.module items;
    
    catT: ([] ref: items`ref),' lib.module.toCat items`module;

    // Use a left join to ensure category, subcategory columns from the items prevail if they exist
    : `ref xasc cols[data.ARTIFACTS] xcols 
        catT lj `ref xkey items
    }
// @fileOverview Builds the input data structure for the preprocessors
// @param settings      {#settings} 
// @param artifacts     {#pre_artifacts}
// @returns {#pre.in}
// settings: data.SETTINGS;
// artifacts: .z.m.qd.i.getArtifacts[];
.z.m.qd.lib.build.input:{[settings; artifacts]
    
    // Extract the default information (category/subcategory) from onLoad function body
    artifacts: lib.defaults.apply[artifacts]
        settings[`defaults]: lib.defaults.extract[settings]
            exec content from artifacts where kind = `function, (name like "onLoad") or name like "*.onLoad";
    
    files       : `ref xasc select from artifacts where kind = `file, ref like "*.q";
    functions   : `ref xasc select from artifacts where kind in `function`data;
    readmes     : `ref xasc select from artifacts where kind in `file`readme, lower[name] in `readme`readme.md;
    onLoads     : `ref xasc select from artifacts where kind = `function, (name like "onLoad") or name like "*.onLoad";     // Need like because name = ref for global functions
    tdefs       : `ref xasc typedefs.get[settings] onLoads; // @qlintsuppress MISSING_DEPENDENCY(0)

    : pre.in.new (files; functions; readmes; onLoads; tdefs; settings);
    }

.z.m.qd.lib.cat.toModule:{[catT]
    
    : $[(type catT) ~ 98h; lib.i.cat.toModule each catT;
        (type catT) ~ 99h; lib.i.cat.toModule catT;
        '"catT: invalid type, expecting table or dict"
        ];
    }

// @fileOverview Provides the absolute path for a file in directory structure.
// TopLevelModule/SubModule/.function
// @param catT {#.z.m.qd.catT | #.z.m.qd.catD}
// @returns {string[] | string} Returns a list of paths or a path depending on if a table or a dictionary was provided

// @example Inputs
// catT :`ref`name`category`subcategory!(`.foo.bar.bat.baz; `baz; `foo;`bar.bat);
// catT :`ref`name`category`subcategory!(`.foo.bar.baz; `baz; `foo;`bar);
// catT :`ref`name`category`subcategory!(`.foo.baz; `baz; `foo;`);
// catT :`ref`name`category`subcategory!(`baz; `baz; `;`);
// catT :`ref`name`category`subcategory!(`.foo.baz; `baz; `cat;`);
// catT :`ref`name`category`subcategory!(`.foo.baz; `baz; `cat;`subcat);
// catT :`ref`name`category`subcategory!(`baz; `baz; lib.GLOBAL_CAT;`);
// catT :`ref`name`kind`category`subcategory!(`$".foo.bar/README"; `REAMDE; `file ;`foo;`);
// lib.cat.toPath cat
.z.m.qd.lib.cat.toPath:{[catT]
    
    : $[(type catT) ~ 98h; lib.i.cat.toPath each catT;
        (type catT) ~ 99h; lib.i.cat.toPath catT;
        '"catT: invalid type, expecting table or dict"
        ];
    }
// @fileOverview Extract delfault-category/subcategory information to the artifacts
// @param artifacts {#artifacts} 
// @param defaults {dict (category: table; subcategory: table)} 
// @returns {#artifacts}
.z.m.qd.lib.defaults.apply:{[artifacts; defaults]
    
    // Prevent blowing up if someone passes empty defaults dictioanry
    if[99h <> type defaults; : artifacts];
    if[not all 99h = type each defaults`category`subcategory; : artifacts];
    
    : (lib.defaults.i.subcategory/)[; 0!defaults`subcategory]
        (lib.defaults.i.category/)[; 0!defaults`category]
            artifacts
    }

// @fileOverview Extract delfault-category/subcategory information from the onLoad function body
// @param settings {#settings} 
// @param contents {string[]} 
// @returns {dict (category: table; subcategory: table)}
.z.m.qd.lib.defaults.extract:{[settings; contents]
    
    defaults: $[`defaults in key settings; settings`defaults; data.DEFAULTS];
    
    tagBlocks: raze .z.m.qd.lib.genTagBlocks[settings; contents] 1;
    defaultBlocks: select from tagBlocks where tagType like "@default-*";
    
    if[0 = count defaultBlocks; : defaults];
    
    tags: string distinct defaultBlocks`tagType;
    
    defaultTagVal: {[x;y] flip `$trim (0,/: a?\:" ") _' a:trim first each exec lines from x where tagType like y}[defaultBlocks];
    
    categories: select first category by namespace from
        flip `namespace`category! 
            $["@default-category" in tags; defaultTagVal "@default-category"; (`$(); `$())];
    
    subcategories: select first subcategory by namespace from
        flip `namespace`subcategory! 
            $["@default-subcategory" in tags; defaultTagVal "@default-subcategory"; (`$(); `$())];
    
    : `s#`namespace xasc/: defaults upsert' (categories; subcategories)
    }

.z.m.qd.lib.defaults.i.category:{[x;y] 
    $[`global ~ y`namespace;
        update category: y`category from x where module = `;
        update category: y`category from x where (module = y`namespace) or module like (string[y`namespace], ".*")
        ]
    }
.z.m.qd.lib.defaults.i.subcategory:{[x;y] 
    $[`global ~ y`namespace;
        update subcategory: y`subcategory from x where module = `;
        update subcategory: y`subcategory from x where (module = y`namespace) or module like (string[y`namespace], ".*")
        ]
    }

// @fileOverview Drops empty artifacts from a table of artifacts
// @param artifacts {#pre_artifacts} 
// @returns {#pre_artifacts}
// artifacts: lib.PRE_ARTIFACTS
.z.m.qd.lib.drop.empty.artifacts:{[artifacts]
    : artifacts where not (first data.ARTIFACTS) ~/: artifacts
    }

// @fileOverview Drops empty artifacts from a table of markdown artifacts
// @param md        {#markdown} 
// @returns         {#markdown}
// md: lib.PRE_MARKDOWN
.z.m.qd.lib.drop.empty.md:{[md]
    : md where not (first data.ARTIFACTS) ~/: md
    }

// @fileOverview Finds argument names and qdoc info for function and returns them in a array

// @param contents {string | string []} Contents of functions

// @returns {(table (lines:string; tagType:symbol)[]; table (lines:string; tagType:symbol)[])} 
// A tuple of lists of tables: <br>
// [0] - list of tables containing tagType and lines (tag content) for the header section of the function <br>
// [1] - list of tables containing tagType and lines (tag content) for the body section of the function

// @example Execute function
// contents: exec content from .axqdtools.ws.artifacts.get[] where module in `.qd;
// .z.m.qd.genTagBlocks[contents];

// @private
.z.m.qd.lib.genTagBlocks:{[settings; contents]
    
    // Return empty schema if contents is empty
    if[ .z.m.axq.isEmpty contents; : (enlist ([] lines:(); tagType:()); enlist ([] lines:(); tagType:()))];
    
    // Seperates function content into headers (qdoc information) and bodies which contains arguments inside it as well
    seperated: lib.separateDocHeader[contents];

    headers     : seperated[;0];
    bodies      : seperated[;1];
    // .z.m.axqc.q is expensive. Run it conditionally for things like linter
    parameters  : $[1b ~ settings`checkParams;
        {lib.getParams @[.z.m.axqc.q; x; ()][0;0]}each bodies;
        count[bodies]#()
        ];
    
    // Make tags in qdoc and description for each in a block
    // Newlines in descriptions is seperated which must be joined later
    headerTagBlocks: lib.i.stringsToTagBlocks[settings; headers];
    bodyTagBlocks: lib.i.stringsToTagBlocks[settings; bodies];
    
    // convert any @desc to @overview if it comes before: param, returns, type 
    
    headerTagBlocks: {
        d: where (`$"@desc") = x`tagType;
        x[d where d < first asc x[`tagType]?`$("@param"; "@returns"; "@return"; "@type");`tagType]:`$"@overview";
        x
        } each headerTagBlocks;
    
    // Return a general list: containing a general list of tables and a general list of chars
    : (headerTagBlocks; bodyTagBlocks; parameters);
    }
// @fileOverview Extract function parameters from parse tree
// @param tree {()} 
// @returns {string[]} 
// @example
// tree: .z.m.axqc.q["{[foo; bar]}"][0;0]
// lib.getParams tree
.z.m.qd.lib.getParams:{[tree]
    : $[() ~ tree;
            ();
        (first first tree) in `PN`APPLY;
            .z.s tree[1;0];
        (first first tree) ~ `FUNCTION;
            [   args: tree[1;0];
                $[  (first first args) ~ `empty;
                    ();
                    args[;1]]];
            ()];
    }

// markdown: pre.out.md output;
.z.m.qd.lib.getReadmes:{[markdown]
    
    if[.z.m.axq.isEmpty markdown; : 0#data.ARTIFACTS];
    
    // Find all distinct categories and subcategories.
    allCat: select distinct category, subcategory from markdown where 
        kind <> `typedefs, category <> .z.m.qd.data.GLOBAL_CAT;
    // We also need a readme for each category
    allCat: distinct allCat, ([] category: allCat`category; subcategory: (count allCat)#`);
    
    modules: lib.cat.toModule allCat;
    refs: .z.m.axq.asSymbol (.z.m.axq.asString modules) ,\: "/README";
    cnt: count modules;
    
    readmes: flip cols[data.ARTIFACTS]!(refs; cnt#`README; cnt#`file; modules; allCat`category; allCat`subcategory; .z.m.axq.asString cnt#`);
    
    : readmes, lib.i.globalreadme markdown
    }
// @fileOverview Returns the top level from a given ref
// Returns ` if the ref is not full qualified denoting it belongs to global module
// @param refs {symbol | symbol[]} 
// @returns {symbol | symbol[]}
.z.m.qd.lib.getTopLevel:{[refs]
    : { $[lib.isFq x; ` sv 2#` vs x; `] } each .z.m.axq.asSymbol refs
    }

// @fileOverview Determines the file name for each item in markdown table based on the groupBy parameter
// @param settings {dictionary} 
// @param markdown {table}
// @returns {table}
.z.m.qd.lib.group:{[settings; markdown]
    : (flip enlist[`file]!enlist lib.url.file[settings; markdown; `md]),' markdown
    }

.z.m.qd.lib.handleAttrTags:{[ioTags]
    
    if[.z.m.axq.isEmpty ioTags; : ioTags];
    
    : lib.i.handleDescTag
        lib.i.handleDefaultTag
            lib.i.handleReqTag ioTags
    
    }

// @fileOverview Given a table of name (fully qualified name) and kind, it estimates the module name. 
// Function only works on file, function, data, module kinds.
// @param items {table (name: symbol; kind:symbol)} 
// @returns {table (name: symbol; module:symbol; kind:symbol)}
.z.m.qd.lib.i.calc.module:{[items] 
    
    // Sets the module to null symbol first to ensure we get correct type.
    // Files - module name is extracted by splitting at "/"
    // Functions and data - module name is extracted by splitting at "."
    // Module - module name is extracted is same as name
    
    if[not `module in cols items;
        items: update module: ` from items;
        items: update module: .z.m.qd.lib.unhsym first each ` vs/: hsym name from items where kind in `file`readme, name like ("*/*");
        items: update module: ` sv/: -1_/:` vs/: name from items where kind in `function`data, name like ".*";
        items: update module: name from items where kind = `module
        ];
    
    : items 
    }
// @fileOverview Given a table of name (fully qualified name), module and kind, it calculates the relative name
// Maps the given name column to ref
// Adds a new name column that holds the relative name
// Doesn't do anything if the ref column already exists
// @param items {table (name: symbol; module:symbol  kind:symbol)} 
// @returns {table (ref:symbol;  name: symbol; module:symbol; kind:symbol)}
.z.m.qd.lib.i.calc.name:{[items]

    if[not `ref in cols items;
        items: update ref: name from items;
        items: update name: ` sv/: ((count')` vs/: module)_' ` vs/:ref from items where module like ".*", kind in `function`data;
        items: update name: `$1_/: ((count') string module)_' (string') ref from items where kind in `file`readme, ref like "*/*"
        ];
    
    : items
    }
// catD: `category`subcategory! (data.GLOBAL_CAT; `)
// catD: `category`subcategory! (data.GLOBAL_CAT; `dfdf.sdsd)
// catD: `category`subcategory! (`; `)
// catD: `category`subcategory! (`sdsd; `)
// catD: `category`subcategory! (`sdsd; `sdfsd)
// catD: `category`subcategory! (`sdsd; `sdfsds.sdfd)
.z.m.qd.lib.i.cat.toModule:{[catD]
    
    : $[data.GLOBAL_CAT = catD`category;
            catD`subcategory;
        ` = catD`category;
            catD`category;
        ` = catD`subcategory;    
            ` sv (`; catD`category);
            ` sv (`; catD`category; catD`subcategory)
            ]
    }

.z.m.qd.lib.i.cat.toPath:{[catD]
    if["file" ~ catD`kind; catD[`ref]: "." sv "/" vs catD`ref];
    
    // Category will be empty for global artifacts
    if[catD[`category] like ""; : `$catD`ref];
        
    dirFn: {[joinStr; f]
        
                f: $[f[`subcategory] like ""; 
                        f`category;
                        joinStr sv (f`category; f`subcategory)
                        ];
                : f,joinStr
                };
    
    namespace: dirFn["."; catD];
    funcName: last namespace vs catD`ref;
    
    // Drop "." from the starting. This will stay when "namespace" (category) is different than actual function context
    // This will happen when someone uses category and subcategory tags
    if[lib.isFq funcName; funcName: 1_funcName];
    
    dirStruct:  dirFn["/"; catD];
    : `$$["file" ~ catD`kind;
        dirStruct,funcName;
        "." sv (dirStruct;funcName)
        ]
    }

// {[catD]
//     if[`file ~ catD`kind; catD[`ref]: `$"." sv "/" vs string catD`ref];
//     
//     // Category will be empty for global artifacts
//     if[` ~ catD`category; : catD`ref];
//     
//     path: lib.unhsym ` sv (hsym catD[`category]),catD[`subcategory],catD`ref;
//     
//     : `$ssr[string path; "//"; "/"]
//     }
// catD: `ref`name`category`subcategory`kind!(".gg/README"; "README"; "gg";""; "file")
// @fileOverview Removes multiline comments after mutable tags if there is no type (curly brackets) defined. 
// Those multiline comments could be a normal comment, not a part of the qdoc.
// KXAX-10002

.z.m.qd.lib.i.checkMutable:{[tagBlock]
    
    // Return if not mutable tags
    if[not (`$"@mutable") in tagBlock`tagType; : tagBlock];
    
    // Get mutables with multiline comments
    muts: select from tagBlock where tagType = (`$"@mutable"), (count each lines) > 1;
    
    if[.z.m.axq.isEmpty muts; : tagBlock];
    
    // Drop all items except the first if the first item doesn't have type (curly braces) 
    muts[`lines]: {$[2 <> count x[0] ss "[{}]"; enlist first x; x ]} each muts`lines; 
    
    : update lines:muts[`lines] from tagBlock where tagType = (`$"@mutable"), (count each lines) > 1;
    }

.z.m.qd.lib.i.globalreadme:{[tags]
    
    : $[data.GLOBAL_CAT in distinct select category from tags; 
        [
            c: data.GLOBAL_CAT;
            r: ` sv (data.GLOBAL_CAT;`README);
            $[not r in tags`ref;
                cols[data.ARTIFACTS]!(r;`README;`file;c;c;`;"");
                0#data.ARTIFACTS
                ]
            ];
        0#data.ARTIFACTS]
    }
// @private
.z.m.qd.lib.i.groupByBlock:{[settings; trimmedHeaders]
    
    // Identify lines that have tags on them, and the char position of the tags
    tregex: reg.tag each trimmedHeaders;
    tagIndex: where each not .z.m.axq.isEmpty each/: tregex;
    
    // Extract the tags by thier char positon
    tagLines: trimmedHeaders @' tagIndex;
    toCut: tregex @' tagIndex;
    splitOnTags: toCut _'' tagLines; 
    tagSyms: $[`tagmap in key settings; settings`tagmap; ::] lower `$first each' splitOnTags; //Tags seperated from content
    tagContent: last each' splitOnTags;  //Content seperated from tags
    
    // Generate a GUID for each line that has a tag, and then use 'fills' so that each
    // line that does not have a tag will be associated with the tag that came before it.
    t: ([] tagIndex:tagIndex; tagContent:tagContent; tagSyms:tagSyms);
    tagTables: trimmedHeaders {[headers;d]
       ret:([] 
            lines:headers;
            block:0ng;
            tagType:`
            );
        // The asc is a hack so that 'group by' does not alter the order because it gives block the sorted attribute
        ret: update tagType:d[`tagSyms], lines:d[`tagContent],block:asc count[i]?0ng from ret where i in d[`tagIndex];
        ret: update block:fills block from ret; // use fills to associate all lines of code with the tag lines that preceeded them
        ret: select lines,tagType by block from ret;
        : update tagType:first each tagType from ret;
        }' t;
    
    // Return a list of tables keyed by block
    : tagTables;
    }

.z.m.qd.lib.i.handleDefaultTag:{[ioTags]
   
    a: select from ioTags where Tag = `default;
    
    if[.z.m.axq.isEmpty a; : ioTags];
    
    default: flip (enlist each d[;0]),' trim enlist each " " sv/: 1_/: d:" " vs' a[`Description];

    a: flip `Name`Default`Description! default,enlist a[`Description];
    a: select from a where Name in ioTags[`Name];
    
    // Drop default tags from the ioTags
    ioTags: select from ioTags where not Description in a[`Description];
    
    : ioTags lj `Name xkey select Name, Default from a
    }

.z.m.qd.lib.i.handleDescTag:{[ioTags]
    
    a: select from ioTags where Tag = `desc;
    
    if[.z.m.axq.isEmpty a; : ioTags];
    
    // Description holds the name and the actual value (of desc). Split on space, extract name (first item) and then
    // join the rest of the string together
    description: flip (enlist each d[;0]),' trim enlist each " " sv/: 1_/: d:" " vs' a[`Description];

    a: flip `Name`Desc`Description! description,enlist a[`Description];
    a: select from a where Name in ioTags[`Name];

    // Drop default tags from the ioTags
    ioTags: select from ioTags where not Description in a[`Description];
    
    : ioTags lj `Name xkey select Name, Description:Desc from a
    }

.z.m.qd.lib.i.handleReqTag:{[ioTags]
    
    a: select from ioTags where Tag = `req;
    
    if[.z.m.axq.isEmpty a; : ioTags];
    
    a: flip `Name`Required`Description!(flip trim 2#/:" " vs' a[`Description]),enlist a[`Description];
    a: select from a where Name in ioTags[`Name];
    a: update Required: (.z.m.qd.lib.i.mapReq each a[`Required]) from a;
    
    // Drop req tags from the ioTags
    ioTags: select from ioTags where not Description in a[`Description];
    
    : ioTags lj `Name xkey select Name, Required from a
    }
.z.m.qd.lib.i.mapReq:{[x]
    x: lower x;
    
    : $[("false" ~ x) or 0b ~ x; 0b;
        ("true" ~ x) or 1b ~ x; 1b;
        x
        ]
    }

// module: first i.getArtifacts[]`module;
.z.m.qd.lib.i.module.toCat:{[module]

    m: 1_` vs module;
    
    : $[lib.isFq module;
        (cols lib.i.category)!(first m; $[ 0 = count 1_m; `; ` sv 1_m]);
        (cols lib.i.category)!(data.GLOBAL_CAT; $[` = module; `; module])      // Global artifacts
        ];
    }

// @fileOverview Takes QDOC string and returns a table of tag blocks
// The string MUST be sanitized to remove empty lines and trailing left whitespace

// @param headers {string []} A header which has been split by newline and sanitized to remove empty lines + trailing left whitespace
// @returns {table (lines:string; tagType:symbol) []} Returns a list table 

// @private
.z.m.qd.lib.i.stringsToTagBlocks:{[settings; headers]
    
    // Strip commenting characters from the QDOC header so that we are just left with QDOC strings
    // .e.g "  // @param X {Int} This is X" -> " @param X {Int} This is X"
    trimmedHeaders: lib.i.trimTagComments[headers];
    
    // Group tags by block
    gByBlock: lib.i.groupByBlock[settings; trimmedHeaders];
    
    // Each tag block was grouped by a guid, remove this internal detail
    ret: value each gByBlock;

    // Turn all the tags to lower case in order to support both upper and lower case tags
    ret: { : update tagType : lower tagType from x } each ret;
    
    // KXAX-10002; Remove multiline comments after mutable tags if there is no type (curly brackets) defined
    ret: lib.i.checkMutable each ret;
   
    : ret;
    }

// tagBlock: first fnTags;
.z.m.qd.lib.i.tagToString:{[tagBlock]
    
    lines: "\n// " sv/: tagBlock`lines;
    tagss: "// ",/: .z.m.axq.asString tagBlock`tagType;
    
    : "\n" sv tagss ,' lines 
    }  

// @fileOverview
// This function takes a list of QDOCHeaders and returns
// the headers split by newline with commenting characters and left hand-side whitespace trimmed.

// @param headers {string []}  A string of multiple comments that come before the start of a function
// @return {string []}

// @private
.z.m.qd.lib.i.trimTagComments:{[headers]
    
    splitHeaders: "\n" vs/: headers;

    // Identify which lines are comments, anything thats not a comment can just be thrown out (in practice we are just throwing out redudnant newlines used for prettifying)
    // Additonally the regex gives us the position of where the commenting characters stop
    // e.g "   /* @param" would give us the positions 0 6 because 6 is the first non-commenting non-whitespace char (the @ symbol)
    
    cregex: .z.m.pcre2.imatch[.z.m.qd.reg.COMMENT; ; ::] each splitHeaders;
    matches: not .z.m.axq.isEmpty each/: cregex;
    commentsIndex: where each matches;

    // Strip lines that arent comments
    justComments: splitHeaders @' commentsIndex;
    
    // Strip the commenting chars from lines that are comments
    toCut: cregex @' commentsIndex;
    
    // Each row of toCut will be a list of pairs of ints. Each pair of ints
    // 0 + the index to cut the string at. Same pair as explained in the sample above with "   /* @param"
    justQDOC: last each' toCut _'' justComments;
    
    : justQDOC;
    }

// @fileOverview Returns a list of booleans indicating the artifacts that do not contain any valid qdoc tags
// @param tagBlocks {#tagBlocks} 
// @returns {boolean[]}
.z.m.qd.lib.isEmpty:{[tagBlocks]
    : not any each (@[;`tagType] each tagBlocks) in (raze value data.TAGS)
    }

// @fileOverview Checks if the argument starts with a "." or not
// @returns {boolean}
.z.m.qd.lib.isFq:{ : "." ~ first .z.m.axq.asString x}

// @fileOverview Returns a list of booleans indicating the artifacts containing the @private tag
// @param tagBlocks {#tagBlocks} 
// @returns {boolean[]}
.z.m.qd.lib.isPrivate:{[tagBlocks]
    : (`$"@private") in/: @[;`tagType] each tagBlocks
    }

// @fileOverview Returns a list of booleans indicating the artifacts containing the @todo tag
// @param tagBlocks {#tagBlocks} 
// @returns {boolean[]}
.z.m.qd.lib.isTodo:{[tagBlocks]
    : (`$"@todo") in/: @[;`tagType] each tagBlocks
    }

// @fileOverview Converts windows path to linux style path
// Linux style paths are preferred when writing to disk using `0:`.
// @param path {symbol}
// @returns {symbol} Linux style path
.z.m.qd.lib.lPath:{[path]     
    : hsym .z.m.axq.asSymbol ssr[.z.m.axq.asString path; "\\"; "/"]
    }

// @fileOverview Extract category and subcategory from module name
// @param modules {symbol | symbol[]}
// @returns {table (category: symbol; subcategory: symbol)}
// modules: `abc`.z.m.qd.types`.abc`abc.sd``.
.z.m.qd.lib.module.toCat:{[modules]
    // Return empty schema if items is empty
    if[ (.z.m.axq.isEmpty modules) or .z.m.axq.isNull modules;
        : 0#lib.i.category];
    
    : lib.i.module.toCat each $[-11h ~ type modules; enlist modules; modules]
    }
// @fileOverview Sanitizes the output path. Used by .z.m.qd.settings and .z.m.qd.out.pandoc.settings
// Add default output directory if required
// Append the CWD if the supplied path wasn't an absolute path
// @param path {string| symbol} 
// @returns {symbol}
.z.m.qd.lib.outdir:{[path]
    
    path: lib.unhsym .z.m.axq.asSymbol path;
    
    : lib.lPath
        $[.z.m.axq.isNull path; 
            ` sv (hsym `$.z.m.ax.os.pwd[]; `out);
        .z.m.pcre2.test[reg.ABSOLUTE_PATH; path; ::];
            path;
            ` sv (hsym `$.z.m.ax.os.pwd[]; path)
            ]
    }
// @param   path    {string}    A linux dir structure path
// @return  {dict (module: string; artifact: string)}
// path: "qd/md/.i.runFormatBlocks.md";
// path: "testFunc.md"
.z.m.qd.lib.parseDirStruct:{[path]
    
    if[not "/" in path; : `module`artifact!("";path)];
    
    
    index: last path ss "/";
    module: (index sublist path), "/";
    artifact: ((1 + index) - count path) sublist path;
    
    : `module`artifact!(module;artifact)
    }
// @fileOverview Enter a description here...
// @returns {Type} Enter a return description here...
// x: "foo/README.md"
.z.m.qd.lib.ps:{[x]
    : .z.m.axq.asSymbol 
        $[10h ~ type x;
            .z.m.ax.os.ps x;
        all 10h = type each x;
            .z.m.ax.os.ps each x;
        -11h ~ type x;
            .z.m.ax.os.ps string x;
        11h ~ type x;
            .z.m.ax.os.ps each string x;
            '"expecting string or symbol"
            ]
    }

// @fileOverview This function takes a list of strings and seperates QDOC Headers from the function bodies.
// @param contentStrings {string []} A list of strings which contain QDOC + function bodies.
// @returns {()} (QDocHeaders; qfnBodies)

// @example Arguments
// contentStrings: "//test \n \\ test \n {}"
// contentStrings: "//@typedef name {sfsdf} safds \n//"

// @private
// contentStrings: contents
.z.m.qd.lib.separateDocHeader:{[contentStrings] 
    
    // Make sure contentStrings is a general
    if [not (0h = type contentStrings); contentStrings: enlist contentStrings];
    
    // Allow empty functions to be treated as a niladic function which return generic null -> {[]}
    empties: where .z.m.axq.isEmpty each contentStrings;
    contentStrings[empties]: count[empties]#enlist"{[]}";
    
    // Use a regex to find the start of a function in a string of text. The regex accepts vector input
    regexSplit: reg.function contentStrings;
    if[any e:.z.m.axq.isEmpty each regexSplit;
        regexSplit[where e]: reg.data contentStrings where e;
        // Handle cases when there are just comments in the file ("//test \n")
        if[any e:.z.m.axq.isEmpty each regexSplit;
            c: count each contentStrings where e;
            regexSplit[where e]: flip (c; c)
            ]
        ];
    
    // 0 n _ String will split a string at index n, so we build a 2xcount[contentStrings] matrix whose first column is all zero
    toCut: .z.m.axq.asInt 0,' regexSplit[;0];
    split: toCut _' contentStrings;
    : split;
    }



// @fileOverview This is reverse of genTagBlocks. It converts tagBlocks back to contents. 
// Loses the code inside the the function. 
// @param tagBlocks {} 
// @returns         {string[]}
// t: genTagBlocks[pre.in.functions[input]`content];
// tagBlocks: `header`body!t;
.z.m.qd.lib.tagToContent:{[tagBlocks]
    
    if[98h ~ type tagBlocks`header; tagBlocks[`header]: enlist tagBlocks`header];
    if[98h ~ type tagBlocks`body; tagBlocks[`body]: enlist tagBlocks`body];
    
    headers: lib.i.tagToString each tagBlocks`header;
    bodies: lib.i.tagToString each tagBlocks`body;
    
    : headers lib.FN_TEMPLATE ' bodies
    }

// @fileOverview Deletes the ':' from the start of argument if it exists.
// @param x {symbol|symbol[]|string|string[]} 
// @returns {symbol|symbol[]|string|string[]}
// @example arguments
// x: `:foo;
// x: `:foo`:bar;
// x: `:foo`bar;
// x: ":foo";
// x: "foo";
// x: (":foo"; ":bar");
.z.m.qd.lib.unhsym:{[x]
    drop: {$[":" = first x; 1_x; x]};
    
    : $[11h ~ type x;
            `$drop each string x;
        -11h ~ type x;
            `$drop string x;
        10h ~ type x;
            drop x;
        all 10h = type each x;
            drop each x;
        -10h ~ type x;
            drop enlist x;
            '"expecting a string[] or symbol[]"
        ]
    }

// @fileOverview Returns the file name based on the group attribute. 
// It also sanitizes the file name and adds an extension if provided
// @param settings {#setting} 
// @param artifacts {#artifacts} 
// @param ext {symbol} File extension to use (`md or `html)
// @returns {symbol[]}
.z.m.qd.lib.url.file:{[settings; artifacts; ext]
    
    files: $[`ref ~ settings`group;
            lib.cat.toPath .z.m.axq.asString lib.artifacts.wc artifacts;
         `category ~ settings`group;
            artifacts`category;
         `subcategory ~ settings`group;
            {$[` ~ y; x; `$"_" sv string x,y]} ./: flip (artifacts`category; artifacts`subcategory);
            '"group: unsupported option ", string settings`group
            ];
    
    if[settings`sanitizeURL;
        files: lib.url.sanitize each files
        ];
    
    if[not null ext;
        files: ` sv/: files,\:ext
        ];

    // Sanitize the filename of typedefs file to make sure it always the same
    // regardless of whether the user wants to sanitize all url or not
    files: ?[`typedefs = artifacts`kind; lib.url.sanitize each files; files];
    
    : files
    }
// @fileOverview Santizes the given argument by:
// - Replacing space and underscores with hyphen
// - lower case
// @param url {string | symbol} 
// @returns {symbol}
.z.m.qd.lib.url.sanitize:{[url]
    `$lower ssr/[.z.m.axq.asString url ;(" "; "_"); ("-"; "-")]
    }

.z.m.qd.lib.i.category:flip (`category`subcategory)!enlist each ``
.z.m.qd.lib.FN_TEMPLATE:{ x, "\n{[]\n     \n", y,"\n    }\n"}
.z.m.qd.lib.onLoad:{[]
    // @typedef tags_config x y {dict (input:#x) | dict (artifacts:#y; docprivate:boolean; docempty:boolean; exclude:string; modules:string; functions:string)}
    }

.z.m.qd.lib.onLoad[];
system "d .z.m";

system "d .z.m.qd";
// @fileOverview Converts a string into an HTML anchor ID using mkdocs's algorithm
// Algorithm: 
//  - All text is converted to lowercase
//  - Any illegal characters are dropped
//  - Whitspaces and consecutive dashes are then reduced to a single dash.
// https://github.com/Python-Markdown/markdown/blob/master/markdown/extensions/toc.py
// https://github.com/mkdocs/mkdocs/blob/master/docs/user-guide/writing-your-docs.md#linking-to-pages
// @param x {string} 
// @returns {string}
.z.m.qd.autoidentifier.mkdocs:{[x]
    
    : autoidentifier.i.mkdocs.REPLACE_DISALLOWED
        autoidentifier.i.mkdocs.FILTER_ILLEGAL lower trim .z.m.axq.asString x
    }

// @fileOverview Converts a string into an HTML anchor ID using pandoc's algorithm
// Algorithm: 
// - Convert all alphabetic characters to lowercase.
// - Remove all punctuation, except underscores, hyphens, and periods.
// - Replace all spaces and newlines with hyphens.
// - Remove everything up to the first letter (identifiers may not begin with a number or punctuation mark).
// - If nothing is left after this, use the identifier section.
// https://pandoc.org/MANUAL.html#headers-and-sections
// @param x {string} 
// @returns {string}
.z.m.qd.autoidentifier.pandoc:{[x]
    
    ret: first autoidentifier.i.pandoc.FIRST_LETTER
        autoidentifier.i.pandoc.REPLACE_DISALLOWED
            autoidentifier.i.pandoc.FILTER_ILLEGAL lower trim .z.m.axq.asString x;

    : $[(ret ~ "") or ret ~ ();
        "section";
        ret
        ]
    }
// @fileoverview Replace consecutive space characters with a hyphen
.z.m.qd.autoidentifier.i.pandoc.REPLACE_DISALLOWED:.z.m.pcre2.replace[.z.m.pcre2.compile["[\\s]+"; .z.m.pcre2.use.replaceAll[]]; ; "-" ;::]
// @fileoverview Extract the string after first character
.z.m.qd.autoidentifier.i.pandoc.FIRST_LETTER:.z.m.pcre2.match[.z.m.pcre2.compile["[a-zA-z].*"; ::]; ; ::]
// @fileoverview Remove all characters except hyphens, underscore, period, word or a space character
.z.m.qd.autoidentifier.i.pandoc.FILTER_ILLEGAL:.z.m.pcre2.replace[.z.m.pcre2.compile["[^\\w\\s\\_.-]"; .z.m.pcre2.use.replaceAll[]]; ; "";::]

// @fileoverview Replace consecutive hyphen and space characters with a hyphen
.z.m.qd.autoidentifier.i.mkdocs.REPLACE_DISALLOWED:.z.m.pcre2.replace[.z.m.pcre2.compile["[-\\s]+"; .z.m.pcre2.use.replaceAll[]]; ; "-" ;::]
// @fileoverview Remove all characters except hyphnes, word or a space character
.z.m.qd.autoidentifier.i.mkdocs.FILTER_ILLEGAL:.z.m.pcre2.replace[.z.m.pcre2.compile["[^\\w\\s-]"; .z.m.pcre2.use.replaceAll[]]; ; "";::]
system "d .z.m";

system "d .z.m.qd";
// @subcategory Pandoc Plugin
// @deprecated
// @fileOverview Returns the version of pandoc
// @returns {string} version number
.z.m.qd.out.pandoc.getVersion:{[]
    last " " vs first @[system; "pandoc -v"; {'"pandoc is not installed"}]
    }

// @fileOverview This function converts md files to html files using pandoc

// @param mdFileNames    {string []}     Markdown file names
// @param htmlFileNames  {string []}     HTML file names
// @private
.z.m.qd.out.pandoc.i.convert:{[mdFileNames; htmlFileNames]
   
    // Wrap the paths in quotes to handle spaces
    absInFileNames: {"\"",/:x,\:"\""} string lib.unhsym mdFileNames;
    absOutFileNames: {"\"",/:x,\:"\""} string lib.unhsym htmlFileNames;

    // Make the directory structure before invoking pandoc
    // Split at the last occurrence "/" to get the directory name
    createDirs: distinct {(last x ss "/")#x} each absOutFileNames;
    .z.m.ax.os.mkdir each ,\:[;"\""] createDirs;
    
    // Extensions were not supported in pandoc versions less than 1.10 
    // Extracting the second column to see if the release is a one digit number (<10) or not.
    // @qlintsuppress DEPRECATED_FUNCTION(1)
    ver: count @[;1] "." vs out.pandoc.getVersion[];

    // @qlintsuppress DEBUG_FUNCTION(1)
    show "Converting *.md to *.html";
    system each out.pandoc.i.CMD[ver],/:(absOutFileNames,\:" "),'absInFileNames; / dnl
    }

// @fileOverview Extract the H1 header from the given content and converts it into an ID
// @see qd.autoidentifier.pandoc
// @param x {string[]} 
// @returns {symbol[]}
// @private
.z.m.qd.out.pandoc.i.extractID:{[x]
    if[x ~ (); : `symbol$()];
    m: first each out.pandoc.i.REG.H1 x;
    a: first each "\n" vs/: ?[() ~/: m; count[m]#enlist ""; m];
    :`$.z.m.qd.autoidentifier.pandoc each ?["#" ~/: first each a; 1_/:a; a]
    }
// @fileOverview Returns a link to the HTML page for each item in the markdown table
// The link includes the base html page and the anchor tag for tag linking to the speific item
// The anchor from a README file is calculated from the first h1 header in its content
// Anchor for other artifacts such are function and data is calculated based on its name
// Leading '.' is removed from the name
// ".z.m.qd.DOC" -> "qd.html#qd.doc"
// @param markdown {table (name: symbol; category: symbol; content: string)} 
// @returns {symbol[]}
// @private
.z.m.qd.out.pandoc.i.getLink:{[settings; markdown]
    markdown: update name: .z.m.qd.out.pandoc.i.extractID content from markdown where name like "*/README";
    ids  : lower string markdown`name;
    files: .h.hu each string 
        $[settings`sanitizeURL; lib.url.sanitize each markdown`category; markdown`category];
    `$files,' ".html#",/: ?[lib.isFq each ids; 1_/:ids; ids]
    }
// @fileOverview Generates a TOC tree for all the items in the markdown table
// The README files becomes the nodes (category/subcategory) whereas the functions
// and data artifacts becomes the leafs of the tree.
// @param output {#pre.out} 
// @returns {string}
// @private
.z.m.qd.out.pandoc.i.getTOC:{[settings; output]
    elements: string delete file, kind, module, content from 
        update href: .z.m.qd.out.pandoc.i.getLink[settings; output`md] from output`md;
    
    leafs: select from elements where not name like "*/README";
    nodes: select from elements where name like "*/README";

    : out.pandoc.i.list.category
        out.pandoc.i.list.subcategory[nodes]
            out.pandoc.i.list.artifact leafs
    }
// @private
// @param content   {string []} List of contents to be wrapped in the body tag 
// @returns         {string []} Contents wrapped in body. Same list size as the input
.z.m.qd.out.pandoc.i.html.body:{[content]
    :  "\n<body>",/: content,\: "\n</body>"
    }
// @qlintsuppress UNUSED_INTERNAL(1)
// @private
// @param content   {string} Content to be bolded
// @returns         {string} Content wrapped bold tag
.z.m.qd.out.pandoc.i.html.bold:{[content]
    "\n\n<b class=\"bold\">",content,"</b>"
    }

// @fileOverview Builds a standalone HTML page out by wrapping HTML tags around the content
// @param settings      {#settings}
// @param paths         {symbol []}     Name of the md to html file names that were written to the disk 
// @param toc           {string []}     Table of contents for each HTML page 
// @returns {string []}
// @private
.z.m.qd.out.pandoc.i.html.builder:{[settings; paths; toc]
    
    $[.z.m.axq.isEmpty paths;
        [
            htmlFuncNames:  "";
            contents: enlist "";
            relPath: enlist ""
            ];
        [
            contents: ("\n" sv read0 @) each paths;
            htmlFuncNames: (count string settings[`htmlDir]) _/: lib.unhsym string paths;  
            dirDepth: count each where each htmlFuncNames =\: "/";    
            relPath: {raze .z.m.axq.asString x#.z.m.axq.asSymbol "../"} each dirDepth
            ]
        ];
    

    : out.pandoc.i.html.html
    
    out.pandoc.i.html.head[relPath; settings[`jsscripts]; 
          out.pandoc.i.html.meta[count relPath; ""; "Content-Type"; "text/html; charset=utf-8"]
        , out.pandoc.i.html.meta[count relPath; ""; "Content-Style-Type"; "text/css"]
        , out.pandoc.i.html.meta[count relPath; "google"; ""; "notranslate"]
        , out.pandoc.i.html.title[count relPath; "kx-Doc"]
        , out.pandoc.i.html.link[relPath,\:"assets/css/qdoc-dark.css"; "text/css"; "stylesheet"; "dark"]
        , out.pandoc.i.html.link[relPath,\:"assets/css/qdoc-light.css"; "text/css"; "alternate stylesheet"; "light"]
        , out.pandoc.i.html.link[relPath,\:"assets/images/favicon.ico"; "image/x-icon"; "shortcut icon"; ""]
        , out.pandoc.i.html.link[relPath,\:"assets/images/favicon.png"; "image/png"; "icon"; ""]
        , out.pandoc.i.html.script[relPath,\:"assets/js/jquery.min.js"]
        , out.pandoc.i.html.script[relPath,\:"assets/js/underscore.js"]
        , out.pandoc.i.html.script[relPath,\:"assets/js/utf.min.js"]
        , out.pandoc.i.html.script[relPath,\:"assets/js/makeResizeHandle.min.js"]
        , out.pandoc.i.html.script[relPath,\:"assets/js/jstree.min.js"]
        , out.pandoc.i.html.script[relPath,\:"assets/js/QDocViewer.js"]]
    
    out.pandoc.i.html.body
        out.pandoc.i.html.div["qd-wrapper"]
            out.pandoc.i.html.paralleldiv["qd-leftPaneOuter";
                out.pandoc.i.html.div["qd-leftPaneInner"]
                    out.pandoc.i.html.paralleldiv["qd-satic";
                           out.pandoc.i.html.img[relPath,\:"assets/images/kxlogowhite.png"]
                        ,' out.pandoc.i.html.h1[relPath,\:"index.html"; "qd-allModules"; "All Modules"]]
                    count[relPath]#out.pandoc.i.html.div["qd-modules"; enlist toc]]
            out.pandoc.i.html.paralleldiv["qd-sidebarResizeHandle"; (count relPath)#(enlist "")]
            out.pandoc.i.html.div["qd-rightPaneOuter"]
                out.pandoc.i.html.div["qd-rightPaneInner"]
                    out.pandoc.i.html.div["qd-content"; contents];
    
    }

// @private
// @param id        {string} 
// @param content   {string []} 
// @returns {string []}
.z.m.qd.out.pandoc.i.html.div:{[id; content]
    : ("\n<div id=\"",id,"\">"),/: content,\: "\n</div>"
    }

// @private
.z.m.qd.out.pandoc.i.html.h1:{[hrefs; id; content]
    : "\n<h1 class=\"bar\"><a href=\"",/: hrefs,\: "\" id=\"",id,"\">",content,"</a></h1>";
    }
// @private
// @param relPath               {string []} An array of strings containing relative path from each html file
//                                          to the doc directory
// @param addScriptIncludes     {string []} An array of strings containing relative path from the doc <br>
//                                          directory to the additional scripts that needs to be included
// @param includesList          {string []} Generic includes (css, images, js etc) 
// @param content               {string []} Body section of each page 
// @returns {string []}
.z.m.qd.out.pandoc.i.html.head:{[relPath; addScriptIncludes; includesList; content]
    
    if[not .z.m.axq.isEmpty addScriptIncludes;
        includesList: includesList, raze { out.pandoc.i.html.script[x,\:y]}[relPath; ] each addScriptIncludes;
        ];

    includes: raze each flip includesList;
    
    : ("\n<head>",/:includes,\:"</head>"),' content;
    }
// @private
.z.m.qd.out.pandoc.i.html.html:{[content]
    : "\n<html>",/: content,\: "\n</html>";
    }

// @private
.z.m.qd.out.pandoc.i.html.img:{[srcs]
    : "\n<img src=\"",/: srcs,\: "\" width=\"50px\" />";
    }

// @private
.z.m.qd.out.pandoc.i.html.link:{[hrefs; ty; rel; title]
    : enlist "\n<link href=\"",/:hrefs,\:"\" type=\"",ty,"\" rel=\"",rel,"\" title=\"",title,"\" />";
    }

// @private
.z.m.qd.out.pandoc.i.html.meta:{[cnt; name; http; c]
    : enlist .z.m.axq.asString cnt#.z.m.axq.asSymbol "\n<meta name=\"",name,"\" http-equiv=\"",http,"\" content=\"",c,"\" />";
    }
// @private
// @param id        {string} 
// @param content   {string []} 
// @param di        {string []} Parallel div to join to. List must be same size as content
// @returns {string []}
.z.m.qd.out.pandoc.i.html.paralleldiv:{[id; content; di]
    : (("\n<div id=\"",id,"\">"),/: content,\: "\n</div>"),' di;
    }
// @private
.z.m.qd.out.pandoc.i.html.script:{[srcs]
    : enlist "\n<script src=\"" ,/:srcs,\: "\"></script>";
    }
// @private
.z.m.qd.out.pandoc.i.html.title:{[cnt; title]
    : enlist .z.m.axq.asString cnt#.z.m.axq.asSymbol "\n<title>",title,"</title>";
    }

// @fileOverview Returns an HTML list item for each artifact (function/data) in the leafs table 
// @param leafs {table} 
// @returns {table (category: string; subcategory: string; content: string)}
// @private
.z.m.qd.out.pandoc.i.list.artifact:{[leafs]    
    c:.h.htac[`li; enlist[`class]!enlist "noStyle"] each 
        .h.htac[`a] ./: flip (select href, id:name, class:(count[i]#enlist "artifact") from  leafs; leafs`name);
    
    : select category, subcategory, content: c from leafs
    }

// @fileOverview Builds unordered list of categories by wrapping each subcategory in an
// HTML list item. 
// @param subcategoryList {table (category: string; href: string; content: string)}
// @returns {string}
// @private
.z.m.qd.out.pandoc.i.list.category:{[subcategoryList]
    
    // Add "category-" to the id to prevent erroneously linking to the ToC when 
    // searching for the anchor on page load
    x: 0!select 
        href: first href, 
        id: ("category-",first category), 
        class:first (count[i]#enlist "category"),
        content: "\n" sv content by category from subcategoryList;
    
    : .h.htac[`ul; ()!()] "\n" sv 
        .h.htac[`li; enlist[`class]!enlist "noStyle"] each
            (.h.htac[`a] ./: flip (`href`id`class#x; x`category)),'
            .h.htac[`ul; ()!()] each x`content
    };

// @fileOverview The artifacts that have a subcategory are wrapped in an HTML list item
// corresponding to their subcategory
// @param nodes {table} 
// @param artifactList {table (category: string; subcategroy: string; content: string)} 
// @returns {table (category: string; href: string; content: string)}
// @private
.z.m.qd.out.pandoc.i.list.subcategory:{[nodes; artifactList]
    
    x: update id: "." sv/: flip (category; subcategory), class:(count[i]#enlist "subcategory") from 
        nodes lj select content: "\n" sv content by category, subcategory from artifactList;
    
    list: .h.htac[`li; enlist[`class]!enlist "noStyle"] each 
            (.h.htac[`a] ./: flip (`href`id`class#x; x`subcategory)),'
            .h.htac[`ul; ()!()] each x`content;
    
    : delete name from update content: ?["" ~/: x`subcategory; x`content; list] from x
    }
// @fileOverview Generate HTML output file names
// @param output        {#pre.out} 
// @returns {string[]}
// @private
.z.m.qd.out.pandoc.i.names:{[output]
        
    mdfiles: `${ssr[x; "README.md"; "index.md"]} each .z.m.axq.asString distinct exec file from output`md;
    
    : ` sv/: (-1_/:` vs/: mdfiles),\:`html
    }


// @private
.z.m.qd.out.pandoc.i.settings.sanitize:{[settings]
    
    if[(.z.m.axq.isEmpty settings) or .z.m.axq.isNull settings; 
        settings: out.pandoc.i.SETTINGS];
    
    if[not 99h ~ type settings;
        '"settings: invalid type, expecting a dictionary"];
    
    if[.z.m.axq.isNull settings`out;
        '"no markdown files found on disk"];
    
    // Overwrite default settings with the given settings and only keep the relevant settings
    // Allows user to pass same dict to the generate markdown and render it using one of the plugins
    settings: (key out.pandoc.i.SETTINGS)#out.pandoc.i.SETTINGS, settings;
    
    // Type validation
    settings: out.pandoc.i.settings.validate settings;
    
    : settings
    }
// @private
.z.m.qd.out.pandoc.i.settings.validate:{[settings]
    
    // Type validation
    if[not (type settings`out) in -11 -10 10 101h;
        '"out: invalid type, expecting a symbol or hsym or string"];
    
    if[-1h <> type settings`sanitizeURL;
        '"sanitizeURL: invalid type, expecting boolean"];
    
    if[`category <> settings`group;
        '"group: only grouping by category is supported for pandoc render"];
    
    settings[`jsscripts]: $[10h = type settings`jsscripts;
                                enlist settings`jsscripts;
                            all 10h = type each settings`jsscripts;
                                settings`jsscripts;
                                '"jsscripts: invalid type, expecting a string or list of strings"
                                ];
    
    // Add default output directory if required
    // Append the CWD if the supplied path wasn't an absolute path
    settings[`out]: lib.outdir settings`out;

    settings[`htmlDir]: ` sv settings[`out],`doc;
    settings[`mdDir]: ` sv settings[`out],`md;
    
    : settings
    }

// @fileOverview Enter a description here...
// @returns {Type} Enter a return description here...
// @private
.z.m.qd.out.pandoc.i.write.file:{[settings; output]
    
    // Generate HTML and MD names
    htmlFileNames: ` sv/: settings[`htmlDir],/: out.pandoc.i.names output;
    mdFileNames: ` sv/: settings[`mdDir],/: distinct exec file from output`md;
    
    // Generate HTML from MD once it is written to the disk
    out.pandoc.i.convert[mdFileNames; htmlFileNames];
    
    : htmlFileNames
    }
// @fileOverview Converts the HTML file fragments written to disk by pandoc md to HTML conversion
// to standalone files. It rewrites the content on disk with the content wrapped in HTML header and body. 
// It embeds a ToC in each HTML file.
// An index.html file is also wrtten to the disk.
// @param settings {dict (out: symbol; jsscripts: string| string[])} 
// @param output {#ret} 
// @param htmlFileNames {symbol[]} Path to HTML file fragments 
// @returns {symbol[]} Path to all the HTML files written/modified by this function
// @private
.z.m.qd.out.pandoc.i.write.standalone:{[settings; output; htmlFileNames]
    
    // Get table of contents to be embedded in the pages
    toc: out.pandoc.i.getTOC[settings; output];
    
    // Write index.html with the toc
    indexFileName: ` sv settings[`htmlDir], `index.html;    
    indexFileName 0: out.pandoc.i.html.builder[settings; ""; toc];
    
    // Overwride the raw htmlFiles with standalone HTML pages with built-in toc
    htmlFileNames 0:' enlist each out.pandoc.i.html.builder[settings; htmlFileNames; toc];
    
    : indexFileName, htmlFileNames
    };
// @fileOverview Write static files to disk
// @param settings {#settings} 
// @returns {string []} List of HTML static files written to the disl
// @private
.z.m.qd.out.pandoc.i.write.static:{[settings] 
    
    files: .z.m.axq.asSymbol out.pandoc.i.STATICFILES[`name];
    fileDir: `$$[ all files in key hsym `$".z.m.qd.out.pandoc";
                    ".z.m.qd.out.pandoc";                                        // Workspace: files in workspace
                all files in key hsym `$".z.m.qd.out.pandoc/file";
                    ".z.m.qd.out.pandoc/file";                                   // Git structure: used during build time
                all files in key hsym `$.z.m.axenv.path.ws[],".z.m.qd.out.pandoc";
                    .z.m.axenv.path.ws[],".z.m.qd.out.pandoc";                        // Analyst ws: [KXAX-6742] Avoids the dependency of having .z.m.qd.html in workspace
                    '"cannot find static files under the .z.m.qd.out.pandoc"
                ];

    // Create directory structure for static files
    .z.m.ax.os.mkdir each lib.unhsym string ` sv/: settings[`htmlDir],/:out.pandoc.i.DIRECTORIES;
    
    src: lib.unhsym string ` sv/: (hsym fileDir),/: files;
    dst: lib.unhsym string ` sv/: settings[`htmlDir],/: `$out.pandoc.i.STATICFILES[`path];
    src .z.m.ax.os.cp ' dst;
     
    : hsym `$dst
    }
// @subcategory Pandoc Plugin
// @deprecated
// @fileOverview Checks whether pandoc is installed on the server or not.
// @returns {boolean}
.z.m.qd.out.pandoc.isInstalled:{[]
    not .z.m.axq.isEmpty @[system; "pandoc -v"; ()]
    }

// @subcategory Pandoc Plugin
// @deprecated Pandoc plugin is deprecated and will be removed in the next version. Please use mkdocs.
// @fileOverview Converts the markdown files generated using `.z.m.qd.doc` function to a static HTML site using pandoc. 
// 
// Pandoc must be installed on the server for this plugin to work.
// You can check if pandoc is installed using .z.m.qd.out.pandoc.isInstalled.

// @param settings  {dict (out: symbol; jsscripts: string| string[])} Optional. Pass generic null to use defaults
// @param output    {#ret} Output from the .z.m.qd.doc function
// @returns {string[]} Filenames of all the HTML files written to the disk

// @desc settings.out Path to the generated files on disk. By default it will be determined from output.out
// @desc settings.jsscripts Paths to additional javascript files that needs to be included in the generated site

// @desc output.out The directory where the generated markdown files are written on disk
// @desc output.md  A table of items and their generated markdown content
// @desc output.md.file Name of the markdown file the item would exist in
// @desc output.md.name Name of the item
// @desc output.md.kind Type of the item
// @desc output.md.module The module this item belongs to
// @desc output.md.category The category this item belongs to
// @desc output.md.subcategory The subcategory this item belongs to
// @desc output.md.content Markdown content of the item
// @desc output.error A table of errors encountered during markdown generation
// @desc output.error.ref Name of the item
// @desc output.error.qdType The documented QDoc type
// @desc output.error.errorType The type of error (`PARSE` or `RESOLUTION`)
// @desc output.error.error The error message

// @example Generate HTML documentation
// .z.m.qd.out.pandoc.write[::] .z.m.qd.doc[::] `.foo.q
// @see qd.doc
// @see qd.out.mkdocs.write
.z.m.qd.out.pandoc.write:{[settings; output]
    
    -2 "Warning: Pandoc plugin is deprecated and will be removed in the next version.";
    -2 "Please use mkdocs.";
    
    // @qlintsuppress DEPRECATED_FUNCTION(1)
    if[not out.pandoc.isInstalled[]; '"pandoc is not installed"];
    
    // To ensure adding default out works with null settings
    if[(.z.m.axq.isEmpty settings) or .z.m.axq.isNull settings; 
        settings: ()!()];
    
    settings: out.pandoc.i.settings.sanitize settings, 
                enlist[`out]!enlist ` sv -1_ ` vs lib.lPath output`out;
    
    if[.z.m.axq.isEmpty output`md; 
        : `out`html!(`;([] file:()))];
    
    // Convert MD to raw HTML fragments and write them to the disk
    htmlFileNames: out.pandoc.i.write.file[settings; output];
    
    // Write static files (CSS, JS and images) to the disk
    staticFileNames: out.pandoc.i.write.static settings;
    
    // Convert the HTML file fragments to standalone files with embedded ToC
    standaloneFileNames: out.pandoc.i.write.standalone[settings; output; htmlFileNames];
    
    files: last each string[settings[`htmlDir]] vs/: string standaloneFileNames, staticFileNames;
    
    : `out`html!(lib.ps settings`htmlDir; ([] file: .z.m.axq.asSymbol files))
    }
// @private
.z.m.qd.out.pandoc.i.STATICFILES:([]
    name: (
        "qdoc-dark.css"; 
        "qdoc-light.css"; 
        "favicon.ico";
        "favicon.png";
        "kxlogowhite.png";
        "jquery.min.js";
        "jstree.min.js";
        "makeResizeHandle.min.js"; 
        "underscore.js";
        "utf.min.js";
        "QDocViewer.js";
        "qdoc.js"
        );
    path: (
        "assets/css/qdoc-dark.css"; 
        "assets/css/qdoc-light.css"; 
        "assets/images/favicon.ico";
        "assets/images/favicon.png";
        "assets/images/kxlogowhite.png";
        "assets/js/jquery.min.js";
        "assets/js/jstree.min.js";
        "assets/js/makeResizeHandle.min.js"; 
        "assets/js/underscore.js";
        "assets/js/utf.min.js";
        "assets/js/QDocViewer.js";
        "assets/js/qdoc.js"
        )
    )
// @private
.z.m.qd.out.pandoc.i.SETTINGS:(!) . flip 0N 2#(
    `out                ; ::;
    `sanitizeURL        ; 0b;
    `jsscripts          ; "assets/js/qdoc.js";
    `group              ; `category
    );
// Matches H1 header using anyt of the two conventions:
// '# Heading\n'
// 'Heading\n=====\n'
// @private
.z.m.qd.out.pandoc.i.REG.H1:.z.m.pcre2.match[.z.m.pcre2.compile["(#\\s*[\\w\\- ]+\\n|[\\w\\- ]+\\n=+\\s*\\n)"; ::];  ;::]

// @private
.z.m.qd.out.pandoc.i.DIRECTORIES:`$("assets/js/"; "assets/css/"; "assets/images/")
// @private
.z.m.qd.out.pandoc.i.CMD:{[ver] 
    : $[ver = 2;
        "pandoc --columns=1000 -f markdown+grid_tables+multiline_tables -t html5 -o ";
        "pandoc --columns=1000 -t html5 -o "];
    }
system "d .z.m";

system "d .z.m.qd";
.z.m.qd.typedefs.appendDescription:{[tdefs; catD; ioTag]
    
    fqRefs: 1_/:typedefs.i.parse.ref[catD; ioTag][;1];
    
    typedef: select from tdefs where ref in fqRefs;
    if[1 < count typedef;        
        typedef: typedef iasc {where x in enlist y}[typedef[`ref]] each (distinct fqRefs)
        ];

    ioTag[`Description]: " " sv (ioTag[`Description]; " " sv typedef[`description]);
    
    : ioTag
    }

// @fileOverview Extractes typedef names from the parse tree
// @doctest Extract typedef name
// enlist[`foo] ~ .z.m.qd.typedefs.extractNames first .z.m.qd.types.parse "table (x: #foo)"
.z.m.qd.typedefs.extractNames:{[tree]
    tt: `symbol$();
    if[tree ~ (); : tt];
    : typedefs.i.extractNames[tt; tree]
    }
// @fileOverview Fully qualifies the typedefs (if any) in the ioTags (param, return).
// @param catD {#catD} 
// @param ioTag {#ioTag} 
// @returns {#ioTag} ioTag with fully qualified names of typedefs
.z.m.qd.typedefs.fq:{[catD; ioTag]
    
    if[not any "#" =/: ioTag`Type; : ioTag];
    
    // Get the typedef references used in the IO type. Returns (relRef;fqRef)
    refs: typedefs.i.parse.ref[catD; ioTag];
    
    // Update typedef references to be full qualified references
    ioTag[`Type]: typedefs.i.update.ref[ioTag[`Type]; distinct refs];
    
    : ioTag
    }

// @fileOverview This is a getter function for typedefs defined in the onLoads

// @param onLoads {#onLoad}

// @returns {#typedefs.tdefs}

// @example Arguments
// settings: data.SETTINGS;
// onLoads: @[;`onLoads] lib.build.input[data.SETTINGS] .axqdtools.ws.artifacts.get[];
// tdefs: .z.m.qd.typedefs.get[settings; onLoads];
.z.m.qd.typedefs.get:{[settings; onLoads]
    
    if[not 98h ~ type onLoads;
        '"onLoad: invalid type, expecting a table"];
    
    if[(.z.m.axq.isEmpty settings) or .z.m.axq.isNull settings; 
        settings: data.SETTINGS];
    
    onLoads: `ref xasc select from onLoads where (name like "onLoad") or name like "*.onLoad";
    
    if[.z.m.axq.isEmpty onLoads; : typedefs.global[]];
    
    : typedefs.i.get[settings] onLoads
    }
// @fileOverview Returns a table of global typedefs supported by Analyst
// @returns {#typedefs.tdefs}
.z.m.qd.typedefs.global:{
    cnt: count typedefs.i.global;
    k: .z.m.axq.asString key typedefs.i.global;
    emptyStrList: .z.m.axq.asString (cnt)#`;
    
    : ([]   onLoad      : cnt#`onLoad;
            category    : cnt#.z.m.qd.data.GLOBAL_CAT;
            tag         : cnt#`typedef;
            ref         : "." ,/: k;
            alias       : k;
            qType       : value typedefs.i.global[;0];
            error       : emptyStrList;
            description : ("File symbol"; "Any kdb+ type");
            descs       : cnt#enlist data.IO_TAGS;
            parseTree   : (enlist (`option;enlist(`atom;((`atom;"hsym");(`array;0)))); 
                           enlist (`option;enlist(`atom;((`atom;"any");(`array;0)))));
            paramCount  : cnt#0;
            paramName   : cnt#();
            isPrivate   : cnt#0b
        );
    }

// @fileOverview Links the all the description tags asscoiated with with the given tdef
.z.m.qd.typedefs.i.associateDesc:{[tdefs; tdef]
    descs: select from tdefs where tag = `desc, ref like (tdef[`ref],".*");
    tdef[`descs]: distinct tdef[`descs], typedefs.i.toIOTagSchema descs;
    : tdef
    }

// @fileOverview Builds the typedefs table
// @param onLoad   {dict}
// @param ioTags   {#ioTags} 
// @returns {#typedefs.tdefs}
// onName: onLoads[`ref][0]
// ioTags: ioTagss[0];
.z.m.qd.typedefs.i.buildT:{[onLoad; ioTags]
    
    if[.z.m.axq.isEmpty ioTags; : 0#typedefs.global[]];
    
    // Get the module name for each onLoad function in order to fully qualify the typedefs
    // Drop the .onLoad from the onLoad functions fully qualified name
    // Module name for global onLoads should be `
    moduleName   : .z.m.axq.asString $[`onLoad ~ onLoad`ref; `;` sv -1_` vs onLoad`ref];
    
    // Prepend "Optional; " to the description for optional dict keys/table columns
    ioTags       : update Name: -1_/:1_/:Name, Description: ("Optional; ",/:Description) 
        from ioTags where Name like "[[]*[]]";
    
    refs         : typedefs.i.makeFQ[moduleName; ]  each first each " " vs/: ioTags`Name;
    tdefParams   : typedefs.i.getParamInfo ioTags;
    ioTags[`Type]: typedefs.i.fqGlobalTdefs each ioTags`Type;
    ioTags       : typedefs.i.parse.type'[ioTags; tdefParams];
    ioTags       : typedefs.i.errors ioTags;
    
    // Build a table with typedef info    
    tdefInfo     : ([] onLoad: (count ioTags)#onLoad`ref; category: (count ioTags)#onLoad`category),' 
        select tag: Tag, ref:refs, alias:Name, qType:Type, error, description:Description, 
            descs: (count ioTags)#enlist .z.m.qd.data.IO_TAGS, parseTree from ioTags;

    : tdefInfo ,' tdefParams
    }
// @fileOverview Parses each type from the ioTag table and returns a list of string containing 
// any parse errors that were encountered. It also returns error for incomplete typedef definitions
// @param ioTags {#ioTag[]}
// @returns {string []}
.z.m.qd.typedefs.i.errors:{[ioTags]

    // Empty typedef name, type errors
    // This typedef could also be the one that is dynamically created by the @datatype tag
    ioTags[`error]: ?[ioTags[`Name] like "";
        count[ioTags]#enlist "incomplete typedef definition: missing name";
        ioTags`error
        ];
    
    // Type will be empty for description tags in onLoad
    ioTags[`error]: ?[(ioTags[`Type] like "") and ioTags[`Tag] in `typedef`typedef:private;
        count[ioTags]#enlist "incomplete typedef definition: missing type" ;
        ioTags`error
        ];
    
    : ioTags
    }
.z.m.qd.typedefs.i.extractNames:{[tt; tree]
    tok: first tree;
    val: last tree;
    : $[tok in ``atom`array`column`keyedColumn`typedefParam;
            tt;
        `typedef ~ tok;
            tt, `$1_last first val;
            $[1 ~ count val;
                typedefs.i.extractNames[tt; first val];
                raze typedefs.i.extractNames[tt] each val
                ]
            ]
    }

.z.m.qd.typedefs.i.fqGlobalTdefs:{
    if[x like "*#hsym*";
        x: ssr[x; "#hsym"; "#.hsym"]];
    
    if[x like "*#any*";
        x: ssr[x; "#any"; "#.any"]];
    
    : x
    }

.z.m.qd.typedefs.i.get:{[settings; onLoads]
    
    // Get blocks of tags. Each item relates to all the tags types found in an onLoads
    tagBlocks: lib.genTagBlocks[settings; onLoads`content][1];
    
    // Categorize tagBlock into broader categories and get relevant tags
    ioTagss: typedefs.i.tags[settings] each tagBlocks;
    ioTagss: onLoads {if[0 ~ count y; : y]; typedefs.fq[x] each y} ' ioTagss;
    
    tdefs: raze onLoads typedefs.i.buildT ' ioTagss;
    
    if[0 ~ count tdefs; : typedefs.global[]];
    
    // Link descs with their associated tdefs
    tdefs: typedefs.i.associateDesc[tdefs] each tdefs;
    // Resolve nested typedefs if not documenting them sperately
    if[not settings`doctypedef;
        tdefs: typedefs.i.resolveNested[settings; tdefs] each tdefs
        ];
        
    // Return a table of typedefs joined with global typedefs
    : typedefs.global[], 
        `ref xdesc
            update isPrivate: ?[tag = `typedef:private; 1b; 0b] from 
                select from tdefs where tag in `typedef`typedef:private
    }
// @fileOverview Returns a table containing information about arguments for each typedef
// @param ioTags {#ioTags} 
// @returns {table (paramCount: long; paramName: string[])}
.z.m.qd.typedefs.i.getParamInfo:{[ioTags]
    split: " " vs/: ioTags`Name;
    : ([] paramCount:(count each split) - 1; paramName:1_/:split)
    }

// alias: first aliases;
.z.m.qd.typedefs.i.makeFQ:{[module; alias]
    
    if[(`$alias) in key typedefs.i.global; : ".",alias];
    
    if[` ~ module; : alias];
    
    : $["." ~ first alias;                                                      // . in the begining implies it is a full qualified name
            alias;                                                              // return as is
            "." sv .z.m.axq.asString (module; alias)                                // Join the module with alias
            ]
    }

.z.m.qd.typedefs.i.parse.ref:{[catD; ioTag]
    
    // An alias in the param type is denoted by "\\#". Only extracts the alias names, not the arguents to the alias
    alias   : reg.alias ioTag[`Type];
    // Drop '#' from infront of the aliasName (1_/:) before fully qualifying alias names
    fqAlias : "#",'typedefs.i.makeFQ[lib.getTopLevel catD`module] each 1_'alias;

    if[ioTag[`Tag] in `typedef`typedef:private;
        // Do not fully qualify arg names
        paramName: first exec paramName from typedefs.i.getParamInfo enlist ioTag;
        fqAlias  : ?[(1_/:alias) in paramName; alias; fqAlias]
        ];
    
    : flip (alias; fqAlias)
    }

// @fileOverview Checks the syntax of a given qd type. Returns an empty string if no error exists
// @param ioTag {#ioTag} 
// @returns {#ioTag}
// ioTag: ioTags 0
// tdefParam: tdefParams 0
.z.m.qd.typedefs.i.parse.type:{[ioTag; tdefParam]
    ioTag,: `parseTree`error!((); "");
    if[.z.m.axq.isEmpty ioTag`Type; : ioTag];
    
    // Re-write typedef parameter names to start with '%' instead of '#'
    // Allows qdoc type resolver to easily distinguish between typedefs and parameters.
    if[0 < tdefParam`paramCount;
        ioTag[`Type]: ssr/[ioTag`Type; "#",/:tdefParam`paramName; "%",/:tdefParam`paramName]
        ];
    
    // Parse the tag type. If the parser fails to parse
    // parsed will contain a string containing the error message
    // @qlintsuppress MISSING_DEPENDENCY(1)
    parsed: @[types.parse; ioTag`Type; {x}];
    
    ioTag[`parseTree`error]: $[.z.m.axq.isString parsed; ((); parsed); (parsed; "")];
    
    : ioTag
    }

// @fileOverview Resolve nested typedefs upto a maximum depth of 10
// @param tdefs {#typedefs.tdefs} 
// @param tdef {dict} 
// @returns {dict}
// tdef: tdefs 11;
.z.m.qd.typedefs.i.resolveNested:{[settings; tdefs; tdef]

    if[not tdef[`tag] in `typedef`typedef:private; : tdef];
    
    toExtractFrom: tdef`parseTree;
    
    // Need a max depth to prevent infinite loop in case the definition wasn't found
    n:10;
    while[(0 < count names: distinct raze typedefs.extractNames each toExtractFrom) & 0 < n-:1;
        hits         : select from tdefs where (tag in `typedef`typedef:private) and (|/) ref like/: string names;
        toExtractFrom: distinct first each hits`parseTree;
        $[0 ~ count hits;
            n:0;
            [
                // Update the name of the description tags to the tdef name so that it can be applied correctly
                descs       : distinct raze hits`descs;
                descs[`Name]: ssr/[; distinct hits`ref; count[distinct hits`ref]#enlist tdef`ref] each descs`Name;
                tdef[`descs]: distinct tdef[`descs], descs;
                ]
            ]
        ];

    // Catch any parse errors and save that in the tdef error column
    resolved: $[.z.m.axq.isEmpty tdef`error; 
        .[.z.m.qd.types.out.qd; (settings; tdefs; tdef`parseTree); {.z.m.axq.asSymbol x}];
        .z.m.axq.asSymbol tdef`error
        ];
    $[-11h ~ type resolved;
        // TODO: remove 'tdef[`ref], " -> "' when linter starts reporting typedefs with error correctly
        tdef[`error]: tdef[`ref], " -> ", string resolved;
        tdef[`qType]: resolved
        ];
    
    : tdef
    }





// @fileOverview Categorizes a tagBlock into broader categories. Then returns the relevant IO tags
// @param tagBlock {} 
// @returns {#ioTag}
// tagBlock:  tagBlocks[1];
.z.m.qd.typedefs.i.tags:{[settings; tagBlock]

    if[any (`$("@datatype";"@datatype:private")) in tagBlock`tagType;
        // @qlintsuppress MISSING_DEPENDENCY(1)
        tagBlock,: pre.datatype.tdef[settings] tagBlock];
    // @qlintsuppress MISSING_DEPENDENCY(1)
    ioTag: .z.m.qd.md.transform[0b; tagBlock][`io];

    : select from ioTag where Tag in `typedef`typedef:private`desc
    }
// @fileOverview Converts tdefs to ioTags schema
.z.m.qd.typedefs.i.toIOTagSchema:{[tdef]
    : select Tag:tag, Name: ref, Type: qType, Description:description, Required: 0b, Default: 0b, Typedefs: count[tdef]#() from tdef;
    }

// @example
// Type: ioTag[`Type]
// TODO: Wanted to use this but the indices will change after one pass and it will break. So, have to use ssr
//     indices: {0,@[x; 1; {x+1}]} each matches[;1 2];
//     {{(first y; x; last y)}[z] y _ x }/[Type; indices; fqRef]
.z.m.qd.typedefs.i.update.ref:{[Type; refs]
    : {ssr[x; y; z]}/[Type; refs[;0]; refs[;1]];
    }


    
// typedef: (qd type; js type)
.z.m.qd.typedefs.i.global:(!) . flip (
                (`hsym  ;   ("hsym"; "string"));
                (`any   ;   ("any"; "any"))
                );   
.z.m.qd.typedefs.onLoad:{[]
    // @typedef tdefs {table (
    //  onLoad      : symbol; 
    //  category    : symbol;
    //  tag         : symbol;
    //  ref         : string; 
    //  alias       : string; 
    //  qtype       : string; 
    //  error       : string; 
    //  description : string; 
    //  paramCount  : long; 
    //  paramName   : string[]
    //  )} 
    //  A table containing information about the typedefs
    }
.z.m.qd.typedefs.onLoad[];
system "d .z.m";

system "d .z.m.qd";
// @fileOverview Checks if the given typedef name exists in the typedef table or not
// @param typedef   {#typedefs.tdefs} 
// @param name      {string} 
// @param args      {string[]}  Arguments supplied to the typedef 
// @returns {dict}  Dictionary of typedef
.z.m.qd.types.i.check.tdef:{[typedef; name; args]

    // typedef contains all the aliases. Extract the one we are resolving in this pass
    t: select from typedef where tag in `typedef`typedef:private, ref like 1_name;
    
    if[ .z.m.axq.isEmpty t;
        '"unresolved alias(es): ",1_name];
    
    // Check: Num of args given = expected
    if[ not any t[`paramCount] = count args;
        '"rank: ", 1_name, ". Expecting ", (" or " sv .z.m.axq.asString asc t[`paramCount]), ", given ", string count args];
    
    // Overloaded typedefs: There could be multiple typedefs with same name but different number of parameters.
    // Can't add the paramCount filter in the query above because then the rank error will never get generated
    :$[1 < count t;
        exec from t where paramCount = count args;
        raze t];
    }

.z.m.qd.types.i.js.array:{[n]            
    : raze first[1_n]#enlist "[]" 
    }
// n:  first first 1_ first .z.m.qd.types.parse "int[]";
// n: first first 1_ first .z.m.qd.types.parse "char[]";
// n: first first 1_ first .z.m.qd.types.parse "symbolic file path (hsym)";
// n: first first 1_ first .z.m.qd.types.parse "*";
.z.m.qd.types.i.js.atom:{[typedef; n]
    val: first 1_n;
    array: .z.m.qd.types.out.js[typedef; enlist last val];
    
    if["char[]" ~ (first val[;1]),array; : ("string"; types.i.js.td)];

    // Escape type "*" to be used with the like expression
    ty: $[(enlist "*") ~ first val[;1]; "[*]"; first val[;1]];    
    // Global typedef contain non primitive q types    
    nonQType: .z.m.axq.asSymbol exec alias from typedefs.global[] where qType like ty;
    atom: $[.z.m.axq.isEmpty nonQType;
                .z.m.axq.asString types.map[`qd; `js; lower first val[;1]];
                @[typedefs.i.global; nonQType][0;1]
                ];

    : ("" sv (atom;array); types.i.js.td)
    }

// n: first first 1_ first .z.m.qd.types.parse "dict (col1: #.z.m.im.io int[]; col2: char)";
// n: first first 1_ first .z.m.qd.types.parse "dict (name:char[]; param: dict (arg: char))";
// n: first first 1_ first .z.m.qd.types.parse "dict (name:char[]; param: int)[]";
// n: first first 1_ first .z.m.qd.types.parse "dict []";
.z.m.qd.types.i.js.dict:{[typedef; n]
    // dict (name:char[]; param: dict (arg: char))
    //
    // to
    //
    // @param {Object} arg - msg
    // @param {string} arg.name
    // @param {Object} arg.param 
    // @param {string} arg.param.arg
    
    val: first 1_n;
    array: types.out.js[typedef] enlist last val;
    if[.z.m.axq.isEmpty 1_val; : (`header`names`types!( "Object",array; (); ()); types.i.js.td)];
    
    c    : 0N 2#-1_val;
    col: (array,"."),/:c[;0;1;1];;
    tys: (types.out.js[typedef] enlist@) each c[;1];
    
//     tys:  types.i.js.tdef.build each tys; 
    
    : (`header`names`types!("Object",array; col; tys[;0]); raze tys[;1])
    }

// n:  first first 1_ first .z.m.qd.types.parse "$ symbol[]";
// n:  first first 1_ first .z.m.qd.types.parse "$ symbol";
// Always return string or string[]
.z.m.qd.types.i.js.enum:{[typedef; n]
    
    val: first 1_n;
    array: .z.m.qd.types.out.js[typedef] enlist last last last val[0;1];
    
    : ("" sv ("string";array); types.i.js.td)
    }

// n: first first 1_first .z.m.qd.types.parse "fn [] (dict (param:int)) ->  table (name:char[]; param: table(arg:char)[])[]";
// n: first first 1_first .z.m.qd.types.parse "fn";
// n: first first 1_first .z.m.qd.types.parse "function  (function) -> second";
.z.m.qd.types.i.js.func:{[typedef; n]

    array: types.out.js[typedef] enlist first first 1_n;
    val: 1_first 1_n;
    if[.z.m.axq.isEmpty val; : ("function", array;types.i.js.td)];

    // Extract all the function parameters
    parameters: types.out.js[typedef] each val[;1] where `param = val[;0];
    return: types.out.js[typedef] last last val;
    
    // Build jsdoc typedef for compound q types like dict, table ...
    tys: types.i.js.tdef.build each parameters, enlist return;
    fn: "function",array, " (", ("; " sv -1 _ tys[;0]), "): ", (first last tys);

    : (fn; raze tys[;1])
    }

// n: first .z.m.qd.types.parse "symbol[] | int[]"
// n: first .z.m.qd.types.parse "dict (x:int)"
.z.m.qd.types.i.js.option:{[typedef; n]
    val  : first 1_n;
    : $[1 ~ count val;
        types.out.js[typedef; val];
        [
            tys:(types.out.js[typedef] enlist@) each val;
            tys:  types.i.js.tdef.build each tys; 
            ("" sv (" (";;") ") " | " sv tys[;0]; raze tys[;1])
            ]
        ];
    
    }

// n: first first 1_first .z.m.qd.types.parse "table (name:char[]; param: table(arg:char)[])[]";
// n: first first 1_ first .z.m.qd.types.parse "table (name:char[]; param: table(arg: char; y:int))";
// n: first first 1_ first .z.m.qd.types.parse "table (name:char[]; param: int)[]";
// n: first first 1_ first .z.m.qd.types.parse "table (name:char)";
// n: first first 1_ first .z.m.qd.types.parse "table []";
// typedef: "";
.z.m.qd.types.i.js.table:{[typedef; n]
    // table (name:char[]; param: table(arg: char))
    //
    // to
    //
    // @param {Object[]} arg - msg
    // @param {string} arg[].name
    // @param {Object[]} arg[].param 
    // @param {string} arg[].param[].arg
    
    val  : first 1_n;
    array: types.out.js[typedef] enlist last val;
    if[.z.m.axq.isEmpty 1_val; :  (`header`names`types!( "Object[]",array; (); ()); types.i.js.td)];
        
    c    : 0N 2#-1_val;   
    col: (array,"[]."),/:c[;0;1;1];;
    tys: (types.out.js[typedef] enlist@) each c[;1];
    
//     tys:  types.i.js.tdef.build each tys; 
    
    : (`header`names`types!( "Object[]",array; col; tys[;0]); raze tys[;1])
    }

// Build fake typedef if an object type (dict, table) is used within complex types (tuple, option, fn)
// These are complex types and can contain more than one type within
// ty: last tys
.z.m.qd.types.i.js.tdef.build:{[ty]
    : $[99h ~ type first ty;
        [
            alias: 6?.Q.A;
            ty[0]: types.i.js.tdef.flatten[ty];
            jsTDef: ([] tdef: enlist alias),'enlist ty[0];
            (alias; jsTDef)
            ];
        ty
        ];
    }
// If type has an alias that is defined in the tdef table, then resolve the alias to flatten it
// ty: last tys
.z.m.qd.types.i.js.tdef.flatten:{[ty]
    if[.z.m.axq.isEmpty ty[1]; : ty[0]];
    
    dict: ty[0];
    dict[`types]: {[tab; z]  
                        : $[all z in tab[`tdef]; 
                            raze select header, names, types from tab where tdef like z;  
                            z]}[ty[1];] each dict[`types];
    : dict
    }

// n: first first 1_first .z.m.qd.types.parse "(int; char)";
// n: first first 1_first .z.m.qd.types.parse "(int; dict (x:int))";
// n: first first 1_first .z.m.qd.types.parse "()[]"
.z.m.qd.types.i.js.tuple:{[typedef; n]
        
    val: first 1_n;
    array: last last val;
    
    if[.z.m.axq.isEmpty 1_val; : ((array+1) types.i.js.wrapArray/"";types.i.js.td)];
    
    tys: types.out.js[typedef] each enlist each -1_val;    
    tys:  types.i.js.tdef.build each tys; 
    
    // Wrap the types in Array<>. +1 since it is a tuple
    : ((array+1) types.i.js.wrapArray/ ", " sv tys[;0]; raze tys[;1])
    }

// n: first first 1_first .z.m.qd.types.parse "#.testMod.myType    [] int[] char";
// 
// n: first first 1_first  .z.m.qd.types.parse "#.ctrlui.newTest dict(x:int;y:table(b:char))";
// n: first first 1_first  .z.m.qd.types.parse "#.ctrlui.newTest int[]";
// n: first first 1_first .z.m.qd.types.parse "#.any";
// typedef: .z.m.qd.t.t;
// typedef: flip `ref`alias`qType`description`paramCount`paramName!
//  (enlist ".testMod.myType"; enlist "myType a b"; enlist "dict (fir: #a; sec: #b)"; 
//  enlist ""; enlist 2;  enlist ( enlist "a"; enlist "b"));
.z.m.qd.types.i.js.typedef:{[typedef; n]
    val  : first 1_n;
    name: first val[;1];
    array: types.out.js[typedef] enlist val[1]; 
    
    args: (types.out.js[typedef] enlist@) each last val[;1];
    argsTdef: $[.z.m.axq.isEmpty raze args[;1]; types.i.js.td; raze args[;1]];
    
    if[.z.m.axq.isEmpty typedef;
        : (" " sv (name, array;" " sv args[;0]); argsTdef)];
    
    // Get the the only typedef out of the table which is relevant to this pass
    t: types.i.check.tdef[typedef; name; args];
    
    // If it is the global typdef, then no need to do anything else
    if[t[`ref] in @[typedefs.global[];`ref];
        : types.out.js[""; ] types.parse t[`qType]];
    
        
    // If the args were compound type (dict or table): first get the qd type, 
    // then replace args with qd type and then resolve to js.
    // Otherwise you can not use type {#ref dict}
    $[10h ~ type first args[;0];
        argDict: ("%" ,/: t[`paramName])!args[;0];
        [
            args: types.i.unindent each (types.out.qd[data.settings; typedef] enlist@) each last val[;1];
            argDict: ("%" ,/: t[`paramName])!args
            ]
        ];
    
    ty: {ssr[y; z; x @ z]}[argDict] over enlist[t[`qType], array], key argDict;
    ty: types.out.js[typedef] types.parse ty;
    
    // Build the tdefs table from the resolved type of this typedef.
    // Flatten out the q type to just one type if it has any nested compund type
    $[10h ~ type first ty;
        tys: `header`names`types!(ty[0]; ();());
        tys: types.i.js.tdef.flatten[ty]
        ];
    
    // If it is an advanced typedef (tdef with params) then embed the type of arg followed by keys in the reference name
    // Otherwise a typedef with two different params would be resolved to the same name
    $[.z.m.axq.isEmpty args; 
        alias: upper first " " vs t[`alias];
        [
            alias: upper "_" sv (first " " vs t[`alias]; tys[`header]; "_" sv 1_/:tys[`names]);
            if[alias like "*_"; alias: -1_alias]
            ]
        ];
    
    jsTDef: argsTdef,([] tdef: enlist alias),' enlist tys;
    
    : (alias; jsTDef)
    }
.z.m.qd.types.i.js.wrapArray:{
    : "Array.<",x,">";
    }

.z.m.qd.types.i.out.q:{[s; typedef; n]
    tok:first n;
    k:first tok;
    : $[`array          ~ k; types.i.q.array tok;
        `atom           ~ k; types.i.q.atom[s; typedef; tok];
        `dict           ~ k; types.i.q.dict[s; typedef; tok];
        `enum           ~ k; types.i.q.enum[s; typedef; tok];
        `fn             ~ k; types.i.q.func[];
        `option         ~ k; types.i.q.option[s; typedef; tok];
        `table          ~ k; types.i.q.table[s; typedef; tok];
        `tuple          ~ k; types.i.q.tuple[s; typedef; tok];
        `typedef        ~ k; types.i.q.typedef[s; typedef; tok];
        `typedefParam   ~ k; {first 1_x} tok;
        '`nyi];
    }

// n: first enlist (`array; 1)
.z.m.qd.types.i.q.array:{[n]
    : $[0 < first 1_n; "s"; ""];
    }

// n: first first 1_first .z.m.qd.types.parse "any";
// s: ``pad!0 0
// typedef:""
// @qlintsuppress UNUSED_PARAM(1)
.z.m.qd.types.i.q.atom:{[s; typedef; n]
    
    val: first 1_n;
    array: .z.m.qd.types.out.q[typedef; enlist last val];
    
    atom: first val[;1];    
    ret: $[atom like "hsym";
                "`hsym";
            atom in ("any";"null";"Type";enlist "*";"bool";"integer");
                "`default"; /dnl
            "string" ~ atom; 
                "`char"; /dnl
                "`", atom
            ];
    : ret, array
    }

// n: first first 1_ first .z.m.qd.types.parse "dict (col1: #.z.m.im.io int[]; col2: char)";
// n: first first 1_ first .z.m.qd.types.parse "dict (name:char[]; param: dict (arg: char))";
// n: first first 1_ first .z.m.qd.types.parse "dict (name:char[]; param: int)[]";
// n: first first 1_first .z.m.qd.types.parse "dict []";
// typedef:"";
// s: ``pad!0 0;
.z.m.qd.types.i.q.dict:{[s; typedef; n]    
    val  : first 1_n;
    array: last last val;
    if[1 ~ count val; : "`default"];

    c    : 0N 2#-1_val;
    col  : c[;0;1;1];
    tys  : (types.i.out.q[s; typedef] enlist@) each c[;1];
    ks   : {$[1=count x;"enlist[`",first[x],"]";raze"`",'x]}; /dnl
    bs   : {$[1=count x; "enlist[",first[x],"]";"(",("; "sv x),")"]}; /dnl
    
    ret: "!" sv (ks;bs)@' (col; tys);
    
    : $[0 < array;
        (raze array#enlist "enlist "), ret;
        ret
        ];
    }

// n: first first 1_ first .z.m.qd.types.parse "$ symbol  []"
.z.m.qd.types.i.q.enum:{[s; typedef; n]
    
    : types.i.out.q[s; typedef] first 1_n
    }

.z.m.qd.types.i.q.func:{[]
    /'"function can not be bct decoded"
    : "`default";
    }

// // n: first .z.m.qd.types.parse "(int; symbol)|(int)";
// n: first .z.m.qd.types.parse "int[] | symbol[]";
.z.m.qd.types.i.q.option:{[s; typedef; n]
    
    val  : first 1_n;
    if[1 < count val;
        // Options in types can not be bct decoded. Select the first one
        val: enlist first val
        ];
    
    : types.i.out.q[s; typedef; val];
    }

// n: first first 1_ first .z.m.qd.types.parse "table (name:char[]; param: table(arg: char; y:int))";
// n: first first 1_ first .z.m.qd.types.parse "table (name:char[]; param: int)[]";
// n: first first 1_ first .z.m.qd.types.parse "table (name:char)";
// n: first first 1_ first .z.m.qd.types.parse "table []";
// typedef:"";
// s: ``pad!0 0;
.z.m.qd.types.i.q.table:{[s; typedef; n]    
    val  : first 1_n;
    array: last last val;
    if[1 ~ count val; : "`default"];
  
    c    : 0N 2#-1_val;
    col  : c[;0;1;1];
    tys  : (types.i.out.q[@[s;`pad;+;4]; typedef] enlist@)each c[;1];
    
    ret: "([]\n       ",(s[`pad]#" "), ((";\n       ",(s[`pad]#" ")) sv ": enlist "sv/: flip (col; tys)),")"; /dnl
    
    : $[0 < array;
        (raze array#enlist "enlist "), ret;
        ret
        ];
    }

// n: first first 1_first .z.m.qd.types.parse "(int; char[])[][]";
// @qlintsuppress UNUSED_PARAM(1)
.z.m.qd.types.i.q.tuple:{[s; typedef; n]
    
    val: first 1_n;
    array: last last val;
    tys: "(" , ("; " sv types.out.q[typedef] each enlist each -1_val) , ")";
    
    : $[0 < array;
        (raze array#enlist "enlist "), tys;
        tys
        ];
    }

// n: first first 1_first .z.m.qd.types.parse "#.testMod.myType    [] int[] char";
// typedef: flip `ref`alias`qType`description`paramCount`paramName!
//  (enlist ".testMod.myType"; enlist "myType a b"; enlist "dict (fir: #a; sec: #b)"; 
//  enlist ""; enlist 2;  enlist ( enlist "a"; enlist "b"));
// s: ``pad!0 0;
.z.m.qd.types.i.q.typedef:{[s; typedef; n]

    val  : first 1_n;
    name: first val[;1];
    array: last val[1]; 
    args: (types.out.qd[data.SETTINGS; typedef] enlist@) each last val[;1];
    
    if[.z.m.axq.isEmpty typedef;
        args: (types.out.q[typedef] enlist@) each last val[;1];
        : " " sv (name, raze array#enlist "[]"; " " sv args)];
    
    // Get the the only typedef out of the table which is relevant to this pass
    t: types.i.check.tdef[typedef; name; args];
    
    argDict: ("%" ,/: t[`paramName])!args;
    
    // Add array (square brackets) to the q type
    // Needed because array for complex type would be prepended with enlist and for atom appended with s
    ty: t[`qType] , raze array#enlist "[]";
    ty: {ssr[y; z; x @ z]}[argDict] over enlist[ty], key argDict;

    : types.i.out.q[s; typedef] types.parse ty
    }
// n: last first 1_first .z.m.qd.types.parse "int[][]"
// typedef:""
.z.m.qd.types.i.z.m.qd.array:{[n]            
    : raze first[1_n]#enlist "[]" 
    }

// n: first first 1_first .z.m.qd.types.parse "int[]"
.z.m.qd.types.i.z.m.qd.atom:{[settings; typedef; n]
    
    val: first 1_n;
    array: .z.m.qd.types.out.qd[settings; typedef; enlist last val];
    
    : (first val[;1]),array;
    }

// n: first first 1_first .z.m.qd.types.parse "dict (error:any; message:any; payload: table (name:symbol; objType:symbol; ",
//      "displayName:char; containers:symbol[]; package:symbol; description:char; code:char; ",
//      "parameters:table (name: symbol; paramtype:symbol; default:char; description:symbol; required:boolean); ", 
//      "parameterPerms:table (parameter:symbol; permclass:symbol; permtype:symbol); atype:symbol; public:boolean; ", 
//      "connection:symbol; alias:symbol; returntype:symbol; returndescription:char; returndata:char; typ:symbol))";
// n: first first 1_first .z.m.qd.types.parse "table(col1: int; col2: char[]; col3:dict (x: int; y:char))";
// n: first first 1_first .z.m.qd.types.parse "table []";
// typedef: .z.m.qd.typedefs.get @[;`onLoads] lib.build.input[data.SETTINGS] i.getArtifacts[];

.z.m.qd.types.i.z.m.qd.dict:{[settings; typedef; n]
    
    tokVal  : first 1_n;
    array   : types.out.qd[settings; typedef] enlist last tokVal; 
    
    // Return if the user didn't define the schema of the dict or table
    // THe only token that exists is the array token.
    if[1 ~ count tokVal; : "dict", array];
    
    c    : 0N 2#-1_tokVal;                      // Delete the last token. i.e array
    // Drop `column token by overiding it with its value
    columns: c[;0;1;1];
    
    // Recursive function call to get the base type of the column
    vals: (types.out.qd[settings; typedef; ] enlist@) each c[;1];
    // Join closing parenthesis to the last item. Do a recurssive fn call until the last item is a list of strings
    types.i.z.m.qd.fn: {$[10h ~ type x[-1+count x]; [x[-1+count x] ,: ")"; :x]; [x[-1+count x]: types.i.z.m.qd.fn[x[-1+count x]]; :x ] ]};
    vals: types.i.z.m.qd.fn[vals];
    
    : "dict (",("; " sv ": " sv/: flip (columns; vals)), array;
    }
 
// n: first first 1_ first .z.m.qd.types.parse "$ symbol  []"
.z.m.qd.types.i.z.m.qd.enum:{[settings; typedef; n]
    
    : "enumerated ", types.out.qd[settings; typedef] first 1_n
    }

// n: first first 1_first .z.m.qd.types.parse "fn (dict (any:any)) -> #myType any int";
// n: first first 1_first .z.m.qd.types.parse "fn [] (dict (any:#any)) ->  #any | int";
// n: first first 1_first .z.m.qd.types.parse "fn";
// typedef: "";
.z.m.qd.types.i.z.m.qd.func:{[settings; typedef; n]

    array: types.out.qd[settings; typedef] enlist first first 1_n;
    val: 1_first 1_n;
    // Return if the user didn't define the parameter and the return type of the function
    if[.z.m.axq.isEmpty val; : "fn", array];

    // Extract all the function parameters
    parameters: types.out.qd[settings; typedef] each val[;1] where `param = val[;0];
    return: types.out.qd[settings; typedef] last last val;

    : "fn ", array ,"(",("; " sv parameters),") &rarr; ",return;
    }

// n: first .z.m.qd.types.parse "table (col1: int; col2: char) | dict (col1: int; col2: char) | char[]";
// n: first .z.m.qd.types.parse "fn (dict (any:any)) ->  int";
// n: first .z.m.qd.types.parse "table (a: int; b: symbol)";
// n: first .z.m.qd.types.parse "(int; symbol)|(int)";
// n: first .z.m.qd.types.parse "int[] | symbol[]"
// typedef: "";
.z.m.qd.types.i.z.m.qd.option:{[settings; typedef; n]
    
    val  : first 1_n;
    : $[1 ~ count val;
        types.out.qd[settings; typedef; val];
        [
            tys: (types.out.qd[settings; typedef]  enlist@) each val;
            // Display each type on a new line if any of the types is a compound type (dict or table)
            $[any tys like "*&nbsp*";
                " | <br>" sv tys;
                " | " sv tys
                ]
            ]
        ];
    }

// n: first first 1_first .z.m.qd.types.parse "dict (error:any; message:any; payload: table (name:symbol; objType:symbol; ",
//      "displayName:char; containers:symbol[]; package:symbol; description:char; code:char; ",
//      "parameters:table (name: symbol; paramtype:symbol; default:char; description:symbol; required:boolean); ", 
//      "parameterPerms:table (parameter:symbol; permclass:symbol; permtype:symbol); atype:symbol; public:boolean; ", 
//      "connection:symbol; alias:symbol; returntype:symbol; returndescription:char; returndata:char; typ:symbol))";
// n: first first 1_first .z.m.qd.types.parse "table(col1: int; col2: char[]; col3:dict (x: int; y:char))";
// n: first first 1_first .z.m.qd.types.parse "table []";
// n: first first 1_first .z.m.qd.types.parse "table ([x: int; y: dict()] t: int; u: table())";
// n: first first 1_first .z.m.qd.types.parse "table ([x: int; y: dict()] t: int; u: table())[]";
// typedef: .z.m.qd.typedefs.get @[;`onLoads] lib.build.input[data.SETTINGS] i.getArtifacts[];
.z.m.qd.types.i.z.m.qd.table:{[settings; typedef; n]
    
    tokVal  : first 1_n;
    array   : types.out.qd[settings; typedef] enlist last tokVal; 
    
    // Return if the user didn't define the schema of the dict or table
    // THe only token that exists is the array token.
    if[1 ~ count tokVal; : "table", array];
    
    c    : 0N 2#-1_tokVal;                      // Delete the last token. i.e array
    // Drop `column token by overiding it with its value
    columns: c[;0;1;1];
    
    // Join all the column names who have a `keyedColumn token and wrap them in []
    keyedColumns: "" sv (enlist "[" ;" " sv columns where `keyedColumn = c[;0;0]; "] ");
    
    // Recursive function call to get the base type of the column
    vals: (types.out.qd[settings; typedef; ] enlist@) each c[;1];
    // Join closing parenthesis to the last item. Do a recurssive fn call until the last item is a list of strings
    types.i.z.m.qd.fn: {$[10h ~ type x[-1+count x]; [x[-1+count x] ,: ")"; :x]; [x[-1+count x]: types.i.z.m.qd.fn[x[-1+count x]]; :x ] ]};
    vals: types.i.z.m.qd.fn[vals];
        
    : "table (",keyedColumns,("; " sv ": " sv/: flip (columns; vals)), array;
    }
 
// n: first first 1_first .z.m.qd.types.parse "(int; char)[]";
// n: first first 1_first .z.m.qd.types.parse "(table (x:int); dict(y:char); int; dict(y:char))";
.z.m.qd.types.i.z.m.qd.tuple:{[settings; typedef; n]
        
    val: first 1_n;
    array: types.out.qd[settings; typedef] enlist last val;
    tys: types.out.qd[settings; typedef] each enlist each -1_val;
    
    // Display each type on a new line if any of the types is a compound type (dict or table)
    : $[any tys like "*&nbsp*";
        "(" , ("; <br>" sv tys) , ")",array;
        "(" , ("; " sv tys) , ")",array
        ];
    }

// n: first first 1_first .z.m.qd.types.parse "#.z.m.qd.settings";
// typedef: .z.m.qd.typedefs.get @[;`onLoads] lib.build.input[data.SETTINGS] i.getArtifacts[];

.z.m.qd.types.i.z.m.qd.typedef:{[settings; typedef; n]
    val  : first 1_n;
    name : first val[;1];
    array: types.out.qd[settings; typedef] enlist val[1]; 
    args : (types.out.qd[settings; typedef;] enlist@) each last val[;1];
    
    // Ensure this check is performed before tdef check in order to allow bypassing 
    // typedef resolution
    if[.z.m.axq.isEmpty typedef;
        : $[.z.m.axq.isEmpty args; name, array; " " sv (name, array;" " sv args)]];
    
    // Get the the only typedef out of the table which is relevant to this pass
    t:  types.i.check.tdef[typedef; name; args];
    
    // Check for tdef errors before even if typedefs are documented separately
    if[settings`doctypedef;
        : $[.z.m.axq.isEmpty args; name, array; " " sv (name, array;" " sv args)]
        ];
    
    argDict: ("%" ,/: t[`paramName])!args;
    
    ty: {ssr[y; z; x @ z]}[argDict] over enlist[t[`qType], array], key argDict;
    
    // Only try and parse and resolve (nested typedefs) the qType if it doesn't already have parse errors.
    // If an error exist, use the syntactically inccorect qType as the syntax error 
    // should have already been logged
    : $[.z.m.axq.isEmpty t`error;
        types.out.qd[settings;typedef] types.parse ty;
        ty]
    }
// @fileOverview Resolve the qd type to js output type

// @param tdefs     {#typedefs.tdefs}
// @param ref       {string}    Fully qualified name of the function 
// @param ioTag     {#ioTag}

// @return {dict (rType: string; warning: #errorD)} A dictionary of resolved type and warning. Warning dictionary will always be empty. 
.z.m.qd.types.i.resolve.js:{[tdefs; ref; ioTag]
    if[.z.m.axq.isEmpty ioTag`Type; 
        ioTag[`Type]: (ioTag[`Type]; types.i.js.td);
        : `ioTag`warning!(ioTag; data.ERROR) 
        ];
    
    // Note: For both parsing and resolution it throws an error instead of logging a console message
    // So, we would always return an empty warning table just to match the expected schema.
    
    // Parse the tag type. Return the tag without resolving if the parser fails to parse
    parsed: @[types.parse; 
                ioTag`Type; 
                {[name; Type; x] '"Error: (", name, ") ", x, " --> ",Type}[.z.m.axq.asString ref; ioTag`Type]
                ];
    
    // Overide type by resolving the parsed tag type. Return the tag without overiding the type 
    // if the typedef couldn't be resolved
    resolvedType: .[types.out.js; 
                        (tdefs; parsed); 
                        {[name; Type; x] '"Error: (", name, ") ", x, " --> ",Type}[.z.m.axq.asString ref; ioTag`Type]
                        ];
    
    : `ioTag`warning!(update Type:resolvedType from ioTag; data.ERROR)
    }
// @fileOverview Resolve the qd type to bct output type

// @param tdefs     {#typedefs.tdefs}
// @param ref       {string}    Fully qualified name of the function 
// @param ioTag     {#ioTag}

// @return {dict (rType: string; warning: #errorD)} A dictionary of resolved type and warning. Warning dictionary will always be empty. 

.z.m.qd.types.i.resolve.q:{[tdefs; ref; ioTag]
    if[.z.m.axq.isEmpty ioTag`Type; : `ioTag`warning!(ioTag; data.ERROR)];

    // Note: For both parsing and resolution it throws an error instead of logging a console message
    // So, we would always return an empty warning table just to match the expected schema.
    
    // Parse the tag type. Return the tag without resolving if the parser fails to parse
    parsed: @[types.parse; 
                ioTag`Type; 
                {[name; Type; x] '"Error: (", name, ") ", x, " --> ",Type}[.z.m.axq.asString ref; ioTag`Type]
                ];
    
    // Overide type by resolving the parsed tag type. Return the tag without overiding the type 
    // if the typedef couldn't be resolved
    resolvedType: .[types.out.q; 
                        (tdefs; parsed); 
                        {[name; Type; x] '"Error: (", name, ") ", x, " --> ",Type}[.z.m.axq.asString ref; ioTag`Type]
                        ];
    
    : `ioTag`warning!(update Type:resolvedType from ioTag; data.ERROR)
    }
// @fileOverview Resolve the qd type to qd output type

// @param tdefs     {#typedefs.tdefs}
// @param ref       {string}    Fully qualified name of the function 
// @param ioTag     {#ioTag}

// @return {dict (rType: string; warning: #errorD)} A dictionary of resolved type and warning

.z.m.qd.types.i.resolve.qd:{[settings; tdefs; ref; ioTag]
    if[.z.m.axq.isEmpty ioTag`Type; : `ioTag`warning!(ioTag; data.ERROR)];
    
    // Parse the tag type. Return the tag without resolving if the parser fails to parse
    // parsed will contain a table of warning if it fails to parse the type
    parsed: @[types.parse;
        ioTag`Type; 
        {[name; Type; msg]
            : flip (cols data.ERROR)!enlist each (.z.m.axq.asSymbol name; enlist Type; `PARSE_ERROR; enlist msg)
            }[ref; ioTag`Type]];
    
    if[.z.m.axq.isTable parsed; : `ioTag`warning!(ioTag; parsed)];
    
    // Overide type by resolving the parsed tag type. Return the tag without overiding the type 
    // if the typedef couldn't be resolved
    // resolved will contain a table of warning if it fails to resolve the parse tree
    resolved: .[types.out.qd; 
        (settings; tdefs; parsed); 
        {[name; parsed; Type; msg]
            // Try to bypass reolution errors and pretty-print the type
            ty: .[types.out.qd; (``doctypedef!11b; (); parsed); Type];
            : flip (cols data.ERROR)!enlist each (.z.m.axq.asSymbol name; enlist ty; `RESOLUTION_ERROR; enlist msg)
            }[ref; parsed; ioTag`Type]];
    
    : $[.z.m.axq.isTable resolved; 
            `ioTag`warning!(update Type:first first resolved`qdType from ioTag; resolved); 
            `ioTag`warning!(update Type:resolved from ioTag; data.ERROR)];
    }

// ioTag: `Tag`Name`Type`Description!(`param;"test"; "table"; "This is test");
// ioTag: `Tag`Name`Type`Description!(`param;"test"; "table (x: int; y: string)"; "This is test");
// ioTag: `Tag`Name`Type`Description!(`param;"test"; "table (x: dict (x: int; y:dict(r:int)); y: string)"; "This is test");
// {(table(x:int)) | dict(x: int)}
// ref: catD`ref;
.z.m.qd.types.i.resolve.t:{[settings; tdefs; ref; ioTag]
    
    if[.z.m.axq.isEmpty ioTag`Type; : `ioTag`warning!(enlist ioTag; data.ERROR)];
    
    if[not ioTag[`Tag] in `param`return`returns`type; : `ioTag`warning!(enlist ioTag; data.ERROR)];
    
    // Parse the tag type. Return the tag without resolving if the parser fails to parse
    // parsed will contain a table of warning if it fails to parse the type
    parsed: @[types.parse; 
        ioTag`Type; 
        {[name; Type; msg]
            : flip (cols data.ERROR)!enlist each (.z.m.axq.asSymbol name; enlist Type; `PARSE_ERROR; enlist msg)
            }[ref; ioTag`Type]];
    
    if[.z.m.axq.isTable parsed; : `ioTag`warning!(enlist ioTag; parsed)];

    // Overide type by resolving the parsed tag type. Return the tag without overiding the type 
    // if the typedef couldn't be resolved
    // resolvedType will contain a table of warning if it fails to resolve the parse tree
    tt: flip (key ioTag)!(count key ioTag)#();
    resolved: .[types.out.table; 
        (settings; tdefs; tt; ioTag; parsed); 
        {[name; parsed; Type; msg]
            // Try to bypass reolution errors and pretty-print the type
            ty: .[types.out.qd; (``doctypedef!11b; (); parsed); Type];
            : flip (cols data.ERROR)!enlist each (.z.m.axq.asSymbol name; enlist ty; `RESOLUTION_ERROR; enlist msg)
            }[ref; parsed; ioTag`Type]];

    : $[(cols resolved) ~ cols data.ERROR;        
            `ioTag`warning!(enlist update Type:first first resolved`qdType from ioTag; resolved); 
            `ioTag`warning!(distinct resolved; data.ERROR)];
    }

// tok: first first 1_first .z.m.qd.types.parse "dict";
// tok: first first 1_first .z.m.qd.types.parse "dict ()";
// tok: first first 1_first .z.m.qd.types.parse "dict (x: int)";
// tok: first first 1_first .z.m.qd.types.parse "dict (x: table (x: int); y: string)";
.z.m.qd.types.i.t.dict:{[settings; tdefs; tt; ioTag; tok]
    
    tokVal: first 1_tok;
    array: types.out.qd[settings; tdefs] enlist last tokVal; 
    ioTag[`Type]: "dict", array;
    
    // Add "<return>" as the name incase it is missing
    if[.z.m.axq.isEmpty ioTag[`Name]; ioTag[`Name]: "<",(.z.m.axq.asString ioTag[`Tag]),">"]; 
    
    // Return if the user didn't define the schema of the dict or table
    // The only token that exists is the array token.
    if[1 ~ count tokVal; : enlist ioTag];
    
    c    : 0N 2#-1_tokVal;                      // Delete the last token. i.e array
    repeatable: `repeatable = c[;0;1;0]; 
    columns: repeatable {$[x; "<",y,">"; y]}' c[;0;1;1];
   
    Names: (ioTag[`Name],"."),/:columns;
    Description: {$[x; "Repeatable; "; ""]} each repeatable; 
    Tags: (count Names)#ioTag[`Tag];
    Types: (count Names)#enlist "";
    Required: (count Names)#1b;
    Default: (count Names)#enlist "";
    Typedefs: (count Names)#enlist ioTag`Typedefs;
    
    temp: flip (key ioTag)!(Tags; Names; Types; Description; Required; Default; Typedefs);

    tt: raze temp types.out.table[settings; tdefs; tt] ' enlist each c[;1];
    
    : ioTag, tt
    }

// @fileOverview Enter a description here...
// @returns {Type} Enter a return description here...
.z.m.qd.types.i.t.option:{[settings; tdefs; tt; ioTag; tok]
    
    val: first 1_tok;
    : $[1 ~ count val;
        types.out.table[settings; tdefs; tt; ioTag; val];
        [
            ioTag[`Type]: " | " sv (types.out.qd[settings; tdefs]  enlist@) each val; 
            ioTag[`Typedefs],: "#",/: string .z.m.qd.typedefs.extractNames tok;
            tt, ioTag
            ]
        ]
    }

.z.m.qd.types.i.t.other:{[settings; tdefs; tt; ioTag; tok]
    
    ioTag[`Type]: types.out.qd[settings; tdefs; enlist tok];
    ioTag[`Typedefs],: "#",/: string .z.m.qd.typedefs.extractNames tok;
    : tt, ioTag
    }

// tok: first first 1_first .z.m.qd.types.parse "table";
// tok: first first 1_first .z.m.qd.types.parse "table ()";
// tok: first first 1_first .z.m.qd.types.parse "table (x: int)";
// tok: first first 1_first .z.m.qd.types.parse "table (x: dict (x: int); y: string)";
// tok: first first 1_first .z.m.qd.types.parse "table ([] t: int)";
// tok: first first 1_first .z.m.qd.types.parse "table ( [ x: int] t: int)";
// tok: first first 1_first .z.m.qd.types.parse "table ([x: int; y: dict()] t: int; u: table())";
.z.m.qd.types.i.t.table:{[settings; tdefs; tt; ioTag; tok]
    
    tokVal: first 1_tok;
    array: types.out.qd[settings; tdefs] enlist last tokVal; 
    ioTag[`Type]: "table", array;
    
    // Add "<return>" as the name incase it is missing
    if[.z.m.axq.isEmpty ioTag[`Name]; ioTag[`Name]: "<",(.z.m.axq.asString ioTag[`Tag]),">"]; 
    
    // Return if the user didn't define the schema of the dict or table
    // The only token that exists is the array token.
    if[1 ~ count tokVal; : enlist ioTag];
    
    c    : 0N 2#-1_tokVal;                      // Delete the last token. i.e array
    repeatable: `repeatable = c[;0;1;0]; 
    columns: repeatable {$[x; "<",y,">"; y]}' c[;0;1;1];
    
    // Join all the column names who have a `keyedColumn token and wrap them in []
    keyedColumns: " " sv columns where `keyedColumn = c[;0;0];
    if[not .z.m.axq.isEmpty keyedColumns; 
        ioTag[`Type],:"" sv (" [" ;keyedColumns; enlist "]")
        ];
    
    Names: (ioTag[`Name],"."),/:columns;
    Description: {$[x; "Repeatable; "; ""]} each repeatable; 
    Tags: (count Names)#ioTag[`Tag];
    Types: (count Names)#enlist "";
    Required: (count Names)#1b;
    Default: (count Names)#enlist "";
    Typedefs: (count Names)#enlist ioTag`Typedefs;
    
    temp: flip (key ioTag)!(Tags; Names; Types; Description; Required; Default; Typedefs);

    tt: raze temp types.out.table[settings;tdefs; tt] ' enlist each c[;1];
    
    : ioTag, tt
    }

// tok: first first 1_first .z.m.qd.types.parse "#.z.m.qd.items";
.z.m.qd.types.i.t.typedef:{[settings; tdefs; tt; ioTag; tok]
    
    val  : first 1_tok;
    name : first val[;1];
    array: types.out.qd[settings; tdefs] enlist val[1]; 
    
    args:(types.out.qd[settings; tdefs;] enlist@) each last val[;1];
    
    if[.z.m.axq.isEmpty tdefs;
        ioTag[`Type]: $[.z.m.axq.isEmpty args; name, array; " " sv (name, array;" " sv args)];
        : enlist ioTag];
    
    // Extract tdefs out of the table which is relevant to this pass
    // Throws an error if it can't find a tdef
    t: types.i.check.tdef[tdefs; name; args];
    
    // Check for tdef errors before even if typedefs are documented separately
    if[settings`doctypedef;
        ioTag[`Type]: $[.z.m.axq.isEmpty args; name, array; " " sv (name, array;" " sv args)];
        ioTag[`Typedefs],: enlist name;
        : enlist ioTag
        ];

    // Update the name of the description tags associated with the typedef being resolved
    ioName: $[.z.m.axq.isEmpty ioTag[`Name]; "<",(.z.m.axq.asString ioTag`Tag),">"; ioTag`Name];
    tt: (update Name: ssr[; 1_name; ioName] each Name from t`descs), tt;

    argDict: ("%" ,/: t[`paramName])!args;
    
    t[`qType]: {ssr[y; z; x @ z]}[argDict] over enlist[t`qType], key argDict;
    
    // Only parse and resolve the qType if it doesn't already have parse errors.
    // If an error exist, use the syntactically inccorect qType as the syntax error 
    // should have already been logged
    : $[.z.m.axq.isEmpty t`error;
        types.out.table[settings; tdefs; tt; ioTag] types.parse t[`qType], array;
        enlist ioTag];
    }

// Takes a type and removes indentation and new line
// ty: "dict (<br>&nbsp;&nbsp;&nbsp;&nbsp;x: int;<br>&nbsp;&nbsp;&nbsp;&nbsp;y: char )"
.z.m.qd.types.i.unindent:{[ty]
    : "" sv "&nbsp;" vs "" sv "<br>" vs ty
    }

.z.m.qd.types.isDict:{ 
    : $[0b ~ @[.z.m.axpc.prs[.z.m.qd.types.dict]; x; 0b]; 0b; 1b]
    }
.z.m.qd.types.isTable:{ 
    : $[0b ~ @[.z.m.axpc.prs[.z.m.qd.types.table]; x; 0b]; 0b; 1b]
    }

.z.m.qd.types.map:{[frm; to; ty]
    
    frm: .z.m.axq.asSymbol frm;
    to: .z.m.axq.asSymbol to;
    ty: .z.m.axq.asSymbol lower ty;

    if[not frm in cols types.MAP;
        '"invalid 'from' parameter"];
    
    if[not to in cols types.MAP;
        '"invalid 'to' parameter"];
    
    c: (enlist (=; (lower; frm); `ty));
    : first ?[types.MAP;c;();to]
    }
.z.m.qd.types.out.js:{[typedef; n]
    tok:first n;
    k:first tok;
    : $[`array          ~ k; types.i.js.array tok;
        `atom           ~ k; types.i.js.atom[typedef; tok];
        `dict           ~ k; types.i.js.dict[typedef; tok];
        `enum           ~ k; types.i.js.enum[typedef; tok];
        `fn             ~ k; types.i.js.func[typedef; tok];
        `option         ~ k; types.i.js.option[typedef; tok];
        `table          ~ k; types.i.js.table[typedef; tok];
        `tuple          ~ k; types.i.js.tuple[typedef; tok];
        `typedef        ~ k; types.i.js.typedef[typedef; tok];
        `typedefParam   ~ k; {first 1_x}tok;
        '`nyi];
    }

// n: .z.m.qd.types.parse "int";
.z.m.qd.types.out.q:{[typedef; n]
    : types.i.out.q[``pad!0 0; typedef; n]
    }

// // Atom      -->
//                  n: .z.m.qd.types.parse "int";
// // Array     -->
//                  n: .z.m.qd.types.parse "int[]";
// // Option    -->
//                  n: .z.m.qd.types.parse "symbol | table (col1: int; col2: char)";
// // Fn        --> 
//                  n: .z.m.qd.types.parse "fn (dict (any:any)) -> #.testMod.myType any int"
// // Table     -->
//                  n: .z.m.qd.types.parse "table (col1: int; col2: char)";
// // Dict      -->
//                  n: .z.m.qd.types.parse "dict (col1: int; col2: char)";
// // Typedef   -->
//                  n: .z.m.qd.types.parse "table (col1: #.testMod.myType int[] char; col2: char)";

// typedef: flip `ref`alias`qType`description`paramCount`paramName!
//  (enlist ".testMod.myType"; enlist "myType a b"; enlist "dict (fir: #a; sec: #b)"; 
//  enlist ""; enlist 2;  enlist ( enlist "a"; enlist "b"));

.z.m.qd.types.out.qd:{[settings; typedef; n]
    tok:first n;
    k:first tok;
    : $[`ignore         ~ k; types.i.z.m.qd.ignore tok;
        `array          ~ k; types.i.z.m.qd.array tok;
        `atom           ~ k; types.i.z.m.qd.atom[settings; typedef; tok];
        `dict           ~ k; types.i.z.m.qd.dict[settings; typedef; tok];
        `enum           ~ k; types.i.z.m.qd.enum[settings; typedef; tok];
        `fn             ~ k; types.i.z.m.qd.func[settings; typedef; tok];
        `option         ~ k; types.i.z.m.qd.option[settings; typedef; tok];
        `table          ~ k; types.i.z.m.qd.table[settings; typedef; tok];
        `tuple          ~ k; types.i.z.m.qd.tuple[settings; typedef; tok];
        `typedef        ~ k; types.i.z.m.qd.typedef[settings; typedef; tok];
        `typedefParam   ~ k; {first 1_x}tok;
        '`nyi];
    }
// tdefs: .z.m.qd.typedefs.get[""];
// tt: flip `Tag`Name`Type`Description!4#();       // table to store running types in recurssive call
// ioTag: `Tag`Name`Type`Description!(`param;"test"; "#.z.m.qd.random"; "This is test");
// n: .z.m.qd.types.parse "int | dict(x: #.any) ";
// n: .z.m.qd.types.parse "#.z.m.qd.random dict(x: #.any) ";
.z.m.qd.types.out.table:{[settings; tdefs; tt; ioTag; n]
    
    tok: first n;
    k: first tok;
    
    : $[`table          ~ k; types.i.t.table[settings; tdefs; tt; ioTag; tok];
        `dict           ~ k; types.i.t.dict[settings; tdefs; tt; ioTag; tok];
        `typedef        ~ k; types.i.t.typedef[settings; tdefs; tt; ioTag; tok];
        `option         ~ k; types.i.t.option[settings; tdefs; tt; ioTag; tok];
        types.i.t.other[settings; tdefs; tt; ioTag; tok]
        ]
    }

.z.m.qd.types.parse:{[typ]
    : .z.m.axpc.prs[types.parser] typ
    }

// @fileOverview Resolve the qd type to the specfied format

// @param settings  {#settings} 
// @param tdefs     {#typedefs.tdefs}
// @param catD      {#catD} 
// @param ioTag     {#ioTag}

// @returns {(#ioTag; #errorD)}
// resolveTo:`table
// .z.m.qd.types.resolve[resolveTo; tdefs; catD; ioTag]
.z.m.qd.types.resolve:{[settings; tdefs; catD; ioTag]
    
    if[any "#" =/: ioTag`Type; 
        ioTag: typedefs.fq[catD; ioTag];
        ioTag: typedefs.appendDescription[tdefs; catD; ioTag]
        ];
     
    : $[`qd     ~ settings`resolve; types.i.resolve.qd[settings; tdefs; catD`ref; ioTag];
        `q      ~ settings`resolve; types.i.resolve.q[tdefs; catD`ref; ioTag];
        `js     ~ settings`resolve; types.i.resolve.js[tdefs; catD`ref; ioTag];
        `table  ~ settings`resolve; types.i.resolve.t[settings; tdefs; catD`ref; ioTag];
        '"type resolution to '", (string settings`resolve),"' is not supported"
        ];
    }

.z.m.qd.types.i.special:flip `qd`ctrl`js!
     flip  ((`null      ;   `NullType   ;   `null);
            (`number    ;   `Integer    ;   `number);
            (`type      ;   `NullType   ;   `null);
            (`any       ;   `NullType   ;   `$"*");
            (`$"*"      ;   `NullType   ;   `$"*"));
.z.m.qd.types.i.ctrl:flip `qd`ctrl`js!
     flip  ((`CTRL_Config       ;   `Config     ;   `null);
            (`CTRL_Email        ;   `Email      ;   `string);
            (`CTRL_Instruction  ;   `Instruction;   `string));
.z.m.qd.types.i.compound:flip `qd`ctrl`js!
     flip  ((`dict      ;   `Dict       ;   `Object);
            (`dictionary;   `Dict       ;   `Object);
            (`fn        ;   `NullType   ;   `undefined);
            (`function  ;   `NullType   ;   `undefined);
            (`table     ;   `Table      ;   `$"Object[]"));
.z.m.qd.types.i.atoms:flip `qd`ctrl`js!
     flip  ((`bool      ;   `Boolean    ;   `boolean);
            (`boolean   ;   `Boolean    ;   `boolean);
            (`byte      ;   `Byte       ;   `number);
            (`char      ;   `Character  ;   `string);
            (`character ;   `Character  ;   `string);
            (`date      ;   `Date       ;   `Date);
            (`datetime  ;   `Datetime   ;   `Date);
            (`float     ;   `Float      ;   `number);
            (`guid      ;   `Guid       ;   `string);
            (`int       ;   `Integer    ;   `number);
            (`integer   ;   `Integer    ;   `number);
            (`long      ;   `Long       ;   `number);
            (`minute    ;   `Minute     ;   `Date);
            (`month     ;   `Month      ;   `Date);
            (`real      ;   `Real       ;   `number);
            (`second    ;   `Second     ;   `Date);
            (`short     ;   `Short      ;   `number);
            (`string    ;   `String     ;   `string);
            (`symbol    ;   `Symbol     ;   `string);
            (`time      ;   `Time       ;   `Date);
            (`timespan  ;   `Timespan   ;   `Date);
            (`timestamp ;   `Timestamp  ;   `Date);
            (`code      ;   `NullType   ;   `undefined);
            (`foreign   ;   `NullType   ;   `undefined));
.z.m.qd.types.i.array:flip `qd`ctrl`js! flip `$0N 3#(
    "bool[]"       ; "Boolean[]"   ; "boolean[]"    ;
    "boolean[]"    ; "Boolean[]"   ; "boolean[]"    ;
    "byte[]"       ; "Byte[]"      ; "number[]"     ;
    "char[]"       ; "String"      ; "string[]"     ;
    "character[]"  ; "String"      ; "string[]"     ;
    "date[]"       ; "Date[]"      ; "Date[]"       ;
    "datetime[]"   ; "Datetime[]"  ; "Date[]"       ;
    "float[]"      ; "Float[]"     ; "number[]"     ;
    "guid[]"       ; "NullType"    ; "string[]"     ;
    "int[]"        ; "Integer[]"   ; "number[]"     ;
    "integer[]"    ; "Integer[]"   ; "number[]"     ;
    "long[]"       ; "Long[]"      ; "number[]"     ;
    "minute[]"     ; "Minute[]"    ; "Date[]"       ;
    "month[]"      ; "Month[]"     ; "Date[]"       ;
    "real[]"       ; "Real[]"      ; "number[]"     ;
    "second[]"     ; "Second[]"    ; "Date[]"       ;
    "short[]"      ; "Short[]"     ; "number[]"     ;
    "string[]"     ; "String[]"    ; "string[]"     ;
    "symbol[]"     ; "Symbol[]"    ; "string[]"     ;
    "time[]"       ; "Time[]"      ; "Date[]"       ;
    "timespan[]"   ; "Timespan[]"  ; "Date[]"       ;
    "timestamp[]"  ; "Timestamp[]" ; "Date[]"       ;
    "dict[]"       ; "Table"       ; "Object[]"     ;
    "dictionary[]" ; "Table"       ; "Object[]"     ;
    "fn[]"         ; "NullType"    ; "undefined"    ;
    "function[]"   ; "NullType"    ; "undefined"    ;
    "table[]"      ; "NullType"    ; "Object[][]"   ;
    "null[]"       ; "NullType"    ; "null"         ;
    "number[]"     ; "Integer[]"   ; "number[]"     ;
    "type[]"       ; "NullType"    ; "null"         ;
    "any[]"        ; "NullType"    ; "Array"        ;
    "*[]"          ; "NullType"    ; "Array"
    );
.z.m.qd.types.MAP:types.i.atoms, types.i.special, types.i.compound, types.i.ctrl, .z.m.qd.types.i.array
.z.m.qd.types.i.js.td:flip `tdef`header`names`types!("";"";();())
.z.m.qd.types.i.indent:"&nbsp;&nbsp;&nbsp;&nbsp;"
// @qlintsuppress UNUSED_INTERNAL(1)
.z.m.qd.types.i.grammar:types.identifier    :   .z.m.axpc.seq (
                            .z.m.axpc.a[{$[.z.m.axq.isEmpty x; `; `repeatable]}] .z.m.axpc.optional .z.m.axpc.ws .z.m.axpc.str "...";
                            .z.m.axpc.a[enlist ].z.m.axpc.many1 .z.m.axpc.anyOf ".",.Q.an);


types.arrayParser   :   .z.m.axpc.a[{enlist `array,count where `array~/:x}] 
                            .z.m.axpc.many .z.m.axpc.a[`array,] .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "[]";


types.atoms         :   l idesc count each l: string each types.i.atoms[`qd], types.i.special[`qd], types.i.ctrl[`qd];
types.atomParsers   :   .z.m.axpc.tok[`atom] .z.m.axpc.seq (
                            .z.m.axpc.oneOf .z.m.axpc.try each .z.m.axpc.tok[`atom] @' .z.m.axpc.casestr each types.atoms;
                            types.arrayParser);


// Parser for global typedefs. These could contain non native q types
types.g.tdefsParsers:  .z.m.axpc.tok[`atom] .z.m.axpc.seq (
                            .z.m.axpc.oneOf .z.m.axpc.try each .z.m.axpc.tok[`atom] @' .z.m.axpc.casestr each .z.m.qd.typedefs.global[][`qType];
                            types.arrayParser);


// Delete it once the Aaron fixes the old syntax in all the ctrlui functions
types.wrapped       :   .z.m.axpc.seq (
                            .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "{";
                            .z.m.axpc.delay `.z.m.qd.types.parser;
                            .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "}";
                            .z.m.axpc.ignore .z.m.axpc.many .z.m.axpc.anyOf " ",.Q.an);


types.enum          :   .z.m.axpc.tok[`enum] .z.m.axpc.seq (
                            .z.m.axpc.ignore .z.m.axpc.str "$";
                            .z.m.axpc.delay `.z.m.qd.types.parser);


types.tuple         :   .z.m.axpc.tok[`tuple] .z.m.axpc.seq (
                            .z.m.axpc.ws .z.m.axpc.between[
                                .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "(";
                                .z.m.axpc.optional .z.m.axpc.sepBy[
                                    .z.m.axpc.ws .z.m.axpc.delay `.z.m.qd.types.parser; 
                                    .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ";"];
                                .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ")"];
                            types.arrayParser);


types.kvParser      :   {[tok]
                            : .z.m.axpc.sepBy[
                                .z.m.axpc.seq (
                                    .z.m.axpc.ws .z.m.axpc.tok[tok] types.identifier;
                                    .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ":"; 
                                    .z.m.axpc.ws .z.m.axpc.delay `.z.m.qd.types.parser);
                                .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ";"]};


types.keyedTable    :    .z.m.axpc.between[
                            .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "[";
                            .z.m.axpc.optional types.kvParser[`keyedColumn];
                            .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "]"];


types.tableParser    :   .z.m.axpc.seq (
                            .z.m.axpc.optional .z.m.axpc.ws .z.m.axpc.between[
                                .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "(";
                                .z.m.axpc.seq (
                                    .z.m.axpc.optional types.keyedTable;
                                    .z.m.axpc.optional types.kvParser[`column]);
                                .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ")"];
                            .z.m.axpc.optional types.arrayParser);


types.dictParser    :   .z.m.axpc.seq (
                            .z.m.axpc.optional .z.m.axpc.ws .z.m.axpc.between[
                                .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "(";
                                .z.m.axpc.optional types.kvParser[`column];
                                .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ")"];
                            .z.m.axpc.optional types.arrayParser);


types.table         :   .z.m.axpc.tok[`table] .z.m.axpc.seq (
                            .z.m.axpc.ignore .z.m.axpc.casestr "table";
                            .z.m.axpc.optional types.tableParser);    
   

types.dict          :   .z.m.axpc.tok[`dict] .z.m.axpc.seq (
                            .z.m.axpc.ignore .z.m.axpc.oneOf (
                                .z.m.axpc.casestr "dictionary";
                                .z.m.axpc.casestr "dict");
                            .z.m.axpc.optional types.dictParser);


types.func          :   .z.m.axpc.tok[`fn] .z.m.axpc.seq (
                            .z.m.axpc.ignore .z.m.axpc.oneOf (
                                .z.m.axpc.casestr "function";
                                .z.m.axpc.casestr "fn");
                            types.arrayParser;
                            .z.m.axpc.optional .z.m.axpc.seq (
                                .z.m.axpc.ws .z.m.axpc.between[
                                    .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "(";
                                    .z.m.axpc.optional .z.m.axpc.sepBy[
                                        .z.m.axpc.tok[`param] .z.m.axpc.delay `.z.m.qd.types.parser; 
                                        .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ";"];
                                    .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ")"];
                                .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.oneOf (.z.m.axpc.str "->"; .z.m.axpc.casestr "&rarr;");
                                .z.m.axpc.tok[`return] .z.m.axpc.delay `.z.m.qd.types.parser));


types.tdef          :   .z.m.axpc.tok[`typedef] .z.m.axpc.seq (
                            .z.m.axpc.tok[`name]  .z.m.axpc.seq ( 
                                .z.m.axpc.str "#"; 
                                .z.m.axpc.many1 .z.m.axpc.anyOf ".",.Q.an); 
                            types.arrayParser;
                            .z.m.axpc.ws .z.m.axpc.tok[`arg] .z.m.axpc.many .z.m.axpc.ws .z.m.axpc.oneOf (
                                .z.m.axpc.try .z.m.axpc.between [
                                    .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str "<";
                                    .z.m.axpc.delay `.z.m.qd.types.parser;
                                    .z.m.axpc.ignore .z.m.axpc.ws .z.m.axpc.str ">"];
                                .z.m.axpc.delay `.z.m.qd.types.parser));

types.tdefParam     :  .z.m.axpc.tok[`typedefParam] .z.m.axpc.seq (
                                .z.m.axpc.str "%";
                                .z.m.axpc.many1 .z.m.axpc.anyOf ".",.Q.an); 

types.all           :   .z.m.axpc.seq(
                            .z.m.axpc.oneOf (
                                types.tdef; 
                                types.tdefParam;
                                types.wrapped;
                                types.enum;
                                types.tuple; 
                                types.dict; 
                                types.table; 
                                types.func;
                                types.g.tdefsParsers; 
                                types.atomParsers);
                            .z.m.axpc.ws[]);


types.parser: {[state] .z.m.axpc.oneOf[(.z.m.axpc.tok[`option] .z.m.axpc.sepBy[.z.m.axpc.ws types.all; .z.m.axpc.ch "|"]; types.all)] state};
.z.m.qd.types.ALL:types.MAP[`qd], (.z.m.axq.asSymbol "#" ,/: typedefs.global[][`alias])
.z.m.qd.types.onLoad:{[]
    
    // @typedef resolveTo       {symbol} A symbol indicating what should the qd type be resolved to (`q, `js, `qd)
    }

.z.m.qd.types.onLoad[];
system "d .z.m";

system "d .z.m.axdatatype";
// @fileOverview
// Create a new datatype
// @param name {symbol}
// @param ks {symbol[]}
// @param ms {symbol[]}
// @returns {symbol}
.z.m.axdatatype.create:{[name; ks; ms]
    if[0b ~ @[get; name; 0b];
        name set enlist[`]!enlist (::);
        ];
    
    : i.new [name; `symbol$(); ks; ms];
    }

// @fileOverview 
// Extend a datatype with new field
// @example
//
//      .z.m.axdatatype.create[`.my.a; `a`b`c; `a`b];
//      .z.m.axdatatype.extend[`.my.b; `d`e; enlist `e; `.my.a];
//
//      item : .my.b.new 1 2 3 4 5
//      .my.b.is item;
//      .my.a.is item;
//      item : .my.b.with.a[0] .my.b.with.e[0] item;
//
// @param name {symbol} new datatype name
// @param ks {symbol[]} fields 
// @param ms {symbol[]} mutators
// @param oldname {symbol} datatype to inherit from
// @returns {symbol} 
.z.m.axdatatype.extend:{[name; ks; ms; oldname]
    if[0b ~ @[get; name; 0b];
        name set enlist[`]!enlist (::);
        ];
    
    : i.extend [name; ks; ms; oldname];
    }

// @fileOverview
// Extend a datatype from a namespace
// @param name {symbol}
// @param ks {symbol[]}
// @param ms {symbol[]}
// @param oldname {symbol}
// @returns {symbol}
// @see axdatatype.extend
// @deprecated
.z.m.axdatatype.extendFrom:{[name; ks; ms; oldname]
    // @qlintsuppress DEBUG_FUNCTION(1)
    show "Deprecated invocation of .z.m.axdatatype.extendFrom - Please use .z.m.axdatatype.extend"; 
    : extend[name; ks; ms; oldname];
    }

// @deprecated
// @fileOverview
// Create a new datatype from a namespace
// @param name {symbol}
// @param ks {symbol[]}
// @param ms {symbol[]}
// @returns {symbol}
.z.m.axdatatype.from:{[name; ks; ms]
    // @qlintsuppress DEBUG_FUNCTION(1)
    show "Deprecated invocation of .z.m.axdatatype.from - Please use .z.m.axdatatype.create";
    : create[name; ks; ms];
    }

// @fileOverview
// Extend a datatype
// @param name {symbol}
// @param ks {symbol[]}
// @param ms {symbol[]}
// @param oldname {symbol}
// @returns {symbol}
.z.m.axdatatype.i.extend:{[name; ks; ms; oldname]
    
    if [any ks in\: value[oldname][`i][`ks];
        '"Extender cannot use any fields of the extended"]; /dnl
    
    ks : value[oldname][`i][`ks] union ks;
    ms : value[oldname][`i][`ms] union ms;
    ps : oldname , value[oldname][`i][`ps];
    
    // want to inherit a,b,c, with.a, with.b, with.c, 
    : i.new [name; ps; ks; ms];
    
    }

// @fileOverview
// Create a new datatype
// @param o {symbol}
// @param ps {symbol[]}
// @param ks {symbol[]}
// @param ms {symbol[]}
// @returns {symbol}
.z.m.axdatatype.i.new:{[o; ps; ks; ms]    
    
    // Ensure mutators are a subset of the fields
    if [not all ms in\: ks; '"Modifier set is not a subset of the fields"]; /dnl
    
    // internal bookeeping
    @[o;`i;:;``type`ps`ks`ms!(::;o;ps;ks;ms)];
    
    // Is Type
    @[o; `is; :;
        {[name; item] 
            if [.z.m.axq.isKeyedTable item; : 0b];
            if [not 99h ~ type item; : 0b];
            if [not `i_.type in key item; : 0b];
            // Is the name of this datatype in the items type or extensions?
            : name in (item `i_.type) , item`i_.extensions;
            }[o]];
    
    // Check Type
    @[o; `check; :;
        {[name; item]
            if [not 99h ~ type item; '"type: expected dictionary"]; /dnl
            if [not `i_.type in key item; '"type: expected ", string name]; /dnl
            : item;
            }[o]];
    
    // Creation
    @[o; `new; :;
        {[ps; name; ks; xs]
            if [count[xs] < count[ks]; '"Not all arguments specified"]; /dnl
            if [count[xs] > count[ks]; '"Too many arguments specified"]; /dnl
            : (`i_.null`i_.type`i_.extensions!(::; name; ps)), ks!xs;
            }[ps; o; ks]];
    
    // Accessors
    {[o;x] @[o;x;:; {[x;item] : item x }[x]]; }[o] each ks;
    
    // Mutators
    mvs : {[o;x]
        : {[x;val;item]
            item[x]:val;
            : item;
            }[x];
        }[o] each ms;
    
    // Inject the mutator subnamespace
    @[o;`with;:;(ms!mvs),(enlist[`]!enlist(::))];
    : o;
    }
system "d .z.m";

system "d .z.m.axutl";
// Inject deps into module
// deps is a dictionary argName!dep
.z.m.axutl.injeqt.i.injeqt:{[deps; moduleSym; targetSym] /moduleSym: `.wsState; deps:d; targetSym: `
    
    fns: k!ms @ k:key[ms] where value 100h = type each ms: get moduleSym;
    fnNames: key[fns] where m:raze any each key[deps] in/: ( value each  fns)[;1]; 
    uninjeqted: key[fns] where not m;

    uninjeqted: uninjeqted!ms @ uninjeqted;
    //Dependencies which are symbols need to be enlisted to they can be put into the parse tree
    symbols: where `symbol = .z.m.axq.typeOf each deps;
    deps[symbols]: enlist each deps[symbols];
    
    injected: {[fns; msym; dep; name] 
        n: last value (;);
        argCount: count value[fns[name]][1]; 
        //Determine which dependencies apply to this function /delete d from `.
        dPosns: (where argCount = d:key[dep]!  i: value[fns[name]][1] ? key[dep] );
        dPosns: dPosns _d;

        // Create a parse tree for the function, binding in the dependency and using
        // special null value to indicate those arguments are not yet provided.
        parseTree: argCount # (::);
        parseTree[value dPosns]: dep  @ key dPosns; 
        parseTree[til[argCount] except value dPosns]: n;
        parseTree:  (enlist `$ "." sv string (msym; name)) , parseTree;
        // @qlintsuppress DEBUG_FUNCTION(1)
        : eval parseTree;
        }[fns; moduleSym; deps;] each fnNames; / name: `b; dep:  deps; msym: moduleSym
    
    //Bind the projected fns to a new namespace for use
    if [ targetSym =`;
            : uninjeqted, (fnNames ! injected)
            ];
    
    (`$ "." sv/: (string targetSym,/: fnNames)) set' injected;
    (`$ "." sv/: (string targetSym,/: key[uninjeqted])) set' value uninjeqted;
    
    : uninjeqted, (fnNames ! injected)
    }
.z.m.axutl.injeqt.injeqt:{[deps; moduleSym; targetSym]
    : injeqt.i.injeqt[ deps; moduleSym; targetSym];
    }

system "d .z.m";

system "d .z.m.axds";
// @fileOverview 
// Add a list of children nodes under
// a given node to a tree
// @param gapi {dict} DAG api 
// @param n {dict} the parent node 
// @param c {dict[]} list of child nodes 
// @param g {table} tree specification
// @returns {table} updated specification
.z.m.axds.tree.inject.add.children:{[gapi; n; c; g]
    gapi[`add][`children][n;c;g]
    }

// @fileOverview 
// Add a new root to an existing tree
// @param gapi {dict} DAG api 
// @param n {dict} the new root 
// @param g {table} tree specification
// @returns {table} updated specification
.z.m.axds.tree.inject.add.root:{[gapi; n; g]
    
    : $[gapi[`empty] g;
        
        // There are no nodes, so just add it
        gapi[`add][`node][n; g];
        
        // Otherwise there are nodes
        [
            root : .z.m.axds.tree.inject.root[gapi; g];
            // Add the edge between the node and the previous root
            gapi[`add][`edge][n; root; g]]];
    
    }

// @fileOverview 
// Return all ancestor nodes from a given node
// in a tree
// @param gapi {dict} DAG api 
// @param n {dict} a node within the tree 
// @param g {table} tree specification
// @returns {table} all ancestors of the node in the tree
.z.m.axds.tree.inject.ancestors:{[gapi; n; g]    
    gapi[`ancestors][n;g]    
    }

// @fileOverview 
// Return all child nodes from a given node in a tree
// @param gapi {dict} DAG api 
// @param n {dict} a node within the tree 
// @param g {table} tree specification
// @returns {table} all children of the node in the tree
.z.m.axds.tree.inject.children:{[gapi; n; g] 
    gapi[`children] [n; g] 
    }
// @category Tree
//
// @fileOverview
// Clones all elements in a Tree to keep the same
// structure and payload with different node id's
//
// @param gapi {dict} 
// @param g {table<tree>} Tree to clone
//
// @returns {table<tree>} Cloned tree
.z.m.axds.tree.inject.clone:{[gapi; g]
    : gapi[`clone] g
    }
// @category Tree
// 
// @fileOverview 
// Connect multiple trees as children of the given node
// in a new tree
//
// @param gapi {dict} 
// @param r         {dict<tree.node>}   New root 
// @param treelist  {table[]}           List of tree specifications
//
// @returns {table<tree>} Merged tree specification
.z.m.axds.tree.inject.connect:{[gapi; r; treelist]
    
    // If there are no trees to join then short circuit 
    // and return the root as a tree
    if[0 ~ count treelist;
        : enlist r];
    
    // Join the tables into a main table
    g: raze treelist;
    
    // Capture the source nodes
    s: gapi[`sources] g;
    
    // Update the new root to have all the old sources as children
    r: gapi[`node][`with][`children] [s`id; r];    
    
    // Update the table to make edges from the new root to all
    // of the previous sources
    : (update parents: (parents,\:r`id) from g where id in s`id),r
    }

// @fileOverview 
// Return all descendants of a given node in a tree
// @param gapi {dict} DAG api 
// @param n {dict} node in the tree 
// @param g {table} tree specification
// returns {table} all descendants of the node
.z.m.axds.tree.inject.descendants:{[gapi;n;g]    
    gapi[`descendants][n;g]    
    }

// @fileOverview 
// Return a node given an id
// @param gapi {dict} DAG api 
// @param id {GUID} 
// @param g {table} tree specification 
// @returns {dict} tree node
.z.m.axds.tree.inject.find:{[gapi; id; g]    
    gapi[`find][id; g]    
    }

// @category Tree
//
// @fileOverview
// Folds over a function using the given directed graph and a list of nodes.
// The function to fold over must accept a single node as its first argument 
// and a tree as its second argument and return a tree
// 
// @param gapi {dict} 
// @param f {function}      Function to fold over
// @param s {table<tree>}    A list of tree nodes
// @param g {table<tree>}    tree to fold over
//
// @returns {table<tree>} The tree with f applied successively with each node
.z.m.axds.tree.inject.fold:{[gapi; f; s; g]
    : gapi[`fold] [f; s; g];
    }
// @fileOverview
// Inserts a directed edge and node between a parent and child in the tree
// NB: If p or c are not in dag then they will be added
//
// @param gapi {dict} DAG api 
// @param p {dict}  Parent node of n
// @param n {dict}  New node
// @param c {dict}  Child node of n
// @param t {table} A tree
//
// @returns {table} Updated tree
.z.m.axds.tree.inject.insert:{[gapi;p;n;c;t]
    : gapi[`insert][p;n;c;t];
    }

// @category Tree
// 
// @fileOverview
// Returns if the input has the correct schema to be a tree
//
// @param gapi {dict} 
// @param t {table<tree>}
// 
// @returns {boolean} If the input is a tree or not
//
// @see i.DAG
.z.m.axds.tree.inject.is:{[gapi; t] 
    : gapi[`is] t
    }

// @fileOverview 
// Modifies the item of a given node in g
// @param gapi {dict} DAG api 
// @param node {dict} a node in the tree 
// @param item {any} new item for the node 
// @param tree {table} tree specification
// @returns {table} updated tree specification
.z.m.axds.tree.inject.modify:{[gapi; node; item; tree]
    gapi[`modify][node; item; tree]
    }

// @fileOverview 
// Create a new tree
// @param gapi {dict} DAG api
// @returns {table} a new tree
.z.m.axds.tree.inject.new:{[gapi]
    gapi[`new][]
    }

// @fileOverview 
// Returns all of the children of a node by id
// @param gapi {dict} DAG api 
// @param node {dict} tree node
// @returns {GUID[]} list of children ids
.z.m.axds.tree.inject.node.children:{[gapi; node]
    gapi[`node][`children] node
    }

// @fileOverview 
// Returns this node's id
// @param gapi {dict} DAG api 
// @param node {dict} tree node
// @returns {GUID} Id of this node
.z.m.axds.tree.inject.node.id:{[gapi; node]
    gapi[`node][`id] node
    }

// @fileOverview 
// Extract the content of a node in the tree
// @param gapi {dict} DAG api 
// @param node {dict} tree node
// @returns {any} the content stored in the node
.z.m.axds.tree.inject.node.item:{[gapi; node]
    gapi[`node][`item] node
    }

// @fileOverview 
// Create a new tree node with the given content
// @param gapi {dict} DAG api 
// @param item {any} content of the node
// @returns {dict} tree node
.z.m.axds.tree.inject.node.new:{[gapi; item]
    gapi[`node][`new] item
    }
// @fileOverview 
// Update the given node to hold a new item
// @param gapi {dict} DAG api 
// @param item {any} the new content of the node 
// @param node {dict} a tree node to update
// @returns {dict} an updated tree node
.z.m.axds.tree.inject.node.with.item:{[gapi; item; node]
    gapi[`node][`with][`item][item; node]
    } 
// @fileOverview 
// Returns the parent of a given node
// @param gapi {dict} DAG api 
// @param node {dict} tree node 
// @param tree {table} tree specification
// @returns {dict|null}
.z.m.axds.tree.inject.parent:{[gapi; node; tree]
    parents : gapi[`parents][node; tree]; 
    : $[not 0 = count parents;
        first parents;
        (::)];
    }

// @fileOverview 
// 
// @param gapi {dict} 
// @param n {dict} 
// @param g {table} 
// @returns {table} 
.z.m.axds.tree.inject.remove.leaf:{[gapi;n;g]
    : gapi[`remove][`node][n;g];
    }

// @fileOverview 
// Return the root of the tree
// @param gapi {dict} DAG api 
// @param tree {table} tree specification
// @returns {dict} root node of the tree
.z.m.axds.tree.inject.root:{[gapi; tree]    
    first gapi[`sources][tree]    
    }

// @fileOverview 
// Returns the subtree of the given node in the graph
// @param gapi  {dict}  DAG api
// @param n     {dict}  A node within the tree 
// @param g     {table} Tree specification
// @returns     {dict}  The subtree
.z.m.axds.tree.inject.subtree:{[gapi; n; g]
    : enlist[n, enlist[`parents]!enlist ()], .z.m.axds.tree.descendants[n] g
    };

system "d .z.m";

system "d .z.m.axds";
// @category Directed Acyclic Graph - Add
//
// @fileOverview
// Adds a directed edges between a node and a set of children nodes
//
// @param n {#node}         The source DAG node
// @param c {#node | #dag}  New children of n
// @param g {#dag}
//
// @returns {#dag} Children of node in DAG
//
// @throws cycle If adding an edge creates a cycle
.z.m.axds.dag.add.children:{[n;c;g]
    : dag.fold[dag.add.edge n; $[dag.node.is c; enlist c; c]] g;
    }

// @category Directed Acyclic Graph - Add
//
// @fileOverview
// Adds a directed edge between a node and an endpoint in the given DAG.
// NB: If n or end are not in dag then they will be added
//
// @param n {#node}  Source DAG node
// @param c {#node}  New child of n
// @param g {#dag}   A DAG
//
// @returns {#dag} Updated DAG
//
// @throws dag      If dag is not a DAG
// @throws cycle    If adding the edge creates a cycle
.z.m.axds.dag.add.edge:{[n; c; g]
    
    // If the nodes are already in the DAG then make sure 
    // we have the most up to date version of them
    n: $[dag.member[n] g; dag.find[n] g; n];
    c: $[dag.member[c] g; dag.find[c] g; c];
    
    // Check for a cycle
    $[  dag.node.id[n] ~ dag.node.id c;
            dag.throw.cin[];
        dag.member[c] dag.ancestors[n] g;
            dag.throw.cycle[];
        dag.member[n] dag.descendants[c] g;
            dag.throw.cycle[];       
            1b
         ];
    
    // Add n to the parents of c and c to the children of n.
    // Then add both nodes to the DAG
    : dag.add.node[
        dag.node.with.children[distinct dag.node.children[n],enlist dag.node.id c] n] 
        dag.add.node[
            dag.node.with.parents[distinct dag.node.parents[c],enlist dag.node.id n] c] 
        g;
    }
// @category Directed Acyclic Graph - Add
//
// @fileOverview
// Adds a node to the DAG with no links. If the node
// already exists then do not add it but just update it
//
// @param n {#node}  DAG node to add
// @param g {#dag}   DAG to append to
//
// @returns {#dag} DAG with added node
.z.m.axds.dag.add.node:{[n; g]
    : $[  dag.member[n] g;
            // If the node is already in the dag then update the node.
            // We add an empty record to the end of the table to make 
            // the `item column a general type then drop it afterwards to 
            // avoid type errors.
            -1 _ @[g,(first 0#g),enlist[`item]!enlist (); first where dag.node.id[n] = g`id; :; n];
            
            // Adding a node to a dag is as simple as joining the
            // node to the dag. This will append the record to the
            // tail of the dag
            g,n    
        ];
    }

// @category Directed Acyclic Graph - Add
//
// @fileOverview
// Adds parents to a node in a dag. 
//
// @param n {#node}         The dag node to add
// @param p {#node | #dag}   The new parents of n
// @param g {#dag}               The dag to append to
//
// @returns {#dag} 
//
// @throws cycle If adding an edge creates a cycle
.z.m.axds.dag.add.parents:{[n;p;g]
    : dag.fold[dag.add.edge[;n]; $[98h ~ type p;p;enlist p]] g;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns the set of all ancestors in a dag given a base node
// 
// @param n {#node}  Base node to search from
// @param g {#dag}   DAG to search
//
// @returns {#dag} A DAG containing the set of ancestors
.z.m.axds.dag.ancestors:{[n; g]
    : dag.nodes dag.find[;g] each distinct (raze dag.ids each dag.ancestors[;g] each p),dag.ids p:dag.parents[n] g;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns the immediate children of the given node in the DAG
//
// @param n {#node}  Node to find the children of
// @param g {#dag}   DAG to search
//
// @returns {#dag} A set containing the children of n
.z.m.axds.dag.children:{[n; g]
    : dag.nodes dag.find[;g] each dag.node.children dag.find[n] g
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Clones all elements in a DAG to keep the same
// structure and payload with different node id's
//
// @param g {#dag} DAG to clone
//
// @returns {#dag} Cloned dag
.z.m.axds.dag.clone:{[g]
    // For each identifier in the graph, update the id and
    // all the references to that id.
    : {[g; baseid]
        newid: first 1?0ng;
        
        // Update the edges between the nodes
        g: update parents:  (newid,/:parents except\: baseid)   from g where baseid in/: parents;
        g: update children: (newid,/:children except\: baseid)  from g where baseid in/: children; 
        
        // Update the node id
        : update id:newid from g where id = baseid
        } over enlist[g], dag.ids g;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns a set of nodes in g that is the complement of the set s
//
// @param s {#dag} Nodes to not include in the output
// @param g {#dag} Universe DAG
//
// @returns {#dag} All nodes of g that are not in s
.z.m.axds.dag.complement:{[s;g]
    : dag.nodes dag.find[;g] each dag.ids[g] except dag.ids s
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns the set of descendants of the given node
//
// @param n {#node}  Base node to search from
// @param g {#dag}   DAG to search
// 
// @returns {#dag} A set of all descendants of n
//
// @see ancestors
.z.m.axds.dag.descendants:{[n; g]    
    // @see ancestors for a note on the ordering of this expresion
    : dag.nodes dag.find[;g] each distinct (raze dag.ids each dag.descendants[;g] each c),dag.ids c:dag.children[n] g;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns all edges connected to n as a DAG
//
// @param n {#node}  Node to return the edges for
// @param g {#dag}   DAG to search through
//
// @returns {#dag} A DAG of all edges to and from n
.z.m.axds.dag.edges:{[n; g]
    : dag.children[n;g],dag.parents[n:dag.find[n] g;g];
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns if this DAG is empty or not
//
// @param g {#dag} DAG to check
//
// @returns {boolean} If the DAG is empty
.z.m.axds.dag.empty:{[g] 
    : not count g;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns a table with the id, parents and children column but if
// item is a list of dictionaries then there will be a column for each key
//
// @param g {#dag} DAG to expand
//
// @returns {table} Original DAG with the item expanded to be first class columns
.z.m.axds.dag.expand:{[g]
    if[0 ~ count g; : g];
    
    if[all 99h = type each g`item;
        // Get the distinct keys from each item
        keyz: distinct raze key each g`item;
        
        // If there are no items to expand then just return
        if[0 ~ count keyz;
            : g];
        
        // Create a table from the 
        : ?[g;();0b;c!c:`id`parents`children] ,'flip keyz!((enlist[`]!enlist (::)),/:g[`item])@\:/:keyz
        ];
    
    : g;
    
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Search for a node in the DAG. If the ID matches any nodes in the DAG then
// return that node
//
// @param n {#node | guid}   Node or the id of the node to find
// @param g {#dag}           DAG to search
//
// @returns {#node} The first match
.z.m.axds.dag.find:{[n; g]
    
    // Identifier of the node to import
    nodeid: $[-2h ~ type n; n; n`id];
    
    // Get the first node that matchs n 
    f:first select from g where id = nodeid;
    
    // If the first node is a null node then there was no match so return a default node
    : (f; dag.NODE) 0ng ~ f`id;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Folds over a function using the given directed graph and a list of nodes.
// The function to fold over must accept a single node as its first argument 
// and a DAG as its second argument and return a DAG
// 
// @param f {function}  Function to fold over
// @param s {#dag}      A list of DAG nodes
// @param g {#dag}      DAG to fold over
//
// @returns {#dag} The DAG with f applied successively with each node
.z.m.axds.dag.fold:{[f; s; g]
    : {[f; g; n] f[n] g }[f] over enlist[g], s;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns a list of each node in a dag
//
// @param g {#dag} A DAG
//
// @returns {guids} The ids of each node in the dag
.z.m.axds.dag.ids:{[g]
    : dag.node.id each g 
    } 

// @fileOverview
// Inserts a directed edge and node between a parent and child in the given DAG.
// NB: If p or c are not in dag then they will be added
//
// @param p {#node}  Parent node of n
// @param n {#node}  New DAG node
// @param c {#node}  Child node of n
// @param g {#dag}   A DAG
//
// @returns {#dag} Updated DAG
//
// @throws dag      If dag is not a DAG
// @throws cycle    If adding the edge creates a cycle
.z.m.axds.dag.insert:{[p; n; c; g]
    // If the nodes are already in the DAG then make sure 
    // we have the most up to date version of them
    p: $[dag.member[p] g; dag.find[p] g; p];
    n: $[dag.member[n] g; dag.find[n] g; n];
    c: $[dag.member[c] g; dag.find[c] g; c];
    
    // Check for a cycle
    $[  dag.node.id[p] ~ dag.node.id n;
            dag.throw.cin[];
        dag.node.id[p] ~ dag.node.id c;
            dag.throw.cin[];
        dag.node.id[n] ~ dag.node.id c;
            dag.throw.cycle[];
        dag.member[n] dag.ancestors[p] g;
            dag.throw.cycle[];
        dag.member[p] dag.descendants[n] g;
            dag.throw.cycle[];
            1b
         ];
    
    // Add p to parents of n and c to the children of n
    // Add n to the parents of c and remove p
    // Add n to the children of p and remove c
    : dag.add.node[
        dag.node.with.children[distinct enlist[dag.node.id n] , dag.node.children[p] except dag.node.id c] p
        ] //p children: pc + n - c
        dag.add.node[
            dag.node.with.parents [distinct enlist[dag.node.id n] , dag.node.parents[c] except dag.node.id p] c
        ] //c parents: cp + n - p
        dag.add.node[
            dag.node.with.children[distinct dag.node.children[n],enlist dag.node.id c] //n children: nc + c
            dag.node.with.parents [distinct dag.node.parents[n],enlist dag.node.id p] n
        ] g; //n parents: np + p
    }

// @category Directed Acyclic Graph
// 
// @fileOverview
// Finds the intersection between two DAGs
//
// @param g1 {#dag} 
// @param g2 {#dag}
// 
// @returns {#dag} Intersection
.z.m.axds.dag.intersect:{[g1; g2] 
    : dag.nodes dag.find[;g1,g2] each dag.ids[g1] inter dag.ids[g2];
    }

// @category Directed Acyclic Graph
// 
// @fileOverview
// Returns if the input has the correct schema to be a DAG
//
// @param g {#dag} 
// 
// @returns {boolean} If the input is a DAG or not
//
// @see DAG 
.z.m.axds.dag.is:{[g] 
    : $[98h ~ type g; 
        // Order independent comparison
        all any cols[dag.DAG] ~\:/: cols g; 
        0b
        ];
    }

// @category Directed Acyclic Graph
// 
// @fileOverview
// Returns the union of nodes in two DAGs
//
// @param g1 {#dag}
// @param g2 {#dag}
// 
// @returns {#dag} Union
.z.m.axds.dag.join:{[g1; g2]
    : dag.nodes dag.find[;g1,g2] each dag.ids[g1] union dag.ids[g2];
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns if a DAG contains a node
//
// @param n {#node}  Node to check for
// @param g {#dag}   DAG to search in
//
// @returns {boolean} If n is a member of g
.z.m.axds.dag.member:{[n; g]
    : dag.node.id[n] in dag.nodes[g]`id;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Modifies the item of a given node in g
//
// @param n {#node} Node to modify
// @param m {*}     New item for n
// @param g {#dag}  DAG to update
// 
// @returns {#dag} A DAG where n contains item
//
// @throws missing If n is not a member of g
.z.m.axds.dag.modify:{[n; m; g]
    // Special case, if the node is not a member
    // of the DAG then throw an error
    if[not dag.member[n] g; dag.throw.missing[]];

    : 1 _ update item:sum[id = n`id]#enlist m from (dag.NODE,g) where id = n`id;
    }

// @category Directed Acyclic Graph
// 
// @fileOverview
// Returns a new directed acyclic graph table
//
// @returns {#dag}
// @see DAG
.z.m.axds.dag.new:{:dag.DAG}

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Returns the children of a node
//
// @param n {#node} A DAG node
//
// @returns {guid[]} The node's children
.z.m.axds.dag.node.children:{[n] : n`children }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Given a dictionary that has the same keys as a DAG node but 
// possibly has the wrong types, convert it into a proper DAG node
//
// @param n0 {dict} A dictionary that has similar keys to a DAG node
//
// @returns {#node} A proper DAG node with the relevant information from n0
.z.m.axds.dag.node.decode:{[n0]
    
    // Create a new node using the item from n0
    n: dag.node.new n0`item;
    
    // This is a hack to set the ID of the node.
    // THIS SHOULD NEVER BE DONE ANYWHERE ELSE!
    if[(not .z.m.axq.isNull n0`id) and 0 < count n0`id;
        n: n,enlist[`id]!enlist .z.m.axq.parseGUID n0`id
        ];
    
    // If n0 has parents then use them
    if[(not .z.m.axq.isNull n0`parents) and 0 < count n0`parents;
        n: node.with.parents[.z.m.axq.parseGUID each n0`parents] n
        ];
    
    // Use n0's children if it has any
    if[(not .z.m.axq.isNull n0`children) and 0 < count n0`children;
        n: dag.node.with.children[.z.m.axq.parseGUID each n0`children] n
        ];
    
    : n;
    }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Returns the id of a node
//
// @param n {#node} A DAG node
//
// @returns {guid} The node's id
.z.m.axds.dag.node.id:{[n] : n`id }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Returns the number of inbound edges from the given node
//
// @param n {#node} A dag node
//
// @returns {long} Indegree of this node
.z.m.axds.dag.node.indegree:{[n]
    : count dag.node.parents n;
    }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Returns if the give node is a DAG node or not
//
// @param n {#node} A DAG node
//
// @returns {boolean} If the input is a DAG node  
// @see NODE
.z.m.axds.dag.node.is:{[n] 
    : $[99h ~ type n; 
        // Order independent comparison
        all any key[dag.NODE] ~\:/: key n;  
        0b
        ];
    }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Returns the item element of a DAG node
//
// @param n {#node} A DAG node
//
// @returns {*} The payload of the node
// @see NODE
.z.m.axds.dag.node.item:{[n] 
    : dag.node.self[n]`item;
    }

// @category Directed Acyclic Graph - Node
// 
// @fileOverview
// Returns a new node dictionary
//
// @param item {*} Item that this node will hold
//
// @returns {#node}
// @see NODE
.z.m.axds.dag.node.new:{[item] 
    : dag.node.with.item[item] dag.NODE,enlist[`id]!enlist rand 0ng;
    }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Returns the number of outbound edges from the given node
//
// @param n {#node} A dag node
//
// @returns {long} Outdegree of this node
.z.m.axds.dag.node.outdegree:{[n]
    : count dag.node.children n;
    }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Returns the parents of a node
//
// @param n {#node} A DAG node
//
// @returns {guid[]} The node's parents
.z.m.axds.dag.node.parents:{[n] : n`parents }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Confirms that the input is a node and returns it
//
// @param n {#node} A DAG node
//
// @returns {#node} If n is a DAG then return n
// @throws node If the input is not a DAG node
.z.m.axds.dag.node.self:{[n] 
    : $[not dag.node.is n; dag.throw.node[]; n]; 
    }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Adds the given children to a node and returns the updated node
//
// @param c {guid[]}    New children of the node
// @param n {#node}     Node to modify
//
// @returns {#node} Updated node
// @see NODE
.z.m.axds.dag.node.with.children:{[c; n]
    : dag.node.self[n],enlist[`children]!enlist c;
    }

// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Adds the given item to a node and returns the updated node
//
// @param item  {*}     New payload of the node
// @param n     {#node} Node to modify
//
// @returns {#node} Updated node
// @see NODE
.z.m.axds.dag.node.with.item:{[item; n] 
    : dag.node.self[n],enlist[`item]!enlist item; 
    }


// @category Directed Acyclic Graph - Node
//
// @fileOverview
// Adds the given parents to a node and returns the updated node
//
// @param p {guid[]} New parents of the node
// @param n {#node}  Node to modify
//
// @returns {#node} Updated node
// @see NODE
.z.m.axds.dag.node.with.parents:{[p; n]
    : dag.node.self[n],enlist[`parents]!enlist p;
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// The identity function for a dag. It checks that the input is a dag 
// and returns the dag
//
// @param g {#dag}
//
// @returns {#dag} 
// @throws dag if the input is not a dag
.z.m.axds.dag.nodes:{[g] 
    : $[
        // Special case, if the given g is an empty list then 
        // we will treat it as an empty DAG.
        //
        // This was done because in some cases doing an 'each' on
        // an empty DAG returns an empty list which will then 
        // throw type errors. This is an effort to fix that
        () ~ g; 
            dag.new[]; 
        not dag.is g; 
            dag.throw.dag[]; 
            g
        ];
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns the immediate parents of node n in a DAG
//
// @param n {#node}  Base node
// @param g {#dag}   DAG to search
//
// @returns {#dag} A set of parents for n
.z.m.axds.dag.parents:{[n;g]
    : dag.nodes dag.find[;g] each dag.node.parents dag.find[n] g
    }

// @category Directed Acyclic Graph - Remove
//
// @fileOverview
// Removes all of the child nodes of n
//
// @param n {#node}  Base node to remove the children from
// @param g {#dag}   DAG to modify
//
// @returns {#dag} DAG where the chilren of n have been removed
.z.m.axds.dag.remove.children:{[n; g]
    : dag.fold[dag.remove.node; dag.children[n] g] g
    }

// @category Directed Acyclic Graph - Remove
//
// @fileOverview
// Removes the edge between n and e
//
// @param n {#node}  Parent node of the edge
// @param e {#node}  Child node of the edge
// @param g {#dag}   DAG to update
//
// @returns {#dag} A DAG without the edge from n to e
.z.m.axds.dag.remove.edge:{[n; e; g]
    g: dag.add.node[dag.node.with.parents[dag.node.parents[e] except dag.node.id n] e:dag.find[e] g]
        dag.add.node[dag.node.with.children[dag.node.children[n] except dag.node.id e] n:dag.find[n] g] g;
    
    // If there are missing parents or children then a null 
    // node will be added. It must be removed
    : ![g; enlist (=; `id; 0ng); 0b; `symbol$()];
    }

// @category Directed Acyclic Graph - Remove
//
// @fileOverview
// Removes a node and all related edges from a DAG
//
// @param n {#node}  Node to remove
// @param g {#dag}   A DAG to remove n from
//
// @returns {#dag} The updated dag
.z.m.axds.dag.remove.node:{[n; g]
    // Remove the edges from n to its children
    g: dag.fold[dag.remove.edge n; dag.children[n] g] g;
        
    // Remove the edges from n's parents
    g: dag.fold[dag.remove.edge[;n]; dag.parents[n] g] g; 
    
    // Remove n
    : ![g; enlist (in; `id; (0ng; dag.node.id n)); 0b; `symbol$()];
    }

// @category Directed Acyclic Graph - Remove
//
// @fileOverview
// Removes all of the parent nodes of n
//
// @param n {#node}  Base node to remove the parents from
// @param g {#dag}   DAG to modify
//
// @returns {#dag} DAG where the parents of n have been removed
.z.m.axds.dag.remove.parents:{[n; g]
    : dag.fold[dag.remove.node; dag.parents[n] g] g
    }

// @category Directed Acyclic Graph
//
// @fileOverview
// Returns all of the sinks in a dag. A sink is defined as a node
// where the outdegree is 0
//
// @param g {#dag} A DAG to search
//
// @returns {#dag} The set of all sinks in g
.z.m.axds.dag.sinks:{[g]
    : select from dag.nodes[g] where not count each children;
    }

// @category Directed Acyclic Graph
//
// @fileOverview 
// Returns all of the source nodes in g. A source is defined as a node
// where the indegree is 0
//
// @param g {#dag} The DAG to search
//
// @returns {#dag} The set of sources
.z.m.axds.dag.sources:{[g]    
    : select from dag.nodes[g] where not count each parents;
    }

// @category Directed Acyclic Graph - Error
//
// @fileOverview
// Throws a cycle error in the event that the given node
// is a child of itself
.z.m.axds.dag.throw.cin:{'"cycle: child is node"}

// @category Directed Acyclic Graph - Error
//
// @fileOverview
// Throws a generic cycle error
.z.m.axds.dag.throw.cycle:{'"cycle"}

// @category Directed Acyclic Graph - Error
//
// @fileOverview
// Throws a type error that the expected value was to be a DAG
.z.m.axds.dag.throw.dag:{'"type: expected dag"}

// @category Directed Acyclic Graph - Error
//
// @fileOverview
// Throws an error that the given node does not
// exist in this DAG
.z.m.axds.dag.throw.missing:{'"missing: node not a member of dag"}
// @category Directed Acyclic Graph - Error
//
// @fileOverview
// Throws a type error that the expected value was to be a DAG node
.z.m.axds.dag.throw.node:{'"type: expected dag node"}
.z.m.axds.dag.NODE:(!) . flip (
    (`id;       0ng);
    (`parents;  `guid$());
    (`children; `guid$());
    (`item;     ())
    )
.z.m.axds.dag.DAG:([]id:`guid$(); parents:(); children: (); item:())
.z.m.axds.dag.onLoad:{[]
    // @typedef dag data {table (id: guid; parents: guid[]; children: guid[]; item: #data)}
    // @typedef node data {table (id: guid; parents: guid[]; children: guid[]; item: #data)}
    
    }
 
.z.m.axds.dag.onLoad[];
system "d .z.m";

system "d .z.m.axds";
.z.m.axds.tree.onLoad:{[]
    
    .z.m.axutl.injeqt.injeqt [enlist[`gapi]!enlist .z.m.axds.dag; `.z.m.axds.tree.inject; `.z.m.axds.tree];
    .z.m.axutl.injeqt.injeqt [enlist[`gapi]!enlist .z.m.axds.dag; `.z.m.axds.tree.inject.node; `.z.m.axds.tree.node];
    .z.m.axutl.injeqt.injeqt [enlist[`gapi]!enlist .z.m.axds.dag; `.z.m.axds.tree.inject.node.with; `.z.m.axds.tree.node.with];
    .z.m.axutl.injeqt.injeqt [enlist[`gapi]!enlist .z.m.axds.dag; `.z.m.axds.tree.inject.add; `.z.m.axds.tree.add];
    .z.m.axutl.injeqt.injeqt [enlist[`gapi]!enlist .z.m.axds.dag; `.z.m.axds.tree.inject.remove; `.z.m.axds.tree.remove];

    }

.z.m.axds.tree.onLoad[];
system "d .z.m";

system "d .z.m.qu";
// @fileOverview `after` blocks execute at the end of a feature. They are used for test cleanup by, for example,  
// deleting any global variables defined by the test. 
//
// | name  | parent block |       content    | description allowed | abort on error |
// |-------|--------------|------------------|---------------------|----------------|
// | after |    feature   | q function block |         no          |        no      |
//
// @example
//
//     after 
//           a::1                //|q function block  

// @example
//   feature                    //multiple after blocks are allowed in a feature
//      after 
//           a::1        
//      after 
//           b::1  

// @example
//   feature                    //before after execute at the end of their parent feature
//      after 
//           a::1        
//   feature                    
//      after 
//           a::2 

// @private
// @param target {function} After function target
// @returns {#block.dagTree} 
.z.m.qu.block.after:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`after; "After"; target]
    }
// @fileOverview `after each` blocks execute after each should block in a feature. They are used for 
// test cleanup by, for example,  deleting any global variables defined by the test. 
// Errors thrown in `after each` blocks cause the feature to abort.
//
// |     name   | parent block |       content    | description allowed | abort on error |
// |------------|--------------|------------------|---------------------|----------------|
// | after each |   feature    | q function block |         no          |        yes      |

// @example
//
//     after each
//           a::1                //|q function block  

// @example
//
//  feature
//      before
//          a::1
//      //this after each block executes after both of the should blocks
//      after each             
//           a::2
//      should
//          expect
//              show a;             //will display 1
//              1b
//          expect
//              show a;             //will display 1
//              1b
//      should
//          expect
//              show a;             //will display 2
//              1b 

// @private

// @param target {function} After Each function target
// @returns {#block.dagTree} 
.z.m.qu.block.afterEach:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`afterEach; "After Each"; target]
    }
// @fileOverview `baseline` blocks contain the q function whose runtime is being being compared to a `behaviour` block. 
// A bench block may have at most one `behaviour` block.
//
// If no `timelimit` or `baseline` are present, the test will pass and the time taken will be logged.
//
// Unless there is also a `tolerance` block in the `bench` block, 
// the `behaviour` block must have a runtime less than or equal to the runtime of the "baseline" block. If a `tolerance` block is present then the `behaviour`
// block must have a runtime within some percentage of the `baseline` block runtime.
//
// |    name  | parent block |    content       | description allowed | abort on error |
// |----------|--------------|------------------|---------------------|----------------|
// | baseline |    bench     | q function block |        yes          |        no      |


// @example
// feature
//      bench a basic runtime
//          behaviour
//              til 1      // no check, just log the run time in ms
//
// @example
// feature
//      bench a comparative runtime
//          baseline    
//              til 10000000          // runtime approximately 10 ms
//          behaviour
//              til 1      //this will have a runtime within the baseline runtime, and the test will pass
//
// @private   
// @param label {string} Label for this block
// @param target  {#block.dagTree[]} Test specification
// @returns {#block.dagTree} 
.z.m.qu.block.baseline:{[label; target]

    : enlist .z.m.axds.tree.node.new
     block.data.create[`baseline; label; target] 
    }
// @fileOverview `Before` blocks execute at the beginning of a feature. They are used for test preparation by, 
// for example, setting global variables to be used in the tests. 
// Errors thrown in `before` blocks cause the feature to abort.
// 
// |   name | parent block |    content       | description allowed | abort on error |
// |--------|--------------|------------------|---------------------|----------------|
// | before |    feature   | q function block |          no         |      yes       |
//
// @example
//
//     before 
//           a::1               //|q function block  

// @example
//   feature                    //multiple before blocks are allowed in a feature
//      before 
//           a::1        
//      before 
//           b::1  

// @example
//   feature                    //before blocks execute at the start of their parent feature 
//      before 
//           a::1        
//   feature                    
//      before 
//           a::2 

// @private
// @param target {function} Before function target
// @returns {#block.dagTree} 
.z.m.qu.block.before:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`before; "Before"; target] 
    }
// @fileOverview `before each` blocks execute prior to each should block in a feature. They are used for
// test preparation by, for example, setting global variables to be used in the tests. 
// Errors thrown in `before each` blocks cause the feature to abort.
//
// |     name    | parent block |     content      | description allowed | abort on error |
// |-------------|--------------|------------------|---------------------|----------------|
// | before each |    feature   | q function block |        no           |      yes       |
//
// @example
//
//     before each
//           a::1                //|q function block  

// @example
//  feature
//      //this before each block executes prior to both of the should blocks
//      before each             
//           a::1
//      should
//          expect
//              show a;             //will display 1
//              a::2;
//              1b
//          expect
//              show a;             //will display 2
//              a::2;
//              1b
//      should
//          expect
//              show a;             //will display 1
//              a::2;
//              1b

// @private
// @param target {function} Before Each function target
// @returns {#block.dagTree} 
.z.m.qu.block.beforeEach:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`beforeEach; "Before Each"; target]
    }
// @fileOverview `behaviour` blocks contain the q function whose runtime is being analyzed. In a `bench` block the `behaviour` block runtime is compared
// to either a timelimit, the runtime of a `baseline` block, or both. A bench block must have exactly one `behaviour` block.
//
// |     name  | parent block |     content      | description allowed | abort on error |
// |-----------|--------------|------------------|---------------------|----------------|
// | behaviour |    bench     | q function block |         yes         |       no       |
//
// Note: "behaviour" may alternatively be spelled "behavior" in the quke file. This is done to accommodate international spelling.

// @example
//
//     behaviour    behaviours may have descriptions
//           til 20                //|q function block  

// @example
// feature
//      bench
//          timelimit
//              100          // timelimit of 10 milliseconds
//          baseline    
//              til 10000000          // runtime approximately 10 ms
//          behaviour   
//              til 1      //this will have a runtime within the baseline runtime and within the timelimit, and the test will pass

// @private   
// @param label {string} Label for this block
// @param target  {function} Test specification
// @returns {#block.dagTree} 
.z.m.qu.block.behaviour:{[label; target]
    : enlist .z.m.axds.tree.node.new
     block.data.create[`behaviour; label; target] 
    }
// @fileOverview The `bench` block runs a test where the runtime of a q function in a `behaviour` block is compared to the 
// runtime of a `baseline` block q function or to a timelimit set in a `timelimit` block. 

// The "bench" block may contain "behaviour", "baseline", "timelimit", "setup", "teardown", "tolerance", and "replicate" blocks. 
//
// | name  | parent block |                       content                                  | description allowed | abort on error|
// |------ |--------------|----------------------------------------------------------------|---------------------|---------------|
// |       |              | Required:                                                      |                     |               |
// |       |              | One behaviour block                                            |                     |               |
// |       |              | One baseline block, one timelimit block, or one of each        |                     |               |
// |       |              | If there is a tolerance block, one baseline block is required  |                     |               |
// |       |              |                                                                |                     |               |
// | bench |   feature    | Optional:                                                      |        yes          |      no       |
// |       |              | One or more setup blocks                                       |                     |               |
// |       |              | One or more teardown blocks                                    |                     |               |
// |       |              | One tolerance block                                            |                     |               |
// |       |              | One replicate block                                            |                     |               |

// When running functions that are relatively close in runtime (for example, "til 10000" as a "baseline" function and "til 9000"
// as a "behaviour" function), the "baseline" test will sometimes fail even though the "behaviour" function should run slightly faster.
// This occurs due to overhead from memory allocation, and may, in a predictable fashion, cause the "baseline" test to fail, even if 
// each block is run multiple times by setting the "replicate" block value greater than one.
// Two solution exist:

// First, the user can run the test a second time. During the second run, the memory will usually have been pre-allocated,
// so the overhead from memory allocation will be less of an issue and (as one would normally expect)
// the "til 9000" function will run faster than the "til 10000"  function.

// Second, the user can set the number of secondary threads in the workspace to zero. Doing so allows garbage collection to run after each replicate in the bench test.
// Although this makes every run of the "baseline" or "behaviour" q function block take slightly longer,
// it makes runtime for each replicate far more consistent, and almost guarantees that the expected functions will run faster
// (any random variation can be overcome by increasing the number of replicates in the "replicate" block). 
// 
// The smallest measurable time difference can vary depending on the operating system.
// At the time of this writing, the smallest measurable time on a Linux server is roughly 1 microsecond, while it is roughly 1 millisecond on a Windows server.
// The runtimes of "Baseline" and "behaviour" block functions will be indistinguishable if their runtime is less than the smallest measurable runtime. 


// @example
// feature                      //a feature may contain several bench blocks
//
//      //A bench test must have either one baseline block, one timelimit block, or one of each
//      bench   
//          baseline
//              til 100000000          
//          behaviour
//              til 1      
//      bench
//          timelimit
//              100        
//          behaviour
//              til 1     
//      bench  benchs may have descriptions
//          timelimit
//              100         
//          baseline
//              til 10000000         
//          behaviour
//              til 1      


// @example
// feature                      
//      bench
//          setup       //multiple setup blocks are allowed
//              a::1
//          setup
//              b::1
//          baseline
//              til 100000000          
//          behaviour
//              til 1      
//          teardown    //multiple teardown blocks are allowed
//              a::1
//          teardown
//              b::1

// @example
// feature                      
//      bench
//          replicate
//              10              //a single replicate is allowed
//          tolerance
//              10              //a single tolerance is allowed
//          timelimit
//              10              //a single timelimit is allowed
//          baseline
//              til 100000000   //a single baseline is allowed. If a tolerance block is present the baseline block is required.
//          behaviour           //a single behaviour is allowed
//              til 1      

// @private   
// @param label {string} Label for this block
// @param spec  {#block.dagTree[]} Test specification
// @returns {#block.dagTree} 
.z.m.qu.block.bench:{[label; spec]

    : .z.m.axds.tree.connect[
        .z.m.axds.tree.node.new
         block.data.create[`bench; label; ::]] spec
    }
// @fileOverview Creates a check for a property
//
// @param target {*} check
//
// @returns {#block.dagTree}

// @private
//
.z.m.qu.block.check:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`check; "Check"; target]
    }
// @fileOverview Creates a Qumin block with some default properties
//
// @param name      {symbol}
// @param label     {string}
// @param target    {*}
//
// @returns {#block.blocks}
//
// @private
//
.z.m.qu.block.data.create:{[name; label; target]

    : block.data.new (
        0ng;
        name; 
        label; 
        target; 
        first block.blocks.contextual where name = block.blocks.name;
        0Np; 
        0Nn; 
        ::; 
        1b; 
        `; 
        0b; 
        0b;
        block.events; 
        enlist[`]!enlist[::]
        );
    }; 
// @fileOverview Executes a single block in a sequence
//
// @param previous  {#block.blocks} Previously executed block
// @param current   {#block.blocks} Block currently being executed
//
// @returns {#block.blocks} The current block after execution
// 
// @throws 'abort - If a abort on error block fails

// @private
.z.m.qu.block.data.execute:{[previous; current]

    // Start the timer
    current: block.data.with.start[.z.p] current;

    // Set the current block to "skip if" a previous "skip if" block returned true
    // Must check if the current name is a feature, since the previous
    // block for a feature does not contain a metadata dictionary
    // Also the skip if only applies to a given feature, so we have to break
    // at each new feature
    if[`feature <> block.data.name current;
        if[ 1b ~ block.data.metadata[previous]`skipIf;
            current : block.data.with.skipped[1b] block.data.with.metadata[block.data.metadata[current],enlist[`skipIf]!enlist 1b] current
            ];
        ];

    // Ensure that this block has not been aborted or skipped. If so then
    // skip this node
    if[(block.data.aborted current) or block.data.skipped current;
        : block.data.with.time[.z.m.axq.asTimespan 0] current];

    out: $[block.data.name[current] in `baseline`behaviour;
                // We must force block.i.bench.test.run to a monadic function with .
                block.funcRun[current;block.i.bench.test.run .;(current;previous)];
                // Else all other blocks
                block.funcRun[current;block.data.target current;block.data.result previous]
                ];

    error  : out 0;
    result : out 1;

    // Update the bench test results if the is a bench test block
    if[block.data.name[current] in `baseline`behaviour;
        $[not error;
            current: block.data.with.metadata[block.data.metadata[current],(`avgTime`devTime)!(.z.m.axq.asTimespan avg result;.z.m.axq.asTimespan dev result)] current;
            current: block.data.with.metadata[block.data.metadata[current],(`avgTime`devTime)!(.z.m.axq.asTimespan 0;.z.m.axq.asTimespan 0)] current
         ]];

    // Capture the execution time of this block
    current: block.data.with.time[.z.p - block.data.start current] current;

    // Check if skipping the feature has been specified by the test in "skip if"
    if[(block.data.name[current] ~ `skipIf) and result ~ 1b;
        current : block.data.with.metadata[block.data.metadata[current],enlist[`skipIf]!enlist 1b] current
        ];

    // Check if the block ran without an error and update the 
    // success value of the block
    current: $[error;

        // If there was an error then check if this block should
        // abort execution. If so then throw 'abort
        $[first block.blocks.abortOnError where block.blocks.name = block.data.name current;
            :block.data.with.aborted[1b] block.data.with.success[0b]
                block.data.with.error["abort in ",(string block.data.name current)," block due to error \"", result ,"\""] current;
            // If a null error (projected or generic) is thrown when the block is executed, it returns "". This string is converted to null for user clarity
            block.record.error[0b; $[0 = count result; "null" ;result]]
            ];

        block.record.success[not 0b ~ result; result]
        ] current;

    // Data for tolerance and timeLimit blocks are held in the metadata. This if statetement shuffles all of the metadata
    // down to the baseline block so that it can be interpreted by the behaviour block when it runs
    if[block.data.name[previous] in `tolerance`timelimit`replicate;
           current: block.data.with.metadata[(block.data.metadata previous),block.data.metadata current] current;
    ];

    // Deal with timer comparison for bench blocks. If the current block is a behaviour block then all of the setup
    // necessary to run these time comparisons has occurred
    if[block.data.name[current] = `behaviour;
          current: block.i.bench.tests[previous;current]
    ];
    // Return the executed block
    : current
    }
// @fileOverview "Should" blocks contain one or more expect blocks.
//
// |   name | parent block |       content           | description allowed | abort on error |
// |--------|--------------|-------------------------|---------------------|----------------|
// | should |    feature   | 1 or more expect blocks |          yes        |       no       |


// @example
// should 
//     expect 
//           1b
//
// @example
// should this should has multiple expects
//     expect one
//           1b      
//     expect two
//           1 = 1
//     expect three
//           any 0010b

// @private   
// @param label {string} Label for this block
// @param spec  {#block.dagTree} Test specification
// @returns {#block.dagTree} 
.z.m.qu.block.describe:{[label; spec]

    : .z.m.axds.tree.connect[
        .z.m.axds.tree.node.new
            block.data.create[`describe; label; ::]] spec
    };

// @fileOverview Injects a callback for any event into the last
// test block in the given specification
// 
// @param evt       {symbol}        Event name to inject callback into
// @param callback  {function}      Callback function will be triggered when event is fired
// @param spec      {#block.dagTree}   Test specification to modify
//
// @returns {#block.dagTree} A modified test specification

// @private
.z.m.qu.block.event.inject:{[evt; callback; spec]
    item: .z.m.axds.tree.node.item tnode: last spec;
    
    // Wrap the event and callback in a dictionary
    // and pass then into the block data. Then update 
    // the tree item with the modified block
    : .z.m.axds.tree.node.with.item[
        block.data.with.event[
            block.data.events[item], enlist[evt]!enlist callback
            ] item
        ] tnode;
    }
// @fileOverview `expect` blocks are the assertion based unit test blocks for qcumber. An `expect` block may
// be used alone or be associated with a `to match` block directly following the `expect` block.
// If no `to match` block is present, then the q function within an `expect` block should 
// return a boolean value indicating whether or not the test passed. Any value other than boolean
// true (`1b`) will be reported as a failed test.
// If a `to match` block follows the `expect` block, the q functions within both the `expect`
// and `to match` block should return the same result for the test to pass. If the results
// do not match then the test will fail.

// | Name   | Parent block | Content               | Description allowed | Abort on error |
// |--------|--------------|-----------------------|---------------------|----------------|
// | expect |    should    | Required:             |          yes        |       no       |
// |        |              |    q function block   |                     |                |
// |        |              |                       |                     |                |
// |        |              | Optional:             |                     |                |
// |        |              |    One to match block |                     |                |

// @example
//     feature
//         should	
//             expect          
//                 1b  
//
// @example
//     feature
//         should                            
//             expect may have a description
//                 v:0;                    / q function block: this
//                 v+:1;                   / block spans multiple 
//                 v+:1;                   / lines but is parsed
//                 v=2;                    / into a single function
//
// @example
//     feature
//         should
//             expect
//                 [a:8;          / q function block: a q function
//                  b:8;          / block may optionally be enclosed 
//                  a=b]          / by a single pair of square brackets
//
// @example
//     feature
//         // The following two should blocks are equivalent
//         // Using a to match block to specify the expected return
//         // from an expect block often leads to cleaner syntax
//         should
//             expect
//                 3 ~ count 1 2 3
//         should	
//             expect          
//                 count 1 2 3
//             to match
//                 3
//
// @param target {any} Expectation
// @returns {#block.dagTree} 
// @private
.z.m.qu.block.expect:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`expect; "Expectation"; target]
    }
// @fileOverview `feature` blocks form the main test block of a quke file. Each `feature` block may contain one or more 
//  `before`, `after`, `should`, `bench`, or `property` blocks. A quke file may contain multiple `feature` blocks.
//
// |  name   | parent block | content                               | description allowed | abort on error|
// | ------- |--------------|---------------------------------------|---------------------|---------------|
// |         |              | Required:                             |                     |               |
// |         |              | At least one child block                         |                     |               |
// |         |              |                                       |                     |               |
// | feature |      NA      | Optional:                             |         yes         |      NA       |
// |         |              | One or more before blocks               |                     |               |
// |         |              | One or more after blocks                |                     |               |
// |         |              | One or more before each blocks          |                     |               |
// |         |              | One or more after each blocks           |                     |               |
// |         |              | One or more should blocks               |                     |               |
// |         |              | One or more bench blocks                |                     |               |
// |         |              | One or more property blocks             |                     |               |
//

// @example
//      //A feature block containing all of the possible qcumber blocks
//      feature this is a feature                      //descriptions are allowed after feature blocks
//         before              
//             .ab.a : 0
//         after               
//             delete a from `.ab
//         before each         
//             .ab.a : 1
//         after each        
//             .ab.a : 0
//         should this is a should                     //descriptions are allowed after should blocks
//             expect this is an expect                //descriptions are allowed after expect blocks 
//                 .ab.a = 1
//             expect this is another expect           //descriptions are allowed after expect blocks  
//                 .ab.a = 1
//         bench this is a bench                       //descriptions are allowed after bench blocks
//             setup
//                 .ab.b : 1
//             timelimit 
//                 100
//             tolerance 
//                 10 100
//             replicate 
//                 1000
//             baseline this is a baseline            //descriptions are allowed after baseline blocks
//                 til 10000
//             behaviour this is a behaviour          //descriptions are allowed after behaviour blocks
//                 til 5000
//             teardown
//                 delete b from `.ab
//         property this is a property                //descriptions are allowed after property
//             .z.m.qch.check
//             .z.m.qch.forall[.z.m.qch.g.int[]]{
//                     x=x
//             } 

// @example
//     feature                 // multiple features are allowed in a quke file
//        should
//           expect
//              1b
//     feature                 
//        should
//           expect
//              1=1

// @param label {string} Label for this block
// @param spec  {#block.dagTree} Test specification
// @returns {#block.dagTree} the feature block
// @private

.z.m.qu.block.feature:{[label; spec]
    : .z.m.axds.tree.connect[
        .z.m.axds.tree.node.new
            block.data.create[`feature; label; ::]] spec
    }
// @fileOverview Runs the function
// @param current {#block.blocks} Block currently being executed
// @param f       {function} the monadic function to execute
// @param arg     {any} the argument to the function
// @returns {(boolean;any)} a tuple with a boolean indicating if there was an error and the result 
//                          (the result is the error string if an error occurred)
.z.m.qu.block.funcRun:{[current;f;arg]
    
    // Trapping and rethrowing the error prevents debugging past the catch,
    // so if either of these are set, it is allowed to propagate
    propagate: .z.m.qu.block.breakOnErrors | .z.m.qu.block.breakOnFail;
    
    // Since trapping the error doesn't work,
    // the current location can't be printed only when there is an error,
    // but must be printed for each block.
    // "expect", "toMatch", and "check" are virtual blocks created when running
    // expect or property blocks, and shouldn't appear in the output.
    if [propagate and not current[`name] in `expect`toMatch`check;
        b: exec from .z.m.qu.block.blocks where name = current `name;
        block.print ((4 * b`indent)#" ") , raze[b`text] , current `label];
        
    : $[.z.m.axq.isSymbol block.data.target current;
        (1b; .z.m.axq.asString block.data.target current);
        $[  propagate;
            (0b; block.replaceProjectedNull f arg);
            .[  {[f; arg] (0b; block.replaceProjectedNull f arg)};
                (f; arg);
                (1b;)]]];
    }

// @fileOverview performs all bench block time comparison tests
//
// @param previous  {#block.blocks} Previously executed block
// @param current   {#block.blocks} Block currently being executed
//
// @returns {bool} the result of the test
// @private
//
.z.m.qu.block.i.bench.test.baseline:{[previous; current]
    
    //Used to allow a test to be run with only a time limit and no baseline
    previousTime : $[block.data.name[previous] = `baseline; block.data.metadata[previous] `avgTime; 0wt]; 
    
//     ratio: $[`benchTimeRatio in key block.data.metadata[current];
//                                 block.data.metadata[current][`benchTimeRatio];
//                                 1];
//     
    
    //Th comparison tests for greater than or equal to (instead of greater than), in part so that, if both functions have zero runtime due to 
    //having a runtime that is smaller than the smallest division on the system clock
    //the test still passes. This might obscure situations where the user wants to test 
    //the runtime of a very fast function. (i.e. the user might have a function that is really fast
    //but that needs to be run lots of times, so small differences matter. If they run the bench test
    //and both behaviour and baseline return times of the smallest system time division, then differences might be 
    //obscured and the user wouldn't know that they should investigate further because the test passed). 
    
    fasterThanBaseline: $[`tolerance in key block.data.metadata[previous];
                            //If there is a tolerance block, only run the tolerance test, do not run the direct baseline comparison
                            1b;
                            block.data.metadata[current][`avgTime] <= previousTime];
        
    
    :fasterThanBaseline
    }
// @fileOverview Run the behaviour or baseline function in a bench test
//
// @param current  {#block.blocks} Previously executed block
// @param previous   {#block.blocks} Block currently being executed
//
// @returns {(any;timespan)[]} a list of tuples. Each
//              tuple contains the results of running the function
//              and the runtime of the function (in ns, however 
//              the result is only precise to us). 

// @private
//
.z.m.qu.block.i.bench.test.run:{[current;previous]
    
    //Find the number of times to run the function
    timesToRun : $[`replicate in key block.data.metadata[previous]; 
                    .z.m.axq.parseInt block.data.metadata[previous] `replicate;
                    1];

    //A list that contains the results of the running the behaviour
    //or baseline function and the time (in ns) for the function to
    //run
    runtimes: ();
    
    //An function used to execute the behaviour or baseline function,
    //measure the execution time, and record the results.
    timerFunction:{
                   //Garbage collection is done before
                   //run to improve the consistency of the time 
                   //measurement. However, garbage collection cannot be 
                   //done in child processes if there are secondary threads (the process will hang), and qmin must be run in a 
                   //child process during the overnight build. Thus, the number of secondary threads
                   //is checked before executing garbage collection.
                   .Q.gc[];
                   startTime: .z.m.ax.os.time[];
                   x[];
                   endTime: .z.m.ax.os.time[];

                   : endTime - startTime};
    
    //initialize the number of runs that the do loop has run
    numTimes: 0;

    //Run the baseline or behaviour function in a do block
    //to allow the user to set how many times to run the function
    //(to limit the risk of an anomalous runtime from causing
    //the test to fail.
    //All setup functions are run prior to each execution of the target function,
    //and all teardown functions are run after said execution.
    do[timesToRun;

            //increment the numTimes variable to keep track of how many
            //times the function ran so that in the event of an error, this
            //value can be reported to the user
            numTimes +: 1;

         //DEPRECATED, MAY ADD TO NEW BLOCK IN LATER RELEASES:Run all setup functions.
         //    {[setupFunction;numTimes] 
         //       @[first setupFunction;::;
         //           {[numTimes;setupFunction;error]
         //               '"setup function error of type ",error, " on run ", (.z.m.axq.asString numTimes), " [line #", (.z.m.axq.asString last setupFunction) ,"] "
         //               }[numTimes;setupFunction]]
         //   }[;numTimes] each block.data.metadata[previous][`setup];
            
            //run the baseline or behaviour function. 
            runtimes,: @[timerFunction;block.data.target current;{[numTimes;error] '"in run ", .z.m.axq.asString[numTimes], " - \"", error,"\""} numTimes];
        
        //DEPRECATED, MAY ADD TO NEW BLOCK IN LATER RELEASES: run all teardown functions.
        //    {[teardownFunction;numTimes] 
        //        @[first teardownFunction;::;
        //            {[numTimes;teardownFunction;error]
        //                '"teardown function error of type ",error, " on run ", (.z.m.axq.asString numTimes), " [line #", (.z.m.axq.asString last teardownFunction) ,"] "
        //                }[numTimes;teardownFunction]]
        //    }[;numTimes] each block.data.metadata[previous][`teardown];
        
        ];

    : runtimes

    }
// @fileOverview performs all bench block time comparison tests
//
// @param previous  {#block.blocks} Previously executed block
// @param current   {#block.blocks} Block currently being executed
//
// @returns {bool} the result of the test
// @private
//
.z.m.qu.block.i.bench.test.timelimit:{[previous; current]
    timeToFinish: $[`timelimit in key block.data.metadata[previous];
                                .z.m.axq.parseLong block.data.metadata[previous] `timelimit;
                                0w];
    fasterThanTimeLimit:   (timeToFinish*1000000) >=  .z.m.axq.asInt block.data.metadata[current] `avgTime;
    
    :fasterThanTimeLimit
    
    }

// @fileOverview performs all bench block time comparison tests
//
// @param previous  {#block.blocks} Previously executed block
// @param current   {#block.blocks} Block currently being executed
//
// @returns {bool[]} the results of the test
// @private
//
.z.m.qu.block.i.bench.test.tolerance:{[previous; current]
    
    //Used to allow a test to be run with only a time limit and no baseline
    previousTime : $[block.data.name[previous] = `baseline; block.data.metadata[previous] `avgTime; 0wt]; 
    
    //Find the ratio of the baseline and behaviour times
    timePercent: 100*block.data.metadata[current][`avgTime]%previousTime;
    //If the baseline and behaviour times are 0, timePercent is 0n. Handle this case.
    timePercent: $[0n ~ timePercent; 0;timePercent];
    //Parse the percent values in any tolerance blocks into a list of numbers
    //If there is only one number, then use it as the upper tolerance bound. Otherwise
    //there are two numbers (this is checked by the parser, the numbers are sorted,
    //with the larger one being the upper bound and the smaller one being the lower bound.
    //If tolerance is not a field in the metadata (meaning there was no tolerance block)
    //substitute 0 and infinity as the respective bounds of the test. 
    toleranceBounds: $[`tolerance in key block.data.metadata[previous];
                        [   bounds: (.z.m.axq.parseFloat " " vs  block.data.metadata[previous] `tolerance) except 0N;
                            $[1 = count bounds;
                            (0;first bounds);     
                            asc bounds]
                        ];
                        (0;0wt)];
    
    slowerThanLowerBound:  timePercent >= first toleranceBounds;
    fasterThanUpperBound:  timePercent <= last toleranceBounds;
    
    :(slowerThanLowerBound;fasterThanUpperBound)
    
    }
// @fileOverview performs all bench block time comparison tests
//
// @param previous  {#block.blocks} Previously executed block
// @param current   {#block.blocks} Block currently being executed
//
// @returns {#block.blocks} The current block after execution
// @private
//
.z.m.qu.block.i.bench.tests:{[previous; current]

    //Perform the four comparisons and check for baseline or behaviour errors:
    //Did the behaviour run faster than the baseline?
    //Did the behaviour run faster than the maximum time limit (timelimit block)?
    //Was the ratio of behaviour to baseline larger than the lower bound (from the tolerance block)?
    //Was the ratio of behaviour to baseline smaller than the upper bound (from the tolerance block)?
    
    baselineNoError: $[`baseline = block.data.name previous;
                        not .z.m.axq.isString block.data.error previous;
                        1b];
    behaviourNoError: not .z.m.axq.isString block.data.error current;  
    fasterThanTimelimit: block.i.bench.test.timelimit[previous; current];
    fasterThanBaseline: block.i.bench.test.baseline[previous; current];
    toleranceBounds: block.i.bench.test.tolerance[previous;current];
    slowerThanLowerBound: first toleranceBounds; 
    fasterThanUpperBound: last toleranceBounds;
    
    //If there are baseline or behaviour errors, then any other tests are invalid, so set to true
    //so that they are not displayed to the user.
    if[not all baselineNoError,behaviourNoError;
        fasterThanBaseline :1b;
        toleranceBounds : 1b;
        slowerThanLowerBound : 1b;
        fasterThanUpperBound :1b];
    
    //Add the results from the four comparisons to the metadata of the behaviour block
    current: block.data.with.metadata[block.data.metadata[current], 
                (enlist `passedBaseline)! enlist fasterThanBaseline] current; 
    current: block.data.with.metadata[block.data.metadata[current], 
                (enlist `passedTimeLimit)! enlist fasterThanTimelimit] current;
    current: block.data.with.metadata[block.data.metadata[current],
                (enlist `passedLowerTolerance)! enlist slowerThanLowerBound] current;
    current: block.data.with.metadata[block.data.metadata[current],
                (enlist `passedUpperTolerance)! enlist fasterThanUpperBound] current;  
                      
    //If all tests passed (and the blocks ran without error), then the bench block succeeded. Failed otherwise.
    current: block.data.with.success[all baselineNoError, behaviourNoError, fasterThanBaseline, fasterThanTimelimit,
                                          fasterThanUpperBound, slowerThanLowerBound] current;  

    :current
    
    }

// @fileOverview Extracts the value of the desired metadata field  from the last node 
//              of a specification
//
// @param field {symbol}   Metadata property to extract
// @param spec  {#block.blocks}   Specification to extract metadata value from
//
// @returns {any} the value from the metadata
// @private
// 
.z.m.qu.block.metadata.extract:{[field; spec]
    : @[;field] block.data.metadata .z.m.axds.tree.node.item last spec;
    }
// @fileOverview Modifies a field of the metadata of the last block in a given specification
//               to contain the new data. The modified specification is then returned
// 
// @param field {symbol}        Field in metadata to modify
// @param entry {*}             Value to insert into metadata
// @param spec  {#block.blocks}   Tree specification of blocks to modify
//
// @private
// 
// @returns {#block.blocks} Updated tree specification
.z.m.qu.block.metadata.modify:{[field; entry; spec]
  
    // Extract the block from the node
    item: .z.m.axds.tree.node.item last spec;

    // Update the tree node with the node block
    node: .z.m.axds.tree.node.with.item[
        // Inject the new item into the metadata
        block.data.with.metadata[block.data.metadata[item],enlist[field]!enlist entry ] item
        ] last spec;

    : (-1 _ spec), node;
    }
// @fileOverview Returns the value of a key within a given node in a tree
//
// @param field {symbol}            Field of node item to extract
// @param node  {#block.blocks}  Node of tree
//
// @returns {*} Value of node in tree
// @private
//
.z.m.qu.block.node.item:{[field; node]
    : node[`item] field
    }
// @fileOverview Sets the value of a field to be new value
//
// @param field     {symbol}            Field of node item to update
// @param content   {*}                 Value to insert into node
// @param node      {#block.blocks}   Node of tree
//
// @returns {#block.blocks} Updated tree node
// @private
//
.z.m.qu.block.node.with.item:{[field; content; node]
    : node, enlist[`item]!enlist node[`item],enlist[field]!enlist content
    }
 
// @fileOverview This is just a wrapper for -1 that can be stubbed for testing
// @returns {null}
.z.m.qu.block.print:-1

// @fileOverview `property` blocks allow for improved access to quick-check tests. QuickCheck allows multiple tests to be run with 
// randomly generated input parameters. Although 
// QuickCheck tests can be run within an `expect` block, the `property` block has the benefit of displaying any counter examples to the user. 
// 
// A `property` block must contain a q function block that returns the results of a valid QuickCheck expression. 
//
// |    name  | parent block |            content           | description allowed | abort on error |
// |----------|--------------|------------------------------|---------------------|----------------|
// | property |    feature   | valid QuickCheck expression |         yes         |       no       |
//
// @example
//
//     property 
//          //the QuickCheck expression
//          .z.m.qch.check
//              .z.m.qch.forall[.z.m.qch.g.int[]]{
//                 x=x
//              }

// @example
//
//     property another property
//          .z.m.qch.check
//              .z.m.qch.forall2[.z.m.qch.g.int[];.z.m.qch.g.int[]]{
//                 all .z.m.axq.isInt each x
//              }


// @example
//
//     property 
//          a::1;                   //q syntax is allowed prior to the QuickCheck expression in the property block
//          .z.m.qch.check
//              .z.m.qch.forall[.z.m.qch.g.int[]]{
//                 1 in a,x
//              }
//
// @private
// @param label {string} Label for this block
// @param action {function} action to execute
// @param spec  {#block.dagTree} Test specification
// @returns {#block.blocks} A specification with a check block
.z.m.qu.block.property:{[label; action;spec]
    : .z.m.axds.tree.connect[
        .z.m.axds.tree.node.new
            block.data.create[`property; label; action]] spec
    }
// @fileOverview Records if a block errored during execution. This will trigger
// the callback event in the block's event registry
//
// @param success   {boolean}       If this block was considered successful
// @param error     {string}        The error that this block encountered
// @param block_    {#block.blocks}   Block that errored
//
// @returns {#block.blocks} The updated block
// @private
//
.z.m.qu.block.record.error:{[success; error; block_]
    
    // Update the block to include the error
    // and success status
    block_: block.data.with.success[success] 
        block.data.with.error[error] block_;
    
    // Trigger the error event
    block.data.events[block_] [`error] block_;
    
    : block_
    }

// @fileOverview Records if a block succeeded during execution. This will trigger
// the callback event in the block's event registry
//
// @param success   {boolean}       If this block was considered successful
// @param result    {*}             The result that this function returned
// @param block_    {#block.blocks}   Block that errored
//
// @returns {#block.blocks} The updated block
// @private
//
.z.m.qu.block.record.success:{[success; result; block_]
    
    // Update the block to include the result
    // and success status
    block_: block.data.with.success[success]
        block.data.with.result[result] block_;
    
    // Trigger the success event
    block.data.events[block_] [`success] block_;
    
    : block_
    }
// @fileOverview Replace projected null with generic null
//                  Unexpected projected nulls can cause errors many statements
// @param x {any}
// @returns {any}
.z.m.qu.block.replaceProjectedNull:{[x]
    :$[.z.m.axq.isNull x;::;x]
    }
// @fileOverview `replicate` blocks set the number of replicates to be performed on the test functions of the `bench` block. 
// The average runtimes will be used in the `bench` comparison tests. The number of replicates defaults to 1 if 
// no replicate block is present. The number of replicates must be greater than zero. 
//
// |   name    | parent block | content           | description allowed |abort on error |
// |-----------|--------------|-------------------|---------------------|---------------|
// | replicate |     bench    | 1 long that is    |         no          |       NA      |
// |           |              | greater than zero |                     |               |
//
// @example
//
//     replicate
//           10              //10 replicates 

// @example
// feature
//      bench
//          replicate
//              10           //10 replicates. The behaviour will be executed 10 times, and its average runtime will be found.
//          timelimit
//              100          
//          behaviour
//              til 1      

// @example
// feature
//      bench
//          replicate
//              10           //10 replicates. The behaviour and baseline will each executed 10 times, and their average runtimes will be found and compared.
//          baseline
//              10000000          
//          behaviour
//              til 1   
//
// @private
// @param target {function} always {1b}, used to keep the block consistent with other blocks
// @returns {#block.dagTree}
.z.m.qu.block.replicate:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`replicate; "Replicate"; target]
    }
// @fileOverview Runs a test specification from the root. This function requires
// that the given specification is a feature specification.
//
// @param spec {#block.dagTree[]} list of Feature specifications to run for a given test file
//
// @returns {#block.blocks} An executed specification
// @private
//
.z.m.qu.block.run:{[spec]
    if[0 = count spec; :0#enlist block.data.create[`;"";::]];
    : raze {[x] :block.seq.run block.seq.validate block.seq.from x} each spec;
    }
// @fileOverview Adds contextual blocks to a block sequence from a specification 
//
// @param spec {#block.dagTree}    Test specification
// @param bseq {#block.dagTree}   Sequence of blocks to execute
//
// @returns {#block.dagTree} Updated execution sequence 
// @private
//
.z.m.qu.block.seq.addcontext:{[spec; bseq]

    // Capture all of the contextual blocks in 
    // the given spec
    contextBlocks: exec item from spec where item@'`contextual;
    
    // If there are no contextual blocks then short circuit
    if[0 ~ count contextBlocks;
        : bseq];
    
    // Reverser the order of the bench blocks to ensure teardowns and setups occur in the correct order
    contextBlocks: (contextBlocks where contextBlocks[`name] in `afterEach`beforeEach),
                   (reverse contextBlocks where contextBlocks[`name] in `teardown`behaviour`baseline`replicate`timelimit`tolerance`setup),
                     contextBlocks where contextBlocks[`name] in `after`before`skipIf;
    // Sort the context blocks according to their priority 
    contextBlocks @: iasc where each contextBlocks[`name] =\: `afterEach`beforeEach`teardown`behaviour`baseline`replicate`timelimit`tolerance`setup`after`before`skipIf;

    // Add each context block into the block sequence
    : {[spec; bseq; block_]
        name: block.data.name block_;

        : $[`skipIf ~ name;
                .z.m.table.insertAfter[bseq; block_] last where bseq[`name] in `feature`skipIf;
            `before ~ name;
                .z.m.table.insertAfter[bseq; block_] last where bseq[`name] in `feature`before;
            `after ~ name;
                bseq,block_;
            `beforeEach ~ name;
                .z.m.table.insertAt[bseq; block_] where (bseq[`name] in `describe`property) and not bseq `skipped;
            `afterEach ~ name; 
                [
                    // Add `afterEach before every block in the second level of nesting except the first
                    // If the previous block was a bench or was skipped, we don't add an afterEach block
                    bseq: .z.m.table.insertAt[bseq; block_; 1_exec i from bseq where prev (not name = `bench) and not skipped, name in `describe`property`bench];
                    // The last block is either a property or a should that is not skipped, 
                    //  then afterEach must be added at the end.
                    // If it has been skipped no afterEach block needs to be added since it would have been added at an earlier point
                    slvl : last select name, skipped from bseq where name in `describe`property`bench;
                    if[(slvl[`name] in `describe`property) and not slvl`skipped;
                        bseq:bseq, block_;
                        ];
                    bseq
                ];
            name in `teardown`behaviour`baseline`timelimit`tolerance`replicate`setup;
                .z.m.table.insertAfter[bseq; block_] first where (bseq[`name] = `bench) and bseq[`id] in first exec parents from spec where id = block_[`id];
            //else
            bseq
            ];
        }[spec] over enlist[bseq], contextBlocks; 
    }
// @fileOverview Returns a block sequence from a test specification
//
// @param spec {#block.dagTree} Test specification to convert
//
// @returns {#block.dagTree} A sequence of blocks to execute
// @private
//
.z.m.qu.block.seq.from:{[spec]
    // Update each block to have the id from the original specification
    spec: {block.node.with.item[`id; .z.m.axds.tree.node.id x] x} each spec;
    
    // Capture the root of the specification
    root: .z.m.axds.tree.root spec;
    
    // Add all of non contextual blocks and then add 
    // the contextual blocks to the block sequence
    : block.seq.addcontext[spec] {[spec; node_]
        if[0ng ~ .z.m.axds.tree.node.id node_;
            : ()];
        
        children: $[ 0 ~ count .z.m.axds.tree.node.children node_; 
                        ();
                    // else
                        raze .z.s[spec] each .z.m.axds.tree.children[node_] spec
                    ];
        
        : enlist[.z.m.axds.tree.node.item node_],children
        }[select from spec where not item@'`contextual; root]
    }

// @fileOverview Executes a sequence of blocks in order
//
// @param bseq {#block.dagTree} Sequence to run
//
// @returns {#block.dagTree} Executed block sequence
// @private
//
.z.m.qu.block.seq.run:{[bseq]

    : {[executed; current]
        if [block.data.aborted last executed;
            : executed];
        
        newBlk: block.data.execute[last executed] current;
        
        : $[block.data.aborted newBlk;
            enlist
                block.data.with.label[block.data.label first executed]   
                    block.data.with.name[block.data.name first executed]        
                        newBlk;
            executed,newBlk];
        } over enlist[0#enlist block.data.create[`;"";::]], bseq;
    }
// @fileOverview Validates the block types within a sequence. This ensures
// that all blocks are valid types and the sequence starts with
// a feature
//
// @param bseq {#block.dagTree} Block sequence to validate
//
// @returns {#block.dagTree} Returns bseq if it is valid
//
// @throws 'qumin error - If the sequence is invalid
// @private
//
.z.m.qu.block.seq.validate:{[bseq]
    
    // Ensure that the sequence starts with a feature block
    if[`feature <> block.data.name first bseq;
        '"qumin error: root of specification must be a feature"]; 
    
    // Check that all blocks in the sequence are recognized
    recognizedBlocks: bseq[`name] in\: block.blocks.name;
    if[ not all recognizedBlocks;
        '"qumin error: unrecognized block '", string[first bseq[`name] where not recognizedBlocks],"'"];
    
    // At this point the sequence is considered "valid".
    // Return the sequence with no errors
    : bseq
    }
// @fileOverview `setup` blocks execute at the beginning of a bench block. They are used
// for test preparation by, for example, setting global variables to be used in the tests. 
// Errors thrown in `setup` blocks cause the feature to abort.
//
// | name  | parent block |      content     | description allowed | abort on error |
// |-------|--------------|------------------|---------------------|----------------|
// | setup |     bench    | q function block |           no        |        yes     |
//
// @example
//        
//     setup
//           a::1                //|q function block   
//
// @example
// feature
//     bench
//        setup
//           a::0                //the setup runs at the beginning of the bench block
//        baseline
//          til 10000000
//        behaviour
//          til 1

// @example
// feature
//     bench
//        setup
//           a::0                //multiple setups are allowed
//        setup
//           b::0                
//        baseline
//          til 10000000
//        behaviour
//          til 1

// @example
// feature
//     bench
//        setup
//           a::0                //each setup only applies to its parent bench block
//        baseline
//          til 10000000
//        behaviour
//          til 1
//      bench
//        setup
//           a::1               
//        baseline
//          til 10000000
//        behaviour
//          til 1

// @private
// @param target {function} setup function target
//
// @returns {#block.dagTree}
.z.m.qu.block.setup:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`setup; "Setup"; target]
    }
// @fileOverview `skip if` blocks execute at the beginning of a `feature`. They are used to validate conditions and 
//      determine whether or not the tests should be run. If the block returns boolean true (`1b`), then the 
//      `feature` is skipped, and all of its blocks are reported as skipped blocks.
//      If the `skip if` block returns boolean false (`0b`), then `feature` is executed.
//      If a non-boolean value is returned, or if an error is thrown, the `feature` aborts.
// 
// |   name | parent block |    content       | description allowed | abort on error |
// |--------|--------------|------------------|---------------------|----------------|
// | skip if|    feature   | q function block |          yes        |      yes       |
//
// @example
//
//     skip if 
//          .z.o like "l*"      // q function block, will skip if os is linux

// @example
//   feature                    //multiple before "skip if" blocks are allowed in a feature
//      skip if 
//          .z.o like "m*"
//      skip if 
//          `w64 ~ .z.o

// @example
//   // "skip if" blocks execute at the start of their parent feature, and determine whether the rest of the feature is tested
//   feature                    
//      skip if 
//          .z.o like "m*"       
//   feature                    
//      skip if 
//          `w64 ~ .z.o

// @private
// @param target {function} Before function target
// @returns {#block.dagTree} 
.z.m.qu.block.skipIf:{[target]
    : enlist .z.m.axds.tree.node.new
        // Wrap in a function that checks if the result is a boolean variable
        // If not, throw an error so that this block is handled the same as before blocks
        // @qlintsuppress UNUSED_PARAM
        block.data.create[`skipIf; "Skip If"; {[f;x] r : f[]; :$[.z.m.axq.isBoolean r;r;'"\"skip if\" block must return boolean value"] } target] 
    }
// @fileOverview `teardown` blocks execute at the beginning of a bench block. 
// They are used for test cleanup by, for example, deleting global variables from the workspace. 
// Errors thrown in `teardown` blocks cause the feature to abort.
//
// |    name  | parent block |      content     | description allowed | abort on error |
// |----------|--------------|------------------|---------------------|----------------|
// | teardown |     bench    | q function block |         no          |        yes     |
//
// @example
//
//     teardown
//           a::0                //|q function block  

// @example
// feature
//     bench
//        baseline
//          til 10000000
//        behaviour
//          til 1
//        teardown
//           a::0                //the teardown runs at the end of the bench block

// @example
// feature
//     bench
//        baseline
//          til 10000000
//        behaviour
//          til 1
//        teardown
//           a::0                //multiple teardowns are allowed
//        teardown
//           b::0               

// @example
// feature
//     bench
//        baseline
//          til 10000000
//        behaviour
//          til 1
//        teardown
//           a::0                //each teardown only applies to its parent bench block
//     bench
//        baseline
//          til 10000000
//        behaviour
//          til 1
//        teardown
//           a::1                

// @private
// @param target {function} teardown function target
//
// @returns {#block.dagTree}
.z.m.qu.block.teardown:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`teardown; "Teardown"; target]
    }
// @fileOverview The `timelimit` block sets the maximum runtime (in milliseconds) for a `behaviour` block. A bench block may have at most one `timelimit` block.
// If no `behaviour` block is present a `bench` block must have a `timelimit` block. The `behaviour` block must have a runtime less than
// or equal to the timelimit.
// 
// |    name   | parent block | content  | description allowed | abort on error |
// |-----------|--------------|----------|---------------------| -------------- |
// | timelimit |    bench     | One long |         no          |       NA       |
//
// @example
//
//     timelimit
//           10          // timelimit of 10 milliseconds

// @example
// feature
//      bench
//          timelimit
//              100        // timelimit of 10 milliseconds
//          behaviour
//              til 1      //this will have a runtime less than the timelimit, and the test will pass

// @private
// @param target {function} always {1b}, used to keep the block consistent with other blocks
//
// @returns {#block.dagTree}
.z.m.qu.block.timelimit:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`timelimit; "Timelimit"; target]
    }
// @fileOverview `to match` blocks are used to specify the expected result from an `expect` block. By default, the test will fail
// if the `expect` block returns anything other than boolean true (`1b`). With the `to match` block it is possible
// to specify an alternative test result. This result will be compared with the return value of the `expect` block,
// and if they are exactly equal the test will pass. This block can help clean up the structure of tests.

// | Name     | Parent block | Content          | Description allowed | Abort on error |
// |----------|--------------|------------------|---------------------|----------------|
// | to match |    expect    | q function block |          yes        |       no       |

// @example
//     feature
//         // these two should blocks are equivalent
//         // however, the second can often be cleaner syntax if complex data structures are involved
//         should
//             expect
//                 3 ~ count 1 2 3
//         should	
//             expect          
//                 count 1 2 3
//             to match
//                 3
//
// @private
//
// @param label     {string}        Label of story
// @param action    {function}      Action to execute
//
// @returns {#block.dagTree} A specification with a when block
.z.m.qu.block.toMatch:{[label; action]

    exptFn : {$[.z.m.axq.isDict x;(~). x`expect`toMatch;0b]};

    : .z.m.axds.tree.connect[
        .z.m.axds.tree.node.new
            block.data.create[`toMatch; label; action]] 
        enlist .z.m.qu.block.expect exptFn
    }
// @fileOverview `tolerance` blocks set tolerance limits for the tolerance tests. 
// The `tolerance` block may contain one or two numerical values. If one value is present it is the upper tolerance value.
// If two values are present the larger one is the upper tolerance value and the smaller one is the lower tolerance value.
// 
// Two tolerance tests exist: the upper tolerance test and the lower tolerance test.
//
// In the upper tolerance test, the `behaviour` must execute with a runtime less than or equal to 
// some percentage (the upper tolerance value) of the `baseline` runtime.

// In the lower tolerance test, the `behaviour` must execute with a runtime greater than or equal to 
// some percentage (the upper tolerance value) of the `baseline` runtime.

// A `bench` block that contains a tolerance block must also have a `baseline` block.

//
// |    name   | parent block |       content              | description allowed | abort on error |
// |-----------|--------------|----------------------------|---------------------| -------------- |
// | tolerance |     bench    | One or two floats or longs |         no          |       NA       | 
//
// @example
//
//     tolerance
//           90          // a tolerance with only an upper tolerance value of 90%
//                       // The behaviour must have a runtime less than 90% of the baseline runtime

// @example
//
//     tolerance
//           10 90         // a tolerance block with both upper and lower tolerance values of 90% and 10% respectively
//                         // The behaviour must have a runtime less than 90% and greater than 10% of the baseline runtime

// @example
//
//     tolerance
//           10.0 90.0          // a tolerance block with both the upper and lower tolerance values as floats

// @example
// feature
//     bench
//        baseline              //if a tolerance block is present there must be a baseline block
//          til 10000000 
//        behaviour
//          til 5000000 
//        tolerance             //The behaviour will have a runtime within the given percentages of the baseline runtime
//           10 90          

// @private
// @param target {function} always {1b}, used to keep the block consistent with other blocks
//
// @returns {#block.dagTree}
.z.m.qu.block.tolerance:{[target]
    : enlist .z.m.axds.tree.node.new
        block.data.create[`tolerance; "Tolerance"; target]
    }
// @fileOverview Creates a block to describe a story and the expectations
//               when an operation is performed
//
// @private
//
// @param label     {string}        Label of story
// @param action    {function}      Action to execute
// @param spec      {#block.dagTree}   Test specification
//
// @returns {#block.dagTree} A specification with a when block
.z.m.qu.block.when:{[label; action; spec]
    : .z.m.axds.tree.connect[
        .z.m.axds.tree.node.new
            block.data.create[`when; label; action]] spec
    }
// @fileOverview Avaiable events for listening too during specification
// execution. These events can be subscribed to within the
// definition of a specification
// @private
.z.m.qu.block.events:(!) . flip (
    (`error     ; ::);
    (`success   ; ::)
    );
// @fileOverview Set this to true via .z.m.qu.setBreakOnFail to propagate fails in unit tests to facilitate debugging
.z.m.qu.block.breakOnFail:0b
// @fileOverview Set this to true via .z.m.qu.setBreakOnErrors to propagate errors in unit tests to facilitate debugging
.z.m.qu.block.breakOnErrors:0b
//@private
//@fileOverview rules for how to treat each type of block when running tests
.z.m.qu.block.blocks:(
    `name`contextual`abortOnError`indent`text!(`feature    ; 0b; 0b; 0; "Feature ");
    `name`contextual`abortOnError`indent`text!(`describe   ; 0b; 0b; 1; "Should ");
    `name`contextual`abortOnError`indent`text!(`when       ; 0b; 0b; 2; "Expect ");
    `name`contextual`abortOnError`indent`text!(`expect     ; 0b; 0b; 2; "");
    `name`contextual`abortOnError`indent`text!(`toMatch    ; 0b; 0b; 2; "");
    `name`contextual`abortOnError`indent`text!(`property   ; 0b; 0b; 1; "Property ");
    `name`contextual`abortOnError`indent`text!(`check      ; 0b; 0b; 1; "");
    `name`contextual`abortOnError`indent`text!(`bench      ; 0b; 0b; 1; "Bench ");
    `name`contextual`abortOnError`indent`text!(`baseline   ; 1b; 0b; 2; "Baseline ");
    `name`contextual`abortOnError`indent`text!(`behaviour  ; 1b; 0b; 2; "Behaviour ");
    `name`contextual`abortOnError`indent`text!(`tolerance  ; 1b; 0b; 2; "");
    `name`contextual`abortOnError`indent`text!(`timelimit  ; 1b; 0b; 2; "");
    `name`contextual`abortOnError`indent`text!(`replicate  ; 1b; 0b; 2; "");
    `name`contextual`abortOnError`indent`text!(`setup      ; 1b; 1b; 2; "");
    `name`contextual`abortOnError`indent`text!(`teardown   ; 1b; 1b; 2; "");
    `name`contextual`abortOnError`indent`text!(`skipIf     ; 1b; 1b; 1; "");
    `name`contextual`abortOnError`indent`text!(`before     ; 1b; 1b; 1; "");
    `name`contextual`abortOnError`indent`text!(`beforeEach ; 1b; 1b; 1; "");
    `name`contextual`abortOnError`indent`text!(`after      ; 1b; 0b; 1; "");
    `name`contextual`abortOnError`indent`text!(`afterEach  ; 1b; 1b; 1; "")
    )

// @fileOverview sets up the datatypes for the module
// @returns {null} 
.z.m.qu.block.onLoad:{[]

// @typedef dagTree {table(id: GUID;
//                         parents: GUID[];
//                         children: GUID[];
//                         item: #blocks)}
//
// @typedef dagTreeArray arg {#arg[]}
//
// @typedef blocks {table (
//                      null : null;
//                      i_.type    : symbol;
//                      i_.extentions : symbol[];
//                      id         : GUID;
//                      name       : symbol;
//                      label      : string;
//                      target     :function;
//                      contextual :boolean;
//                      start      :timestamp;
//                      time       :timespan;
//                      result     :any;
//                      success    :boolean;
//                      error      :string;
//                      aborted    :boolean;
//                      events     :dict (error: any; success: any);
//                      metadata   :dict)}

    .z.m.axdatatype.create[`.z.m.qu.block.data;
        `id`name`label`target`contextual`start`time`result`success`error`aborted`skipped`events`metadata;
        `id`name`label`target`contextual`start`time`result`success`error`aborted`skipped`events`metadata
        ];
    
    .z.m.qu.block.event ,: key[block.events]!block.event.inject @/: key block.events;
    
    }
.z.m.qu.block.onLoad[];
system "d .z.m";

system "d .z.m.axutl";
// @fileOverview
// Check if a version is above or below a required version
//
// @param m {symbol} `` `min `` or `` `max ``, implies which check will be used
// @param required {string} The required version ("x.x.x")
// @param given {string} The given version ("x.x.x")
//
// @returns {null}
.z.m.axutl.checkVersion:{[m; required; given]
    required : "J"$ "." vs required;
    given    : "J"$ "." vs given;
    comp     : $[`min ~ m; (>;<); (<;>)];
    k        : 0;
    
    // Validate that the version string is valid
    if[any 3 <> count each (required;given); 'string[m],"Version malformed, should be in the format X.X.X"];

    while[k<3;
        if [comp[0][given[k]] required k; : 1b];
        if [comp[1][given[k]] required k; : 0b];
        k+:1];
    
    : 1b;
    }

// @fileOverview decodes a base64 encoded string
// For details on base64 see: http://en.wikipedia.org/wiki/Base64
// @param x {String} The string to decode
// @returns {String} The base64 decoded string
.z.m.axutl.decode64:{[x]
    
    // The empty string case needs to be handled separately
    if [x ~ "";
        : ""];
    
    encoding : "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"!(til 64); /dnl
    exponents: {2 xexp x} each (18; 12; 6; 0);
     
    str1: `int$sum each (encoding each (4 cut x)) *\: exponents;
    str : raze reverse each `char$flip (1 256 65536) {(y div x) mod 256}\: str1;

    pad : count where ("=" = reverse [x] [til 3]);
    : (neg pad)_str;
    }

// @fileOverview encodes a string using base64 encoding
// For details on base64 see: http://en.wikipedia.org/wiki/Base64
// @param x {String} The string to encode
// @returns {String} The base64 encoded string
.z.m.axutl.encode64:{[x]
    
    // The empty string case needs to be handled separately
    if [x ~ "";
        : ""];
    
    encoding : (til 64)!"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"; /dnl

    // pad with nulls if not modulo 3
	
    pad : (0; 2; 1)[(count x) mod 3];
  
    exp1 : (65536; 256; 1); 
    bits : sum each ((each [`int$] 3 cut x,(pad#"")) *\: exp1);
    exp2 : (1; 64; 4096; 262144); // 2 xexp (0; 6; 12; 18);
    bytes: reverse (bits div/: exp2) mod 64; // {(x div y) mod 64}/: exponents;
    str  : raze flip encoding [bytes];
  
    // pad end of coded text properly and return
    if [pad = 1; 
        str [(count str) - 1]: "="];
    
    if [pad = 2; 
        str [(count str) - (1 2)]: "="];
	
    : str;
    }
// @fileOverview 
// Run a system command safely, sanitizing and escaping user inputs. Note that this means
// that relative paths won't work as expected, and will be taken literally
//
// @param cmd {string} The command to inject the sanitized arguments into
// @param args {string[]} The arguments to sanitize and inject into the command
// @returns {*} The output of the system command
// 
// @example
//      .z.m.axutl.execute["ls {0}"] enlist "~";  
//          => runs system "ls '~'"
//
//      .z.m.axutl.execute["cp {0} {1}"] ("/tmp/test.file"; "/tmp/new/"); 
//          => runs system "cp '/tmp/test.file' '/tmp/new/'"
//
//      .z.m.axutl.execute["ls {0}"] enlist "'; echo \"unsafe!\"; '"
//          => runs system "ls ''\\''; echo \"unsafe!\"; '\\'''"
//
.z.m.axutl.execute:{[cmd; args]
    // Sanitize arguments, and wrap in quotes
    args: .z.m.axstr.escape each args;
   
    // Inject each argument
    safe: .z.m.axstr.interp[cmd; args];

    : system safe;
    }

// @fileOverview Retrieves the literals from a function, regardless of kdb version
// @param fn {function}
// @returns {any[]} 
.z.m.axutl.getFuncLiterals:{[fn]
    // The first four items in the function definition always refer to the same thing
    // These are (bytecode; parameters; locals; (context; globals))
    // kdb3.5 added extra information at the end of a function, the second of which is the name. 
    // The last item in the function value is still the string representation of the function
    :$[.z.K > 3.4;-5;-1]_4_value fn
    }

// @fileOverview
// Takes a symbol representing an object in the namespace and 
// extracts its context
//
// @example 
// .z.m.axutl.getNS `.abc.def
// /=> `.abc
//
// @example works for root context
// .z.m.axutl.getNS `abc.def
// /=> `.
//
// @param data {symbol | symbol[]} Symbols and symbol lists
//
// @returns {symbol | symbol[]} The context
.z.m.axutl.getNS:{[data]
    if[11h <> abs type data;'"type"];
    if [wasAtom:.z.m.axq.isSymbol data;
        data:enlist data];
    root: where not data like ".*";
    ctx: ` sv/: 2#/:` vs/: data;
    ctx[root]:`.;
    :$[wasAtom;first;::] ctx
    }
// @fileOverview
// Generates globally unique ids without overlap even when called
// in quick succession. This function circumvents the kdb+ issue
// where invoking `-1?0ng` in rapid succession results in duplicate
// ids.
// @param n {long} Number of ids to generate
// @return {guid[]} Globally unique ids
.z.m.axutl.guid:{[n] 
    // clear the global guid cache of ids that are older than 1 second
    // as this bug only occurs in subsecond intervals
    delete from `.z.m.axutl.i.guids where time < .z.p - 0D00:00:01.000;
    cache : raze i.guids`guids;
    size  : abs n;
    n     : neg size; // ensure n is negative
    ids   : ();

    while[size > count ids; ids,:(n?0ng) except cache];
    ids: size#ids; // we may generate more than the required number of ids, drop the rest
    
    // note: upsert by reference is significantly faster than setting the value
    `.z.m.axutl.i.guids upsert `time`guids!(.z.p; ids); 
    
    : ids;
    }

// @private
// @fileOverview Heuristic that determines whether or not files are binary.
// Git already provides this for files it controls. We provide this for workspace entities (i.e uncommited revisions)
// using the same algorithm implemented in q instead of c.
// Note libgit2 and native git differ in how the compute what is binary. Git only check if  files contain a null in the first 8000 bytes
// @param c {string[]}
// @returns {boolean[]}
.z.m.axutl.isBinary:{[c]
    //Look at the first 8000 bytes of each content
    co:count each c;
    co[where co > 8000] : 8000;
    ci:co#'c;
    
    //If something contains NULL it is immediatly non-printable regardless of how many
    //other printable chars it may have.
    hasNull:(`byte$0) in/: ci;
    
    //Printable characters are those above 0x1f, exluding 0x7f
    //Excluding \n\t\r\f\b\v (newline + tab)
    //(These rules taken from libgit2 source: src/buf_text.c bool git_buf_text_gather_stats)
    
    //TODO do this in a less hardcoded way, had to stop development on this to look at something else.
    //TODO That said it will work as is, just not if you want to add something else to white list.
    allowlist:`byte$"\n\t\r";
    v:(allowlist[0] = ci) or (allowlist[1] = ci) or (allowlist[2] = ci)
        or
        (ci <> 0x7f) and (ci > 0x1f) and not hasNull;
    printable:sum each v;
    nonprintable: co - printable;
    
    //Equivalent to  (printable >> 7) < nonprintable because shift-right by 7 is equivalent to division by 2 to power 7 (128).
    :(printable % 128) < nonprintable;
    }

// @fileOverview Tokenizes the input and strips comments
// @param text {String} A string of q code
// @returns {String[]} The token list
.z.m.axutl.tokenize:{[text]
    
    // Tokenize the input
    parsed: -4!text;
    
    // Get the indices of the comments
    // Comments are any tokens starting with / or whitespace, unless that token has length 1 or is /:
    // The tokens of length 1 are not included because these could refer to the / operator
    cmtInd: where ((1 < count each parsed) & parsed[;0] in "/ \t\n") & not  parsed ~\: "/:";
    
    // Strips comments
    // Any leading whitespace must be maintained to be compatible with pre 3.5 kdb versions
    parsed[cmtInd] : (parsed[cmtInd]?\:"/")#'parsed[cmtInd];

    :parsed where (0 <> count each parsed)
    }
// @fileOverview Meta type letters to symbolic names
.z.m.axutl.METATYPES:" bgxhijefcCspmdznuvt"!`general`boolean`guid`byte`short`int`long`real`float`char`compoundChar`symbol`timestamp`month`date`datetime`timespan`minute`second`time /dnl
.z.m.axutl.onLoad:{[]
 
    i.guids: ([] time: `timestamp$(); guids: ());
    
    }

.z.m.axutl.onLoad[];
system "d .z.m";

system "d .z.m.qch";
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for a value of a random base type.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.any[]
.z.m.qch.g.any:{[]
    : g.oneof (value g.basetypes) @\: (::);
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random booleans.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.bool[]
.z.m.qch.g.bool:{[]
    : g.new (
        // Arb
        {[x] first 1?0b}; 
        // Shrink
        (::);
        // Less Than
        (::)
        );
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random booleans.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.boolean[]
.z.m.qch.g.boolean:{[]
    : g.bool[]
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random bytes.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example Any random byte
// .z.m.qch.g.reify .z.m.qch.g.byte[]
//
// @example Random bytes less than 0x55
// .z.m.qch.g.reify .z.m.qch.g.byte 0x55
.z.m.qch.g.byte:{[range]
    if [(::) ~ range; range : 0x00];
    
    : g.new (
        // Arb
        {[range;x] first 1?range} "x"$min 255,range; 
        // Shrink
        g.i.shrinkNum"x";
        // Less Than
        {[a;b] abs[a] < abs b }
        );
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random characters.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.char[]
.z.m.qch.g.char:{[]    
    : g.new (
        // Arb
        { first 1?" " }; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// Generates random nested data but converts the type to a kdb+
// compound data type by serializing and deserializing the data. 
// The result is data that appears to be normal nested data but 
// has a type value of 77h + type x
//
// @example Generating random compound data
// data: .z.m.qch.g.reify .z.m.qch.g.compound[]
// /=> 15:20:30 08:24:51 16:26:25
// /=> 23:47:09 07:21:02 21:51:49 21:32:36 08:08:02
// /=> 15:54:15 23:28:13 16:15:22 11:24:38 11:55:21 14:08:34
// /=> `second$()
// /=> 22:16:37 14:09:14 21:24:53 04:36:38 16:20:03 15:49:10 18:15:49
// /=> ..
//
// type data
// /=> 95h
//
// @example Generating compound byte data
// data: .z.m.qch.g.reify .z.m.qch.g.compound .z.m.qch.g.byte[]
// /=> 0xb5113ba623
// /=> 0x00fbdac5d9bc1c96049fba474046c98dc24f88
// /=> 0x60d0342808
// /=> 0xa0d57c013ff5041cebeb65844eae
// /=> 0x8be2ef457bfc3a
// /=> ..
// 
// type data
// /=> 81h
//
// @param x {#.z.m.qch.genS} Generator seed
// 
// @return {#.z.m.qch.genS} Compound data generator
//
// @see nested
.z.m.qch.g.compound:{[x]
    : $[genS.is x;
            g.compound_.i.fromGen x;
        // else
            g.compound_.i.fromNull[]];
    }
// @private
.z.m.qch.g.compound_.i.fromGen:{[gen]
    : g.new (
        
        // Arb
        {[gen; x]
            item : g.reify g.nested gen;
            compound: exec item from get h:hsym["S"$string[rand 0ng],"/"] set ([] item:item);    
            // @qlintsuppress MISSING_DEPENDENCY(1)
            @[i.fdel; h; `];
            : compound
            } gen;    
        
        // Shrink
        (::);
        
        // Less Than
        {[a;b]: (count a) < count b }
        );
    }

// @private
.z.m.qch.g.compound_.i.fromNull:{[]
    gens: (g.basetypes key[g.basetypes] except 11) @\: (::);
    : g.oneof g.compound each gens;
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for generating constant values.
//
// @example Constant 5s
// .z.m.qch.g.reify .z.m.qch.g.const 5
.z.m.qch.g.const:{[v]
    : g.new (
        // Arb
        {[v;y] v}[v;];
        // Shrink
        (::);
        // Less Than
        (::)
        );
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random dates.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.date[]
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.date 2012.12.31
.z.m.qch.g.date:{[range]
    // The range is the maximum date value in q
    if [(::) ~ range; range: 2290.12.31];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random datetimes.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.datetime[]
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.datetime 2012.12.31T23:59:59.999
.z.m.qch.g.datetime:{[range]
    // Maximum datetime that can be represented in q
    // @qlintsuppress DEPRECATED_DATETIME(1)
    if [(::) ~ range; range: 2290.12.31T23:59:59.999];
    
    : g.new (
        // Arb
        {[x;y] rand x } range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random dictionaries
//
// @example Random dictionaries
// .z.m.qch.g.reify .z.m.qch.g.dict[]
// /=> foahnn | 0x6a
// /=> lde    | 14:10:15
// /=> jipolcm| 2276.03.28D19:29:46.168452096
//
// @example Random dictionaries of specified keys and types
// .z.m.qch.g.reify .z.m.qch.g.dict `a`b`c!(.z.m.qch.g.char[]; .z.m.qch.g.list .z.m.qch.g.boolean[]; .z.m.qch.g.int[])
// /=> a| "v"
// /=> b| 110b
// /=> c| -134832122i
.z.m.qch.g.dict:{[x]

    : $[99h ~ type x;
            g.dict_.i.fromDict x;
        x ~ (::);
            g.dict_.i.fromNull[];
            g.dict_.i.fromNull[]];
    
    }

// @private
.z.m.qch.g.dict_.i.fromDict:{[gendict]
    ks : key gendict;
    gens : value gendict;
    
    : g.new (
        
        // Arb
        {[ks; gens; z]
            : ks!g.reify each gens;
            }[ks; gens; ];
        
        // Shrink
        {[gendict; arb]
            // shrink each key
            : raze {[gendict; arb; k] arb ,/: g.dict_.i.shrinkKey [gendict; k; arb]}[gendict; arb] each key gendict;
            } gendict;
        
        // Less
        {[gendict; a; b]
            
            // a dictionary is less than another if it has keys that are less than the other
            lessDict : key[gendict]!genS.less each value gendict;            
            lessCount : {[lessDict; a; b; k]
                : lessDict[k][a k;b k];
                }[lessDict; a; b] each where not null lessDict;                                    
            : any lessCount; 
            
            } gendict
        );
    }

// @private
.z.m.qch.g.dict_.i.fromNull:{[]
    : g.new ({
        size : first 1? genS.maxSize x;
        gendict : g.reify[g.listn[size] g.symbol[]]!size#enlist g.any[];

        : g.reify g.dict_.i.fromDict gendict;
        };
        ::;
        ::
        );
    }

// @private
.z.m.qch.g.dict_.i.shrinkKey:{[gendict; k; arb]
    shr : genS.shrink gendict k;
    if [.z.m.axq.isNull shr;   
        : enlist arb];
    
    candidates : shr arb k;
    : (!) .' enlist[enlist k] ,/: enlist each enlist each candidates;
    } 

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator that randomly samples from a list of values
//
// @example 
// .z.m.qch.g.reify .z.m.qch.g.elements (1; `hi; `a`b!1 2)
// /=> 1
//
// @example 
// .z.m.qch.g.reify .z.m.qch.g.list .z.m.qch.g.elements (1; `hi; `a`b!1 2)
// /=> `a`b!1 2
// /=> `hi
// /=> 1
// /=> `hi
// /=> 1
// /=> `hi
// /=> `a`b!1 2
// /=> `hi
// /=> `a`b!1 2
// /=> `hi
// /=> 1
// /=> `a`b!1 2
.z.m.qch.g.elements:{[els]
    
    : g.oneof g.const each els
    
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// Constructs a generator for random enumerated symbols. All symbols
// are enumerated against a global sym vector.
//
// @example Any random enumerated value
// .z.m.qch.g.reify .z.m.qch.g.enum[]
// /=> `sym$`ddfij
//
// @example An enumerated value of length 8
// .z.m.qch.g.reify .z.m.qch.g.enum 8
// /=> `sym$`mieldlnd
//
// @param range {string | symbol | null} Range of symbols to generate
// 
// @return {#.z.m.qch.genS} A enumeration generator
//
// @see symbol
.z.m.qch.g.enum:{[range]
    : g.new (
        {[x;y]
            : `sym?g.reify g.symbol x
            } range;
        (::);
        (::)
        )
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random floats.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example Random floats
// .z.m.qch.g.reify .z.m.qch.g.float[]
//
// @example Floats less than 500
// .z.m.qch.g.reify .z.m.qch.g.float 500f
.z.m.qch.g.float:{[range]
    // Maximum float value in q
    if [(::) ~ range; range: "f"$2 xexp 1023];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } "f"$range; 
        // Shrink
        g.i.shrinkNum"f";
        // Less Than
        {[a;b] abs[a] < abs b }
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random GUIDs.
//
// @example Random GUIDs
// .z.m.qch.g.reify .z.m.qch.g.guid[]
// /=> 3c4dcb4f-cfbd-6902-e6ff-143a01109013
.z.m.qch.g.guid:{[]
    : g.new (
        // Arb
        {[x] 
            // There is a q bug where guid generation in a tight
            // loop is not random so we need to sleep for 1
            // microsecond to be random enough.
            // 50000 {x xexp 7 % 3}/2;
            rand 0Ng 
            }; 
        // Shrink
        (::);
        // Less Than
        (::)
        );
    }
// @private
.z.m.qch.g.i.emptyList:{[gen]
    reified : g.reify gen;
    metatype : type reified;
    
    : $[metatype > 0h; (); metatype = -20; `sym$(); metatype$()];    
    }
.z.m.qch.g.i.shrinkNum:{[t;v]
    if [v = 0; : enlist v];
    sign: $[v<0;neg;::];
    : t$sign 20?abs v;
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random ints.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example Random ints
// .z.m.qch.g.reify .z.m.qch.g.int[]
//
// @example Ints less than 500
// .z.m.qch.g.reify .z.m.qch.g.int 500
.z.m.qch.g.int:{[range]
    if [(::) ~ range; range: 0i];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } "i"$range; 
        // Shrink
        // want 20 numbers that are closer to 0
        g.i.shrinkNum"i";
        // Less Than
        {[a;b] abs[a] < abs b }
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random integers (shorts, ints, or longs).
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example Random integers
// .z.m.qch.g.reify .z.m.qch.g.integer[]
.z.m.qch.g.integer:{[]
    : g.oneof (g.short[]; g.int[]; g.long[]);
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// Generator for a random keyed table
//
// @example Random keyed tables
// .z.m.qch.g.reify .z.m.qch.g.keyed[]
//
// /=> bjkjm      dkkin      | haono lobcj        eibac                                kldpc               
// /=> ----------------------| ----------------------------------------------------------------------------
// /=> 2223.11.08 -176583628 | 1     9.383562e+37 e417caff-59f9-4cd3-5f48-76fa2cdc9791 -471413405933135178 
// /=> 2202.05.16 -1247002427| 0     6.835657e+37 6f53f082-97ab-d300-1a00-685041531f7b -3870884166007458545
// /=> 2207.02.21 -1309403346| 0     9.480811e+37 96dd94d1-b951-eb84-ac5c-9c2a3214f784 -3387762304318492719
// /=> 2282.10.22 1561366720 | 0     1.867861e+37 a0b16096-a462-5eff-09dc-61f2e753d689 766242245343837302  
// /=> 2056.01.06 -204003469 | 1     7.917941e+37 50bfd09c-9caf-17a6-4bbd-e467abd9353a 8565158336067688102 
//
// @example Random keyed tables from a schema
// .z.m.qch.g.reify .z.m.qch.g.keyed ([a: enlist .z.m.qch.g.int[]] b:enlist .z.m.qch.g.list .z.m.qch.g.boolean[])
//
// /=> a          | b                   
// /=> -----------| --------------------
// /=> -1404973722| 111001010b          
// /=> -1558646847| 110010000001b       
// /=> -1056169914| 0111001011111110b   
// /=> -2061464593| 111111b             
// /=> 1700923440 | 0011011101011100011b
.z.m.qch.g.keyed:{
    $[type[x] ~ 98h;
            '.z.m.axlocalize.t`.qch_genKeyedTypeError;
       type[x] ~ 99h;
            g.table_.i.fromTable x;
       // Else
            g.keyed_.i.fromNull[]
        ]
    }

// @private
.z.m.qch.g.keyed_.i.fromNull:{[]
    : g.new (
        {
             size : first 2 + 1?genS.maxSize x;    
             gens : g.any[] , (value g.basetypes) @\: (::);
             idxs : size ? count gens;

             colz : size?`5;
             keyz :(first 1 + 1?size)?-1_colz;             
            
             :keyz xkey g.reify g.table_.i.fromTable 
                flip colz!enlist each gens idxs; 
             };
        
        // Shrink
        {[table]
            size:count table;
            : {[table; size; z] select from table where i in size?size}[table;size] each til 20;
            };
        
        // Less Than
        {[a;b]
            : (count a) < count b;
            }
        )
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// Generator for lists of any other generator.
//
// @example Random lists (homogeneous and heterogeneous)
// .z.m.qch.g.reify .z.m.qch.g.list[]
//
// /=> 04:10 19:22 14:58 22:24 19:59 19:51 01:33 
//
// @example Random lists of integers
// .z.m.qch.g.reify .z.m.qch.g.list .z.m.qch.g.int[]
//
// /=> 151062153 -544442381 -1198138497 -53500579 890403070
//
// @example Random lists of lists of booleans
// .z.m.qch.g.reify .z.m.qch.g.list .z.m.qch.g.list .z.m.qch.g.boolean[]
//
// /=> 100b
// /=> 1011010b
// /=> 010111100111b
// /=> 0000011111110b
// /=> 1000001110b
.z.m.qch.g.list:{[x]
    : $[genS.is x;
            g.list_.i.fromGen x;
        x ~ (::);
            g.list_.i.fromNull[];
        // Else
            g.list_.i.fromNull[]];
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// Generator for lists of at least a given size of any other generator.
//
// @example Random lists of integers greater than length 2
// .z.m.qch.g.reify .z.m.qch.g.listOfOver[2] .z.m.qch.g.int[]
//
// /=> 151062153 -544442381 -1198138497 -53500579 890403070
//
// @example Random lists of non-empty lists of booleans
// .z.m.qch.g.reify .z.m.qch.g.list .z.m.qch.g.listOfOver[0] .z.m.qch.g.boolean[]
//
// /=> 100b
// /=> 1011010b
// /=> 010111100111b
// /=> 0000011111110b
// /=> 1000001110b
.z.m.qch.g.listOfOver:{[size; gen]
    : g.new (
        
        // Arb
        {[size; gen; x]
            list : {[gen;z] g.reify gen}[gen] each til size + first 1?genS.maxSize x;
            // Ensure generated empty lists have the correct type
            : $[0 = count list;
                g.i.emptyList gen; // (neg type item)$list;
                list];
            }[size; gen];    
        
        // Shrink
        {[size; list]
            thissize:count list;
            : {[list;thissize;size;x] list@where @[thissize?0b;size?thissize;:;1b]}[list;thissize;size] each til 20;
            } size;
        
        // Less Than
        {[a;b]
            : (count a) < count b;
            }
        );
    }

// @private
.z.m.qch.g.list_.i.fromGen:{[gen]
    : g.new (
        
        // Arb
        {[gen; x]
            list : {[gen;z] g.reify gen}[gen] each til first 1?genS.maxSize x;
            // Ensure generated empty lists have the correct type
            : $[0 = count list;
                g.i.emptyList gen;
                list];
            } gen;    
        
        // Shrink
        {[list]
            size:count list;
            : {[x;y;z] x@where y?0b}[list;size] each til 20;
            };
        
        // Less Than
        {[a;b]
            : (count a) < count b;
            }
        );
    }

// @private
.z.m.qch.g.list_.i.fromNull:{[]
    gens : g.any[] , (value g.basetypes) @\: (::);
    : g.oneof g.list each gens;
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// Generator for lists of a given size of any other generator.
//
// @example Random lists of 5 integers less than 500
// .z.m.qch.g.reify .z.m.qch.g.listn[5] .z.m.qch.g.int 500
//
// /=> 274 139 36 171 338i
//
// @example Random lists of 3x3 matrices of booleans
// .z.m.qch.g.reify .z.m.qch.g.list .z.m.qch.g.listn[3] .z.m.qch.g.listn[3] .z.m.qch.g.boolean[]
//
// /=> 111b 110b 011b
// /=> 001b 000b 110b
// /=> 001b 001b 100b
// /=> 010b 010b 100b
.z.m.qch.g.listn:{[size; gen]
    : g.new (
        
        // Arb
        {[size;gen; z]
            items: {[gen;z] g.reify gen}[gen] each til size;
            
            $[0 = count items;
                g.i.emptyList[gen];
                items]
            }[size;gen];       
        
        // Shrink
        ::;
        
        // Less Than
        ::
        );
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random longs.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example Random longs
// .z.m.qch.g.reify .z.m.qch.g.long[]
//
// @example Longs less than 500
// .z.m.qch.g.reify .z.m.qch.g.long 500
.z.m.qch.g.long:{[range]
    if [(::) ~ range; range: 0j];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } "j"$range; 
        // Shrink
        g.i.shrinkNum"j";
        // Less Than
        {[a;b] abs[a] < abs b }
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// Set the max size of a generator
//
// @example Lists of at-most 100 booleans
// .z.m.qch.g.reify .z.m.qch.g.maxSize[100] .z.m.qch.g.list .z.m.qch.g.boolean[]
//
// /=> 0000000011000100101110101110101011100110000010b
.z.m.qch.g.maxSize:{[m; a]
    
    : .z.m.qch.genS.with.maxSize[m] a
    
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random minutes.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.minute[]
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.minute 25:00
.z.m.qch.g.minute:{[range]
    if [(::) ~ range; range: 00:00];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random months.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.month[]
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.month 2012.12m
.z.m.qch.g.month:{[range]
    // Maximum month that can be represented in q
    if [(::) ~ range; range: 2290.12m];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// Constructs a generator for creating a list of vectors of
// data. The type of the vector will be the same. 
//
// @example Generating random nested data
// .z.m.qch.g.reify .z.m.qch.g.nested[]
// /=> 1020533141 2038304737 -2001980136 1197013848i
// /=> 1770832780 -910248685i
// /=> 589771609 -1553480334 266104978 -393366211 -1865821815i
// /=> 64733367 -434499523 418052461 89774811  
// /=> 2134963136 -1585171842 -1497061815 596552950 1299989849i
// /=> ..
//
// @example Generating nested strings
// .z.m.qch.g.reify .z.m.qch.g.nested .z.m.qch.g.char[]
// /=> "kabxluajuhqz"
// /=> "jmancm"
// /=> "aey"
// /=> ""
// /=> "kckrosuzh"
// /=> ..
//
// @param arb {#.z.m.qch.genS} Generator to use as seed 
// 
// @return {#.z.m.qch.genS} Nested data generator
.z.m.qch.g.nested:{[arb]    
    : g.new (
        {[x;y] g.reify g.list g.list $[ (::) ~ x; (first 1?value g.basetypes)[]; x] } arb;
        (::);
        (::)
        )
    
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// Create a new generator to generate custom values. Requires three fields: see examples below.
//
// @example A generator with shrinking support
// myGen: .z.m.qch.g.new (
//     // niladic function creating a random value
//     {rand 10}; // random int
//     // shrinking function
//     {20?x}; // 20 random values smaller than x
//     // less-than function for comparing to shrunk values in size
//     <)
// 
// .z.m.qch.g.reify myGen
// /=> 4
//
// .z.m.qch.summary .z.m.qch.check .z.m.qch.forall [myGen] {x=x}
// /=> "OK, passed 100 tests."
//
// @example A generator with no shrinking support
// myGen: .z.m.qch.g.new (
//     // niladic function creating a random value
//     {rand 10}; // random int
//     // shrinking function
//     ::; 
//     // less-than function 
//     ::)
// 
// .z.m.qch.g.reify myGen
// /=> 7
//
// .z.m.qch.summary .z.m.qch.check .z.m.qch.forall [myGen] {x=x}
// /=> "OK, passed 100 tests."

.z.m.qch.g.new:{[l]    
    : genS.new l , g.i.MAXSIZE
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random nulls.
.z.m.qch.g.null:{[]
    : g.new (
        // Arb
        {[x] first 1?value g.i.NULL }; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random numeric values (short, int, long, real, or float).
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example 
// .z.m.qch.g.reify .z.m.qch.g.number[]
// /=> 352745i
.z.m.qch.g.number:{[]
    g.oneof (g.short[]; g.int[]; g.long[]; g.real[]; g.float[])
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for randomly sampling from a list of other generators.
// 
// @example Either a character or an int less than 500
// .z.m.qch.g.reify .z.m.qch.g.oneof (.z.m.qch.g.char[]; .z.m.qch.g.int 500)
//
// @example Either an int, or an int null or infinity
// .z.m.qch.g.reify .z.m.qch.g.oneof (.z.m.qch.g.int[]; .z.m.qch.g.const 0Ni; .z.m.qch.g.const 0Wi; .z.m.qch.g.const -0Wi)

.z.m.qch.g.oneof:{[genlist]
    
    : g.new (
        // Arb
        {[genlist;y] : g.reify genlist@first 1?count genlist; }[genlist;];
        // Shrink
        (::);
        // Less Than
        (::)
        );
    
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for randomly sampling from a list of other generators with weights on the sampling frequencies.
// 
// @example An int 80% of the time, a character 20% of the time
// .z.m.qch.g.reify .z.m.qch.g.oneof_w[(.z.m.qch.g.char[]; .z.m.qch.g.int 500)] 20 80
//
// @example Usually an int, but occasionally an int null or infinity
// .z.m.qch.g.reify .z.m.qch.g.oneof_w [(.z.m.qch.g.int[]; .z.m.qch.g.const 0Ni; .z.m.qch.g.const 0Wi; .z.m.qch.g.const -0Wi)] 85 5 5 5

.z.m.qch.g.oneof_w:{[genlist; weights]
    weightsum : sum weights;
    if [not weightsum > 0; '.z.m.axlocalize.t`.qch_genOneOfWError];
    
    : g.new (
        // Arb
        {[genlist; weights; weightsum;z] 
            percents : "j"$ sums 100 * weights % weightsum;
            target : 0f;
            while [target = 0f; target: first 1?100f];
            index : min (-[;1] count percents) , (asc "f"$percents,target)?target;
            gen : genlist index;
            : g.reify gen; 
            }[genlist; weights; weightsum;];
        // Shrink
        (::);
        // Less Than
        (::)
        );
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for floats within a given range.
// 
// @example
// .z.m.qch.g.reify .z.m.qch.g.range.float[50;100]
.z.m.qch.g.range.float:{[Min; Max]
    
    : g.new (
        // Arb
        {[Min;Max;z] "f"$first Min + 1? Max - Min }["f"$Min;"f"$Max]; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for ints within a given range.
// 
// @example
// .z.m.qch.g.reify .z.m.qch.g.range.int[50;100]
.z.m.qch.g.range.int:{[Min; Max]
    
    : g.new (
        // Arb
        {[Min;Max;z] "i"$first Min + 1? Max - Min }["i"$Min;"i"$Max]; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for longs within a given range.
// 
// @example
// .z.m.qch.g.reify .z.m.qch.g.range.long[50;100]
.z.m.qch.g.range.long:{[Min; Max]
    
    : g.new (
        // Arb
        {[Min;Max;z] "j"$first Min + 1? Max - Min }["j"$Min;"j"$Max]; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for reals within a given range.
// 
// @example
// .z.m.qch.g.reify .z.m.qch.g.range.real[50;100]
.z.m.qch.g.range.real:{[Min; Max]
    
    : g.new (
        // Arb
        {[Min;Max;z] "e"$first Min + 1? Max - Min }["e"$Min;"e"$Max]; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for shorts within a given range.
// 
// @example
// .z.m.qch.g.reify .z.m.qch.g.range.short[50;100]
.z.m.qch.g.range.short:{[Min; Max]
    
    : g.new (
        // Arb
        {[Min;Max;z] "h"$first Min + 1? Max - Min }["h"$Min;"h"$Max]; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random reals.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example Random reals
// .z.m.qch.g.reify .z.m.qch.g.real[]
//
// @example Reals less than 500
// .z.m.qch.g.reify .z.m.qch.g.real 500
.z.m.qch.g.real:{[range]
    // Maximum real value in q
    if [(::) ~ range; range: "e"$2 xexp 127];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } "e"$range; 
        // Shrink
        g.i.shrinkNum"e";
        // Less Than
        {[a;b] abs[a] < abs b }
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// Given any generator, return a concrete random value described by the generator.
// This is useful for testing generators before using them within .qch properties.
.z.m.qch.g.reify:{[gen]
    : $[genS.is gen; (genS.arb gen) gen; gen]
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random seconds.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.second[]
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.time 12:00:00
.z.m.qch.g.second:{[range]
    if [(::) ~ range; range: 00:00:00];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random shorts.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example Random shorts
// .z.m.qch.g.reify .z.m.qch.g.short[]
//
// @example Shorts less than 500
// .z.m.qch.g.reify .z.m.qch.g.short 500
.z.m.qch.g.short:{[range]
    if [(::) ~ range; range: 0h];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } "h"$range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random symbols.
//
// @example Random symbols
// .z.m.qch.g.reify .z.m.qch.g.symbol[]
// /=> `phmici
//
// @example Symbol of length 3 (can be specified to a length of 8)
// .z.m.qch.g.reify .z.m.qch.g.symbol 3
// `fmm
.z.m.qch.g.symbol:{[range]    
    
    : g.new (
        // Arb        
        {[x;y] 
            $[(::) ~ x; 
                    first 1?`$string 1 + first 1?7; 
                11h ~ type x;
                    first 1?first 1?x;
                ("S"$string x) in `1`2`3`4`5`6`7`8;
                    first 1?"S"$string x;
                    '.z.m.axlocalize.t`.qch_genSymbolError
                ] } range; 
        // Shrink
        ::;
        // Less Than
        ::
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random tables.
//
// @example Random tables
// .z.m.qch.g.reify .z.m.qch.g.table[]
//
// /=> efdmh        iggdd                   gcgkm       
// /=> -------------------------------------------------
// /=> 4.524037e+37 2184.10.25T02:00:08.623 6.000541e+36
// /=> 1.240279e+38 2075.01.30T16:55:30.308 1.269743e+38
// /=> 5.251156e+35 2221.09.19T22:34:27.187 2.194081e+37
// /=> 6.122624e+37 2260.07.07T02:24:18.372 1.103271e+38
// /=> 3.799086e+37 2088.07.16T16:39:00.285 2.699894e+37
// /=> 1.208169e+38 2204.05.19T03:12:56.340 7.899556e+37
// /=> 3.141901e+37 2193.12.07T17:06:00.222 4.478858e+36
//
// @example Tables from a given schema
// .z.m.qch.g.reify .z.m.qch.g.table ([] x:enlist .z.m.qch.g.int[]; y:enlist .z.m.qch.g.dict[])
//
// /=> x           y
// /=> --------------------------------------------------------------...
// /=> -1573632087 `dkfemae`a`f`hm`pn!(12:08;2053.01.05D03:49:57.9802...
// /=> -1418157304 `kgl`mnkp`gl`ek`h`ophnmj`cph`pfcegf`k`kbkdlcj`pnoa...
// /=> 912063864   `gopmbcm`jkfmkk`klla`ikef`aicdi`npjbdkk`ded`ip`gpa...
// /=> -1686696290 `odneane`h!(04:47;15:51:03.060)                   ...
// /=> -1913423816 `ndcdod`miokb`aalkjj`hninggm`ohie!(2.304558e+37e;2...
// /=> -1590432310 `kiioda`odplhnp`mdkjodh`mjaan`meai`ncfl`cngjig`mij...
// /=> 401050771   `kflb`dojceig`bf`nanflif`oggelof`ijman`f`no`ig`eke...
// /=> -68902089   `joldn`egcg`goindlk`capp`kmhbh`imjac`pdcejn`cnc`jg...
// /=> -116753778  `cn`mfef`eglk`dcdikk`eko`nel`lcpl`bgafdji`do`bffn`...
// /=> -1964238123 `ibie`n`femm`nad`iled`kolc`pefkd`hmbknan`pebbbfa`b...
// /=> 670859816   `ngo`cmhmdf`ndjlhmd`m`epehbl`p`bce`eiin`eebhdmf`m`...
// /=> 1840155645  `mjc`laije`cahak`md`lbjma`mmlkmf!(16:40;7.13068e+3...
// /=> 1289980260  `kegdem`jd`idiad`c`jejkp`p`h`p`iic`d`hgee`ga`c`mh`...
// /=> -1358539171 `np`en`hcck`jhfd`pbmf`nldm`c`lknifc`jfpl`of`j`k`la...
// /=> -984014185  `icl`kk`la`edhhkm`edgblp`jpdeckl!(0D09:27:35.29826...
// /=> -1646344682 `dimk`bplmaa`dggckag`lco`nph`fnbblb`gemjjca`l`aibj...
//
// @example Keyed tables from a given schema
// .z.m.qch.g.reify .z.m.qch.g.table ([k1: enlist .z.m.qch.g.symbol[]; 
//                             k2: enlist .z.m.qch.g.long[]] 
//                                 x: enlist .z.m.qch.g.int[]; 
//                                 y:enlist .z.m.qch.g.list .z.m.qch.g.char[])
//
// /=> k1     k2                  | x           y                    
// /=> ---------------------------| ---------------------------------
// /=> gkmo   -4620228702888752122| -596722939  "zbveiddit"          
// /=> p      -8969560743393333501| 1622635350  "phwngtrg"           
// /=> hnid   2290267908964463926 | -1067967729 "rxbdfwrmirybvgx"    
// /=> miim   3174895780893159393 | 455416790   "agmosdfcjlepqdvdjei"
// /=> fcdbco 5744985942359303171 | -205496694  "bqxzfkft"           
// /=> cb     -585435820506416102 | -1561250000 "nzdif"              
// /=> okianf 6464196016496855392 | 604935528   ""                   
// /=> cfap   3576779043742497448 | 894171413   "pbszohjnpmxtkts"    
// /=> bmhpe  7796861097321068210 | 1864374805  "zeszerbqlsy"    

.z.m.qch.g.table:{[x]
    
    : $[type[x] in 98 99h;
            g.table_.i.fromTable x;
        x ~ (::);
            g.table_.i.fromNull[];
        // Else
            g.table_.i.fromNull[]];
    
    }
// @private
.z.m.qch.g.table_.i.fromNull:{[]
    
    : g.new (
        
        {
             size : first 1 + 1?genS.maxSize x;    
             gens : g.any[] , (value g.basetypes) @\: (::);
             idxs : size ? count gens;

             Cols : size?`5;    
             : g.reify g.table_.i.fromTable 
                flip Cols!enlist each gens idxs; 
             };
        
        // Shrink
        {[table]
            size:count table;
            : {[table; size; z] table@where size?0b}[table;size] each til 20;
            };
        
        // Less Than
        {[a;b]
            : (count a) < count b;
            }
        
        );
    }

// @private
.z.m.qch.g.table_.i.fromTable:{[genTable]
    
    Keys : keys genTable;
    genDict : flip 0!genTable;
    genList : value genDict;
    Cols : key genDict;
    
    : g.new (
        {[Keys; Cols; genList; x] 
            size : first 1?genS.maxSize x;
            : Keys xkey flip Cols!g.reify each g.listn[size] each first each genList;            
            }[Keys; Cols; genList];
        
        // Shrink
        {[Keys; table]
            // keyed
            size:count table;
            : {[Keys; table; size; z] Keys xkey (0!table)@where size?0b}[Keys;table;size] each til 20;
            } Keys;
        
        // Less Than
        {[a;b]
            : (count a) < count b;
            }
        );
    
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random times.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.time[]
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.time 12:00:00.000
.z.m.qch.g.time:{[range]
    if [(::) ~ range; range: 00:00:00.000];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random timespans.
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.timespan[]
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.timespan 12:00:00.000000000
.z.m.qch.g.timespan:{[range]
    if [(::) ~ range; range: 00:00:00.000000000];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for random timestamps
//
// Note - will NOT generate nulls/infinities. For this, see .z.m.qch.g.messy.\*.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.timestamp[]
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.timestamp 2020.12.31D23:59:59.999999999
.z.m.qch.g.timestamp:{[range]
    // Maximum timestamp that can be represented in q
    if [(::) ~ range; range: 2290.12.31D23:59:59.999999999];
    
    : g.new (
        // Arb
        {[x;y] first 1?x } "p"$range; 
        // Shrink
        (::);
        // Less Than
        (::)
        ) 
    }
 
// @subcategory QuickCheck - Generators
// @fileOverview
// A generator for tuples of a given description.
//
// @example
// .z.m.qch.g.reify .z.m.qch.g.tuple (.z.m.qch.g.char[]; .z.m.qch.g.list .z.m.qch.g.bool[]; .z.m.qch.g.symbol[])
// /=> ("e"; 001010111b; `emfambc)
.z.m.qch.g.tuple:{[genTuple]
    
    : g.new (
        
        // Arb
        {[genTuple;y] g.reify each genTuple } genTuple; 
        
        // Shrink
        {[genTuple;arb]
            // Cat all the possible shrinks of each element of the tuple
            : raze g.tuple_.i.shrinkEl[genTuple; ;arb] each til count genTuple;
            } genTuple;
        
        // Less Than
        {[genTuple;a;b]
            lessTuple : genS.less each genTuple;            
            lessCount : {[lessTuple; a; b; i]
                : lessTuple[i][a i;b i];
                }[lessTuple; a; b] each where not null lessTuple;                                    
            : any lessCount; 
            } genTuple
        );
    }
// @private
.z.m.qch.g.tuple_.i.shrinkEl:{[genTuple; i; arb]
    shr : genS.shrink genTuple i;
    if [.z.m.axq.isNull shr;   
        : enlist arb];
    
    candidates: shr arb i;
    : {[arb;i;c] arb[i]:c; : arb }[arb;i] each candidates;
    
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// Returns the distinct results from the given generator
//
// @example Generating unique integers
// .z.m.qch.g.reify .z.m.qch.g.unique .z.m.qch.g.list .z.m.qch.g.int[5]
// /=> 3 0 4 1 2i
// 
// @param gen {#.z.m.qch.genS} Seed generator to get values from
//
// @return {#.z.m.qch.genS}
.z.m.qch.g.unique:{[gen]
    : g.new (
        // Arb
        {[gen; z]
            item: g.reify gen;
            : $[(99h ~ type item) | 0 > type item; item; distinct item];
            } gen;
        
        (::);
        (::)
        );
    }
// @subcategory QuickCheck - Generators
// @fileOverview
// Generator for a list of *at least* a given length of unique items.
//
// @example
// count distinct .z.m.qch.g.reify .z.m.qch.g.uniqueOfOver[20] .z.m.qch.g.symbol[]
// 26
//
// @see listOfOver unique
.z.m.qch.g.uniqueOfOver:{[size; gen]
    : g.new (
        // Arb
        {[size; gen; x]
            list : {[gen;z] g.reify gen}[gen] each til size + first 1?genS.maxSize x;
            if [(99h ~ type list) | 0 > type list; 
                : list];
            dlist : distinct list;
            if [(size+1) > count dlist;
                dlist: @[;1]
                    {[size;x]((1+size) > count x 1)and 100 > x 0}[size] 
                    {[gen;x](1+x 0;distinct x[1],g.reify gen)}[gen]/(0;dlist);
                if [(size+1) > count dlist; '.z.m.axlocalize.t`.qch_genUniqueOfOverError]];
            
            : dlist;
            }[size; gen];
        // Shrink
        ::;
        // Less Than
        ::
        );
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// Generates unique random data that is the same size
// as the data originally generated by the given generator
//
// @example Generating a unique list of 5 integers
// .z.m.qch.g.reify .z.m.qch.g.uniquen .z.m.qch.g.listn[5] .z.m.qch.g.int[]
// /=> 7 3 4 5 8i
//
// @param gen {#.z.m.qch.genS} Seed generator to get values from
//
// @return {#.z.m.qch.genS}
//
// @see unique listn
.z.m.qch.g.uniquen:{[gen]
    : g.new (
        // Arb
        {[gen; z]
            item: g.reify gen;
            if[(99h ~ type item) | 0 > type item; 
                    : item
                ];
            
            if[98h ~ type item;
                : distinct item
                ];
            
            iter: 0;
            uniq: distinct item;
            while[count[uniq] < count item;
                if[g.i.maxIters ~ iter+:1;
                    '.z.m.axlocalize.t`.qch_genUniqueNError
                    ];
                uniq: distinct count[item]#uniq, g.reify gen
                ];
            
            : uniq;            
            } gen;
        
        (::);
        (::)
        );
    }

// @subcategory QuickCheck - Generators
// @fileOverview
// A generator wrapper around Q random number generation. This
// is much faster than generating vectors using .z.m.qch.g.listn.
//
// @example 20 random values between 0 and 500
// .z.m.qch.g.reify .z.m.qch.g.vector[20;500]
// /=> 452 314 81 332 193 110 210 410 245 278 446 425 143 487 145 225 242 153 127 388
.z.m.qch.g.vector:{[left; right]
    
    : g.new (
        
        // arb
        {[left; right; empty] : left?right }[left; right];
        
        // shrink
        ::;
        
        // less
        ::
        
        );
        
    
    }

// @qlintsuppress UNUSED_INTERNAL
.z.m.qch.g.i.translations:.z.m.axlocalize.addTranslations (!) . flip 
    enlist
    (`en; (!) . flip (
        (`.qch_genUniqueNError; "unique generator reached maximum attempts");
        (`.qch_genUniqueOfOverError; "Could not find unique list in max iters");
        (`.qch_genSymbolError; "Unexpected argument");
        (`.qch_genOneOfWError; "Weights must be positive integers");
        (`.qch_genKeyedTypeError;"Keyed generator expects a keyed table")
    )) 
// @private
.z.m.qch.g.i.maxIters:50
// @private
.z.m.qch.g.i.NULL:(!) . flip (
    (`generic   ; (::));
    (`guid      ; 0ng );  
    (`short     ; 0Nh );
    (`int       ; 0Ni );
    (`long      ; 0N  );
    (`real      ; 0Ne );
    (`float     ; 0n  );
    (`char      ; " " );
    (`symbol    ; `   );
    (`month     ; 0Nm );
    (`date      ; 0Nd );
    // @qlintsuppress DEPRECATED_DATETIME(1)
    (`datetime  ; 0Nz );
    (`minute    ; 0Nu );
    (`second    ; 0Nv );
    (`time      ; 0Nt );
    (`timespan  ; 0Nn );
    (`timestamp ; 0Np )
    )
// @private
// Max size of generated data
.z.m.qch.g.i.MAXSIZE:20
// @subcategory QuickCheck - Generators
// @private
.z.m.qch.g.basetypes:(!) . flip ( 
        (1h;  g.bool);
        (2h;  g.guid);
        (4h;  g.byte);
        (5h;  g.short);
        (6h;  g.int);
        (7h;  g.long);
        (8h;  g.real);
        (9h;  g.float);
        (10h; g.char);
        (11h; g.symbol);
        (12h; g.timestamp);
        (13h; g.month);
        (14h; g.date);
        (15h; g.datetime);
        (16h; g.timespan);
        (17h; g.minute);
        (18h; g.second);
        (19h; g.time)
    )
// @subcategory QuickCheck - Generators
// @private
.z.m.qch.g.onLoad:{[]
    
    // @datatype .z.m.qch.genS
    // @fileOverview
    // Generator definition
    // @field arb {fn} generator
    // @field shrink {fn} create a number of possibly shrunk values from a value
    // @field less {fn} return true if left arg is less than right arg
    // @mutable maxSize {fn} maximum size/length to generate
    .z.m.axdatatype.create [`.z.m.qch.genS; `arb`shrink`less`maxSize; enlist `maxSize];
    
    }

.z.m.qch.g.onLoad[];
system "d .z.m";

system "d .z.m.axutl";
// @private
// @fileOverview
// Converts an atom to a JSON serialized format
// @param cfg  {#json.config}
// @param data {any}
// @return {string}
.z.m.axutl.json.i.atom:{[cfg; data]
    ty: type data;
    
    $[null data          ; "null";
      json.i.inf data    ; $[0 > data; "-inf"; "inf"];
      ty within -9 -5h   ; json.i.number[cfg; data];
      ty ~ -1h           ; ("false";"true") data;
      ty within -4 -2h   ; "\"",string[data],"\"";
      ty within -15 -12h ; json.i.date data;
      ty within -19 -16h ; "\"",string[data],"\"";
      ty within -76 -10h ; json.i.escape string data;
                           '"unexpected type in json stringify: ",string ty]
    }

// @private
// @fileOverview
// Converts a data or timestamp to JSON format
// @param data {date|timestamp|datetime|month}
// @return {string}
.z.m.axutl.json.i.date:{[data]
    // note: in 3.5 and older, D was used for timestamps, in newer versions of kdb it is T
    s: $[.z.K > 3.5; ssr[string data;"D";"T"]; string data];
    : "\"",@[s;2#where "." = s;:;"-"],"\""
    }

// @private
// @fileOverview
// Converts a dictionary to JSON serialization
// @param cfg  {#json.config}
// @param data {any}
// @return {string[]}
.z.m.axutl.json.i.dict:{[cfg; data]
    // keyed tables need to be unkeyed and converted as a list
    if[98h ~ type key data; : json.i.list[cfg; 0!data]];
    if[0 ~ count data; : enlist "{}"];
        
    wrap   : {$[x;enlist[enlist "{"],y,enlist enlist "}";enlist "{",raze[y],"}"]}; 
    expand : cfg[`expand] & cfg[`depth] < cfg`maxDepth;
    state  : `expand`depth!(expand; 1 + cfg`depth);
    pairs  : json.i.kv[cfg,state]'[key data; value data];
    indent : $[expand; cfg`indent; ""];    
    
    : wrap[expand] json.i.join[indent; pairs]
    }

// @private
// @fileOverview
// Escapes a string into a JSON representation
// @param str {string}
// @return {string} 
.z.m.axutl.json.i.escape:{[str]
    // pad a byte to be the smaller of 16 or 32 bits
    pad: {$[16 >= c:count x; ((16-c)#0b),x; ((32-c)#0b),x]};
    unicode: {[p;w;c] 0x0 vs 0b sv p raze ((1 + w) _ first b),2 _' 1 _ b: 0b vs' "x"$w#c} pad;

    str: ssr/[raze str; string "\\\t\r\n\""; ("\\\\"; "\\t";"\\r";"\\n";"\\\"")];
    
    // JSON strings are utf-8 encoded but require all unprintable
    // characters and invalid utf-8 sequences to be escaped as unicode
    // escapes. The following ranges are not printable.
    //
    // 0x00 - 0x20 - control characters
    // 0x73 - 0xa1 - control characters
    //
    // all other valid utf-8 characters that have a 1 in the first bit 
    // are valid unicode values
    //
    // valid utf-8 sequences
    // 0xc0 110xxxxx -> 2 bytes
    // 0xe0 1110xxxx -> 3 bytes
    // 0xf0 11110xxx -> 4 bytes
    //
    // all continuation bytes must follow
    // 0x80 10xxxxxx  
    escape: {[unicode; escaped; chars]
        width   : $[chars[0] within 0xc0df; 2; chars[0] within 0xe0ef; 3; chars[0] within 0xf0f7; 4; 1];
        valid   : $[1 ~ width   ; 1b; all (1_width#chars) within\: 0x80bf];
        visible : $[1 ~ width   ; chars[0] within 0x207f; 
                    2 ~ width   ; (0xc2 <  chars 0) | (0xc2 = chars 0) & 0xa0 < chars 1;
                    width in 3 4;  0x10 <= chars 1;
                                  1b];
        $[valid & visible;
            (escaped,width#chars; width _ chars);
          not visible;
            (escaped,raze "\\u",/:4 cut raze string unicode[width; chars]; width _ chars);
            (escaped,raze "\\u",raze string unicode[1; chars]; 1 _ chars)]
        }[unicode];
    
    : {"\"",x,"\""} first (count last@) (escape .)/(""; str); 
    }

// @private
// @fileOverview
// Joins nested structures into a single array of strings separated by commas
// @param indent {string}   Indent characters
// @param strs   {string[]} Strings to join
// @return {string}
// @example
// json.i.join["\t"]/[""; ("123"; ("{"; "\"x\": \"def\"";"}"))]
// /=> "\t123,"
// /=> "\t{"
// /=> "\t\"x\": \"def\""
// /=> "\t},"
.z.m.axutl.json.i.join:{[indent; strs]
    json.i.trimLast {y,$[10h~type z;enlist x,z,",";x,/:(-1_z),(-1#z),'","]}[indent]/["";strs]
    }
// @private
// @fileOverview
// Converts a key value pair to JSON 
// @param cfg {#json.config}
// @param k {any} key 
// @param v {any} value
// @return {string}
.z.m.axutl.json.i.kv:{[cfg; k; v]
    k: {y,":",x}[$[cfg`expand; " ";""]] first $[null k; enlist "\"\""; json.i.stringify[cfg] k];
    v: json.i.stringify[cfg] v;
    $[10h ~ type v; k,v; (enlist k,first v), 1 _ v]    
    }

// @private
// @fileOverview
// Converts a list to a JSON serialized format
// @param cfg  {#json.config}
// @param data {any}
// @return {string[]}
.z.m.axutl.json.i.list:{[cfg; data]
    ty: type data;
    
    // strings are special
    if[10h ~ ty; : enlist json.i.escape data];
    if[0 ~ count data; : enlist "[]"];
    
    table  : cfg[`expandTables]  | not 98h ~ ty;
    rows   : cfg[`expandRows]    | not 98h ~ ty;
    vector : cfg[`expandVectors] | not ty within 1 19h;
    expand : table & vector & cfg[`expand] & cfg[`depth] < cfg`maxDepth;
    state  : `expand`depth!(expand & rows; 1 + cfg`depth);
    indent : $[expand; cfg`indent; ""];
    
    wrap   : {enlist[enlist "["],x,enlist enlist"]"};
    flat   : {$[all 10h = type each x; x; raze x]};
    list   : (wrap indent,/:json.i.trimLast flat {((-1 _ x),'","),(-1#x),'","}@);
    
    values : $[ty within 5 9h; 
        list json.i.number[cfg,state] each data; 
        wrap json.i.join[indent] json.i.stringify[cfg,state] each data];
    
    : $[expand; values; enlist raze values]
    }

// @private
// @fileOverview
// Converts a number to JSON and preserves its value
// @param cfg  {#json.config}
// @param data {number}
// @return {string}
.z.m.axutl.json.i.number:{[cfg;data] 
    p: cfg`preserveNumbers;
    s: string data;
    t: ("j"$data) ~ "j"$"f"$data;
    $[json.i.inf data; $[0 > data; "-inf"; "inf"];
      not[p] | t     ; s;
                       "\"",s,"\""] 
    }

// @private
// @fileOverview
// Converts data to JSON
// @param cfg  {#json.config}
// @param data {any}
// @return {string|string[]}
.z.m.axutl.json.i.stringify:{[cfg; data]
    ty: type data;
    $[(::) ~ data     ; enlist "null";
      ty < 0h         ; enlist json.i.atom[cfg; data];
      ty within 0 98h ; json.i.list[cfg; data];
      ty ~ 99h        ; json.i.dict[cfg; data];
                        '"unexpected type in json stringify: ",string ty]
    }

// @fileOverview
// Converts any data structure to JSON format.
// @param cfg  {null | #json.config} 
// @param data {any}
// @return {string} JSON serialization of data
.z.m.axutl.json.i.to:{[cfg; data]
    cfg: json.config.default, $[(::) ~ cfg; ()!(); cfg];
    : cfg[`newline] sv json.i.stringify[cfg,`expand`depth!(1b; 0)] data
    }    
// @private
// @fileOverview
// Trims the last character from the last string in an array of strings
// @param x {string[]}
// @return {string[]}
.z.m.axutl.json.i.trimLast:{(-1 _ x),enlist -1 _ last x}
// @fileOverview
// Parses JSON into kdb data structures
// @param str {string} JSON formatted content
// @return {any} KDB representation of JSON data
.z.m.axutl.json.parse:{[str]
    $[`k in key `.j; .j.k str; '".j.k not supported in this version of kdb"]
    }

// @fileOverview
// Pretty prints an object in a JSON serialized format
// @param cfg  {null|#json.config}
// @param data {any}
// @return {string}
.z.m.axutl.json.prettyprint:{[cfg; data]
    cfg: json.config.pretty, $[(::) ~ cfg; ()!(); cfg];
    : json.i.to[cfg] data
    }

// @fileOverview
// Serializes kdb data structures into JSON
// @param data {any} KDB data to serialize
// @return {string} JSON serialization of data
.z.m.axutl.json.stringify:{[data]
    $[`j in key `.j; @[.j.j; data; {[x;y] json.i.to[::] x} data]; json.i.to[::] data]
    }

.z.m.axutl.json.i.inf:(raze (::;neg)@\:(0Wi;0W;0w;0we;0Wj;0Wh;0Wz;0Wd;0Wt;0Wv;0Wu))!22#1b;
// @fileOverview
// Pretty printing configuration for JSON serialization
// @kind data
// @return {#json.config}
.z.m.axutl.json.config.pretty:(!) . flip (
    (`preserveNumbers ; 0b);
    (`indent          ; "    ");
    (`newline         ; "\n");
    (`maxDepth        ; 4);
    (`expandTables    ; 1b);
    (`expandRows      ; 0b);
    (`expandVectors   ; 1b)
    )
// @fileOverview
// Default configuration for JSON serialization
// @kind data
// @return {#json.config}
.z.m.axutl.json.config.default:(!) . flip (
    (`preserveNumbers ; 0b);
    (`indent          ; "");
    (`newline         ; "");
    (`maxDepth        ; 0N);
    (`expandTables    ; 0b);
    (`expandRows      ; 0b);
    (`expandVectors   ; 0b)
    )
.z.m.axutl.json.onLoad:{[]
    
    // @typedef config {dict (
    //  preserveNumbers : boolean
    //  indent          : string;
    //  newline         : string;
    //  maxDepth        : long;
    //  expandTables    : boolean;
    //  expandRows      : boolean;
    //  expandVectors   : boolean
    //  )}
    //
    // @desc config.preserveNumbers If a number cannot be represented as a float
    //  due to preceision loss, represent the number as a string
    // @desc config.indent Characters to use as indentation
    // @desc config.newline Characters to use for newlines
    // @desc config.maxDepth
    //  Maximum depth to pretty print. Objects nested deeper than this
    //  depth will not be pretty printed
    // @desc config.expandTables
    //  If false, tables will be on a single line. If true, each row will be
    //  on its own line and expanded based on `expandRows`
    // @desc config.expandRows
    //  If false, the rows of a table will not be expanded. If true, each row
    //  is expanded unless maxDepth is reached.
    // @desc config.expandVectors
    //  If false, vectors will be inlined. If true, each value of a vector
    //  will be on a different line unless maxDepth is reached.
    
    }

.z.m.axutl.json.onLoad[];
system "d .z.m";

system "d .z.m.qch";
// @fileOverview
// Creates a table of any type (partitioned, splayed, serailized, keyed, etc)
// and returns either the handle or the table itself
// @end
//
// @param schema {table} A schema to conform to for this table
//
// @return {dict} A quickcheck generator
.z.m.qch.g.lib.anytable:{[schema]
    : g.new (        
        {[schema; y]
            
            // If the schema was not specified then create one
            if[not type[schema] in 98 99h;
                size    : first 1 + 1? genS.maxSize y;    
                gens    : (value g.basetypes) @\: (::);
                idxs    : size ? count gens;
                schema  : flip (size?`5)!enlist each gens idxs
                ];
            
            // Because we are potentially changing directories for each 
            // test iteration we need to change back to the original 
            // directory.
            system raze "cd ", g.lib.pwd[]; /dnl
            
            // Pick some random keys
            k: distinct (max enlist[1], -1 + first 1? count cols schema)?cols schema;
            
            // We cannot key a table that only has 1 column
            t: .z.m.qch.g.reify $[1 ~ count cols schema;
                    .z.m.qch.g.table schema;
                    .z.m.qch.g.oneof (.z.m.qch.g.table schema; .z.m.qch.g.keyed k xkey schema)
                ];
            
            // Determine the format of this table
            fmt: first 1?key g.lib.i.anytable;
            
            // If there are no record in the table then it cannot 
            // be partitioned and we must restart
            if[(fmt ~ `part) & 0 ~ count t; 
                : g.reify g.lib.anytable schema;
                ];
            
            // Find the write function
            fn: g.lib.i.anytable fmt;
            : fn[` sv `.z.m.qch.tables__,`$string rand 0ng] t;
            } schema; 
        
        (::);
        
        (::)
        ) 
    }

.z.m.qch.g.lib.cleanup:{[]
    system raze "cd ", g.lib.pwd[]; /dnl  
    // @qlintsuppress MISSING_DEPENDENCY(2)
    @[i.fdel; `:.z.m.qch.tables__; `];
    @[i.fdel; ; {x}] each hsym each k where (k:key `:.) like ".z.m.qch.tables__.*";
    
    ![`.qch; ();0b;enlist `tables__]
    }
.z.m.qch.g.lib.csv:{[delim]
    : g.new (
        {[delim; x]            
            size    : first 1 + 1? genS.maxSize x;    
            gens    : (value g.basetypes) @\: (::);
            idxs    : size ? count gens;
            schema  : flip (size?`5)!enlist each gens idxs;
            gen     : .z.m.qch.g.table schema;

            if[not -10h ~ type delim;
                delim: ","];
            
            : g.lib.i.handle[`csv] 0: delim 0: g.reify gen;
            } delim;
        (::);
        (::)
        );
    }

// @fileOverview
// Creates a quick check generator given a table meta. Supports atom and compound types only.
// @end
//
// @param m {table} The output of 'meta' on a table.
//
// @return {dict} A quickcheck generator for a table with the same meta as the input to this function.
.z.m.qch.g.lib.frommeta:{[m]
    m2:0!m; // hack
    t:.Q.t;td:t!"h"$til count t; // kdb type map for atomics which convinently maps to .z.m.qch.g.basetypes
    ct:@[;(::)] each .z.m.qch.g.basetypes @ td; // Qch type map for atomics;
    ct:ct,upper[t]!value .z.m.qch.g.list each ct;  // Qch type map for compounds;
    :.z.m.qch.g.table flip m2[`c]! enlist each ct @ m2 `t;
    }

.z.m.qch.g.lib.handle:{[ext]
    : g.new (
        {[e;x] 
            : g.lib.i.handle[$[-11h~type e;e;`]]
            } ext;
        (::);
        (::)
        )
    }

.z.m.qch.g.lib.i.handle:{[ext]
    : hsym ` sv `.z.m.qch.tables__,`$string[rand 0ng],".",.z.m.axq.asString ext
    }

.z.m.qch.g.lib.ini:{[]
    : g.new ({
            n: first 1? genS.maxSize x;  
            v: g.reify g.listn[n] g.symbol[];    
            l: g.reify g.listn[n]  g.dict[];

            sections    : {enlist "[",string[x],"]"} each v;
            relations   : { "=" sv/: flip (string key x;string value x) } each l;

            : g.lib.i.handle[`ini] 0: raze sections,'relations
            };
            ::; 
            ::
        );
    }

.z.m.qch.g.lib.json:{[]
    : g.new (
        { g.lib.i.handle[`json] 0: enlist .z.m.axutl.json.stringify g.reify g.table[]};
        (::);
        (::)
        )
    }

.z.m.qch.g.lib.keyvalue:{[equate; sep]
    : g.new (
        {[equate; sep; x]
            
            n: first 1?genS.maxSize x;
            if[0~n; : ""];
            
            sep sv {[e;x]
                : g.reify[g.lib.string[]],e,g.reify g.lib.string[]
                }[equate] each til n 
            
            }[equate; sep];
        (::);
        (::)
        )
    }

.z.m.qch.g.lib.negative:{[range]
    if [(::) ~ range; range: 0j];
    
    : g.new (
        
        {[x;y] neg abs first 1?x } range; 
        
        (::);
        
        (::)
        ) 
    }
.z.m.qch.g.lib.nested:{[arb]
    
    if[ (::) ~ arb;
        arb: (first 1?value g.basetypes)[]
        ];
    
    : g.new (
        {[x;y] g.reify g.list x } arb;
        (::);
        (::)
        )
    
        
    
    }

.z.m.qch.g.lib.positive:{[range]
    if [(::) ~ range; range: 0j];
    
    : g.new (
        
        {[x;y] abs first 1?x } range; 
        
        (::);
        
        (::)
        ) 
    }
.z.m.qch.g.lib.pwd:{[]

    if[() ~ key `.z.m.qch.g.lib.i.pwd;  
        // @qlintsuppress MISSING_DEPENDENCY(1)
        g.lib.i.pwd: i.pwd[]]; /dnl
    
    : g.lib.i.pwd 
    }

.z.m.qch.g.lib.string:{[]
    g.list g.char[]
    }

.z.m.qch.g.lib.temporal:{[]
    g.oneof (
        g.month[];
        g.date[];
        g.datetime[];
        g.minute[];
        g.second[];
        g.time[];
        g.timespan[];
        g.timestamp[]
        )
    }

.z.m.qch.g.lib.year:{ 
    : g.new (        
        { 1000 + first 1?9000 };         
        (::);        
        (::)
        ) 
    }

.z.m.qch.g.lib.i.anytable:(!) . flip (
    (`mem;      {[x;y] y}); 
    (`hmem;     set); 
    (`serial;   {hsym[x] set y});
    (`splay;    {(` sv hsym[x],`) set .z.m.table.enum[`:.] 0!y});
    (`part;     {[h; t]
            t:0!t;
            pcol: first 1?`date`month`year`int;   
            pvec:(`date`month`year`int!"dmjj")[pcol]$count[t]?3000; /dnl
            handle: .z.m.table.write[hsym[h],`sample_table,pcol] flip[enlist[pcol]!enlist pvec],'t;
            .z.m.table.map handle;
            : get `sample_table;
            })        
    )
system "d .z.m";

system "d .z.m.qch";
